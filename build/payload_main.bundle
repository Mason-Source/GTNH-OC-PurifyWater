local Component = require("frontend.ui.base")
local theme_registry = require("frontend.theme.registry")
local ThemeCard = {}
function ThemeCard.new()
    local self = Component.new("theme_card", {})
    self.fingerprint = ThemeCard.fingerprint
    self.render = ThemeCard.render
    return self
end
function ThemeCard:fingerprint(context)
    return table.concat({
        self.key, self.rect.x, self.rect.y, self.rect.w, self.rect.h,
        context.themeId,
    }, "\x1f")
end
function ThemeCard:render(context)
    local p = context.painter
    local r = self.rect
    p:panel(r, "主题")
    if r.h < 3 then return end
    local themes = theme_registry.list()
    local buttonW = 10
    local gap = 2
    local totalW = #themes * buttonW + math.max(0, #themes - 1) * gap
    local x = r.x + 2 + math.max(0, math.floor((r.w - 4 - totalW) / 2))
    local y = r.y + 2
    for _, item in ipairs(themes) do
        local active = item.id == context.themeId
        local rect = { x = x, y = y, w = buttonW, h = 1 }
        p:button(rect, item.label, active, false, active and "success" or "text")
        context:hit({ type = "theme", value = item.id }, rect)
        x = x + buttonW + gap
    end
end
return ThemeCard

frontend/ui/painter.lua
5250
local unicode = require("unicode")
local Painter = {}
Painter.__index = Painter
function Painter.new(gpu, theme)
    return setmetatable({
        gpu = gpu,
        theme = theme,
        fg = nil,
        bg = nil,
    }, Painter)
end
function Painter:setTheme(theme)
    self.theme = theme
end
function Painter:begin()
    self.fg = nil
    self.bg = nil
end
local function blend(base, overlay, alpha)
    alpha = math.max(0, math.min(1, alpha))
    local br = math.floor(base / 0x10000) % 0x100
    local bg = math.floor(base / 0x100) % 0x100
    local bb = base % 0x100
    local overlayR = math.floor(overlay / 0x10000) % 0x100
    local og = math.floor(overlay / 0x100) % 0x100
    local ob = overlay % 0x100
    local r = math.floor(br * (1 - alpha) + overlayR * alpha + 0.5)
    local g = math.floor(bg * (1 - alpha) + og * alpha + 0.5)
    local b = math.floor(bb * (1 - alpha) + ob * alpha + 0.5)
    return r * 0x10000 + g * 0x100 + b
end
local function resolve(painter, role, fallback, seen)
    role = role or fallback or "text"
    if type(role) == "number" then return role end
    local colors = painter.theme.color
    local spec = colors[role]
    if spec == nil then return colors[fallback] or colors.text end
    if type(spec) == "number" then return spec end
    seen = seen or {}
    if seen[role] then return colors[fallback] or colors.canvas end
    seen[role] = true
    if type(spec) == "string" then
        return resolve(painter, spec, fallback, seen)
    end
    if type(spec) == "table" then
        local base = resolve(painter, spec.base or spec.inherit or fallback, "canvas", seen)
        if spec.color == nil then return base end
        local alpha = tonumber(spec.alpha)
        if alpha == nil then alpha = 1 end
        if alpha <= 0 then return base end
        if alpha >= 1 then return spec.color end
        return blend(base, spec.color, alpha)
    end
    return colors[fallback] or colors.text
end
function Painter:color(role, fallback)
    return resolve(self, role, fallback or "text")
end
function Painter:setForeground(role)
    local color = self:color(role, "text")
    if self.fg ~= color then
        self.gpu.setForeground(color)
        self.fg = color
    end
end
function Painter:setBackground(role)
    local color = self:color(role, "canvas")
    if self.bg ~= color then
        self.gpu.setBackground(color)
        self.bg = color
    end
end
function Painter:fill(rect, role)
    self:setBackground(role or "canvas")
    self.gpu.fill(rect.x, rect.y, rect.w, rect.h, " ")
end
function Painter:clear(rect)
    self:fill(rect, "canvas")
end
function Painter:measure(text)
    return unicode.wlen(tostring(text or ""))
end
function Painter:truncate(text, width)
    text = tostring(text or "")
    if width <= 0 then return "" end
    if unicode.wlen(text) <= width then return text end
    local out = ""
    for index = 1, unicode.len(text) do
        local char = unicode.sub(text, index, index)
        if unicode.wlen(out .. char) > width - 1 then break end
        out = out .. char
    end
    return out .. "…"
end
function Painter:text(x, y, text, foreground, background, width)
    text = tostring(text or "")
    if width then text = self:truncate(text, width) end
    self:setForeground(foreground or "text")
    self:setBackground(background or "canvas")
    self.gpu.set(x, y, text)
end
function Painter:textRight(x, y, width, text, foreground, background)
    local value = tostring(text or "")
    return self:text(x + width - self:measure(value), y, value, foreground, background)
end
function Painter:panel(rect, title)
    if rect.w < 2 or rect.h < 2 then return end
    self:fill(rect, "surface")
    self:setForeground("border")
    self:setBackground("surface")
    self.gpu.set(rect.x, rect.y, "┌" .. string.rep("─", rect.w - 2) .. "┐")
    if rect.h > 2 then
        self.gpu.fill(rect.x, rect.y + 1, 1, rect.h - 2, "│")
        self.gpu.fill(rect.x + rect.w - 1, rect.y + 1, 1, rect.h - 2, "│")
    end
    self.gpu.set(rect.x, rect.y + rect.h - 1, "└" .. string.rep("─", rect.w - 2) .. "┘")
    if title and rect.w > 6 and rect.h > 2 then
        local value = " " .. title .. " "
        self:text(rect.x + 2, rect.y, value, "accent", "surface", rect.w - 4)
    end
end
function Painter:bar(rect, ratio, fillRole, trackRole, emptyRole)
    ratio = math.max(0, math.min(1, tonumber(ratio) or 0))
    local filled = math.floor(rect.w * ratio)
    local role = filled > 0
        and (trackRole or "barTrack")
        or (emptyRole or "barEmpty")
    self:fill(rect, role)
    if filled > 0 then
        self:fill({ x = rect.x, y = rect.y, w = filled, h = rect.h }, fillRole or "barFill")
    end
end
function Painter:button(rect, text, active, disabled, foreground, background)
    local bg = disabled and "chipDisabled"
        or (active and "chipActive" or background or "chip")
    local fg
    if disabled then
        fg = "disabled"
    elseif active then
        fg = foreground or "accent"
    else
        fg = foreground or "text"
    end
    self:fill(rect, bg)
    local padding = math.max(0, math.floor((rect.w - self:measure(text)) / 2))
    self:text(rect.x + padding, rect.y, text, fg, bg, rect.w - padding)
end
return Painter

frontend/ui/renderer.lua
2308
local Renderer = {}
Renderer.__index = Renderer
function Renderer.new(painter)
    return setmetatable({
        painter = painter,
        fingerprints = {},
        hitboxesByKey = {},
        hitboxes = {},
        forceAll = true,
    }, Renderer)
end
function Renderer:setTheme(theme)
    self.painter:setTheme(theme)
end
function Renderer:invalidateAll()
    self.forceAll = true
end
function Renderer:invalidate(key)
    if key then self.fingerprints[key] = nil else self.forceAll = true end
end
local function makeContext(renderer, app)
    local context = {
        painter = renderer.painter,
        theme = app.theme,
        themeId = app.theme.id,
        ui = app.ui,
        viewport = app.viewport,
        readOnly = app.readOnly == true,
        hitboxes = {},
    }
    function context:hit(action, rect)
        self.hitboxes[#self.hitboxes + 1] = {
            action = action,
            rect = rect,
        }
    end
    return context
end
function Renderer:render(components, app)
    local context = makeContext(self, app)
    if self.forceAll then
        self.painter:clear({
            x = 1,
            y = 1,
            w = app.viewport.width,
            h = app.viewport.height,
        })
        self.fingerprints = {}
        self.hitboxesByKey = {}
    end
    local drawn = 0
    for _, component in ipairs(components or {}) do
        local key = component.key
        local fingerprint = component:fingerprint(context)
        if self.forceAll or self.fingerprints[key] ~= fingerprint then
            context.hitboxes = {}
            component:render(context)
            self.hitboxesByKey[key] = context.hitboxes
            self.fingerprints[key] = fingerprint
            drawn = drawn + 1
        end
    end
    self.hitboxes = {}
    for _, component in ipairs(components or {}) do
        for _, box in ipairs(self.hitboxesByKey[component.key] or {}) do
            self.hitboxes[#self.hitboxes + 1] = box
        end
    end
    self.forceAll = false
    return drawn
end
function Renderer:hit(x, y)
    for _, box in ipairs(self.hitboxes) do
        local rect = box.rect
        if x >= rect.x and x < rect.x + rect.w
            and y >= rect.y and y < rect.y + rect.h then
            return box.action, box
        end
    end
end
return Renderer

hardware/device.lua
2727
local component = require("component")
local clock = require("services.clock")
local log = require("services.log")
local util = require("shared.util")
local device = {}
local METHOD_LABELS = {
    getSensorInformation = "传感器读取",
    getFluidsInNetwork = "流体网络读取",
    getFluidInNetwork = "流体查询",
    getAllStacks = "物品槽读取",
    getFluidInTank = "流体罐读取",
    getFluidTransferRate = "转运速率读取",
    transferFluid = "流体转运",
    transferItem = "物品转运",
    broadcast = "无线广播",
    send = "无线发送",
    isWorkAllowed = "机器开关读取",
    setWorkAllowed = "机器开关下发",
    isMachineActive = "机器运行读取",
    getWorkProgress = "周期进度读取",
    getWorkMaxProgress = "周期总进度读取",
    getEUMaxStored = "能源存量读取",
    getCoordinates = "坐标读取",
    getName = "组件名称读取",
}
local function labelOf(method)
    return METHOD_LABELS[method] or tostring(method)
end
local function duration(ms)
    if ms >= 1000 then return string.format("%.2fs", ms / 1000) end
    return string.format("%.0fms", ms)
end
function device.list()
    local out = {}
    for address, kind in component.list() do out[address] = kind end
    return out
end
function device.typeOf(address)
    if not address then return nil end
    local ok, kind = pcall(component.type, address)
    if ok and type(kind) == "string" then return kind end
    return nil
end
function device.name(address)
    local value = device.invoke(address, "getName")
    if type(value) == "string" and value ~= "" then return value end
    return nil
end
function device.coordinates(address)
    if not address then return nil, nil, nil end
    local ok, x, y, z = pcall(component.invoke, address, "getCoordinates")
    if ok and type(x) == "number" and type(y) == "number" and type(z) == "number" then
        return x, y, z
    end
    return nil, nil, nil
end
function device.invoke(address, method, ...)
    if not address then return nil, "地址为空" end
    local started = clock.cpuTime()
    local ok, value, reason = pcall(component.invoke, address, method, ...)
    local elapsed = (clock.cpuTime() - started) * 1000
    local label = labelOf(method)
    local short = util.shortAddress(address)
    if not ok then
        log.error(string.format("%s失败：%s（%s）", label, tostring(value), short))
        return nil, value
    end
    if elapsed >= 1000 then
        log.warn(string.format("%s延迟 %s（%s）", label, duration(elapsed), short))
    elseif elapsed >= 250 then
        log.diag(string.format("%s %s（%s）", label, duration(elapsed), short))
    end
    return value, reason
end
return device

hardware/energy.lua
2002
local constants = require("shared.constants")
local energy = {}
local function tierVoltage(name)
    local key = tostring(name or ""):lower()
    for _, tier in ipairs(constants.VOLTAGE_TIERS) do
        if tier.name:lower() == key then return tier.eu end
    end
    return nil
end
local function numericVoltage(tier)
    return 8 * (4 ^ tier)
end
local function laserBufferK(head)
    if head:find("wirelesstunnel", 1, true) then return 4000 end
    if head:find("tunnel", 1, true) then return 24 end
    return nil
end
function energy.classify(name)
    name = tostring(name or "")
    local head = name:match("^hatch%.([^.]+)") or name
    local gtnlTier, gtnlAmps = name:match("wirelessenergyhatch(%a+)(%d+)a$")
    if gtnlTier then
        local voltage = tierVoltage(gtnlTier)
        local amps = tonumber(gtnlAmps)
        if voltage and amps then
            return {
                kind = "gtnl",
                voltage = voltage,
                amps = amps,
                bufferK = 4000,
            }
        end
        return { kind = "unknown" }
    end
    local tier = tonumber(name:match("tier%.(%d+)"))
    if not tier then return { kind = "unknown" } end
    local tunnel = tonumber(head:match("tunnel(%d+)"))
    if tunnel then
        return {
            kind = "laser",
            voltage = numericVoltage(tier),
            amps = 64 * (4 ^ tunnel),
            bufferK = laserBufferK(head),
        }
    end
    local multi = tonumber(head:match("multi(%d+)"))
    return {
        kind = "standard",
        voltage = numericVoltage(tier),
        amps = multi or 1,
    }
end
function energy.powerOf(item, euMax)
    local info = energy.classify(item and item.name)
    if info.kind == "unknown" then return 0, "unrecognized energy hatch" end
    if info.bufferK and type(euMax) == "number" and euMax > 0 then
        return math.floor(euMax / info.bufferK + 0.5), info.kind
    end
    return math.floor(info.voltage * info.amps + 0.5), info.kind
end
return energy

hardware/fluid.lua
1286
local device = require("hardware.device")
local constants = require("shared.constants")
local resources = require("shared.resources")
local fluid = {}
local function interfaceAddress(devices)
    for _, item in ipairs(devices or {}) do
        if item.kind == "fluid_interface" or item.kind == "me_interface" then
            return item.address
        end
    end
end
local function amountOf(item)
    if type(item) ~= "table" then return 0 end
    return tonumber(item.size or item.amount or 0) or 0
end
function fluid.readAll(devices)
    local address = interfaceAddress(devices)
    if not address then return nil, "ME interface not found" end
    local list, err = device.invoke(address, "getFluidsInNetwork")
    if type(list) ~= "table" then return nil, err or "invalid fluid list" end
    local byName = {}
    for _, item in ipairs(list) do
        if type(item) == "table" and item.name then
            byName[tostring(item.name):lower():gsub("^gregtech:", "")] = amountOf(item)
        end
    end
    local levels = {}
    for level = 1, constants.LEVEL_COUNT do
        local id = resources.purifiedWaterId(level)
        local name = tostring(id or ""):lower():gsub("^gregtech:", "")
        levels[level] = byName[name] or 0
    end
    return levels
end
return fluid

hardware/gt_infodata.lua
8109
local gtInfodata = {}
local LENS_REQUEST_LABELS = {
    "lens_requested", "lens requested", "current required lens", "required lens",
    "current lens", "当前透镜", "所需透镜", "请求透镜", "需要的透镜"
}
local FIELDS = {
    {
        name    = "parallel",
        keys    = { "parallel.current", "parallel" },
        labels  = { "当前并行", "并行数", "当前并联", "current parallel", "并行", "parallel" },
        exclude = { "机器", "数量", "machine", "count" }
    },
    {
        name   = "success",
        keys   = { "success_chance", "success" },
        labels = { "成功几率", "成功率", "成功概率", "success chance", "success rate",
            "成功", "success", "chance" }
    }
}
function gtInfodata.stripColors(line)
    return (tostring(line):gsub("§.", ""))
end
function gtInfodata.stripIndex(line)
    return (tostring(line):gsub("^%s*%d+%s*[=:：%)%.]%s*", "", 1))
end
function gtInfodata.splitLine(line)
    local clean = gtInfodata.stripIndex(gtInfodata.stripColors(line))
    local key, rest = clean:match("^([%w%._]+)\\+(.*)$")
    if key then
        rest = rest:gsub("\\+", " / ")
        return key, (rest:gsub("^%s+", ""):gsub("%s+$", ""))
    end
    if clean:match("^[%w%._]+$") then
        return clean, ""
    end
    return nil, clean
end
function gtInfodata.firstNumber(text)
    if type(text) ~= "string" then return nil end
    local cleaned = text:gsub("(%d),(%d)", "%1%2")
    local numStr = cleaned:match("([%-%+]?%d+%.?%d*[eE]?[%-%+]?%d*)")
    if not numStr then return nil end
    local num = tonumber(numStr)
    if num == nil then return nil end
    return num
end
function gtInfodata.coloredNumber(text, fromPos)
    if type(text) ~= "string" then return nil end
    local i = fromPos or 1
    while true do
        local pos = text:find("§", i, true)
        if not pos then return nil end
        local seg = text:sub(pos + 3)
        local stop = seg:find("§", 1, true)
        if stop then seg = seg:sub(1, stop - 1) end
        local num = gtInfodata.firstNumber(seg)
        if num ~= nil then return num end
        i = pos + 3
    end
end
local function matchLabel(lowerLine, labels)
    for _, label in ipairs(labels or {}) do
        local needle = label:lower()
        local pos = lowerLine:find(needle, 1, true)
        if pos then return pos, #needle end
    end
    return nil, nil
end
local function excluded(lowerLine, field)
    for _, token in ipairs(field.exclude or {}) do
        if lowerLine:find(token:lower(), 1, true) then return true end
    end
    return false
end
local function findField(raw, plain, key)
    if key then
        local lowerKey = key:lower()
        for _, field in ipairs(FIELDS) do
            for _, k in ipairs(field.keys) do
                if lowerKey:find(k:lower(), 1, true) then
                    local kpos = raw:find(key, 1, true)
                    return field, (kpos and (kpos + #key) or 1)
                end
            end
        end
        return nil, nil
    end
    local lowerRaw = raw:lower()
    local lowerPlain = plain:lower()
    for _, field in ipairs(FIELDS) do
        local pos, len = matchLabel(lowerRaw, field.labels)
        if pos and not excluded(lowerPlain, field) then
            return field, (pos + len)
        end
    end
    return nil, nil
end
local function valueAt(raw, from)
    local num = gtInfodata.coloredNumber(raw, from)
    if num ~= nil then return num end
    if raw:find("§", 1, true) then return nil end
    return gtInfodata.firstNumber(raw:sub(from))
end
local function toLines(lines)
    if lines == nil then return {} end
    if type(lines) == "string" then
        local out = {}
        for line in tostring(lines):gmatch("[^\n]+") do out[#out + 1] = line end
        return out
    end
    if type(lines) ~= "table" then return {} end
    return lines
end
local function labelEnd(raw, labels)
    local lower = tostring(raw):lower()
    for _, label in ipairs(labels or {}) do
        local pos = lower:find(label:lower(), 1, true)
        if pos then return pos + #label end
    end
    return nil
end
local PH_LABELS = {
    "current ph value", "current ph", "ph value", "ph 值", "当前 ph", "当前ph", "酸碱度"
}
local TEMP_LABELS = {
    "current temperature", "temperature", "当前温度", "温度"
}
local SIGNAL_LABELS = {
    "current control signal", "control signal", "control_signal", "控制信号"
}
function gtInfodata.ph(lines)
    for _, raw in ipairs(toLines(lines)) do
        local plain = gtInfodata.stripColors(raw)
        local from = labelEnd(raw, PH_LABELS)
        if from then
            local value = valueAt(raw, from)
            if value ~= nil then return value end
        end
        local key = gtInfodata.splitLine(plain)
        if key and key:lower():find("ph", 1, true) then
            local kpos = raw:find(key, 1, true) or 1
            local value = valueAt(raw, kpos + #key)
            if value ~= nil then return value end
        end
        local value = gtInfodata.firstNumber(plain:match("([%-%d%.]+)%s*[pP][hH]"))
        if value ~= nil then return value end
    end
    return nil
end
function gtInfodata.temperature(lines)
    for _, raw in ipairs(toLines(lines)) do
        local plain = gtInfodata.stripColors(raw)
        local from = labelEnd(raw, TEMP_LABELS)
        if from then
            local value = valueAt(raw, from)
            if value ~= nil then return value end
        end
        local key = gtInfodata.splitLine(plain)
        if key and key:lower():find("temperature", 1, true) then
            local kpos = raw:find(key, 1, true) or 1
            local value = valueAt(raw, kpos + #key)
            if value ~= nil then return value end
        end
        local value = gtInfodata.firstNumber(plain:match("([%-%d%.]+)%s*[kK]"))
        if value ~= nil then return value end
    end
    return nil
end
function gtInfodata.lensRequest(lines)
    for _, raw in ipairs(toLines(lines)) do
        local plain = gtInfodata.stripIndex(gtInfodata.stripColors(raw))
        local lower = plain:lower()
        for _, label in ipairs(LENS_REQUEST_LABELS) do
            if lower:find(label, 1, true) then
                plain = plain:gsub("%s+", " ")
                return (plain:gsub("^%s+", ""):gsub("%s+$", ""))
            end
        end
    end
    return nil
end
function gtInfodata.controlSignal(lines)
    for _, raw in ipairs(toLines(lines)) do
        local plain = gtInfodata.stripColors(raw)
        local bits = plain:match("0[bB]([01]+)")
        if not bits and labelEnd(raw, SIGNAL_LABELS) then
            bits = plain:match("([01]+)%s*$")
        end
        if bits then return tonumber(bits, 2) end
    end
    return nil
end
local function put(info, name, value)
    info[name] = value
end
function gtInfodata.parse(lines)
    local info = {
        parallel = nil,
        success = nil
    }
    if lines == nil then return info end
    local list = toLines(lines)
    for _, raw in ipairs(list) do
        local plain = gtInfodata.stripColors(raw)
        local key = gtInfodata.splitLine(plain)
        local field, from = findField(raw, plain, key)
        if field then
            local num = valueAt(raw, from)
            if num ~= nil then put(info, field.name, num) end
        end
    end
    return info
end
gtInfodata.common = gtInfodata.parse
function gtInfodata.parallel(lines)
    return gtInfodata.common(lines).parallel
end
function gtInfodata.success(lines)
    return gtInfodata.common(lines).success
end
local FIELD_PARSERS = {
    parallel      = gtInfodata.parallel,
    success       = gtInfodata.success,
    ph            = gtInfodata.ph,
    temperature   = gtInfodata.temperature,
    controlSignal = gtInfodata.controlSignal,
    lensRequest   = gtInfodata.lensRequest
}
function gtInfodata.extract(lines, field)
    if field == nil or field == "common" then return gtInfodata.common(lines) end
    local parser = FIELD_PARSERS[field]
    if not parser then return nil, "unknown sensor field: " .. tostring(field) end
    return parser(lines)
end
return gtInfodata

hardware/machines.lua
