local device     = require("backend.hardware.device")
local gtInfodata = require("backend.hardware.gt_infodata")
local probes     = {}
function probes.switch(address)
    local value, err = device.invoke(address, "isWorkAllowed")
    if type(value) == "boolean" then return value, nil end
    return nil, err or ("开关读数不是布尔值：" .. tostring(value))
end
function probes.active(address)
    local value, err = device.invoke(address, "isMachineActive")
    if type(value) == "boolean" then return value, nil end
    return nil, err or ("活动读数不是布尔值：" .. tostring(value))
end
function probes.progress(address)
    local progress, err = device.invoke(address, "getWorkProgress")
    local maxProgress   = device.invoke(address, "getWorkMaxProgress")
    if type(progress) ~= "number" then return nil, nil, err or "无进度读数" end
    return progress, type(maxProgress) == "number" and maxProgress or nil, nil
end
function probes.sensor(address)
    local lines, err = device.invoke(address, "getSensorInformation")
    if type(lines) ~= "table" then return nil, err or "传感器无数据" end
    return gtInfodata.parse(lines), nil
end
function probes.sensorLines(address)
    local lines, err = device.invoke(address, "getSensorInformation")
    if type(lines) ~= "table" then return nil, err or "传感器无数据" end
    return lines, nil
end
return probes

backend/hardware/transposer.lua
6278
local device     = require("backend.hardware.device")
local transposer = {}
local allTankReadable = nil
local allStacksReadable = nil
function transposer.tanks(address, side)
    local count, err, second = device.invoke(address, "getTankCount", side)
    if err then return nil, err end
    if type(count) == "number" and count > 0 then return count, nil end
    return nil, tostring(second or "无容器")
end
local function tankEntry(tank, info)
    if type(info) == "string" then
        return { tank = tank, fluid = info, amount = 0 }
    end
    if type(info) ~= "table" then
        return { tank = tank, fluid = nil, amount = 0 }
    end
    local fluid = info.fluid
    local name = info.name or (type(fluid) == "table" and fluid.name) or fluid
    local amount = info.amount or (type(fluid) == "table" and fluid.amount) or 0
    return {
        tank   = tank,
        fluid  = (type(name) == "string" and name ~= "") and name or nil,
        amount = tonumber(amount) or 0
    }
end
local function numericLen(t)
    local n = 0
    for key in pairs(t or {}) do
        if type(key) == "number" and key > n then n = key end
    end
    return n
end
local function allTankEntries(all)
    if type(all) ~= "table" or next(all) == nil then return nil end
    if all.name ~= nil or all.amount ~= nil or all.fluid ~= nil then
        return { tankEntry(1, all) }
    end
    local count = numericLen(all)
    if count <= 0 then return nil end
    local out = {}
    for tank = 1, count do out[#out + 1] = tankEntry(tank, all[tank]) end
    return out
end
function transposer.containers(address, side)
    local all, invokeErr = device.invoke(address, "getFluidInTank", side)
    local fast = allTankEntries(all)
    if fast then
        allTankReadable = true
        return fast, nil
    end
    if allTankReadable == true and not invokeErr then return nil, "无容器" end
    local count, err = transposer.tanks(address, side)
    if not count then return nil, err end
    local out = {}
    for tank = 1, count do
        local info = device.invoke(address, "getFluidInTank", side, tank)
        out[#out + 1] = tankEntry(tank, info)
    end
    return out, nil
end
function transposer.inventorySize(address, side)
    local size, err, second = device.invoke(address, "getInventorySize", side)
    if err then return nil, err end
    if type(size) == "number" and size > 0 then return size, nil end
    return nil, tostring(second or "无物品库存")
end
local function allStacksEntries(value)
    if value == nil then return nil end
    local ok, all = pcall(function() return value:getAll() end)
    if not ok or type(all) ~= "table" then return nil end
    local base = (all[0] ~= nil) and 1 or 0
    local out = {}
    for index, stack in pairs(all) do
        local slot = tonumber(index)
        if slot and type(stack) == "table" and stack.name then
            out[#out + 1] = {
                slot    = slot + base,
                name    = stack.name,
                damage  = tonumber(stack.damage) or 0,
                label   = stack.label,
                size    = tonumber(stack.size) or 0,
                maxSize = tonumber(stack.maxSize) or 64
            }
        end
    end
    table.sort(out, function(a, b) return a.slot < b.slot end)
    return out
end
function transposer.items(address, side, knownSize)
    if allStacksReadable ~= false then
        local value, valueErr = device.invoke(address, "getAllStacks", side)
        local fast = allStacksEntries(value)
        if fast then
            allStacksReadable = true
            return fast, nil
        end
        if value == nil and valueErr and valueErr:find("no such method", 1, true) then
            allStacksReadable = false
        end
    end
    local size, err
    if type(knownSize) == "number" and knownSize > 0 then
        size = knownSize
    else
        size, err = transposer.inventorySize(address, side)
    end
    if not size then return nil, err end
    local out = {}
    for slot = 1, size do
        local stack = device.invoke(address, "getStackInSlot", side, slot)
        if type(stack) == "table" and stack.name then
            out[#out + 1] = {
                slot    = slot,
                name    = stack.name,
                damage  = tonumber(stack.damage) or 0,
                label   = stack.label,
                size    = tonumber(stack.size) or 0,
                maxSize = tonumber(stack.maxSize) or 64
            }
        end
    end
    return out, nil
end
function transposer.itemCount(address, side, name, damage, limit)
    local items, err = transposer.items(address, side)
    if not items then return 0, err end
    local total = 0
    local wantDamage = tonumber(damage) or 0
    for _, stack in ipairs(items) do
        if stack.name == name and stack.damage == wantDamage then
            total = total + stack.size
            if type(limit) == "number" and limit > 0 and total >= limit then break end
        end
    end
    return total, nil
end
function transposer.findItem(address, side, name, damage)
    local items, err = transposer.items(address, side)
    if not items then return nil, 0, err end
    local wantDamage = tonumber(damage) or 0
    for _, stack in ipairs(items) do
        if stack.name == name and stack.damage == wantDamage then
            return stack.slot, stack.size, nil
        end
    end
    return nil, 0, nil
end
function transposer.transferItems(address, from, to, count, sourceSlot)
    local moved, _, second = device.invoke(address, "transferItem", from, to, count, sourceSlot)
    if type(moved) == "number" then return true, moved end
    return false, tostring(second or "物品转运失败")
end
function transposer.rate(address)
    local value, err = device.invoke(address, "getFluidTransferRate")
    if type(value) == "number" then return value, nil end
    return nil, err or "读不到转运速率"
end
function transposer.transfer(address, from, to, amount, sourceTank)
    local moved, _, second = device.invoke(address, "transferFluid", from, to, amount,
        math.max(0, (tonumber(sourceTank) or 1) - 1))
    if moved == true then
        return true, tonumber(second) or amount
    end
    return false, tostring(second or "转运失败")
end
return transposer

backend/jobs.lua
9747
local computer         = require("computer")
local scheduler        = require("core.scheduler")
local CONFIG           = require("shared.config")
local constants        = require("shared.constants")
local logs             = require("shared.logs")
local state            = require("shared.state")
local device           = require("backend.hardware.device")
local machines         = require("backend.hardware.machines")
local probes           = require("backend.hardware.probes")
local energy           = require("backend.hardware.energy")
local fluid            = require("backend.hardware.fluid")
local inventory        = require("backend.store.inventory")
local settings         = require("backend.store.settings")
local levels_config    = require("backend.store.levels_config")
local rates_config     = require("backend.store.rates_config")
local history          = require("backend.store.history")
local log_file         = require("backend.store.log_file")
local system           = require("backend.app.system")
local produceApp       = require("backend.app.produce")
local hostCycle        = require("backend.domain.host_cycle")
local jobs             = {}
local last             = {
    scanCount = 0,
    summary = nil,
    powerBefore = nil,
    meOk = false,
    missing = {},
    fluidOk = false,
    fluidErr = nil
}
local startedAt        = computer.uptime()
function jobs.elapsed()
    return computer.uptime() - startedAt
end
function jobs.last() return last end
function jobs.scanHardware(skipProducePatrol)
    device.sweep()
    device.scanMe()
    device.scanNet()
    device.scanMachines()
    local summary = machines.classify()
    if produceApp.refresh() then
        scheduler.emit("produce_changed", { reason = "制作自动化就绪性变化" })
    end
    if skipProducePatrol ~= true and produceApp.patrol() then
        scheduler.emit("produce_changed", { reason = "制作自动化原料状态变化" })
    end
    local hatch   = machines.energy()
    local euMax
    if hatch then
        local stored = device.invoke(hatch.address, "getEUMaxStored")
        if type(stored) == "number" then euMax = stored end
    end
    local totalPower, powerNote = energy.powerOf(hatch, euMax)
    if hatch then hatch.power = totalPower end
    local meProxy = device.me()
    local missing = {}
    if summary.host == 0 then missing[#missing + 1] = "净水厂主机" end
    if not meProxy then missing[#missing + 1] = "ME网络接口" end
    if not hatch then missing[#missing + 1] = "能量仓" end
    local diff = inventory.compareAndSave(machines.topology())
    local prevMissing = last.missing
    last.scanCount          = last.scanCount + 1
    last.summary            = summary
    last.meOk, last.missing = meProxy ~= nil, missing
    if #prevMissing > 0 and #missing == 0 then
        logs.system("硬件缺失已恢复：" .. table.concat(prevMissing, "、") .. "；点【启动系统】恢复")
    elseif #prevMissing == 0 and #missing > 0 then
        logs.warn("硬件缺失：" .. table.concat(missing, "、") .. "；请补齐缺失硬件")
    end
    local prevAll = state.read.powerAll()
    if state.read.powerMax() ~= totalPower then
        state.write.setPowerMax(totalPower)
    end
    if #missing > 0 then
        scheduler.emit("hardware_missing", { missing = missing })
    end
    if diff.changed then
        scheduler.emit("hardware_changed", diff)
    end
    local nowAll = state.read.powerAll()
    if prevAll ~= nowAll then
        scheduler.emit("power_changed", { from = prevAll, to = nowAll, note = powerNote })
    end
    last.powerBefore = totalPower
end
function jobs.scanSettings()
    local snapshot = settings.load() or {}
    local changed, why = levels_config.load(snapshot)
    if changed then
        scheduler.emit("level_rules_changed", { why = why })
    end
    local ratesChanged, ratesWhy = rates_config.load(snapshot)
    if ratesChanged then
        scheduler.emit("rates_changed", { why = ratesWhy })
    end
    local produceChanged, produceWhy = produceApp.reload(snapshot)
    if produceChanged then
        scheduler.emit("produce_changed", { reason = produceWhy })
    end
end
function jobs.readFluids()
    local amounts, ok, err = fluid.readAll()
    last.fluidOk, last.fluidErr = ok, err
    local fluids = {}
    for level = 1, constants.LEVEL_COUNT do
        fluids[level] = (ok and amounts[level]) or 0
    end
    state.write.setFluids(fluids)
end
function jobs.observePlants()
    local hostAllowed = nil
    local hostProgress, hostProgressMax
    local cycleStarted, cycleSeq, cycleRatio
    local cycleSamples
    local deployedLevels = {}
    for level = constants.HOST_LEVEL, constants.LEVEL_COUNT do
        local list                 = machines.of(level)
        local snap                 = state.read.plant(level)
        local want                 = state.read.lastPlan()[level]
        local total, on, off, fail = 0, 0, 0, 0
        local running, actFail     = 0, 0
        local facts                = {}
        local minSample, minSuccess
        for _, machine in ipairs(list) do
            total     = total + 1
            local sw  = probes.switch(machine.address)
            local act = probes.active(machine.address)
            if level == constants.HOST_LEVEL and sw ~= false then
                hostProgress, hostProgressMax = probes.progress(machine.address)
                local started, seq, ratio = hostCycle.observe(hostProgress, hostProgressMax)
                if started then
                    cycleStarted, cycleSeq, cycleRatio = true, seq, ratio
                    cycleSamples = {}
                end
            end
            local fact = { address = machine.address, switch = sw, active = act }
            if sw == true then
                on = on + 1
            elseif sw == false then
                off = off + 1
            else
                fail = fail + 1
            end
            if act == true then running = running + 1 end
            if act == nil then actFail = actFail + 1 end
            facts[#facts + 1] = fact
            if level >= 1 and act == true and hostAllowed ~= false then
                local info  = probes.sensor(machine.address)
                local value = info and info.parallel
                if type(value) == "number" then
                    local success = info and info.success or nil
                    fact.parallel = value
                    fact.success  = success
                    if not minSample or value < minSample then minSample = value end
                    if success and (not minSuccess or success < minSuccess) then minSuccess = success end
                    if cycleStarted then
                        cycleSamples[#cycleSamples + 1] = {
                            level    = level,
                            address  = machine.address,
                            parallel = value,
                            success  = success
                        }
                    end
                end
            end
        end
        local observed = nil
        if total > 0 and fail == 0 then
            if on == total then
                observed = true
            elseif off == total then
                observed = false
            end
        end
        local deployed = snap.deployed or 0
        if deployed ~= total then
            deployed = total
            deployedLevels[#deployedLevels + 1] = level
        end
        local fields = {
            deployed = deployed,
            switch   = observed,
            active   = (total > 0 and actFail == 0) and running or nil,
            machines = facts
        }
        if minSample then fields.sample = minSample end
        if minSuccess then fields.success = minSuccess end
        if level == constants.HOST_LEVEL then
            fields.progress    = hostProgress
            fields.progressMax = hostProgressMax
        end
        state.write.recordPlant(level, fields)
        if level == constants.HOST_LEVEL then
            hostAllowed = observed
        end
        if total > 0 then
            scheduler.emit("plant_observed", {
                level = level, switch = observed, active = snap.active, deployed = total, want = want
            })
        end
    end
    if #deployedLevels > 0 then
        scheduler.emit("deployed_changed", { levels = deployedLevels })
    end
    if cycleStarted then
        scheduler.emit("host_cycle_started", {
            seq = cycleSeq,
            ratio = cycleRatio,
            samples = cycleSamples
        })
    end
end
function jobs.schedule()
    system.requestPlan("定时")
end
function jobs.persist()
    history.append()
    local ok, text = history.save()
    if not ok then logs.warn("T5 写历史失败：" .. tostring(text)) end
    local okLog, logNote = log_file.flush()
    if not okLog then logs.warn("T5 写日志失败：" .. tostring(logNote)) end
end
function jobs.register()
    local n = 0
    local function add(...)
        if scheduler.every(...) then n = n + 1 end
    end
    add("scanHardware", CONFIG.INTERVAL.HARDWARE, jobs.scanHardware)  
    add("readFluids", CONFIG.INTERVAL.FLUID, jobs.readFluids)         
    add("observePlants", CONFIG.INTERVAL.OBSERVE, jobs.observePlants) 
    add("schedule", CONFIG.INTERVAL.SCHEDULE, jobs.schedule)          
    add("persist", CONFIG.INTERVAL.PERSIST, jobs.persist)             
    add("produce", CONFIG.INTERVAL.PRODUCE, produceApp.tick)          
    add("produce_runtime", CONFIG.INTERVAL.PRODUCE_RUNTIME,
        function() return require("backend.app.produce_runtime").tick() end) 
    jobs.scanSettings()
    jobs.scanHardware(true)
    jobs.readFluids()
    jobs.observePlants()
    return n
end
return jobs

backend/store/autostart.lua
3097
local files = require("backend.store.files")
local autostart = {}
local BEGIN_MARK = "# >>> PurifyWater autostart >>>"
local END_MARK   = "# <<< PurifyWater autostart <<<"
local function shrcPath()
    local home = os.getenv("HOME")
    if type(home) ~= "string" or home == "" then home = "/home" end
    return home .. "/.shrc"
end
local function mainPath()
    return files.root() .. "/main.lua"
end
local function trim(text)
    return (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end
local function splitLines(text)
    local out = {}
    for line in (tostring(text or "") .. "\n"):gmatch("(.-)\n") do
        out[#out + 1] = line:gsub("\r$", "")
    end
    if out[#out] == "" then out[#out] = nil end
    return out
end
local function joinLines(lines)
    if #lines == 0 then return "" end
    return table.concat(lines, "\n") .. "\n"
end
local function extractBlocks(lines)
    local kept, commands, removed = {}, {}, 0
    local i = 1
    while i <= #lines do
        if trim(lines[i]) == BEGIN_MARK then
            removed = removed + 1
            i = i + 1
            while i <= #lines and trim(lines[i]) ~= END_MARK do
                local body = trim(lines[i])
                if body ~= "" then commands[#commands + 1] = body end
                i = i + 1
            end
            if i <= #lines then i = i + 1 end
        else
            kept[#kept + 1] = lines[i]
            i = i + 1
        end
    end
    return kept, commands, removed
end
local function findManualLine(lines, target)
    for _, line in ipairs(lines) do
        local text = trim(line)
        if text ~= "" and text:sub(1, 1) ~= "#" and text:find(target, 1, true) then
            return text
        end
    end
    return nil
end
function autostart.read()
    local path       = shrcPath()
    local text       = files.read(path)
    local kept, cmds = extractBlocks(splitLines(text))
    local target     = cmds[#cmds] or nil
    local want       = mainPath()
    local matches    = (target ~= nil) and (target:find(want, 1, true) ~= nil)
    return {
        enabled    = matches,
        stale      = (target ~= nil) and not matches,
        path       = path,
        target     = target,
        exists     = text ~= nil,
        manualLine = findManualLine(kept, want)
    }
end
function autostart.enable()
    local path      = shrcPath()
    local kept      = extractBlocks(splitLines(files.read(path)))
    kept[#kept + 1] = BEGIN_MARK
    kept[#kept + 1] = string.format('lua "%s"', mainPath())
    kept[#kept + 1] = END_MARK
    local ok, err = files.write(path, joinLines(kept))
    if not ok then return false, tostring(err or "写文件失败") end
    return true, path
end
function autostart.disable()
    local path       = shrcPath()
    if not files.exists(path) then return true, path end
    local kept, _, n = extractBlocks(splitLines(files.read(path)))
    if n == 0 then return true, path end
    local ok, err = files.write(path, joinLines(kept))
    if not ok then return false, tostring(err or "写文件失败") end
    return true, path
end
return autostart

backend/store/files.lua
1867
local filesystem = require("filesystem")
local files = {}
local ROOT = "."
function files.setRoot(dir)
    ROOT = tostring(dir or ".")
end
function files.root()
    return ROOT
end
function files.path(name)
    local s = tostring(name or "")
    if s:sub(1, 1) == "/" then return s end
    return ROOT .. "/" .. s
end
function files.exists(path)
    local ok, v = pcall(filesystem.exists, path)
    return ok and v == true
end
function files.read(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local ok, text = pcall(function() return f:read("*a") end)
    f:close()
    if not ok then return nil end
    return text
end
function files.readLines(path)
    local text = files.read(path)
    if not text then return {} end
    local out = {}
    for line in text:gmatch("[^\r\n]+") do
        if line:gsub("%s", "") ~= "" then out[#out + 1] = line end
    end
    return out
end
function files.ensureDir(dir)
    if dir == nil or dir == "" or dir == "." then return true end
    if files.exists(dir) then return true end
    pcall(filesystem.makeDirectory, dir)
    return files.exists(dir)
end
function files.write(path, text)
    local dir = path:match("^(.*)[/\\][^/\\]*$")
    if dir then files.ensureDir(dir) end
    local tmp = path .. ".tmp"
    local f, err = io.open(tmp, "w")
    if not f then return false, tostring(err) end
    f:write(tostring(text or ""))
    f:close()
    local ok, renameErr = pcall(function()
        if filesystem.exists(path) then pcall(filesystem.remove, path) end
        pcall(filesystem.rename, tmp, path)
    end)
    if not ok then return false, tostring(renameErr) end
    return true
end
function files.writeLines(path, lines)
    local out = {}
    for _, line in ipairs(lines) do out[#out + 1] = tostring(line) end
    return files.write(path, table.concat(out, "\n") .. "\n")
end
return files

backend/store/history.lua
4741
local CONFIG    = require("shared.config")
local constants = require("shared.constants")
local state     = require("shared.state")
local files     = require("backend.store.files")
local history   = {}
local viewCache = { key = nil, data = nil }
local function path()
    return files.path(CONFIG.FILES.HISTORY)
end
local function viewKey(points, window)
    local n = #points
    return string.format("%d:%d:%s", n, (n > 0) and math.floor(points[n].t) or 0, tostring(window or 0))
end
local function numbers(line)
    local mark, rest = tostring(line):match("^(%a)%s+(.*)$")
    if not mark then return nil end
    local nums = {}
    for token in rest:gmatch("[%d%.%-]+") do
        local value = tonumber(token)
        if value then nums[#nums + 1] = value end
    end
    return mark, nums
end
local function at(list, index)
    local value = list[index]
    if type(value) ~= "number" then return 0 end
    return value
end
local function sample()
    local water = {}
    for level = 1, constants.LEVEL_COUNT do water[level] = state.read.fluids()[level] or 0 end
    local opened = 0
    for level = 1, constants.LEVEL_COUNT do
        if state.read.lastPlan()[level] == true then opened = opened + 1 end
    end
    return {
        t = os.time(),
        w = water,
        p = state.read.powerAll(),
        u = state.read.powerAll() - state.read.budget(),
        o = opened
    }
end
function history.append()
    local point = sample()
    state.write.chartAppend(point)
    local points = state.read.chart().points
    local limit  = (CONFIG.CHART and CONFIG.CHART.POINTS) or 80
    if #points > limit then
        local tail = {}
        for i = #points - limit + 1, #points do tail[#tail + 1] = points[i] end
        state.write.chartSetPoints(tail)
    end
    return point
end
function history.load()
    local chartPoints = {}
    if not files.exists(path()) then
        state.write.chartSetPoints(chartPoints)
        return false, "没有历史文件"
    end
    local points = 0
    for _, line in ipairs(files.readLines(path())) do
        local mark, nums = numbers(line)
        if mark == "P" and #nums >= 4 + constants.LEVEL_COUNT then
            local w = {}
            for level = 1, constants.LEVEL_COUNT do w[level] = at(nums, 4 + level) end
            chartPoints[#chartPoints + 1] = {
                t = at(nums, 1), p = at(nums, 2), u = at(nums, 3), o = at(nums, 4), w = w
            }
            points = points + 1
        end
    end
    local limit = (CONFIG.CHART and CONFIG.CHART.POINTS) or 80
    if #chartPoints > limit then
        local tail = {}
        for i = #chartPoints - limit + 1, #chartPoints do tail[#tail + 1] = chartPoints[i] end
        chartPoints = tail
    end
    state.write.chartSetPoints(chartPoints)
    return points > 0, string.format("历史：%d 个采样点（保留最新 %d 个）", points, #chartPoints)
end
function history.save()
    local chart = state.read.chart()
    local lines = {
        "# 净水厂历史（自动生成：删掉会重新记录）",
        "# P <时刻> <可用功率> <已用功率> <开着级数> <T1..T8 水量>"
    }
    for _, point in ipairs(chart.points) do
        local nums = { "P", math.floor(point.t), math.floor(point.p or 0),
            math.floor(point.u or 0), point.o or 0 }
        for level = 1, constants.LEVEL_COUNT do
            nums[#nums + 1] = math.floor((point.w and point.w[level]) or 0)
        end
        lines[#lines + 1] = table.concat(nums, " ")
    end
    local ok, err = files.writeLines(path(), lines)
    if not ok then return false, "写历史失败：" .. tostring(err) end
    return true, string.format("历史已写盘（%d 点）", #chart.points)
end
function history.view(window)
    local points = state.read.chart().points
    local key    = viewKey(points, window)
    if viewCache.key == key and viewCache.data then return viewCache.data end
    local from = 1
    if window and window > 0 and #points > 0 then
        local latest = points[#points].t
        while from < #points and (latest - points[from].t) > window do from = from + 1 end
    end
    local times, values = {}, {}
    for level = 1, constants.LEVEL_COUNT do values[level] = {} end
    for i = from, #points do
        local point = points[i]
        times[#times + 1] = point.t
        for level = 1, constants.LEVEL_COUNT do
            values[level][#values[level] + 1] = (point.w and point.w[level]) or 0
        end
    end
    local result = {
        times  = times,
        values = values,
        count  = #times,
        span   = (#times >= 2) and (times[#times] - times[1]) or 0,
        window = window or 0
    }
    viewCache.key, viewCache.data = key, result
    return result
end
return history

backend/store/inventory.lua
1340
local CONFIG    = require("shared.config")
local files     = require("backend.store.files")
local inventory = {}
local function toLine(item)
    return string.format("%s %s %s", tostring(item.level), tostring(item.address), tostring(item.name))
end
local function addressOf(line)
    return tostring(line):match("^%S+%s+(%S+)")
end
function inventory.compareAndSave(items)
    local path = files.path(CONFIG.FILES.HARDWARE)
    local prev = files.readLines(path)
    local prevSet = {}
    for _, line in ipairs(prev) do
        local address = addressOf(line)
        if address then prevSet[address] = line end
    end
    local lines, nowSet = {}, {}
    for _, item in ipairs(items or {}) do
        lines[#lines + 1] = toLine(item)
        nowSet[item.address] = item
    end
    table.sort(lines)
    local added, removed = {}, {}
    for address, item in pairs(nowSet) do
        if not prevSet[address] then added[#added + 1] = item.name end
    end
    for address, line in pairs(prevSet) do
        if not nowSet[address] then removed[#removed + 1] = line end
    end
    table.sort(added)
    table.sort(removed)
    local changed = #added > 0 or #removed > 0
    if changed or #prev == 0 then files.writeLines(path, lines) end
    return { changed = changed, added = added, removed = removed, path = path }
end
return inventory

backend/store/levels_config.lua
3219
local CONFIG        = require("shared.config")
local constants     = require("shared.constants")
local models        = require("shared.models")
local state         = require("shared.state")
local settings      = require("backend.store.settings")
local levels_config = {}
local lastText      = nil
local function thresholdKey(level) return "threshold." .. tostring(level) end
local function enabledKey(level)   return "enabled."   .. tostring(level) end
local function defaultOf(level)
    local d = CONFIG.LEVELS_DEFAULT or {}
    return { threshold = d.threshold or 0, enabled = d.enabled ~= false }
end
local function fingerprint(rules)
    local lines = {}
    for level = 1, constants.LEVEL_COUNT do
        local rule = rules[level] or defaultOf(level)
        lines[#lines + 1] = string.format("%d|%d|%s", level,
            math.floor(tonumber(rule.threshold) or 0), rule.enabled and "true" or "false")
    end
    return table.concat(lines, "\n")
end
local function ensureKeys(snapshot)
    local pairsToSet, missing = {}, 0
    for level = 1, constants.LEVEL_COUNT do
        local d = defaultOf(level)
        if snapshot[thresholdKey(level)] == nil then
            pairsToSet[thresholdKey(level)] = math.floor(tonumber(d.threshold) or 0)
            missing = missing + 1
        end
        if snapshot[enabledKey(level)] == nil then
            pairsToSet[enabledKey(level)] = d.enabled and "true" or "false"
            missing = missing + 1
        end
    end
    if missing == 0 then return snapshot, 0 end
    settings.setMany(pairsToSet)
    for key, value in pairs(pairsToSet) do snapshot[key] = tostring(value) end
    return snapshot, missing
end
function levels_config.load(snapshot)
    snapshot = ensureKeys(snapshot or settings.load() or {})
    local rules = {}
    for level = 1, constants.LEVEL_COUNT do
        local d         = defaultOf(level)
        local threshold = tonumber(snapshot[thresholdKey(level)]) or d.threshold
        rules[level] = {
            threshold = threshold,
            enabled   = models.bool(snapshot[enabledKey(level)], d.enabled)
        }
    end
    local text = fingerprint(rules)
    if text == lastText then return false, "阈值配置未变化" end
    lastText   = text
    state.write.setRules(rules)
    return true, string.format("阈值配置已更新（%d 级）", constants.LEVEL_COUNT)
end
function levels_config.set(level, threshold, enabled)
    local current = state.read.rules()[level] or defaultOf(level)
    state.write.setRuleLevel(level, {
        threshold = threshold or current.threshold,
        enabled   = (enabled == nil) and current.enabled or (enabled == true)
    })
    return levels_config.saveAll()
end
function levels_config.saveAll()
    local pairsToSet = {}
    for level = 1, constants.LEVEL_COUNT do
        local rule = state.read.rules()[level] or defaultOf(level)
        pairsToSet[thresholdKey(level)] = math.floor(tonumber(rule.threshold) or 0)
        pairsToSet[enabledKey(level)]   = rule.enabled and "true" or "false"
    end
    local ok, err = settings.setMany(pairsToSet)
    if not ok then return false, err end
    lastText = fingerprint(state.read.rules())
    return true
end
return levels_config

