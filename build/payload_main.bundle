local CONFIG    = require("shared.config")
local constants = require("shared.constants")
local files     = require("backend.store.files")
local format    = require("backend.store.produce.format")
local produce_table = {}
local function path()
    return files.path(CONFIG.FILES.PRODUCE)
end
function produce_table.load()
    local entries, problems = {}, {}
    local seenMachine, seenTransposer = {}, {}
    for _, line in ipairs(files.readLines(path())) do
        local raw = tostring(line)
        if raw:match("^%s*[^#%s]") then
            local level, machine, transposer, rest =
                raw:match("^%s*(%d+)%s+(%S+)%s+(%S+)%s*(.*)$")
            level = tonumber(level)
            if not level or level < 1 or level > constants.LEVEL_COUNT then
                problems[#problems + 1] = "行格式不对（已跳过）：" .. raw
            elseif seenMachine[machine] then
                problems[#problems + 1] = "机器重复绑定（已跳过）：" .. machine
            elseif seenTransposer[transposer] then
                problems[#problems + 1] = "转运器重复绑定（已跳过）：" .. transposer
            else
                local fields = format.parseFields(rest)
                local sides, sideErr = format.parseSides(fields)
                if sideErr then
                    problems[#problems + 1] = string.format("%s（已忽略侧位）：%s", sideErr, raw)
                else
                    seenMachine[machine], seenTransposer[transposer] = true, true
                    entries[#entries + 1] = {
                        level      = level,
                        machine    = machine,
                        transposer = transposer,
                        sides      = sides,
                        layout     = (fields.layout and fields.layout ~= "-") and fields.layout or nil
                    }
                end
            end
        end
    end
    table.sort(entries, format.less)
    return entries, problems
end
function produce_table.save(entries)
    local lines = {
        "# 制作自动化绑定表（程序写入；一行一台机器：级 机器地址 转运器地址）",
        "# 可选侧位：fluid_target=... fluid_sources=... item_target=... item_sources=... layout=..."
    }
    for _, entry in ipairs(entries or {}) do
        local parts = {
            string.format("%d %s %s",
                entry.level, tostring(entry.machine), tostring(entry.transposer))
        }
        local s = entry.sides
        if type(s) == "table"
            and (s.target ~= nil or s.itemTarget ~= nil
                or (type(s.sources) == "table" and #s.sources > 0)
                or (type(s.itemSources) == "table" and #s.itemSources > 0)) then
            parts[#parts + 1] = "fluid_target=" .. format.sideText(s.target)
            parts[#parts + 1] = "fluid_sources=" .. format.listText(s.sources)
            parts[#parts + 1] = "item_target=" .. format.sideText(s.itemTarget)
            parts[#parts + 1] = "item_sources=" .. format.listText(s.itemSources)
        end
        if entry.layout and tostring(entry.layout) ~= "" then
            parts[#parts + 1] = "layout=" .. tostring(entry.layout)
        end
        lines[#lines + 1] = table.concat(parts, " ")
    end
    return files.writeLines(path(), lines)
end
return produce_table

backend/store/produce/format.lua
2779
local format = {}
local SIDE_MIN, SIDE_MAX = 0, 5
function format.less(a, b)
    if a.level ~= b.level then return a.level < b.level end
    return tostring(a.machine) < tostring(b.machine)
end
function format.sideText(value)
    local n = tonumber(value)
    if n and n >= SIDE_MIN and n <= SIDE_MAX and n % 1 == 0 then
        return tostring(n)
    end
    return "-"
end
function format.listText(list)
    if type(list) ~= "table" or #list == 0 then return "-" end
    local out = {}
    for _, value in ipairs(list) do
        local n = tonumber(value)
        if n and n >= SIDE_MIN and n <= SIDE_MAX and n % 1 == 0 then
            out[#out + 1] = tostring(n)
        end
    end
    if #out == 0 then return "-" end
    table.sort(out, function(a, b) return tonumber(a) < tonumber(b) end)
    return table.concat(out, ",")
end
local function parseSide(text)
    if text == nil or text == "" or text == "-" then return nil, false end
    local n = tonumber(text)
    if n and n >= SIDE_MIN and n <= SIDE_MAX and n % 1 == 0 then
        return n, false
    end
    return nil, true
end
local function parseSideList(text)
    if text == nil or text == "" or text == "-" then return {}, false end
    local out = {}
    for part in tostring(text):gmatch("[^,]+") do
        local n, bad = parseSide(part)
        if bad then return nil, true end
        if n ~= nil then out[#out + 1] = n end
    end
    table.sort(out)
    return out, false
end
function format.parseFields(rest)
    local fields = {}
    for token in tostring(rest or ""):gmatch("%S+") do
        local key, value = token:match("^([%w_]+)=(.+)$")
        if key then fields[key] = value end
    end
    return fields
end
function format.parseSides(fields)
    local has = fields.fluid_target or fields.fluid_sources
        or fields.item_target or fields.item_sources
    if not has then return nil, nil end
    local fluidTarget, bad = parseSide(fields.fluid_target)
    if bad then return nil, "fluid_target 非法" end
    local fluidSources, badSources = parseSideList(fields.fluid_sources)
    if badSources then return nil, "fluid_sources 非法" end
    local itemTarget, badItem = parseSide(fields.item_target)
    if badItem then return nil, "item_target 非法" end
    local itemSources, badItemSources = parseSideList(fields.item_sources)
    if badItemSources then return nil, "item_sources 非法" end
    fluidSources, itemSources = fluidSources or {}, itemSources or {}
    if fluidTarget == nil and itemTarget == nil
        and #fluidSources == 0 and #itemSources == 0 then
        return nil, nil
    end
    return {
        target      = fluidTarget,
        sources     = fluidSources,
        itemTarget  = itemTarget,
        itemSources = itemSources
    }, nil
end
return format

backend/store/produce_config.lua
2071
local constants      = require("shared.constants")
local models         = require("shared.models")
local state          = require("shared.state")
local settings       = require("backend.store.settings")
local produce_config = {}
local lastText       = nil
local DEFAULT        = false
local function keyOf(level) return "produce." .. tostring(level) end
local function fingerprint(flags)
    local lines = {}
    for level = 1, constants.LEVEL_COUNT do
        lines[#lines + 1] = string.format("%d=%s", level, flags[level] and "true" or "false")
    end
    return table.concat(lines, "|")
end
local function ensureKeys(snapshot)
    local pairsToSet, missing = {}, 0
    for level = 1, constants.LEVEL_COUNT do
        if snapshot[keyOf(level)] == nil then
            pairsToSet[keyOf(level)] = DEFAULT and "true" or "false"
            missing = missing + 1
        end
    end
    if missing == 0 then return snapshot end
    settings.setMany(pairsToSet)
    for key, value in pairs(pairsToSet) do snapshot[key] = tostring(value) end
    return snapshot
end
function produce_config.load(snapshot)
    snapshot = ensureKeys(snapshot or settings.load() or {})
    local flags = {}
    for level = 1, constants.LEVEL_COUNT do
        flags[level] = models.bool(snapshot[keyOf(level)], DEFAULT)
        state.write.produceSetLevel(level, { enabled = flags[level] })
    end
    local text = fingerprint(flags)
    if text == lastText then return false, "制作自动化开关未变化" end
    lastText = text
    return true, string.format("制作自动化开关已更新（%d 级）", constants.LEVEL_COUNT)
end
function produce_config.set(level, enabled)
    local ok, err = settings.setMany({ [keyOf(level)] = enabled and "true" or "false" })
    if not ok then return false, err end
    state.write.produceSetLevel(level, { enabled = enabled == true })
    local flags = {}
    for n = 1, constants.LEVEL_COUNT do
        flags[n] = state.read.produceLevel(n).enabled == true
    end
    lastText = fingerprint(flags)
    return true, nil
end
return produce_config

backend/store/rates_config.lua
5345
local CONFIG       = require("shared.config")
local constants    = require("shared.constants")
local models        = require("shared.models")
local state        = require("shared.state")
local settings     = require("backend.store.settings")
local rates        = require("backend.domain.rates")
local rates_config = {}
local lastText     = nil
local REFLUX_LEVELS = { 1, 2 }
local DUAL_LITHIUM_KEY = "t6_dual_lithium"
local function weightKey(level) return "weight." .. tostring(level) end
local function refluxKey(level) return "reflux." .. tostring(level) end
local function sanitizeWeight(value)
    local w = tonumber(value)
    if not w then return CONFIG.RATES.DEFAULT_WEIGHT end
    w = math.floor(w)
    if w < 0 then w = 0 end
    if w > CONFIG.RATES.MAX_WEIGHT then w = CONFIG.RATES.MAX_WEIGHT end
    return w
end
local function fingerprint(weights, boost, reflux, dualLithium)
    local parts = {
        "boost=" .. tostring(boost),
        "dual=" .. tostring(dualLithium == true)
    }
    for level = 1, constants.LEVEL_COUNT do
        parts[#parts + 1] = string.format("%d=%d", level, weights[level] or 0)
        parts[#parts + 1] = string.format("reflux%d=%s", level,
            reflux[level] == true and "true" or "false")
    end
    return table.concat(parts, "|")
end
local function ensureKeys(snapshot)
    local pairsToSet, missing = {}, 0
    for level = 1, constants.LEVEL_COUNT do
        if snapshot[weightKey(level)] == nil then
            pairsToSet[weightKey(level)] = CONFIG.RATES.DEFAULT_WEIGHT
            missing = missing + 1
        end
    end
    if snapshot["t7_boost"] == nil then
        pairsToSet["t7_boost"] = CONFIG.RATES.DEFAULT_T7_BOOST
        missing = missing + 1
    end
    for _, level in ipairs(REFLUX_LEVELS) do
        if snapshot[refluxKey(level)] == nil then
            pairsToSet[refluxKey(level)] = constants.RATE_REFLUX_LEVELS[level] == true
            missing = missing + 1
        end
    end
    if snapshot[DUAL_LITHIUM_KEY] == nil then
        pairsToSet[DUAL_LITHIUM_KEY] = CONFIG.RATES.DEFAULT_T6_DUAL_LITHIUM
        missing = missing + 1
    end
    if missing == 0 then return snapshot, 0 end
    settings.setMany(pairsToSet)
    for key, value in pairs(pairsToSet) do snapshot[key] = tostring(value) end
    return snapshot, missing
end
function rates_config.load(snapshot)
    snapshot = ensureKeys(snapshot or settings.load() or {})
    local weights = {}
    for level = 1, constants.LEVEL_COUNT do
        weights[level] = sanitizeWeight(snapshot[weightKey(level)])
    end
    local boost = rates.acceptBoost(snapshot["t7_boost"])
    local reflux = {}
    for level = 1, constants.LEVEL_COUNT do
        reflux[level] = models.bool(snapshot[refluxKey(level)],
            constants.RATE_REFLUX_LEVELS[level] == true)
    end
    local dualLithium = models.bool(snapshot[DUAL_LITHIUM_KEY],
        CONFIG.RATES.DEFAULT_T6_DUAL_LITHIUM)
    local text = fingerprint(weights, boost, reflux, dualLithium)
    if text == lastText then return false, "速率配置未变化" end
    lastText = text
    state.write.setWeights(weights)
    state.write.setBoost(boost)
    state.write.setReflux(reflux)
    state.write.setT6DualLithium(dualLithium)
    return true, string.format(
        "速率配置已更新（%d 级权重 ｜ T7 增产 ×%s ｜ 回流 T1=%s T2=%s ｜ T6 双锂=%s）",
        constants.LEVEL_COUNT, tostring(boost),
        reflux[1] and "开" or "关", reflux[2] and "开" or "关", dualLithium and "开" or "关")
end
function rates_config.setWeight(level, weight)
    local w = sanitizeWeight(weight)
    state.write.setWeightLevel(level, w)
    local ok, err = settings.setMany({ [weightKey(level)] = w })
    if not ok then return false, err end
    lastText = fingerprint(state.read.weights(), state.read.t7Boost(),
        state.read.reflux(), state.read.t6DualLithium())
    return true
end
function rates_config.setBoost(value)
    local boost = rates.acceptBoost(value)
    state.write.setBoost(boost)
    local ok, err = settings.setMany({ t7_boost = boost })
    if not ok then return false, err end
    lastText = fingerprint(state.read.weights(), state.read.t7Boost(),
        state.read.reflux(), state.read.t6DualLithium())
    return true
end
function rates_config.setReflux(level, enabled)
    local allowed = false
    for _, item in ipairs(REFLUX_LEVELS) do
        if item == level then allowed = true break end
    end
    if not allowed then return false, "回流数据收集只支持 T1/T2" end
    if type(enabled) ~= "boolean" then return false, "开关值无效" end
    local ok, err = settings.setMany({ [refluxKey(level)] = enabled })
    if not ok then return false, err end
    state.write.setRefluxLevel(level, enabled)
    lastText = fingerprint(state.read.weights(), state.read.t7Boost(),
        state.read.reflux(), state.read.t6DualLithium())
    return true
end
function rates_config.setT6DualLithium(enabled)
    if type(enabled) ~= "boolean" then return false, "开关值无效" end
    local ok, err = settings.setMany({ [DUAL_LITHIUM_KEY] = enabled })
    if not ok then return false, err end
    state.write.setT6DualLithium(enabled)
    lastText = fingerprint(state.read.weights(), state.read.t7Boost(),
        state.read.reflux(), state.read.t6DualLithium())
    return true
end
return rates_config

backend/store/settings.lua
