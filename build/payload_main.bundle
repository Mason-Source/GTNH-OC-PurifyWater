backend/domain/produce/t4.lua
2189
local resources = require("shared.resources")
local t4 = {}
local ACID = resources.FLUIDS.HYDROCHLORIC_ACID
local ALKALINE = resources.ITEMS.SODIUM_HYDROXIDE_DUST
local PH_TARGET    = 7
local PH_TOLERANCE = 0.05
local PH_PER_DUST  = 0.01
local PH_PER_10_ACID = 0.01
local MAX_DUST     = 250
local MAX_ACID     = 2500
local STOCK_DUST   = 64
local FLUIDS = { ACID }
local ITEMS  = { ALKALINE }
t4.priority = 30
function t4.requiredFluids() return FLUIDS end
function t4.requiredItems() return ITEMS end
function t4.usesItems() return true end
local STOCK = {
    { item = ALKALINE, amount = STOCK_DUST, label = ALKALINE.label },
    { fluid = ACID.id, amount = MAX_ACID, label = ACID.label }
}
function t4.stockRequirements() return STOCK end
function t4.minTransferRate() return 50000 end
function t4.fluidUnit() return 10 end
function t4.demand(ph)
    ph = tonumber(ph)
    if ph == nil then return nil, "读不到 pH", nil end
    if ph <= 0 then return nil, "pH 尚未初始化", ph end
    local errorValue = PH_TARGET - ph
    if math.abs(errorValue) <= PH_TOLERANCE then
        return {}, nil, ph
    end
    if errorValue > 0 then
        local count = math.min(MAX_DUST, math.floor(errorValue / PH_PER_DUST + 0.5))
        return { { item = ALKALINE, amount = count, label = ALKALINE.label } }, nil, ph
    end
    local doses = math.floor((-errorValue) / PH_PER_10_ACID + 0.5)
    local amount = math.min(MAX_ACID, doses * 10)
    return { { fluid = ACID.id, amount = amount, label = ACID.label } }, nil, ph
end
function t4.need() return {}, nil, nil end
function t4.operation(ctx)
    local ph, err = ctx.sensorInfo("ph")
    if ph == nil then return false, tostring(err or "读不到 pH") end
    local demand, why = t4.demand(ph)
    if not demand then return false, tostring(why) end
    if #demand == 0 then return true end
    for _, need in ipairs(demand) do
        local ok, itemWhy
        if need.item then
            ok, itemWhy = ctx.transferItem(need.item, need.amount)
        else
            ok, itemWhy = ctx.transferFluid(need.fluid, need.amount, need.label)
        end
        if not ok then return false, itemWhy end
    end
    return true
end
return t4

backend/domain/produce/t5.lua
3105
local resources = require("shared.resources")
local t5 = {}
local PLASMA       = resources.FLUIDS.HELIUM_PLASMA
local COOLANT      = resources.FLUIDS.SUPERCOOLANT
local HEAT_TARGET  = 10000
local MAX_TEMP     = 12500
local MAX_CYCLES   = 3
local PLASMA_NEED  = 100
local COOLANT_NEED = 2000
local CYCLE_SETTLE = 1
t5.PLASMA       = PLASMA.id
t5.COOLANT      = COOLANT.id
t5.HEAT_TARGET  = HEAT_TARGET
t5.MAX_TEMP     = MAX_TEMP
t5.MAX_CYCLES   = MAX_CYCLES
t5.PLASMA_NEED  = PLASMA_NEED
t5.COOLANT_NEED = COOLANT_NEED
t5.priority     = 5
local FLUIDS = { PLASMA, COOLANT }
local STOCK  = {
    { fluid = PLASMA.id, amount = PLASMA_NEED, label = PLASMA.label },
    { fluid = COOLANT.id, amount = COOLANT_NEED, label = COOLANT.label }
}
function t5.requiredFluids() return FLUIDS end
function t5.stockRequirements() return STOCK end
function t5.need() return {}, nil, nil end
local function readTemperature(ctx)
    local temperature, err = ctx.sensorInfo("temperature")
    if temperature == nil then return nil, tostring(err or "温度不可读") end
    return temperature, nil
end
local function waitHeat(ctx, temperature)
    while temperature < HEAT_TARGET do
        if temperature > MAX_TEMP then return nil, "温度超过安全上限" end
        if not ctx.active() then return nil, "机器 active=false" end
        ctx.wait((HEAT_TARGET - math.max(0, temperature)) / 1000)
        local err
        temperature, err = readTemperature(ctx)
        if temperature == nil then return nil, err end
    end
    return temperature, nil
end
local function waitCool(ctx, temperature)
    while temperature > 0 do
        if temperature > MAX_TEMP then return nil, "温度超过安全上限" end
        if not ctx.active() then return nil, "机器 active=false" end
        ctx.wait(temperature / 500)
        local err
        temperature, err = readTemperature(ctx)
        if temperature == nil then return nil, err end
    end
    return temperature, nil
end
function t5.operation(ctx)
    local temperature, err = readTemperature(ctx)
    if temperature == nil then return false, err end
    if temperature > MAX_TEMP then return false, "温度超过安全上限" end
    if not ctx.active() then return false, "机器 active=false" end
    if temperature > 0 then
        temperature, err = waitCool(ctx, temperature)
        if temperature == nil then return false, err end
    end
    for _ = 1, MAX_CYCLES do
        if not ctx.active() then return false, "机器 active=false" end
        local ok, why = ctx.transferFluid(PLASMA.id, PLASMA_NEED, PLASMA.label)
        if not ok then return false, why end
        temperature, err = waitHeat(ctx, temperature)
        if temperature == nil then return false, err end
        if not ctx.active() then return false, "机器 active=false" end
        ok, why = ctx.transferFluid(COOLANT.id, COOLANT_NEED, COOLANT.label)
        if not ok then return false, why end
        temperature, err = waitCool(ctx, temperature)
        if temperature == nil then return false, err end
        ctx.wait(CYCLE_SETTLE)
    end
    return true
end
return t5

backend/domain/produce/t6.lua
3708
local resources = require("shared.resources")
local t6 = {}
local WAIT      = 3
local MAX_PROBES = 6
local LENSES = {
    resources.ITEMS.LENS_SYNTHETIC_JADE,
    resources.ITEMS.LENS_AMBER,
    resources.ITEMS.LENS_WIND_MAGIC_CRYSTAL,
    resources.ITEMS.LENS_EMERALD,
    resources.ITEMS.LENS_MAGIC_DIAMOND,
    resources.ITEMS.LENS_BLUE_TOPAZ,
    resources.ITEMS.LENS_AMETHYST,
    resources.ITEMS.LENS_FLUORINE_IRON_TOURMALINE,
    resources.ITEMS.LENS_DILITHIUM
}
local REQUIRED = {}
for index = 1, #LENSES - 1 do REQUIRED[index] = LENSES[index] end
t6.LENSES = LENSES
t6.priority = 6
t6.recoversTargetItems = true
function t6.requiredItems() return REQUIRED end
function t6.usesItems() return true end
function t6.need() return {}, nil, nil end
local function readLensRequest(ctx)
    local signature, err = ctx.sensorInfo("lensRequest")
    if signature == nil then return nil, tostring(err or "透镜需求不可读") end
    signature = tostring(signature)
    if signature == "" then return nil, "透镜需求签名为空" end
    return signature, nil
end
local function waitLensRequest(ctx)
    local lastErr
    for attempt = 1, MAX_PROBES do
        if not ctx.active() then return nil, "机器 active=false" end
        local signature, err = readLensRequest(ctx)
        if signature then return signature, nil end
        lastErr = err
        if attempt < MAX_PROBES then ctx.wait(WAIT) end
    end
    return nil, lastErr or "透镜需求不可读"
end
local function waitLensRequestChange(ctx, baseline)
    local lastErr
    for _ = 1, MAX_PROBES do
        if not ctx.active() then return nil, "机器 active=false" end
        ctx.wait(WAIT)
        local signature, err = readLensRequest(ctx)
        if signature then
            if signature ~= baseline then return signature, nil end
        else
            lastErr = err
        end
    end
    return nil, lastErr or string.format("%d 秒内透镜需求未变化", WAIT * MAX_PROBES)
end
function t6.operation(ctx)
    local recovered, recoverWhy = ctx.recoverTarget()
    if not recovered then
        return false, "目标侧残留回收失败：" .. tostring(recoverWhy)
    end
    local signature, requestWhy = waitLensRequest(ctx)
    if not signature then
        return false, "读取初始透镜需求失败：" .. tostring(requestWhy)
    end
    local first = LENSES[1]
    local moved, moveWhy = ctx.transferItem(first, 1)
    if not moved then
        return false, string.format("%s 投放失败：%s", first.label, tostring(moveWhy))
    end
    for index = 1, #LENSES - 1 do
        local nextSignature, waitWhy = waitLensRequestChange(ctx, signature)
        if not nextSignature then
            return false, string.format("等待第 %d 枚透镜需求变化失败：%s；%s 保留在目标侧",
                index + 1, tostring(waitWhy), LENSES[index].label)
        end
        signature = nextSignature
        if not ctx.active() then return false, "机器 active=false" end
        local current = LENSES[index]
        local returned, returnWhy = ctx.returnItem(current)
        if not returned then
            return false, string.format("%s 回收失败：%s",
                current.label, tostring(returnWhy))
        end
        local nextIndex = index + 1
        local nextLens = LENSES[nextIndex]
        local inserted, insertWhy = ctx.transferItem(nextLens, 1)
        if not inserted then
            if nextIndex == #LENSES then return true end
            return false, string.format("%s 投放失败：%s",
                nextLens.label, tostring(insertWhy))
        end
        if nextIndex == #LENSES then
            return true
        end
    end
    return true
end
return t6

