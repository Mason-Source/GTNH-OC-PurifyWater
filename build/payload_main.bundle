local constants = require("shared.constants")
local state     = require("shared.state")
local power     = {}
function power.adopted(level)
    local learn = state.read.learn(level)
    if learn and type(learn.parallel) == "number" and learn.parallel > 0 then
        return learn.parallel, "measured"
    end
    return power.suggest(level), "suggest"
end
function power.levelParallel(level)
    return power.adopted(level) * math.max(0, state.read.plant(level).deployed or 0)
end
function power.levelPower(level)
    return power.levelParallel(level) * (constants.POWER_LEVELS[level] or 0)
end
function power.suggest(level)
    return state.read.suggest(level)
end
function power.suggestVector()
    local out = {}
    for level = 1, constants.LEVEL_COUNT do
        out[level] = math.floor(tonumber(state.read.suggest(level)) or 0)
    end
    return out
end
function power.refresh()
    state.write.setBudget(state.read.powerAll())
end
return power

backend/domain/produce.lua
1337
local constants = require("shared.constants")
local state     = require("shared.state")
local check     = require("backend.domain.produce.check")
local produce   = {}
local impls     = {}
local REQUIRED  = { "need" }
function produce.register(level, impl)
    level = tonumber(level)
    assert(level and level >= 1 and level <= constants.LEVEL_COUNT,
        "制作自动化方法等级越界：" .. tostring(level))
    assert(type(impl) == "table",
        string.format("%s 的制作自动化方法实现必须是表", constants.levelLabel(level)))
    for _, name in ipairs(REQUIRED) do
        assert(type(impl[name]) == "function",
            string.format("%s 的制作自动化方法缺接口 %s()", constants.levelLabel(level), name))
    end
    impls[level] = impl
end
function produce.has(level)
    return impls[level] ~= nil
end
function produce.method(level)
    return impls[level]
end
produce.check = check.run
function produce.blocked(level)
    if not produce.has(level) then return false end
    local entry = state.read.produceLevel(level)
    if entry.enabled ~= true then return false end
    if entry.valid ~= true then return true end
    for _, sub in pairs(state.read.produce().subs) do
        if sub.level == level and sub.forceOff == true then return true end
    end
    return false
end
return produce

backend/domain/produce/check.lua
1293
local check = {}
local function short(address)
    local s = tostring(address or "")
    if s == "" then return "-" end
    return s:sub(1, 8)
end
function check.run(level, units, env)
    if type(level) ~= "number" then return false, "等级无效" end
    if #units == 0 then return false, "该级没有机器" end
    local unbound = 0
    for _, unit in ipairs(units) do
        if not (env.machines or {})[unit.machine] then
            return false, "机器不在该级注册表：" .. short(unit.machine)
        end
        if not unit.transposer then
            unbound = unbound + 1
        elseif not unit.online then
            return false, "转运器不在网：" .. short(unit.transposer)
        elseif env.minRate then
            local rate = unit.rate
            if type(rate) ~= "number" then
                return false, "读不到转运速率：" .. short(unit.machine)
            end
            if rate < env.minRate then
                return false, string.format("转运器速度不足：%d < %d mB/s（机器 %s）",
                    rate, env.minRate, short(unit.machine))
            end
        end
    end
    if unbound > 0 then
        return false, string.format("还有 %d 台机器未绑定", unbound)
    end
    return true, nil
end
return check

backend/domain/produce/interface.lua
1028
local interface = {}
local function call(method, name)
    local fn = method and method[name]
    if type(fn) ~= "function" then return nil end
    return fn()
end
function interface.requiredFluids(method) return call(method, "requiredFluids") end
function interface.requiredItems(method) return call(method, "requiredItems") end
function interface.stockRequirements(method) return call(method, "stockRequirements") end
function interface.patrolByNeed(method) return call(method, "patrolByNeed") == true end
function interface.minTransferRate(method) return call(method, "minTransferRate") end
function interface.operation(method) return method and method.operation or nil end
function interface.priority(method) return tonumber(method and method.priority) or nil end
function interface.recoversTargetItems(method)
    return method and method.recoversTargetItems == true
end
function interface.applicable(method)
    return interface.requiredFluids(method) ~= nil or interface.requiredItems(method) ~= nil
end
return interface

