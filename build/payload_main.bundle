local event      = require("event")
local computer   = require("computer")
local CONFIG     = require("shared.config")
local logs       = require("shared.logs")
local utils      = require("shared.utils")
local scheduler  = require("core.scheduler")
local runtime    = {}
local quitting   = false
local quitReason = nil
function runtime.quit(reason)
    if quitting then return false end
    quitting   = true
    quitReason = reason or "程序退出"
    return true
end
function runtime.quitReason() return quitReason end
function runtime.discardStaleInterrupts()
    local dropped = 0
    for _ = 1, 20 do
        local ev = { event.pull(0) }
        if ev[1] == nil then break end
        if ev[1] == "interrupted" then
            dropped = dropped + 1
        else
            scheduler.emit(ev[1], ev)
        end
    end
    return dropped
end
local function clampWait(wait)
    local min = CONFIG.LOOP_MIN_IDLE or 0.05
    local max = CONFIG.LOOP_MAX_IDLE or 1.0
    if type(wait) ~= "number" or wait ~= wait then return max end
    if wait < min then return min end
    if wait > max then return max end
    return wait
end
function runtime.frame(onFrame)
    local now  = computer.uptime()
    local wait = clampWait(scheduler.secondsUntilDue(now))
    local ev   = { event.pull(wait) }
    if ev[1] ~= nil then
        scheduler.emit(ev[1], ev)
    end
    if quitting then return true end
    scheduler.tick(computer.uptime())
    scheduler.drain()
    if onFrame then onFrame() end
    return quitting
end
function runtime.run(onFrame)
    while not quitting do
        runtime.frame(onFrame)
    end
    logs.system("主循环结束：" .. tostring(quitReason or "未说明原因"))
end
function runtime.bindQuitKeys()
    scheduler.on("interrupted", function()
        runtime.quit("Ctrl+C")
    end)
    scheduler.on("key_down", function(ev)
        local char, code = ev[3], ev[4]
        if utils.isKey(char, code, "q") then runtime.quit("按键 Q") end
    end)
end
return runtime

core/scheduler.lua
2532
local computer  = require("computer")
local CONFIG    = require("shared.config")
local logs      = require("shared.logs")
local scheduler = {}
local tasks     = {}
local byName    = {}
local listeners = {}
local queue     = {}
local drainSeq  = 0
local MAX_DRAIN = 200
function scheduler.every(name, interval, fn, opts)
    if byName[name] then return false end
    local task = {
        name     = name,
        interval = interval,
        fn       = fn,
        enabled  = not (opts and opts.enabled == false),
        lastRun  = computer.uptime()
    }
    tasks[#tasks + 1] = task
    byName[name] = task
    return true
end
function scheduler.setEnabled(name, on)
    local task = byName[name]
    if not task then return false end
    task.enabled = (on == true)
    return true
end
function scheduler.secondsUntilDue(now)
    now = now or computer.uptime()
    local nextWait = nil
    for _, task in ipairs(tasks) do
        if task.enabled then
            local wait = task.lastRun + task.interval - now
            if wait < 0 then wait = 0 end
            if nextWait == nil or wait < nextWait then nextWait = wait end
        end
    end
    if nextWait == nil then return CONFIG.LOOP_MAX_IDLE or 1.0 end
    return nextWait
end
function scheduler.tick(now)
    now = now or computer.uptime()
    local executed = 0
    for _, task in ipairs(tasks) do
        if task.enabled then
            local interval = task.interval
            if now - task.lastRun >= interval then
                task.lastRun = now
                task.fn(now)
                executed = executed + 1
            end
        end
    end
    return executed
end
function scheduler.on(event, fn)
    if type(fn) ~= "function" then return end
    local list = listeners[event]
    if not list then
        list = {}
        listeners[event] = list
    end
    list[#list + 1] = fn
end
function scheduler.emit(event, payload)
    queue[#queue + 1] = { name = event, payload = payload }
end
function scheduler.drain()
    drainSeq = drainSeq + 1
    local n = 0
    while #queue > 0 do
        if n >= MAX_DRAIN then
            logs.warn("事件队列单帧超过 " .. MAX_DRAIN .. " 条，疑似处理器互相触发，已截断")
            queue = {}
            break
        end
        local item = table.remove(queue, 1)
        n = n + 1
        for _, fn in ipairs(listeners[item.name] or {}) do
            fn(item.payload)
        end
    end
    return n
end
function scheduler.drainSeq()
    return drainSeq
end
return scheduler

frontend/charts.lua
9300
local utils        = require("shared.utils")
local unicode      = require("unicode")
local logs         = require("shared.logs")
local fstate       = require("frontend.state")
local theme        = require("frontend.theme")
local widgets      = require("frontend.widgets")
local charts       = {}
charts.PAD_X       = 2
charts.PAD_Y       = 1
charts.GUTTER      = 7
local boundsWarned = false
function charts.fitNumber(value, w)
    w          = math.max(1, math.floor(w or 1))
    local text = utils.formatShortNumber(value or 0)
    if unicode.wlen(text) <= w then return text end
    local short = (text:gsub("%.%d+", "")) 
    if unicode.wlen(short) <= w then return short end
    return unicode.sub(short, 1, math.max(0, w - 1)) .. "…"
end
local function gutterLabel(area, y, value, color)
    widgets.drawTextRight(area.x + 1, charts.GUTTER, y,
        charts.fitNumber(value, charts.GUTTER), color)
end
function charts.checkBounds(tag, x0, y0, w, h, minY, maxY, maxX)
    if boundsWarned then return end
    if maxX > x0 + w - 1 or maxY > y0 + h - 1 or minY < y0 then
        boundsWarned = true
        logs.warn(string.format(
            "%s 绘制越界：画布 x=%d..%d y=%d..%d，实际用到 x..%d y=%d..%d",
            tag, x0, x0 + w - 1, y0, y0 + h - 1, maxX, minY, maxY))
    end
end
function charts.metrics(area, yOffset)
    local x0 = area.x + charts.PAD_X + 1 + charts.GUTTER
    local y0 = area.y + charts.PAD_Y + 2 + (yOffset or 0)
    local w  = area.w - charts.PAD_X * 2 - 2 - charts.GUTTER
    local h  = area.h - 5
    return x0, y0, w, h
end
function charts.clear(x0, y0, w, h)
    fstate.gpu.setBackground(theme.COLORS.BG)
    fstate.gpu.fill(x0, y0, w, h, " ")
end
function charts.grid(x0, y0, w, h, rows)
    if w < 8 or h < 4 then return end
    rows = rows or 4
    fstate.gpu.setForeground(theme.CHART_GRID)
    for i = 1, rows - 1 do
        local y = y0 + math.floor(h * i / rows)
        for x = 0, w - 1 do fstate.gpu.set(x0 + x, y, "·") end
    end
    fstate.gpu.setForeground(theme.CHART_AXIS)
    for x = 0, w - 1 do fstate.gpu.set(x0 + x, y0 + h - 1, "─") end
    for y = 0, h - 1 do fstate.gpu.set(x0 - 1, y0 + y, "│") end
    fstate.gpu.set(x0 - 1, y0 + h - 1, "└")
end
function charts.project(values, x0, y0, w, h, fixedMin, fixedMax)
    local n = #values
    local minVal, maxVal = fixedMin, fixedMax
    if minVal == nil or maxVal == nil then
        minVal, maxVal = values[1], values[1]
        for i = 2, n do
            local v = values[i]
            if v < minVal then minVal = v end
            if v > maxVal then maxVal = v end
        end
    end
    if minVal == maxVal then maxVal = minVal + 1 end
    local points = {}
    for i = 1, n do
        local px = x0 + math.floor((i - 1) / math.max(1, n - 1) * (w - 1))
        local py = y0 + h - 1 - math.floor((values[i] - minVal) / (maxVal - minVal) * (h - 1))
        points[i] = { x = px, y = py }
    end
    return points, minVal, maxVal
end
function charts.series(area, series, times, title)
    local x0, y0, w, h = charts.metrics(area)
    if w < 8 or h < 4 then return false end
    charts.clear(x0, y0, w, h)
    charts.grid(x0, y0, w, h)
    local minVal, maxVal, drawable = nil, nil, 0
    local valid = {}
    for _, line in ipairs(series) do
        local values = line.values or {}
        if #values >= 2 then
            drawable = drawable + 1
            valid[#valid + 1] = line
            for i = 1, #values do
                local v = values[i]
                if minVal == nil or v < minVal then minVal = v end
                if maxVal == nil or v > maxVal then maxVal = v end
            end
        end
    end
    if drawable == 0 then
        widgets.drawText(x0, y0 - 1, title, theme.COLORS.TEXT_CYAN)
        widgets.drawCenteredTip({ x = x0, y = y0, w = w, h = h }, "数据采集中…")
        return false
    end
    local minUsedY, maxUsedY, maxUsedX = y0, y0, x0
    for _, line in ipairs(valid) do
        local points = charts.project(line.values, x0, y0, w, h, minVal, maxVal)
        fstate.gpu.setForeground(line.color or theme.CHART_WATER)
        for i = 1, #points - 1 do
            local p1, p2 = points[i], points[i + 1]
            local steps = math.max(1, math.abs(p2.x - p1.x))
            for s = 0, steps do
                local x = p1.x + math.floor((p2.x - p1.x) * s / steps)
                local y = p1.y + math.floor((p2.y - p1.y) * s / steps)
                fstate.gpu.set(x, y, "█")
                minUsedY = math.min(minUsedY, y)
                maxUsedY = math.max(maxUsedY, y)
                maxUsedX = math.max(maxUsedX, x)
            end
        end
    end
    charts.checkBounds("折线", x0, y0, w, h, minUsedY, maxUsedY, maxUsedX)
    widgets.drawText(x0, y0 - 1, title, theme.COLORS.TEXT_CYAN)
    gutterLabel(area, y0, maxVal, theme.COLORS.TEXT_YELLOW)
    gutterLabel(area, y0 + h - 1, minVal, theme.COLORS.TEXT_YELLOW)
    local now = os.time()
    local n   = #times
    if n >= 2 then
        for _, index in ipairs({ 1, math.floor(n / 2) + 1, n }) do
            local point = charts.pointAt(index, n, x0, w)
            local diff  = now - (times[index] or now)
            local text
            if index == n then
                text = "现在"
            elseif diff < 60 then
                text = "刚刚"
            elseif diff < 3600 then
                text = string.format("-%d 分", math.floor(diff / 60))
            else
                text = string.format("-%d 时", math.floor(diff / 3600))
            end
            local labelX = point - math.floor(unicode.wlen(text) / 2)
            labelX = math.max(x0, math.min(labelX, x0 + w - unicode.wlen(text)))
            widgets.drawText(labelX, y0 + h, text, theme.COLORS.TEXT)
        end
    end
    return true
end
local function niceCeil(v)
    if v <= 0 then return 1 end
    local pow = 1
    while pow * 10 <= v do pow = pow * 10 end
    local frac = v / pow
    local step = (frac <= 1) and 1 or (frac <= 2) and 2 or (frac <= 5) and 5 or 10
    return step * pow
end
function charts.bars(area, values, labels, title)
    local x0, y0, w, h = charts.metrics(area)
    if w < 8 or h < 4 then return false end
    charts.clear(x0, y0, w, h)
    charts.grid(x0, y0, w, h)
    local n = #values
    if n == 0 then return false end
    local extreme = 0
    for i = 1, n do
        local v = values[i] or 0
        if math.abs(v) > extreme then extreme = math.abs(v) end
    end
    local bound = niceCeil(extreme * 1.05)
    local minVal, maxVal = -bound, bound
    local span = maxVal - minVal
    local function yOf(v)
        return y0 + h - 2 - math.floor((v - minVal) / span * (h - 2))
    end
    local zeroY = yOf(0)
    fstate.gpu.setForeground(theme.CHART_AXIS)
    for x = 0, w - 1 do fstate.gpu.set(x0 + x, zeroY, "─") end
    local cellW = math.floor(w / n)
    if cellW < 3 then cellW = 3 end
    local barW                         = math.max(1, math.min(cellW - 2, w))
    local rooms                        = (cellW >= 6)
    local minUsedY, maxUsedY, maxUsedX = y0, y0, x0
    for i = 1, n do
        local v      = values[i] or 0
        local barX   = x0 + (i - 1) * cellW + math.floor((cellW - barW) / 2)
        barX         = math.max(x0, math.min(barX, x0 + w - barW))
        local valueY = yOf(v)
        local top    = math.max(y0, math.min(zeroY, valueY))
        local bottom = math.min(y0 + h - 1, math.max(zeroY, valueY))
        local rowH   = math.max(1, bottom - top + 1)
        local color  = (v >= 0) and theme.CHART_WATER or theme.COLORS.TEXT_RED
        if v ~= 0 then
            fstate.gpu.setBackground(color)
            fstate.gpu.fill(barX, top, barW, rowH, " ")
            fstate.gpu.setBackground(theme.COLORS.BG)
            minUsedY = math.min(minUsedY, top)
            maxUsedY = math.max(maxUsedY, top + rowH - 1)
        end
        maxUsedX     = math.max(maxUsedX, barX + barW - 1)
        local label  = tostring(labels[i] or "")
        local labelX = x0 + (i - 1) * cellW + math.floor((cellW - unicode.wlen(label)) / 2)
        labelX       = math.max(x0, math.min(labelX, x0 + w - unicode.wlen(label)))
        widgets.drawText(labelX, y0 + h, label, theme.COLORS.TEXT)
        maxUsedX = math.max(maxUsedX, labelX + unicode.wlen(label) - 1)
        if rooms then
            local text = charts.fitNumber(v, cellW)
            local ty   = (v >= 0) and (top - 1) or (top + rowH)
            if ty > y0 + h - 2 then ty = top - 1 end
            ty          = math.max(y0, math.min(y0 + h - 2, ty))
            local textX = x0 + (i - 1) * cellW + math.floor((cellW - unicode.wlen(text)) / 2)
            textX       = math.max(x0, math.min(textX, x0 + w - unicode.wlen(text)))
            widgets.drawText(textX, ty, text, color)
            maxUsedX = math.max(maxUsedX, textX + unicode.wlen(text) - 1)
        end
    end
    charts.checkBounds("柱状图", x0, y0, w, h, minUsedY, maxUsedY, maxUsedX)
    gutterLabel(area, y0, bound, theme.COLORS.TEXT_YELLOW)
    gutterLabel(area, zeroY, 0, theme.COLORS.CHART_AXIS)
    gutterLabel(area, y0 + h - 2, -bound, theme.COLORS.TEXT_YELLOW)
    return true
end
function charts.pointAt(index, n, x0, w)
    if n <= 1 then return x0 end
    return x0 + math.floor((index - 1) / (n - 1) * (w - 1))
end
return charts

frontend/decorate.lua
5392
local utils     = require("shared.utils")
local constants = require("shared.constants")
local theme     = require("frontend.theme")
local M         = {}
local function hostText(sw)
    if sw == nil then return "读取失败", theme.COLORS.TEXT_RED end
    if sw then return "已开启", theme.COLORS.TEXT_GREEN end
    return "已关闭", theme.COLORS.TEXT_RED
end
local function kiloText(milli)
    local kilo = (milli or 0) / 1000
    if kilo == math.floor(kilo) then return utils.formatNumber(kilo) end
    return (string.format("%.3f", kilo):gsub("0+$", ""):gsub("%.$", ""))
end
function M.apply(data)
    local modeId     = data.system.mode or "threshold"
    data.runModeText = (modeId == "rate") and "速率调度" or "阈值调度"
    local machineTotal = 0
    for level = 1, constants.LEVEL_COUNT do
        local row = data.levels[level]
        if not row then
            row = { level = level, label = constants.levelLabel(level), deployed = 0,
                rule = { threshold = 0, effectiveThreshold = 0, enabled = false } }
            data.levels[level] = row
        end
        local pr = (data.produce and data.produce.levels and data.produce.levels[level]) or {}
        row.produceEnabled = pr.enabled == true
        if pr.implemented ~= true then
            row.produceText      = "-"
            row.produceColor     = theme.COLORS.TEXT_DISABLED
            row.produceClickable = false
        elseif pr.state == "off" then
            row.produceText      = "[ ]"
            row.produceColor     = theme.COLORS.TEXT_DISABLED
            row.produceClickable = true
        elseif pr.state == "ok" then
            row.produceText      = "[√]"
            row.produceColor     = theme.COLORS.TEXT_GREEN
            row.produceClickable = true
        elseif pr.state == "blocked" then
            row.produceText      = "[!]"
            row.produceColor     = theme.COLORS.TEXT_YELLOW
            row.produceClickable = true
        else
            row.produceText      = "[×]"
            row.produceColor     = theme.COLORS.TEXT_RED
            row.produceClickable = true
        end
        row.produceReason = pr.reason
        row.label = row.label or constants.levelLabel(level)
        row.rule  = row.rule or { threshold = 0, effectiveThreshold = 0, enabled = false }
        row.running        = (row.deployed > 0) and ((row.active or 0) > 0) or false
        row.waterText      = utils.formatShortNumber(row.water or 0)
        row.thresholdText  = utils.formatShortNumber(row.rule.effectiveThreshold)
        row.thresholdKText = kiloText(row.rule.threshold)
        row.userThresholdText = utils.formatShortNumber(row.rule.userThreshold)
        row.thresholdOverridden = row.rule.thresholdOverridden == true
        row.sampleText     = row.sample and utils.formatShortNumber(row.sample) or "-"
        row.sampleStale    = (row.active or 0) == 0
        local rateStale    = (row.sampleStale and row.success ~= nil) and "（上次）" or ""
        row.rateText       = string.format("成功率 %s%s",
            row.success and (tostring(row.success) .. "%") or "-", rateStale)
        row.suggestText    = utils.formatShortNumber(row.suggest or 0)
        row.switchText     = (row.deployed == 0) and "未部署"
            or ((row.switch == nil) and "读取失败" or (row.switch and "开" or "关"))
        row.deployText     = string.format("×%d", row.deployed or 0)
        row.runText        = (row.deployed == 0) and "-"
            or ((row.active == nil) and "?" or (tostring(row.active) .. "/" .. tostring(row.deployed)))
        row.waterOfText    = string.format("%s / %s", row.waterText, row.thresholdText)
        machineTotal       = machineTotal + (row.deployed or 0)
        local base         = row.rule.effectiveThreshold
        row.ratio          = (base and base > 0) and math.min(1, (row.water or 0) / base) or 0
    end
    data.systemText, data.systemColor = theme.systemStatus(data.system, data.hardware, data.host)
    data.hostText, data.hostColor     = hostText(data.host.switch)
    local usedText                    = utils.formatShortNumber(data.power.used or 0)
    local allText                     = utils.formatShortNumber(data.power.all or 0)
    data.powerText                    = string.format("%s / %s EU/t", usedText, allText)
    data.meText                       = data.hardware.me and "已连接" or "未连接"
    data.meColor                      = data.hardware.me
        and theme.COLORS.TEXT_GREEN or theme.COLORS.TEXT_RED
    data.machineText                  = string.format("%d 台（T1–T8）", machineTotal)
    local hp, hm                      = data.host.progress, data.host.progressMax
    data.cycleRatio                   = (hp and hm and hm > 0) and math.max(0, math.min(1, hp / hm)) or 0
    data.cycleText                    = (hp and hm and hm > 0)
        and string.format("%d%%", math.floor(data.cycleRatio * 100 + 0.5)) or "未运行"
    return data
end
function M.startBlockedReason(data)
    if not data or not data.system then return "状态未知" end
    if data.system.running then return nil end
    local missing = (data.hardware or {}).missing or {}
    if #missing > 0 then return "硬件缺失（" .. table.concat(missing, "/") .. "）" end
    if (data.host or {}).switch == false then return "净水主机未开机" end
    return nil
end
return M

frontend/input.lua
9651
local utils     = require("shared.utils")
local constants = require("shared.constants")
local CONFIG    = require("shared.config")
local logs      = require("shared.logs")
local api       = require("backend.api")
local viewmodel = require("frontend.viewmodel")
local fstate    = require("frontend.state")
local viewinput = require("frontend.viewinput")
local input     = {}
local function fire(command, ...)
    local ok, text = api.exec(command, ...)
    if not ok and text and text ~= "" then
        logs.ui(tostring(text))
    end
    viewmodel.expire()
    return ok
end
local function switchTab(tab)
    if fstate.currentTab == tab then return end
    fstate.currentTab = tab
    fstate.editLevel, fstate.editField, fstate.editBuf = nil, nil, nil
    fstate.invalidateAll()
end
local function selectCell(level, field)
    if fstate.editLevel == level and fstate.editField == field then
        fstate.editLevel, fstate.editField, fstate.editBuf = nil, nil, nil
        return
    end
    local row = fstate.lastData and fstate.lastData.levels[level]
    fstate.editLevel, fstate.editField = level, field
    if field == "threshold" then
        local milli    = (row and row.rule.threshold) or 0
        fstate.editBuf = tostring(math.floor(milli / 1000))
    elseif field == "weight" then
        fstate.editBuf = tostring(math.floor(tonumber(row and row.weight) or 0))
    else
        fstate.editBuf = nil
    end
end
local function selectFactor()
    local sys = fstate.lastData and fstate.lastData.system
    fstate.editLevel, fstate.editField = nil, "factor"
    fstate.editBuf = tostring(math.floor(tonumber(sys and sys.energyFactor) or 100))
end
local function selectStrength()
    local netState = fstate.lastData and fstate.lastData.net
    fstate.editLevel, fstate.editField = nil, "strength"
    fstate.editBuf = tostring(math.floor(tonumber(netState and netState.strength) or CONFIG.NET.STRENGTH))
end
local function clearEdit()
    fstate.editLevel, fstate.editField, fstate.editBuf = nil, nil, nil
end
local function applyCell(level, field)
    if field == "produce" then
        local row = fstate.lastData and fstate.lastData.levels[level]
        if not row or row.produceClickable ~= true then return end
        selectCell(level, "produce")
        fstate.producePage = 1
        return
    end
    if field ~= "enabled" then
        selectCell(level, field)
        return
    end
    local row = fstate.lastData and fstate.lastData.levels[level]
    if not row then return end
    fire("level_enabled_set", level, not (row.rule.enabled == true))
end
local function applyKey(key)
    local field, level = fstate.editField, fstate.editLevel
    if not field then return end
    if field ~= "factor" and field ~= "strength" and not level then return end
    local kind = key.kind
    if kind == "cancel" then
        clearEdit()
        return
    end
    if field == "boost" then
        if kind == "set_boost" then
            fire("t7_boost_set", tonumber(key.value))
            clearEdit()
        elseif kind == "set_reflux" then
            fire("reflux_set", level, key.value == true)
            clearEdit()
        elseif kind == "set_t6_dual" then
            fire("t6_dual_lithium_set", key.value == true)
            clearEdit()
        end
        return
    end
    local isThreshold = (field == "threshold")
    local isFactor    = (field == "factor")
    local isStrength  = (field == "strength")
    local limit       = isThreshold and (CONFIG.UI.MAX_THRESHOLD_KILO or 100000000000000)
        or isFactor and CONFIG.ENERGY.FACTOR_MAX
        or isStrength and CONFIG.NET.STRENGTH_MAX
        or (CONFIG.RATES.MAX_WEIGHT or 100)
    if kind == "commit" then
        local value = tonumber(fstate.editBuf or "")
        if not value then
            logs.ui("未填数字，未保存")
            return
        end
        if isThreshold then
            if value >= limit then
                logs.ui("超过上限（≥ 1e14 kL），未保存")
                return
            end
            fire("level_rules_set", level, value * 1000, nil)
        elseif isFactor then
            if value < CONFIG.ENERGY.FACTOR_MIN or value > limit then
                logs.ui(string.format("利用因子需为 %d-%d 的整数，未保存",
                    CONFIG.ENERGY.FACTOR_MIN, limit))
                return
            end
            fire("energy_factor_set", value)
        elseif isStrength then
            if value < 0 or value > limit then
                logs.ui(string.format("无线范围需为 0-%d 的整数（方块），未保存", limit))
                return
            end
            fire("net_strength_set", value) 
        else
            if value < 0 or value > limit then
                logs.ui(string.format("权重需为 0-%d 的整数，未保存", limit))
                return
            end
            fire("weight_set", level, value)
        end
        clearEdit()
        return
    end
    local buf = fstate.editBuf or ""
    if kind == "digit" then
        if buf == "0" then buf = "" end 
        buf = buf .. key.value
    elseif kind == "mul" or kind == "div" then
        local n     = tonumber(buf) or 0
        local scale = tonumber(key.value) or 1
        buf         = tostring((kind == "mul") and (n * scale) or math.floor(n / scale))
    elseif kind == "set" then
        buf = key.value
    elseif kind == "back" then
        buf = buf:sub(1, math.max(0, #buf - 1))
    elseif kind == "clear" then
        buf = ""
    elseif kind == "copy" then
        local prev = fstate.lastData and fstate.lastData.levels[level - 1]
        if prev then buf = tostring(math.floor((prev.rule.threshold or 0) / 1000)) end
    end
    if buf ~= "" then
        local value = tonumber(buf)
        local over
        if not value then over = true
        elseif isThreshold then over = (value >= limit)
        else over = (value > limit) end
        if over then
            local name = isFactor and "利用因子" or isStrength and "无线范围" or "权重"
            logs.ui(isThreshold and "超过上限（≥ 1e14 kL），未生效"
                or string.format("%s上限 %d，未生效", name, limit))
            return
        end
    end
    fstate.editBuf = buf
end
local function setChartLevel(level)
    fstate.chartLevel = level
    viewmodel.expire()
end
local function onKey(char, code)
    if utils.isKey(char, code, "x") then
        local blocked = viewmodel.startBlockedReason(fstate.lastData)
        if blocked then
            logs.ui("启动被拦下：" .. blocked)
        else
            fire("system_toggle")
        end
    elseif utils.isKey(char, code, "r") then
        fire("refresh")
    elseif utils.isKey(char, code, "t") then
        switchTab((fstate.currentTab == "overview") and "config" or "overview")
    else
        local key   = utils.keyChar(char)
        local level = key and tonumber(key)
        if level and level >= 0 and level <= constants.LEVEL_COUNT then
            setChartLevel(level)
        end
    end
end
local function onClick(x, y)
    for key, box in pairs(fstate.tabs) do
        if fstate.hit(box, x, y) then
            switchTab(key)
            return
        end
    end
    if viewinput.statusArea(x, y) then return end
    if viewinput.chartChip(x, y) then
        viewmodel.expire()
        return
    end
    if fstate.currentTab == "config" then
        for _, box in ipairs(fstate.keys or {}) do
            if fstate.hit(box, x, y) then
                applyKey(box)
                return
            end
        end
        for _, box in ipairs(fstate.produceHits or {}) do
            if fstate.hit(box, x, y) then
                if box.act == "page" then
                    fstate.producePage = (fstate.producePage or 1) + (tonumber(box.value) or 0)
                    viewmodel.expire()
                elseif box.act == "bind" then
                    fire("produce_bind_begin", fstate.editLevel, box.machine)
                elseif box.act == "unbind" then
                    fire("produce_unbind", box.machine)
                elseif box.act == "cancel" then
                    fire("produce_bind_cancel")
                elseif box.act == "toggle" then
                    local row = fstate.lastData and fstate.lastData.levels[fstate.editLevel]
                    fire("level_produce_set", fstate.editLevel, not (row and row.produceEnabled == true))
                end
                return
            end
        end
        if fstate.hit(fstate.strengthCell, x, y) then
            selectStrength()
            return
        end
        if fstate.hit(fstate.factorCell, x, y) then
            selectFactor()
            return
        end
        if fstate.hit(fstate.autostartRow, x, y) then
            fire("autostart_toggle")
            return
        end
        for level, cell in pairs(fstate.cells or {}) do
            for field, box in pairs(cell) do
                if fstate.hit(box, x, y) then
                    applyCell(level, field)
                    return
                end
            end
        end
        return
    end
    local _, box = fstate.buttonAt(x, y)
    if box and box.action then
        fire(box.action)
    end
end
function input.handle(name, payload)
    payload = payload or {}
    if name == "key_down" then
        onKey(payload[3], payload[4])
        return true
    end
    if name == "touch" then
        local x, y = payload[3], payload[4]
        if type(x) == "number" and type(y) == "number" then
            onClick(x, y)
            return true
        end
    end
    return false
end
return input

frontend/layout.lua
3834
local fstate         = require("frontend.state")
local layout         = {}
layout.TAB_H         = 1
layout.CONTROL_H     = 18
layout.MIN_CONTROL_H = 11
layout.MIN_LOG_H     = 6
layout.STATUS_TWO_H  = 19
layout.STATUS_ONE_H  = 12
layout.CONFIG_HEAD_H   = 13
layout.CONFIG_SEP_H    = 2
layout.KEYPAD_H        = 9
layout.CONFIG_CARD_H   = 25
layout.CARD_GAP        = 1
layout.SETTINGS_CARD_H = 5
layout.MIN_CHART_H   = 10
layout.SIDE_PAD      = 1
layout.COL_GAP       = 1
function layout.cols(area, weights)
    local out, total = {}, 0
    for _, weight in ipairs(weights) do total = total + weight end
    if total <= 0 then total = 1 end
    local x, left = area.x, area.w
    for index, weight in ipairs(weights) do
        local w
        if index == #weights then
            w = left
        else
            w = math.floor(area.w * weight / total)
            left = left - w
        end
        out[index] = { x = x, w = w }
        x = x + w
    end
    return out
end
function layout.calculate()
    fstate.W, fstate.H = fstate.gpu.getResolution()
    local W, H         = fstate.W, fstate.H
    local grid         = { rows = {}, cols = {} }
    grid.rows.top      = { y = 1, h = layout.TAB_H }
    grid.rows.body     = { y = layout.TAB_H + 1, h = H - layout.TAB_H }
    local leftW        = math.floor(W * 0.30)
    leftW              = math.max(26, math.min(leftW, 46, W - 40))
    local rightW       = W - leftW - layout.SIDE_PAD * 2 - layout.COL_GAP
    grid.cols.left     = { x = 1 + layout.SIDE_PAD, w = leftW }
    grid.cols.right    = { x = 1 + layout.SIDE_PAD + leftW + layout.COL_GAP, w = rightW }
    local bodyY        = grid.rows.body.y
    local bodyH        = grid.rows.body.h
    local statusH      = (bodyH >= layout.STATUS_TWO_H + layout.MIN_CHART_H + 1)
        and layout.STATUS_TWO_H or layout.STATUS_ONE_H
    local chartH       = bodyH - statusH - 1
    if chartH < layout.MIN_CHART_H then
        chartH  = math.min(layout.MIN_CHART_H, bodyH)
        statusH = math.max(6, bodyH - chartH - 1)
    end
    local controlH = math.min(layout.CONTROL_H, bodyH - layout.MIN_LOG_H - 1)
    controlH       = math.max(math.min(layout.MIN_CONTROL_H, bodyH), controlH)
    local logH     = bodyH - controlH - 1
    if logH < layout.MIN_LOG_H then
        logH     = math.min(layout.MIN_LOG_H, bodyH)
        controlH = math.max(6, bodyH - logH - 1)
    end
    fstate.areas.tabBar   = { x = 1, y = grid.rows.top.y, w = W, h = layout.TAB_H }
    fstate.areas.control  = { x = grid.cols.left.x, y = bodyY, w = grid.cols.left.w, h = controlH }
    fstate.areas.log      = {
        x = grid.cols.left.x,
        y = bodyY + controlH + 1,
        w = grid.cols.left.w,
        h = logH
    }
    fstate.areas.status   = { x = grid.cols.right.x, y = bodyY, w = grid.cols.right.w, h = statusH }
    fstate.areas.chart    = {
        x = grid.cols.right.x,
        y = bodyY + statusH + 1,
        w = grid.cols.right.w,
        h = chartH
    }
    local configX   = 1 + layout.SIDE_PAD
    local configW   = W - layout.SIDE_PAD * 2
    local configH   = math.min(layout.CONFIG_CARD_H, bodyH)
    local settingsY = bodyY + configH + layout.CARD_GAP
    local settingsH = math.min(layout.SETTINGS_CARD_H,
        math.max(0, bodyH - configH - layout.CARD_GAP))
    local innerX    = configX + 2
    local innerW    = math.max(0, configW - 4)
    local keypadH   = math.min(layout.KEYPAD_H,
        math.max(0, configH - layout.CONFIG_HEAD_H - 1))
    local keypadY   = bodyY + configH - 1 - keypadH
    fstate.areas.config   = { x = configX, y = bodyY, w = configW, h = configH }
    fstate.areas.keypad   = { x = innerX, y = keypadY, w = innerW, h = keypadH }
    fstate.areas.settings = { x = configX, y = settingsY, w = configW, h = settingsH }
    fstate.clearHitboxes()
    fstate.invalidateAll()
end
return layout

frontend/panels/chart.lua
2961
local unicode   = require("unicode")
local constants = require("shared.constants")
local fstate    = require("frontend.state")
local theme     = require("frontend.theme")
local widgets   = require("frontend.widgets")
local charts    = require("frontend.charts")
local chart     = {}
function chart.draw(data)
    local area = fstate.areas.chart
    widgets.drawPanelFrame(area, nil, nil, theme.borderColor(data.system.priority == "high"))
    fstate.chartChips = {}
    local x = area.x + 2
    local function chip(level, text)
        local width  = unicode.wlen(text) + 2
        local active = (fstate.chartLevel == level)
        widgets.drawText(x, area.y + 1, " " .. text .. " ",
            active and theme.COLORS.BG or (level == 0 and theme.COLORS.TEXT_CYAN or theme.seriesColor(level)),
            active and theme.COLORS.TEXT_CYAN or theme.COLORS.BTN_BG)
        fstate.chartChips[level] = { x = x, y = area.y + 1, w = width, h = 1 }
        x = x + width + 1
    end
    chip(0, "全部")
    for level = 1, constants.LEVEL_COUNT do
        chip(level, "T" .. level)
    end
    local days = data.historyDays or 0
    if days > 0 then
        widgets.drawTextRight(area.x, area.w - 3, area.y + 1,
            string.format("近 %d 游戏日 ", days), theme.COLORS.TEXT_DISABLED)
    end
    local history = data.history
    if not history or #(history.times or {}) < 2 then
        widgets.drawCenteredTip({ x = area.x, y = area.y + 2, w = area.w, h = area.h - 3 },
            "数据采集中…")
        return
    end
    if fstate.chartLevel == 0 then
        local values, labels = {}, {}
        for level = 1, constants.LEVEL_COUNT do
            local series        = history.values[level] or {}
            values[#values + 1] = (#series >= 2) and (series[#series] - series[1]) or 0
            labels[#labels + 1] = "T" .. level
        end
        charts.bars(area, values, labels,
            string.format("近 %d 游戏日 各级水量变化", days))
    else
        local level = fstate.chartLevel
        local row   = data.levels[level]
        charts.series(area,
            { { values = history.values[level] or {}, color = theme.seriesColor(level) } },
            history.times,
            string.format("近 %d 游戏日 %s 水量曲线", days,
                row and row.label or ("T" .. level)))
    end
end
function chart.fingerprint(data)
    local history = data.history or { times = {}, values = {} }
    local parts   = {
        tostring(data.system.priority),
        tostring(fstate.chartLevel),
        tostring(#(history.times or {})),
        tostring(data.historyDays or 0),
        tostring(fstate.areas.chart and fstate.areas.chart.h or 0)
    }
    for level = 1, constants.LEVEL_COUNT do
        local series      = history.values[level] or {}
        parts[#parts + 1] = tostring(series[1] or 0) .. "," .. tostring(series[#series] or 0)
    end
    return table.concat(parts, "\x1f")
end
return chart

frontend/panels/config.lua
8889
local unicode   = require("unicode")
local constants = require("shared.constants")
local fstate    = require("frontend.state")
local theme     = require("frontend.theme")
local widgets   = require("frontend.widgets")
local layout    = require("frontend.layout")
local config    = {}
local COLS      = {
    { head = "级" },
    { key = "enabled", head = "勾选" },
    { key = "threshold", head = "阈值 kL", align = "right" },
    { key = "weight", head = "权重", align = "right" },
    { key = "boost", head = "收集", align = "right" },
    { key = "produce", head = "制作", align = "right" }
}
local COL_W     = { 0.10, 0.12, 0.26, 0.16, 0.18, 0.18 }
local function numberText(value)
    value = tonumber(value) or 0
    if value == math.floor(value) then return string.format("%d", value) end
    return string.format("%g", value)
end
function config.draw(data)
    local area = fstate.areas.config
    if not area or area.h < 3 then return end
    local sys   = data.system or {}
    local eff   = sys.effectiveConfig or {}
    local inner = { x = area.x + 2, w = area.w - 4 }
    local cols  = layout.cols(inner, COL_W)
    widgets.drawBorder(area.x, area.y, area.w, area.h,
        theme.borderColor(sys.priority == "high"))
    widgets.clearArea(area.x + 1, area.y + 1, area.w - 2, 4)
    widgets.drawText(area.x + 2, area.y + 1, "调度配置", theme.COLORS.TEXT_CYAN)
    local fEditing = (fstate.editField == "factor")
    local fText    = string.format("能源仓利用因子 %s%%",
        fEditing and ((fstate.editBuf or "") .. "_")
        or tostring(math.floor(tonumber(sys.energyFactor) or 100)))
    local sEditing = (fstate.editField == "strength")
    local sText    = string.format("无线范围 %s", sEditing and ((fstate.editBuf or "") .. "_")
        or tostring(math.floor(tonumber((data.net or {}).strength) or 0)))
    local fW       = unicode.wlen(fText)
    local sW       = unicode.wlen(sText)
    local fX       = inner.x + inner.w - fW
    local sX       = fX - sW - 3
    widgets.drawText(fX, area.y + 1, fText,
        fEditing and theme.COLORS.TEXT_YELLOW or theme.COLORS.TEXT_VIOLET)
    widgets.drawText(sX, area.y + 1, sText,
        sEditing and theme.COLORS.TEXT_YELLOW or theme.COLORS.TEXT_CYAN)
    fstate.factorCell   = { x = fX, y = area.y + 1, w = fW, h = 1 }
    fstate.strengthCell = { x = sX, y = area.y + 1, w = sW, h = 1 }
    widgets.drawText(inner.x, area.y + 2, string.rep("─", inner.w), theme.CHART_AXIS)
    widgets.drawText(inner.x, area.y + 4, string.rep("─", inner.w), theme.CHART_AXIS)
    for index, col in ipairs(COLS) do
        if col.align == "right" then
            widgets.drawTextRight(cols[index].x, cols[index].w, area.y + 3, col.head,
                theme.COLORS.TEXT_DISABLED)
        else
            widgets.drawText(cols[index].x, area.y + 3, col.head, theme.COLORS.TEXT_DISABLED)
        end
    end
    widgets.clearArea(inner.x, area.y + layout.CONFIG_HEAD_H, inner.w, layout.CONFIG_SEP_H)
    widgets.drawText(inner.x, area.y + layout.CONFIG_HEAD_H,
        string.rep("─", inner.w), theme.CHART_AXIS)
    local selCol = nil
    for index, col in ipairs(COLS) do
        if col.key and col.key == fstate.editField then selCol = index end
    end
    fstate.cells = {}
    for level = 1, constants.LEVEL_COUNT do
        local row = data.levels[level]
        local y   = area.y + 5 + (level - 1)
        if y > area.y + area.h - 2 then break end
        local sel  = (fstate.editLevel == level)
        local fp   = table.concat({
            row.label, tostring(row.rule.enabled), tostring(row.produceEnabled),
            tostring(row.produceText or "-"),
            tostring(row.rule.threshold),
            tostring(row.weight), tostring(row.thresholdOverridden),
            tostring(sys.t7Boost), tostring(sys.mode), tostring(sys.enforceThreshold),
            tostring(sel), tostring(sel and fstate.editField or ""),
            tostring(sel and fstate.editBuf or "")
        }, ":")
        if fstate.subDirty("config", "row" .. level, fp) then
            widgets.clearArea(inner.x, y, inner.w, 1)
            local rowBg = sel and theme.COLORS.BTN_BG_HOVER or nil
            local function cellBg(index)
                return (sel and selCol == index) and theme.COLORS.BTN_BG_HOVER or nil
            end
            if sel and selCol then
                widgets.clearArea(cols[selCol].x, y, cols[selCol].w, 1, theme.COLORS.BTN_BG_HOVER)
            end
            widgets.drawText(cols[1].x, y, row.label, theme.COLORS.TEXT_CYAN, rowBg)
            local mark      = row.rule.enabled and "[√]" or "[ ]"
            local markColor = (row.rule.enabled and eff.enabled)
                and theme.COLORS.TEXT_GREEN or theme.COLORS.TEXT_DISABLED
            widgets.drawText(cols[2].x, y, mark, markColor, cellBg(2))
            local thrText  = row.thresholdKText or "-"
            local thrColor = eff.threshold
                and (row.thresholdOverridden and theme.COLORS.TEXT_RED or theme.COLORS.TEXT)
                or theme.COLORS.TEXT_DISABLED
            if sel and fstate.editField == "threshold" then
                thrText, thrColor = (fstate.editBuf or "") .. "_", theme.COLORS.TEXT_YELLOW
            end
            widgets.drawTextRight(cols[3].x, cols[3].w, y, thrText, thrColor, cellBg(3))
            local wText  = tostring(row.weight or 0)
            local wColor = eff.weight and theme.COLORS.TEXT or theme.COLORS.TEXT_DISABLED
            if sel and fstate.editField == "weight" then
                wText, wColor = (fstate.editBuf or "") .. "_", theme.COLORS.TEXT_YELLOW
            end
            widgets.drawTextRight(cols[4].x, cols[4].w, y, wText, wColor, cellBg(4))
            local bText, bColor = "-", theme.COLORS.TEXT_DISABLED
            if level == 1 or level == 2 then
                local on = type(sys.reflux) == "table" and sys.reflux[level] == true
                bText = "回流[" .. (on and "√" or " ") .. "]"
                bColor = eff.boost and (on and theme.COLORS.TEXT_GREEN or theme.COLORS.TEXT_DISABLED)
                    or theme.COLORS.TEXT_DISABLED
            elseif level == constants.T6_LEVEL then
                local on = sys.t6DualLithium == true
                bText = "双锂[" .. (on and "√" or " ") .. "]"
                bColor = eff.boost and (on and theme.COLORS.TEXT_GREEN or theme.COLORS.TEXT_DISABLED)
                    or theme.COLORS.TEXT_DISABLED
            elseif level == constants.T7_LEVEL then
                bText = "×" .. numberText(sys.t7Boost)
                bColor = eff.boost and theme.COLORS.TEXT or theme.COLORS.TEXT_DISABLED
            end
            if sel and fstate.editField == "boost" then bColor = theme.COLORS.TEXT_YELLOW end
            widgets.drawTextRight(cols[5].x, cols[5].w, y, bText, bColor, cellBg(5))
            widgets.drawTextRight(cols[6].x, cols[6].w, y, row.produceText or "[×]", row.produceColor, cellBg(6))
        end
        local hasBoost = (level == 1 or level == 2
            or level == constants.T6_LEVEL or level == constants.T7_LEVEL)
        fstate.cells[level] = {
            enabled   = { x = cols[2].x, y = y, w = cols[2].w, h = 1 },
            threshold = { x = cols[3].x, y = y, w = cols[3].w, h = 1 },
            weight    = { x = cols[4].x, y = y, w = cols[4].w, h = 1 },
            boost     = hasBoost
                and { x = cols[5].x, y = y, w = cols[5].w, h = 1 } or nil,
            produce   = row.produceClickable and { x = cols[6].x, y = y, w = cols[6].w, h = 1 } or nil
        }
    end
end
function config.fingerprint(data)
    local area  = fstate.areas.config or {}
    local sys   = (data and data.system) or {}
    local eff   = sys.effectiveConfig or {}
    local parts = {
        tostring(area.x or 0), tostring(area.y or 0), tostring(area.w or 0), tostring(area.h or 0),
        tostring(sys.priority), tostring(sys.mode), tostring(sys.enforceThreshold),
        tostring(sys.t7Boost), tostring(sys.t6DualLithium),
        tostring(type(sys.reflux) == "table" and sys.reflux[1] or nil),
        tostring(type(sys.reflux) == "table" and sys.reflux[2] or nil),
        tostring(sys.energyFactor), tostring((data.net or {}).strength),
        tostring(eff.enabled), tostring(eff.threshold),
        tostring(eff.weight), tostring(eff.boost),
        tostring(fstate.editLevel or 0), tostring(fstate.editField or ""),
        tostring(fstate.editBuf or "")
    }
    for level = 1, constants.LEVEL_COUNT do
        local row         = data.levels[level]
        parts[#parts + 1] = table.concat({
            row.label, tostring(row.rule.enabled), tostring(row.produceEnabled),
            tostring(row.produceText or "-"),
            tostring(row.rule.threshold), tostring(row.weight), tostring(row.thresholdOverridden)
        }, ":")
    end
    return table.concat(parts, "\x1f")
end
return config

frontend/panels/control.lua
6713
local unicode   = require("unicode")
local fstate    = require("frontend.state")
local theme     = require("frontend.theme")
local widgets   = require("frontend.widgets")
local layout    = require("frontend.layout")
local decorate  = require("frontend.decorate")
local control   = {}
local function infoRows(data)
    return {
        { "系统状态：", data.systemText, data.systemColor },
        { "净水主机：", data.hostText, data.hostColor },
        { "运行模式：", tostring(data.runModeText or "-"),
            data.system.priority == "high" and theme.COLORS.TEXT_RED or theme.COLORS.TEXT_CYAN, true },
        { "功率概况：", data.powerText, theme.COLORS.TEXT_CYAN },
        { "ME接口：", data.meText, data.meColor, true },
        { "部署机器：", data.machineText, theme.COLORS.TEXT_CYAN }
    }
end
function control.draw(data)
    local area = fstate.areas.control
    widgets.drawPanelFrame(area, "控制面板", theme.COLORS.TEXT_CYAN,
        theme.borderColor(data.system.priority == "high"))
    local avail    = math.max(1, area.h - 3)
    local twoCol   = false
    local rowsUsed = 5
    local blockH   = (rowsUsed - 1) * 2 + 1
    if avail - blockH < 3 then
        twoCol   = true
        rowsUsed = 3
        blockH   = rowsUsed
    end
    local infoMax = math.max(1, avail - blockH)
    local rows    = infoRows(data)
    while #rows > infoMax do
        local dropped = false
        for index = #rows, 1, -1 do
            if rows[index].optional then
                table.remove(rows, index)
                dropped = true
                break
            end
        end
        if not dropped then table.remove(rows) end
    end
    local cols = layout.cols({ x = area.x + 2, w = area.w - 4 }, { 0.34, 0.66 })
    for index, row in ipairs(rows) do
        local y     = area.y + 1 + index
        local value = tostring(row[2])
        if unicode.wlen(value) > cols[2].w - 1 then
            value = unicode.sub(value, 1, math.max(1, cols[2].w - 2)) .. "…"
        end
        widgets.drawText(cols[1].x, y, row[1], theme.COLORS.TEXT)
        widgets.drawText(cols[2].x, y, value, row[3])
    end
    control.drawButtons(area, data, twoCol)
end
function control.drawButtons(area, data, twoCol)
    fstate.buttons = {}
    local blocked  = decorate.startBlockedReason(data)
    local cannotStart = blocked ~= nil
    local rateMode = (data.system.mode == "rate")
    local ro       = fstate.readOnly == true
    local rows     = {
        { {
            name     = "system",
            action   = "system_toggle",
            label    = data.system.running and "停机" or "启动系统",
            color    = data.system.running and theme.COLORS.TEXT_GREEN or theme.COLORS.TEXT,
            bg       = data.system.running and theme.COLORS.BTN_BG_HOVER or theme.COLORS.BTN_BG,
            disabled = ro or (cannotStart and not data.system.running)
        } },
        { {
            name   = "mode",
            action = "mode_toggle",
            label  = rateMode and "切到阈值调度" or "切到速率调度",
            color  = theme.COLORS.TEXT_CYAN,
            bg     = theme.COLORS.BTN_BG,
            disabled = ro
        }, {
            name   = "subparam",
            action = rateMode and "threshold_enforce_toggle" or "priority_toggle",
            label  = rateMode
                and (data.system.enforceThreshold and "阈值约束：开" or "阈值约束：关")
                or (data.system.priority == "high" and "切到低级水优先" or "切到高级水优先"),
            color  = theme.COLORS.TEXT,
            bg     = (not rateMode and data.system.priority == "high") and theme.COLORS.BTN_PRIORITY_HIGH
                or ((rateMode and not data.system.enforceThreshold) and theme.COLORS.BTN_BG_HOVER
                    or theme.COLORS.BTN_BG),
            disabled = ro
        } },
        { {
            name   = "refresh",
            action = "refresh",
            label  = "刷新扫描",
            color  = theme.COLORS.TEXT,
            bg     = theme.COLORS.BTN_BG,
            disabled = ro
        } },
        { {
            name     = "net",
            action   = "net_toggle",
            label    = data.net.enabled and "无线广播：开" or "无线广播：关",
            color    = data.net.enabled and theme.COLORS.TEXT_CYAN or theme.COLORS.TEXT_YELLOW,
            bg       = data.net.enabled and theme.COLORS.BTN_BG_HOVER or theme.COLORS.BTN_BG,
            disabled = ro or not data.net.available
        } },
        { {
            name   = "quit",
            action = "quit",
            label  = "退出程序",
            color  = theme.COLORS.TEXT_RED,
            bg     = theme.COLORS.BTN_BG,
            disabled = false
        } }
    }
    local margin = 3
    local btnX   = area.x + margin
    local fullW  = area.w - margin * 2
    local function drawItem(item, x, y, w)
        if not item.disabled then
            fstate.buttons[item.name] = {
                x = x, y = y, w = w, h = 1, action = item.action, label = item.label
            }
        end
        widgets.drawButton(x, y, w, item.label, item.color, item.bg, item.disabled)
    end
    if twoCol then
        local flat = {}
        for _, row in ipairs(rows) do
            for _, item in ipairs(row) do flat[#flat + 1] = item end
        end
        local btnW   = math.floor((fullW - 1) / 2)
        local lines  = math.ceil(#flat / 2)
        local startY = area.y + area.h - 2 - (lines - 1)
        for index, item in ipairs(flat) do
            drawItem(item,
                btnX + ((index - 1) % 2) * (btnW + 1),
                startY + math.floor((index - 1) / 2),
                btnW)
        end
        return
    end
    local step   = 2
    local startY = area.y + area.h - 2 - ((#rows - 1) * step + 1) + 1
    for index, row in ipairs(rows) do
        local y = startY + (index - 1) * step
        local w = (#row == 1) and fullW or math.floor((fullW - 1) / 2)
        for slot, item in ipairs(row) do
            drawItem(item, btnX + (slot - 1) * (w + 1), y, w)
        end
    end
end
function control.fingerprint(data)
    return table.concat({
        tostring(data.systemText), tostring(data.hostText), tostring(data.system.priority),
        tostring(data.system.mode), tostring(data.system.enforceThreshold), tostring(data.runModeText),
        tostring(data.powerText), tostring(data.meText), tostring(data.machineText),
        tostring(data.net.enabled), tostring(data.net.available),
        tostring(data.system.awaiting), tostring(#data.hardware.missing),
        tostring(fstate.areas.control and fstate.areas.control.h or 0)
    }, "\x1f")
end
return control

frontend/panels/detail.lua
6399
local unicode   = require("unicode")
local constants = require("shared.constants")
local utils     = require("shared.utils")
local fstate    = require("frontend.state")
local theme     = require("frontend.theme")
local widgets   = require("frontend.widgets")
local layout    = require("frontend.layout")
local detail    = {}
local BULLET    = "· "
local RULE      = "─"
local function ruleLine(x, y, w, text)
    local head = (text ~= "") and (" " .. text .. " ") or ""
    widgets.drawText(x, y, RULE .. head .. string.rep(RULE, math.max(0, w - unicode.wlen(head) - 1)),
        theme.COLORS.TEXT_DISABLED)
end
local function machineRows(machines, record)
    local num                      = utils.formatNumber
    local list, curW, realW, rateW = {}, 0, 0, 0
    for index, m in ipairs(machines or {}) do
        local running      = (m.active == true)
        local cur          = running and (m.current and num(m.current) or "-") or "停"
        local realVal      = m.confirmed or record
        local real         = realVal and num(realVal) or "-"
        local rate         = m.success and (tostring(m.success) .. "%") or "-"
        list[#list + 1]    = { index, cur, real, rate, running }
        curW, realW, rateW = math.max(curW, unicode.wlen(cur)),
            math.max(realW, unicode.wlen(real)), math.max(rateW, unicode.wlen(rate))
    end
    local function cell(prefix, value, width)
        return prefix .. string.rep(" ", math.max(0, width - unicode.wlen(value))) .. value
    end
    local out = {}
    for _, item in ipairs(list) do
        out[#out + 1] = {
            string.format("%s#%d", BULLET, item[1]),
            table.concat({
                cell("当前并行 ", item[2], curW),
                cell("学习并行 ", item[3], realW),
                cell("成功率 ", item[4], rateW)
            }, "   "),
            item[5] and theme.COLORS.TEXT_GREEN or theme.COLORS.TEXT_DISABLED
        }
    end
    return out
end
local function lines(row, level)
    local per      = constants.POWER_LEVELS[level] or 0
    local deployed = row.deployed or 0
    local suggest  = row.suggest or 0
    local running  = (row.active or 0) > 0
    local num      = utils.formatNumber
    local stale    = running and "" or "（上次运行）"
    local liveWatt = running and theme.COLORS.TEXT_YELLOW or theme.COLORS.TEXT_DISABLED
    local out      = {}
    local function sep(text)
        out[#out + 1] = { "rule", text, "", theme.COLORS.TEXT_DISABLED }
    end
    local function item(label, value, color)
        out[#out + 1] = { "item", BULLET .. label, value, color }
    end
    sep("基础")
    item("单并行功耗", num(per) .. " EU/t", theme.COLORS.TEXT)
    item("已部署机器", tostring(deployed) .. " 台", theme.COLORS.TEXT)
    local thresholdText = row.thresholdOverridden
        and (row.userThresholdText .. " → " .. row.thresholdText)
        or row.thresholdText
    item("实际阈值", thresholdText,
        row.thresholdOverridden and theme.COLORS.TEXT_YELLOW or theme.COLORS.TEXT)
    sep("建议（公式推算）")
    item("每台并行", num(suggest), theme.COLORS.TEXT_CYAN)
    item("每台功耗", num(suggest * per) .. " EU/t", theme.COLORS.TEXT_CYAN)
    item("全开总功耗", num(suggest * per * deployed) .. " EU/t", theme.COLORS.TEXT_CYAN)
    sep("当前功耗")
    local perPower = row.sample and (row.sample * per) or nil
    item("当前等级总功耗", perPower and (num(perPower * deployed) .. " EU/t" .. stale) or "-", liveWatt)
    sep("每台机器")
    for _, machineRow in ipairs(machineRows(row.machines, row.parallel)) do
        out[#out + 1] = { "item", machineRow[1], machineRow[2], machineRow[3] }
    end
    return out
end
function detail.draw(data, area)
    local level = fstate.detailLevel
    local row   = level and data.levels[level] or nil
    widgets.drawPanelFrame(area, nil, nil, theme.borderColor(data.system.priority == "high"))
    if not row then
        widgets.drawText(area.x + 2, area.y + 1, "净水单元详情：没有选中等级（点某一行进来）",
            theme.COLORS.TEXT_YELLOW)
        return
    end
    widgets.drawText(area.x + 2, area.y + 1,
        string.format("净水单元详情 · %s", row.label), theme.COLORS.TEXT_CYAN)
    widgets.drawTextRight(area.x + 2, area.w - 4, area.y + 1, "← 点任意处返回", theme.COLORS.TEXT_DISABLED)
    local cols  = layout.cols({ x = area.x + 2, w = area.w - 4 }, { 0.26, 0.74 })
    local rows  = lines(row, level)
    local top   = area.y + 2
    local last  = area.y + area.h - 2
    local drawn = 0
    for _, item in ipairs(rows) do
        local y = top + drawn
        if y > last then break end
        if item[1] == "rule" then
            ruleLine(cols[1].x, y, cols[1].w + cols[2].w, item[2])
        else
            local value = tostring(item[3])
            if unicode.wlen(value) > cols[2].w then
                value = unicode.sub(value, 1, math.max(1, cols[2].w - 1)) .. "…"
            end
            widgets.drawText(cols[1].x, y, tostring(item[2]), theme.COLORS.TEXT_DISABLED)
            widgets.drawText(cols[2].x, y, value, item[4])
        end
        drawn = drawn + 1
    end
    if drawn < #rows and top + drawn <= last then
        widgets.drawText(cols[1].x, top + drawn,
            string.format("…（屏高不够，还有 %d 行）", #rows - drawn), theme.COLORS.TEXT_YELLOW)
    end
end
function detail.fingerprint(data)
    local level = fstate.detailLevel or 0
    local row   = data.levels[level] or {}
    local parts = {
        tostring(level), tostring(row.label), tostring(data.system.priority),
        tostring(fstate.areas.status and fstate.areas.status.w or 0),
        tostring(fstate.areas.status and fstate.areas.status.h or 0),
        tostring(row.deployed), tostring(row.active), tostring(row.sample),
        tostring(row.parallel), tostring(row.suggest),
        tostring(row.rule and row.rule.userThreshold), tostring(row.rule and row.rule.effectiveThreshold),
        tostring(row.thresholdOverridden)
    }
    for _, machine in ipairs(row.machines or {}) do
        parts[#parts + 1] = tostring(machine.address) .. ":" .. tostring(machine.active)
            .. ":" .. tostring(machine.current) .. ":" .. tostring(machine.confirmed)
            .. ":" .. tostring(machine.success)
    end
    return table.concat(parts, "\x1f")
end
return detail

frontend/panels/keypad.lua
16223
local unicode = require("unicode")
local fstate  = require("frontend.state")
local theme   = require("frontend.theme")
local widgets = require("frontend.widgets")
local utils   = require("shared.utils")
local CONFIG    = require("shared.config")
local constants = require("shared.constants")
local keypad  = {}
local KEY_W   = 8
local KEY_GAP = 3
local SEP     = 3
local OPT_W   = 10
local DIGITS  = {
    { { "7", "digit", "7" }, { "8", "digit", "8" }, { "9", "digit", "9" } },
    { { "4", "digit", "4" }, { "5", "digit", "5" }, { "6", "digit", "6" } },
    { { "1", "digit", "1" }, { "2", "digit", "2" }, { "3", "digit", "3" } },
    { nil,                   { "0", "digit", "0" }, nil }
}
local ACTS    = {
    { { "x2", "mul", "2" }, { "x10", "mul", "10" }, { "x100", "mul", "100" } },
    { { "/2", "div", "2" }, { "/10", "div", "10" }, { "/100", "div", "100" } },
    { { "x1000", "mul", "1000" }, { "/1000", "div", "1000" }, { "←", "back", "" } },
    { { "C", "clear", "" }, { "✔", "commit", "" }, { "✘", "cancel", "" } }
}
local PRESETS = {
    { { "1k", "set", "1000" }, { "10k", "set", "10000" }, { "100k", "set", "100000" } },
    { { "1M", "set", "1000000" }, { "10M", "set", "10000000" }, { "100M", "set", "100000000" } },
    { { "1G", "set", "1000000000" }, { "10G", "set", "10000000000" }, { "100G", "set", "100000000000" } },
    { { "1T", "set", "1000000000000" }, { "10T", "set", "10000000000000" }, { "=上级", "copy", "" } }
}
local WEIGHTS = {
    { { "1", "digit", "1" }, { "2", "digit", "2" }, { "3", "digit", "3" }, { "4", "digit", "4" }, { "5", "digit", "5" } },
    { { "6", "digit", "6" }, { "7", "digit", "7" }, { "8", "digit", "8" }, { "9", "digit", "9" }, { "0", "digit", "0" } },
    { { "←", "back", "" }, { "C", "clear", "" }, { "✔", "commit", "" }, { "✘", "cancel", "" } }
}
local function padWidth(rows)
    local cols = 0
    for _, row in ipairs(rows) do cols = math.max(cols, #row) end
    return cols * (KEY_W + KEY_GAP) - KEY_GAP
end
local function keyEnabled(kind)
    if not fstate.editField then return false end
    if kind == "copy" and (fstate.editLevel or 1) <= 1 then return false end
    return true
end
local function drawPad(x, y, rows, shift)
    local cols = 0
    for _, row in ipairs(rows) do cols = math.max(cols, #row) end
    for r = 1, #rows do
        local padX = x + ((shift and shift[r]) or 0)
        for c = 1, cols do
            local key = rows[r][c]
            if key then
                local keyX     = padX + (c - 1) * (KEY_W + KEY_GAP)
                local keyY     = y + (r - 1)
                local disabled = not keyEnabled(key[2])
                widgets.drawButton(keyX, keyY, KEY_W, key[1], theme.keyColor(key[2]), nil, disabled)
                if not disabled then
                    fstate.keys[#fstate.keys + 1] = {
                        x = keyX, y = keyY, w = KEY_W, h = 1, kind = key[2], value = key[3]
                    }
                end
            end
        end
    end
end
local function drawOptions(x, y, w, options)
    local total = #options * OPT_W + (#options - 1) * KEY_GAP
    local kx    = x + math.max(0, math.floor((w - total) / 2))
    for index, option in ipairs(options) do
        local keyX  = kx + (index - 1) * (OPT_W + KEY_GAP)
        local color = option.current and theme.COLORS.TEXT_GREEN or theme.COLORS.TEXT
        local bg    = option.current and theme.COLORS.BTN_BG_HOVER or nil
        widgets.drawButton(keyX, y, OPT_W, option.label, color, bg)
        fstate.keys[#fstate.keys + 1] = {
            x = keyX, y = y, w = OPT_W, h = 1, kind = option.kind, value = option.value
        }
    end
end
local function numberText(value)
    value = tonumber(value) or 0
    if value == math.floor(value) then return string.format("%d", value) end
    return string.format("%g", value)
end
local function hintText(data)
    local field = fstate.editField
    local label = "T" .. tostring(fstate.editLevel or "")
    if field == "threshold" then
        return string.format("正在编辑 %s 阈值（kL）：%s_   ✔ 保存 · ✘ 取消", label, fstate.editBuf or ""),
            theme.COLORS.TEXT_YELLOW
    elseif field == "weight" then
        return string.format("正在编辑 %s 权重：%s_   ✔ 保存 · ✘ 取消", label, fstate.editBuf or ""),
            theme.COLORS.TEXT_YELLOW
    elseif field == "boost" then
        local sys = (data and data.system) or {}
        if fstate.editLevel == 1 or fstate.editLevel == 2 then
            local on = type(sys.reflux) == "table" and sys.reflux[fstate.editLevel] == true
            return string.format("正在编辑 %s 回流数据收集（当前 %s）：点击切换",
                label, on and "开" or "关"), theme.COLORS.TEXT_YELLOW
        elseif fstate.editLevel == constants.T6_LEVEL then
            return string.format("正在编辑 T6 双锂数据收集（当前 %s）：点击切换",
                sys.t6DualLithium == true and "双锂" or "标准"), theme.COLORS.TEXT_YELLOW
        end
        return string.format("正在编辑 T7 增产倍率（当前 ×%s）：点击切换档位",
            numberText(sys.t7Boost)), theme.COLORS.TEXT_YELLOW
    elseif field == "factor" then
        return string.format("正在编辑 能源仓利用因子（%d-%d%%）：%s_   ✔ 保存 · ✘ 取消",
            CONFIG.ENERGY.FACTOR_MIN, CONFIG.ENERGY.FACTOR_MAX, fstate.editBuf or ""),
            theme.COLORS.TEXT_YELLOW
    elseif field == "strength" then
        return string.format("正在编辑 无线范围（方块，上限 %d）：%s_   ✔ 保存 · ✘ 取消",
            CONFIG.NET.STRENGTH_MAX, fstate.editBuf or ""),
            theme.COLORS.TEXT_YELLOW
    end
    return "选中后编辑；勾选切换", theme.COLORS.TEXT_DISABLED
end
local function sideFailText(reason)
    if type(reason) ~= "string" or reason == "" then return nil end
    local miss = reason:match("^输入侧缺流体：(.+)$")
        or reason:match("^输入侧缺物品：(.+)$")
    if miss then
        miss = miss:gsub("熔融超导粗胚（UV%-UMV 任意）", "粗胚")
        return "缺 " .. miss
    end
    if reason:find("找不到空容器", 1, true) then return "无输出容器" end
    if reason:find("有多个空容器", 1, true) then return "输出不唯一" end
    return reason
end
local function fitText(text, width)
    return utils.truncate(text, width)
end
local function drawProduce(area, data)
    local level = fstate.editLevel or 1
    local pd    = (data and data.produce) or {}
    local info  = (pd.levels or {})[level] or { count = 0, online = 0, machines = {} }
    local list  = info.machines or {}
    local row   = ((data or {}).levels or {})[level]
    local NUM_W, COORD_W, TARGET_W, SIDE_W, ACT_W, GAPW = 4, 20, 14, 18, 8, 2
    local blockW = NUM_W + COORD_W + TARGET_W + SIDE_W + ACT_W + GAPW * 4
    local bx     = area.x + math.max(0, math.floor((area.w - blockW) / 2))
    local xNum    = bx
    local xCoord  = xNum + NUM_W + GAPW
    local xTarget = xCoord + COORD_W + GAPW
    local xSide   = xTarget + TARGET_W + GAPW
    local xAct    = xSide + SIDE_W + GAPW
    local perPage = math.max(1, area.h - 2)
    local pages   = math.max(1, math.ceil(#list / perPage))
    fstate.producePage = math.min(math.max(1, tonumber(fstate.producePage) or 1), pages)
    local y  = area.y
    local cx = area.x
    local function put(text, color, act, value)
        local w = unicode.wlen(text)
        widgets.drawText(cx, y, text, color)
        if act then
            fstate.produceHits[#fstate.produceHits + 1] =
                { x = cx, y = y, w = w, h = 1, act = act, value = value }
        end
        cx = cx + w
    end
    put(string.format("制作自动化 · %s", constants.levelLabel(level)), theme.COLORS.TEXT_CYAN)
    cx = cx + 3
    put(string.format("%d/%d 就绪", info.configured or 0, info.count or 0), theme.COLORS.TEXT)
    if pages > 1 then
        cx = cx + 2
        if fstate.producePage > 1 then put("‹ ", theme.COLORS.TEXT_CYAN, "page", -1) end
        put(string.format("%d/%d", fstate.producePage, pages), theme.COLORS.TEXT_DISABLED)
        if fstate.producePage < pages then put(" ›", theme.COLORS.TEXT_CYAN, "page", 1) end
    end
    cx = cx + 2
    local enabled = row and row.produceEnabled == true
    local toggle  = enabled and "[关]" or "[开]"
    put(toggle, enabled and theme.COLORS.TEXT_GREEN or theme.COLORS.TEXT, "toggle")
    if (info.state == "blocked" or info.state == "invalid") and info.reason then
        local binding = pd.binding
        local reserve = (binding and binding.level == level) and 32 or 2
        local room    = math.max(0, area.w - (cx - area.x) - 2 - reserve)
        if room >= 8 then
            cx = cx + 2
            local prefix = (info.state == "blocked") and "关断：" or "未就绪："
            local color  = (info.state == "blocked")
                and theme.COLORS.TEXT_YELLOW or theme.COLORS.TEXT_RED
            put(fitText(prefix .. tostring(info.reason), room), color)
        end
    end
    local binding = pd.binding
    if binding and binding.level == level then
        cx = cx + 2
        put("| 绑定中：放下转运器并接入网络", theme.COLORS.TEXT_YELLOW)
        cx = cx + 2
        put("[取消]", theme.COLORS.TEXT_RED, "cancel")
    end
    local hy = area.y + 1
    widgets.drawText(xNum, hy, "#", theme.COLORS.TEXT_DISABLED)
    widgets.drawText(xCoord, hy, "坐标", theme.COLORS.TEXT_DISABLED)
    widgets.drawText(xTarget, hy, "转运器", theme.COLORS.TEXT_DISABLED)
    widgets.drawText(xSide, hy, "侧位", theme.COLORS.TEXT_DISABLED)
    widgets.drawText(xAct, hy, "操作", theme.COLORS.TEXT_DISABLED)
    local first = (fstate.producePage - 1) * perPage + 1
    for index = 1, perPage do
        local ry   = hy + index
        local item = list[first + index - 1]
        if item and ry <= area.y + area.h - 1 then
            widgets.drawText(xNum, ry, tostring(first + index - 1), theme.COLORS.TEXT)
            widgets.drawText(xCoord, ry, unicode.sub(item.text or "-", 1, COORD_W), theme.COLORS.TEXT)
            if item.sideState == "ok" then
                widgets.drawText(xSide, ry, "配置就绪", theme.COLORS.TEXT_GREEN)
            elseif item.sideState == "auto" then
                local fail = sideFailText(item.sideFail)
                if fail then
                    widgets.drawText(xSide, ry, fitText("失败·" .. fail, SIDE_W), theme.COLORS.TEXT_RED)
                else
                    widgets.drawText(xSide, ry, "自动配置中", theme.COLORS.TEXT_YELLOW)
                end
            else
                widgets.drawText(xSide, ry, "-", theme.COLORS.TEXT_DISABLED)
            end
            if item.bound and item.online == true then
                widgets.drawText(xTarget, ry, utils.shortAddress(item.bound), theme.COLORS.TEXT)
                local label = "[解绑]"
                widgets.drawText(xAct, ry, label, theme.COLORS.TEXT)
                fstate.produceHits[#fstate.produceHits + 1] = {
                    x = xAct, y = ry, w = unicode.wlen(label), h = 1, act = "unbind", machine = item.address
                }
            else
                local text = item.bound and utils.shortAddress(item.bound) or "未绑定"
                widgets.drawText(xTarget, ry, text, theme.COLORS.TEXT_DISABLED)
                local label = "[绑定]"
                widgets.drawText(xAct, ry, label, theme.COLORS.TEXT_DISABLED)
                fstate.produceHits[#fstate.produceHits + 1] = {
                    x = xAct, y = ry, w = unicode.wlen(label), h = 1, act = "bind", machine = item.address
                }
            end
        end
    end
end
function keypad.draw(data)
    local area = fstate.areas.keypad
    if not area or area.w <= 0 or area.h <= 0 then return end
    widgets.clearArea(area.x, area.y, area.w, area.h)
    fstate.keys = {}
    fstate.produceHits = {}
    if area.h < 2 then return end
    if fstate.editField == "produce" then
        drawProduce(area, data)
        return
    end
    local hint, color = hintText(data)
    if unicode.wlen(hint) > area.w then
        hint = unicode.sub(hint, 1, math.max(1, area.w - 1)) .. "…"
    end
    widgets.drawText(area.x, area.y, hint, color)
    local rows  = area.h - 1
    local function slotY(count)
        return area.y + 1 + math.max(0, math.floor((rows - count) / 2))
    end
    if fstate.editField == "threshold" then
        local wA, wB, wC = padWidth(DIGITS), padWidth(ACTS), padWidth(PRESETS)
        local total      = wA + wB + wC + SEP * 2
        local kx         = area.x + math.max(0, math.floor((area.w - total) / 2))
        local ky         = slotY(4)
        local xB         = kx + wA
        local xC         = xB + SEP + wB
        drawPad(kx, ky, DIGITS)
        for r = 0, 3 do
            widgets.drawText(xB + math.floor(SEP / 2), ky + r, "│", theme.CHART_AXIS)
        end
        drawPad(xB + SEP, ky, ACTS)
        for r = 0, 3 do
            widgets.drawText(xC + math.floor(SEP / 2), ky + r, "│", theme.CHART_AXIS)
        end
        drawPad(xC + SEP, ky, PRESETS)
    elseif fstate.editField == "weight" or fstate.editField == "factor"
        or fstate.editField == "strength" then
        local kx = area.x + math.max(0, math.floor((area.w - padWidth(WEIGHTS)) / 2))
        drawPad(kx, slotY(#WEIGHTS), WEIGHTS, { [3] = math.floor((KEY_W + KEY_GAP) / 2) })
    elseif fstate.editField == "boost" then
        local sys     = (data and data.system) or {}
        local level   = fstate.editLevel
        local options = {}
        if level == 1 or level == 2 then
            local on = type(sys.reflux) == "table" and sys.reflux[level] == true
            options = {
                { label = "开", kind = "set_reflux", value = true, current = on },
                { label = "关", kind = "set_reflux", value = false, current = not on }
            }
        elseif level == constants.T6_LEVEL then
            local on = sys.t6DualLithium == true
            options = {
                { label = "标准", kind = "set_t6_dual", value = false, current = not on },
                { label = "双锂", kind = "set_t6_dual", value = true, current = on }
            }
        else
            local current = tonumber(sys.t7Boost) or 1
            for _, value in ipairs(constants.T7_BOOST_OPTIONS) do
                options[#options + 1] = {
                    label = "×" .. numberText(value), kind = "set_boost",
                    value = tostring(value), current = (value == current)
                }
            end
        end
        drawOptions(area.x, slotY(1), area.w, options)
    end
end
function keypad.fingerprint(data)
    local area  = fstate.areas.keypad or {}
    local sys   = (data and data.system) or {}
    local parts = {
        tostring(area.x or 0), tostring(area.y or 0), tostring(area.w or 0), tostring(area.h or 0),
        tostring(fstate.editField or ""), tostring(fstate.editLevel or 0),
        tostring(fstate.editBuf or ""), tostring(sys.t7Boost),
        tostring(sys.t6DualLithium), tostring(type(sys.reflux) == "table" and sys.reflux[1] or nil),
        tostring(type(sys.reflux) == "table" and sys.reflux[2] or nil)
    }
    local row = (data and fstate.editLevel) and data.levels[fstate.editLevel]
    if row then
        parts[#parts + 1] = table.concat({
            tostring(row.rule.enabled), tostring(row.rule.threshold), tostring(row.weight)
        }, ":")
    end
    local pd = (data and data.produce) or {}
    local pl = (pd.levels or {})[fstate.editLevel or -1] or {}
    parts[#parts + 1] = table.concat({
        tostring(fstate.producePage or 1),
        tostring(pl.enabled), tostring(pl.ready), tostring(pl.reason),
        tostring(pl.bound), tostring(pl.configured), tostring(pl.online), tostring(pl.count),
        tostring((pd.binding or {}).level), tostring((pd.binding or {}).machine)
    }, ":")
    for _, m in ipairs(pl.machines or {}) do
        parts[#parts + 1] = table.concat(
            { m.address, tostring(m.bound), tostring(m.online), tostring(m.text), tostring(m.sideState), tostring(m.sideFail) }, ",")
    end
    return table.concat(parts, "\x1f")
end
return keypad

frontend/panels/log.lua
2059
local fstate  = require("frontend.state")
local theme   = require("frontend.theme")
local widgets = require("frontend.widgets")
local logs    = require("shared.logs")
local log     = {}
function log.draw(data)
    local area       = fstate.areas.log
    local rows       = widgets.textAreaRows(area, 1)
    local maxW       = area.w - 3
    local ro         = fstate.readOnly == true
    local title      = ro and " 系统日志（只读） " or " 系统日志 "
    local frameDirty = fstate.subDirty("log", "frame", table.concat({ area.x, area.y, area.w, area.h,
        tostring(data.system.priority) }, ":"))
    if frameDirty then
        widgets.drawPanelFrame(area, title, theme.COLORS.TEXT_CYAN,
            theme.borderColor(data.system.priority == "high"))
    end
    local all       = data.logs or {}
    local bodyDirty = fstate.subDirty("log", "body", table.concat({ logs.fingerprint(),
        #all, tostring(all[1] or ""), tostring(all[#all] or ""),
        rows.top, rows.rows, maxW }, "\x1f"))
    if not (frameDirty or bodyDirty) then return end
    local lines = {}
    for i = #all, 1, -1 do
        local raw     = tostring(all[i])
        local color   = theme.logColor(logs.kindOf(raw))
        local wrapped = widgets.wrapText(raw, maxW)
        for j = #wrapped, 1, -1 do
            table.insert(lines, 1, { text = wrapped[j], color = color })
        end
        if #lines >= rows.rows then break end
    end
    widgets.clearArea(area.x + 1, rows.top, area.w - 2, rows.rows)
    local start = math.max(1, #lines - rows.rows + 1)
    local y = rows.top
    for i = start, #lines do
        widgets.drawText(area.x + 1, y, lines[i].text, lines[i].color)
        y = y + 1
    end
end
function log.fingerprint(data)
    local area = fstate.areas.log
    local all  = data.logs or {}
    return table.concat({ tostring(data.system.priority), logs.fingerprint(),
        tostring(#all), tostring(all[1] or ""), tostring(all[#all] or ""),
        tostring(area and area.h or 0), tostring(area and area.w or 0) }, "\x1f")
end
return log

frontend/panels/settings.lua
