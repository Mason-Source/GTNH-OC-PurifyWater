local logs      = require("shared.logs")
local state     = require("shared.state")
local store     = require("backend.store.autostart")
local autostart = {}
function autostart.refresh()
    local info = store.read()
    state.write.setAutostart(info.enabled == true, info.stale == true, info.path)
    if info.enabled then
        logs.system(string.format("开机自启：已开启（%s）", tostring(info.path)))
    elseif info.stale then
        logs.warn(string.format("开机自启指向其它路径：%s（配置页重新勾选可更新）",
            tostring(info.target or "?")))
    end
    if info.manualLine then
        logs.warn("检测到 .shrc 另有手动启动行，开机可能重复启动：" .. tostring(info.manualLine))
    end
    return state.read.autostart()
end
function autostart.toggle()
    if not state.read.autostart() then
        local ok, info = store.enable()
        if not ok then
            local text = "开机自启设置失败：" .. tostring(info)
            logs.warn(text)
            return false, text
        end
        state.write.setAutostart(true, false, info)
        logs.system(string.format("开机自启已开启：%s（下次开机生效）", tostring(info)))
        return true, ""
    end
    local ok, info = store.disable()
    if not ok then
        local text = "开机自启取消失败：" .. tostring(info)
        logs.warn(text)
        return false, text
    end
    state.write.setAutostart(false, false, info)
    logs.system(string.format("开机自启已关闭：已从 %s 移除", tostring(info)))
    return true, ""
end
return autostart

backend/app/energy.lua
1174
local CONFIG    = require("shared.config")
local logs      = require("shared.logs")
local state     = require("shared.state")
local scheduler = require("core.scheduler")
local settings  = require("backend.store.settings")
local power     = require("backend.domain.power")
local app       = {}
function app.setFactor(value)
    local min, max = CONFIG.ENERGY.FACTOR_MIN, CONFIG.ENERGY.FACTOR_MAX
    value = tonumber(value)
    if not value or value ~= math.floor(value) or value < min or value > max then
        return false, string.format("利用因子需为 %d-%d 的整数（%%）", min, max)
    end
    if value == state.read.energyFactor() then return true, "" end
    local before = state.read.powerAll()
    state.write.setEnergyFactor(value)
    power.refresh()
    local ok = settings.set(CONFIG.ENERGY.FACTOR_KEY, value)
    logs.system(string.format("能源仓利用因子：%d%%%s", value,
        ok and "" or "（保存失败，重启回到默认）"))
    local after = state.read.powerAll()
    if before ~= after then
        scheduler.emit("power_changed", { from = before, to = after, note = "利用因子" })
    end
    return true, ""
end
return app

backend/app/net.lua
