local storage = require("services.storage")
local hardware_store = {}
local PATH = "data/hardware.txt"
function hardware_store.loadLines()
    return storage.readLines(PATH)
end
function hardware_store.saveLines(lines)
    local current = storage.readLines(PATH)
    if table.concat(current, "\n") == table.concat(lines, "\n") then
        return true, false
    end
    local ok, err = storage.replace(PATH, lines)
    if not ok then return false, err end
    return true, true
end
function hardware_store.path()
    return PATH
end
return hardware_store

services/history_service.lua
5371
local CONFIG = require("shared.config")
local constants = require("shared.constants")
local state = require("services.state")
local storage = require("services.storage")
local clock = require("services.clock")
local log = require("services.log")
local HISTORY = CONFIG.HISTORY or {}
local INTERVAL = HISTORY.INTERVAL or 30
local CAPACITY = HISTORY.POINTS or 80
local SAVE_INTERVAL = HISTORY.SAVE_INTERVAL or 1000
local PATH = HISTORY.PATH or "data/history.dat"
local service = {}
local due = { sample = 0, save = 0 }
local lastObservedAt = nil
local loaded = false
local function history()
    return state.get().output.history
end
local function validWater(values)
    if type(values) ~= "table" then return false end
    for level = 1, constants.LEVEL_COUNT do
        if type(tonumber(values[level])) ~= "number" then return false end
    end
    return true
end
local function append(values)
    local h = history()
    local levelCount = constants.LEVEL_COUNT
    h.head = (h.head % CAPACITY) + 1
    local base = (h.head - 1) * levelCount
    for level = 1, levelCount do
        h.values[base + level] = math.floor(tonumber(values[level]) or 0)
    end
    if h.count < CAPACITY then h.count = h.count + 1 end
    state.bump()
end
local function serialize()
    local h = history()
    local levelCount = constants.LEVEL_COUNT
    local lines = {
        "return {",
        "version = 1,",
        "interval = " .. tostring(INTERVAL) .. ",",
        "capacity = " .. tostring(CAPACITY) .. ",",
        "head = " .. tostring(h.head) .. ",",
        "count = " .. tostring(h.count) .. ",",
        "values = {",
    }
    for slot = 1, CAPACITY do
        local row = {}
        local base = (slot - 1) * levelCount
        for level = 1, levelCount do
            row[level] = tostring(h.values[base + level] or 0)
        end
        lines[#lines + 1] = table.concat(row, ", ") .. ","
    end
    lines[#lines + 1] = "},"
    lines[#lines + 1] = "}"
    return lines
end
local function applyLoaded(value)
    if type(value) ~= "table" then return false, "history root is not a table" end
    local h = history()
    h.capacity = CAPACITY
    h.interval = INTERVAL
    h.values = type(value.values) == "table" and value.values or {}
    h.count = math.max(0, math.min(CAPACITY, tonumber(value.count) or 0))
    h.head = tonumber(value.head) or 0
    if h.head < 0 or h.head > CAPACITY then h.head = h.count end
    return true, nil
end
function service.load()
    local h = history()
    h.capacity = CAPACITY
    h.interval = INTERVAL
    h.head = 0
    h.count = 0
    h.values = {}
    if storage.exists(PATH) then
        local text = table.concat(storage.readLines(PATH), "\n")
        if text ~= "" then
            local loader = load
            local chunk, compileErr = loader(text)
            if not chunk then
                log.warn("历史载入失败：" .. tostring(compileErr))
            else
                local ok, value = pcall(chunk)
                if not ok then
                    log.warn("历史载入失败：" .. tostring(value))
                else
                    local applied, applyErr = applyLoaded(value)
                    if not applied then log.warn("历史载入失败：" .. tostring(applyErr)) end
                end
            end
        end
    end
    local now = clock.uptime()
    due.sample = now
    due.save = now + SAVE_INTERVAL
    lastObservedAt = nil
    loaded = true
    state.bump()
    return true
end
function service.step(now)
    if now >= due.sample then
        local water = state.get().facts.water
        local observedAt = tonumber(water.observedAt)
        if validWater(water.value)
            and (observedAt == nil or lastObservedAt == nil or observedAt > lastObservedAt) then
            append(water.value)
            lastObservedAt = observedAt
        end
        due.sample = now + INTERVAL
    end
    if now >= due.save then
        local ok, err = service.save()
        if not ok then log.warn("历史保存失败：" .. tostring(err)) end
        due.save = now + SAVE_INTERVAL
    end
    return false
end
function service.nextDue(now)
    return math.min(due.sample, due.save)
end
function service.save()
    if not loaded then return false, "history not loaded" end
    local ok, err = storage.replace(PATH, serialize())
    if not ok then return false, err or "write failed" end
    return true, nil
end
function service.view()
    local h = history()
    local levelCount = constants.LEVEL_COUNT
    local values = {}
    for level = 1, levelCount do values[level] = {} end
    if h.count > 0 and h.head > 0 then
        local oldest = h.count < CAPACITY and 1 or (h.head % CAPACITY) + 1
        for offset = 0, h.count - 1 do
            local slot = ((oldest - 1 + offset) % CAPACITY) + 1
            local base = (slot - 1) * levelCount
            for level = 1, levelCount do
                values[level][#values[level] + 1] = tonumber(h.values[base + level])
            end
        end
    end
    return {
        count = h.count,
        capacity = CAPACITY,
        interval = INTERVAL,
        windowMinutes = HISTORY.WINDOW_MINUTES or (CAPACITY * INTERVAL / 60),
        values = values,
    }
end
function service.path() return PATH end
function service.interval() return INTERVAL end
function service.capacity() return CAPACITY end
return service

services/host_cycle.lua
1222
local state = require("services.state")
local host_cycle = {}
local armed = false
function host_cycle.observe(progress, maxProgress)
    if type(progress) ~= "number" then return false end
    local data = state.get()
    local cycle = data.facts.host.cycle
    local previous = cycle.progress
    data.facts.host.progress.value = progress
    data.facts.host.progress.observedAt = require("services.clock").uptime()
    if type(maxProgress) == "number" then
        data.facts.host.progressMax.value = maxProgress
        data.facts.host.progressMax.observedAt = data.facts.host.progress.observedAt
    end
    if previous == nil then
        armed = progress <= 1
        cycle.progress = progress
        return false
    end
    if progress < previous and progress <= 1 then armed = true end
    local started = (progress < previous and progress > 1)
        or (armed and previous <= 1 and progress > 1)
    cycle.progress = progress
    if not started then return false end
    armed = false
    cycle.seq = (cycle.seq or 0) + 1
    cycle.detectedAt = data.facts.host.progress.observedAt
    return true, cycle.seq
end
function host_cycle.seq()
    return state.get().facts.host.cycle.seq or 0
end
return host_cycle

services/learning_service.lua
2578
local CONFIG = require("shared.config")
local constants = require("shared.constants")
local state = require("services.state")
local control = require("services.control")
local learning = {}
local tracker = {}
local function limit()
    return math.max(1, CONFIG.RATES.PARALLEL_CONFIRM_CYCLES or 3)
end
function learning.observe(level, address, parallel, success, seq)
    local data = state.get()
    if not control.isRunning(data) then return false end
    if type(parallel) ~= "number" or parallel <= 0 or type(seq) ~= "number" then
        tracker[address] = nil
        return false
    end
    local item = tracker[address]
    if not item then
        tracker[address] = { level = level, seq = seq, value = parallel, streak = 1 }
        return false
    end
    if item.seq == seq then return false end
    if item.seq ~= seq - 1 then
        item.level, item.seq, item.value, item.streak, item.confirmed = level, seq, parallel, 1, nil
        return false
    end
    item.level = level
    item.seq = seq
    if item.value == parallel then item.streak = (item.streak or 1) + 1 else
        item.value, item.streak, item.confirmed = parallel, 1, nil
    end
    if item.streak < limit() or item.confirmed == parallel then return false end
    item.streak, item.confirmed = limit(), parallel
    local learned = data.plan.learned[level] or {}
    local changed = learned.parallel ~= parallel or (success ~= nil and learned.success ~= success)
    data.plan.learned[level] = {
        parallel = parallel,
        success = success,
        source = "measured",
    }
    if changed then
        state.bump()
    end
    return changed
end
function learning.confirmed(address)
    local item = tracker[address]
    return item and item.confirmed or nil
end
function learning.clearLevel(level)
    for address, item in pairs(tracker) do
        if item.level == level then tracker[address] = nil end
    end
end
function learning.resetAll()
    tracker = {}
    local data = state.get()
    local changed = false
    for level = 1, constants.LEVEL_COUNT do
        local learned = data.plan.learned[level]
        if learned and learned.parallel ~= nil then changed = true end
        data.plan.learned[level] = nil
    end
    if changed then state.bump() end
    return changed
end
function learning.count()
    local count = 0
    for level = 1, constants.LEVEL_COUNT do
        local item = state.get().plan.learned[level]
        if item and type(item.parallel) == "number" and item.parallel > 0 then count = count + 1 end
    end
    return count
end
return learning

services/log.lua
4195
local config = require("shared.config")
local clock = require("services.clock")
local storage = require("services.storage")
local log = {}
local CHUNK = config.LOG.CHUNK_LINES or 20
local MAX_PENDING = config.LOG.PENDING_LINES or 300
local FILE_LINES = config.LOG.FILE_LINES
local FILE_COUNT = config.LOG.FILE_COUNT
local VIEW_LINES = config.LOG.VIEW_LINES or 80
local pending = {}
local recent = {}
local seq = 0
local lastLine = nil
local activePath = nil
local activeLines = 0
local KIND = {
    ERROR = "error",
    WARN = "warn",
    SYSTEM = "system",
    DIAG = "diag",
}
local function newPath()
    return "log/log-" .. os.date("%Y%m%d-%H%M%S", clock.realTime()) .. ".txt"
end
local function logFiles()
    local files = storage.list("log/log-")
    table.sort(files)
    return files
end
local function startFile()
    local files = logFiles()
    if #files >= FILE_COUNT and not storage.remove(files[1]) then
        return false, "cannot remove oldest log"
    end
    activePath = newPath()
    activeLines = 0
    return true
end
local function ensureFile()
    if activePath then return true end
    local files = logFiles()
    if #files > 0 then
        local latest = files[#files]
        local lines = #storage.readLines(latest)
        if lines < FILE_LINES then
            activePath = latest
            activeLines = lines
            return true
        end
    end
    return startFile()
end
local function appendPart(lines)
    local ok, err = storage.append(activePath, lines)
    if not ok then return false, err end
    activeLines = activeLines + #lines
    if activeLines == FILE_LINES then activePath = nil end
    return true
end
local function writeChunk(chunk)
    local ok, err = ensureFile()
    if not ok then return false, err end
    local room = FILE_LINES - activeLines
    if #chunk <= room then return appendPart(chunk) end
    local head = {}
    for index = 1, room do head[index] = chunk[index] end
    if room > 0 then
        ok, err = appendPart(head)
        if not ok then return false, err end
    end
    local rest = {}
    for index = room + 1, #chunk do rest[#rest + 1] = chunk[index] end
    ok, err = startFile()
    if not ok then return false, err end
    return appendPart(rest)
end
local function append(level, message)
    seq = seq + 1
    local record = {
        seq = seq,
        at = clock.realTime(),
        kind = KIND[level] or "system",
        level = level,
        text = tostring(message or ""),
    }
    recent[#recent + 1] = record
    if #recent > VIEW_LINES then table.remove(recent, 1) end
    lastLine = string.format("%.3f|%s|%s", clock.uptime(), level, record.text)
    pending[#pending + 1] = lastLine
    if #pending > MAX_PENDING then
        table.remove(pending, 1)
    end
end
function log.error(message) append("ERROR", message) end
function log.warn(message) append("WARN", message) end
function log.system(message) append("SYSTEM", message) end
function log.diag(message) append("DIAG", message) end
function log.count() return seq end
function log.revision() return seq end
function log.last() return lastLine end
function log.pendingCount() return #pending end
function log.entries()
    local out = {}
    for index = 1, #recent do
        local item = recent[index]
        out[index] = {
            seq = item.seq,
            at = item.at,
            kind = item.kind,
            level = item.level,
            text = item.text,
        }
    end
    return out
end
function log.flush()
    if #pending == 0 then return true, activePath or "-" end
    local consumed = 0
    while consumed < #pending do
        local count = math.min(CHUNK, #pending - consumed)
        local chunk = {}
        for index = 1, count do chunk[index] = pending[consumed + index] end
        local ok, err = writeChunk(chunk)
        if not ok then
            if consumed > 0 then
                local rest = {}
                for index = consumed + 1, #pending do rest[#rest + 1] = pending[index] end
                pending = rest
            end
            return false, err
        end
        consumed = consumed + count
    end
    pending = {}
    return true, activePath or "-"
end
return log

services/log_flush.lua
605
local CONFIG = require("shared.config")
local clock = require("services.clock")
local log = require("services.log")
local service = {}
local dueAt = 0
local INTERVAL = (CONFIG.LOG and CONFIG.LOG.FLUSH_INTERVAL) or 5
function service.load(now)
    dueAt = (tonumber(now) or clock.uptime()) + INTERVAL
    return true
end
function service.step(now)
    if now < dueAt then return false end
    dueAt = now + INTERVAL
    local ok, err = log.flush()
    if not ok then log.error("日志保存失败：" .. tostring(err)) end
    return false
end
function service.nextDue(now) return dueAt end
return service

services/net_service.lua
4035
local CONFIG = require("shared.config")
local clock = require("services.clock")
local log = require("services.log")
local models = require("shared.models")
local settings = require("services.settings_store")
local state = require("services.state")
local device = require("hardware.device")
local service = {}
local source = nil
local due = 0
local modem = nil
local pending = nil
local frame = 0
local lastProblem = nil
local INTERVAL = CONFIG.NET.INTERVAL or 10
local PORT = CONFIG.NET.PORT or 4096
local CHUNK = CONFIG.NET.CHUNK or 4000
function service.setSource(fn)
    source = fn
end
local function setAvailable(value)
    local data = state.get()
    value = value == true
    if data.net.available ~= value then
        data.net.available = value
        state.bump()
    end
end
function service.load(now)
    local data = state.get()
    data.net.enabled = data.settings.netEnabled == true
    data.net.strength = tonumber(data.settings.netStrength) or CONFIG.NET.STRENGTH_DEFAULT
    due = tonumber(now) or clock.uptime()
    pending, modem, frame, lastProblem = nil, nil, 0, nil
    setAvailable(false)
    return true
end
local function discover()
    local found, kind
    for address, componentKind in pairs(device.list()) do
        if componentKind == "modem" or componentKind == "tunnel" then
            found, kind = address, componentKind
            break
        end
    end
    modem = found
    setAvailable(found ~= nil)
    return found, kind
end
local function prepare(now)
    if not source then due = now + INTERVAL; return false end
    local text = models.encodeSnapshot(source())
    if type(text) ~= "string" or text == "" then due = now + INTERVAL; return false end
    frame = frame + 1
    state.get().net.frame = frame
    pending = { frame = frame, text = text, index = 1, total = math.max(1, math.ceil(#text / CHUNK)) }
    return true
end
local function fail(message)
    local text = tostring(message or "广播失败")
    if text ~= lastProblem then
        log.warn("无线广播失败：" .. text)
        lastProblem = text
    end
    pending = nil
    modem = nil
    setAvailable(false)
end
function service.step(now)
    local data = state.get()
    if not data.net.enabled then pending = nil end
    if pending then
        local first = (pending.index - 1) * CHUNK + 1
        local part = pending.text:sub(first, first + CHUNK - 1)
        local message = models.chunk(pending.frame, pending.index, pending.total, part)
        local ok, err, reason = device.invoke(modem, "broadcast", PORT, message)
        if ok == false or (ok == nil and reason) then
            fail(err or reason or "发送被拒绝")
            due = now + INTERVAL
            return false
        end
        pending.index = pending.index + 1
        if pending.index <= pending.total then return true end
        pending = nil
        lastProblem = nil
        due = now + INTERVAL
        return false
    end
    if now < due then return false end
    if not modem then
        local found = discover()
        if not found then
            due = now + INTERVAL
            return false
        end
    end
    if not data.net.enabled then
        due = now + INTERVAL
        return false
    end
    if not prepare(now) then return false end
    return true
end
function service.nextDue(now)
    if pending then return now end
    return due
end
function service.toggle()
    local data = state.get()
    local nextValue = data.settings.netEnabled ~= true
    local ok, err = settings.set("net_enabled", nextValue and "true" or "false")
    if not ok then return false, "写配置失败（settings.txt）：" .. tostring(err) end
    data.settings.netEnabled = nextValue
    data.net.enabled = nextValue
    state.bump()
    due = clock.uptime()
    log.system("无线广播：" .. (nextValue and "开" or "关"))
    return true, ""
end
function service.handle(name)
    if name ~= "net_toggle" then return false end
    local ok, err = service.toggle()
    return true, ok, err
end
return service

services/produce_runtime.lua
10413
local CONFIG = require("shared.config")
local constants = require("shared.constants")
local state = require("services.state")
local log = require("services.log")
local control = require("services.control")
local clock = require("services.clock")
local probes = require("hardware.probes")
local gt_infodata = require("hardware.gt_infodata")
local transposer = require("hardware.transposer")
local machines = require("hardware.machines")
local util = require("shared.util")
local produce = require("business.produce")
local machine = require("business.produce.machine")
local produce_service = require("services.produce_service")
local runtime = {}
local function data()
    return state.get()
end
local function store()
    return data().work.produce
end
local function machineText(level, address)
    for _, item in ipairs(machines.of(level)) do
        if item.address == address and type(item.x) == "number"
            and type(item.y) == "number" and type(item.z) == "number" then
            return string.format("(%d,%d,%d)", item.x, item.y, item.z)
        end
    end
    return util.shortAddress(address)
end
local function entryActive(entry)
    for _, current in ipairs(data().produce.bindings or {}) do
        if current == entry then return true end
    end
    return false
end
local function machineActive(address)
    local fact = data().facts.machines[address]
    return fact ~= nil and fact.active == true
end
local function transferCode(raw, fallback)
    local text = tostring(raw or ""):lower()
    if text:find("energy", 1, true) or text:find("能量", 1, true) then return "ENERGY" end
    if text:find("no inventory", 1, true) or text:find("no tank", 1, true)
        or text:find("target", 1, true) or text:find("side", 1, true) then
        return "SIDE_MISSING"
    end
    return fallback
end
local function chunkLimit(task)
    local rate = tonumber(task.entry.rate) or 0
    return math.max(1, math.floor(rate * (CONFIG.PRODUCE.CHUNK_RATIO or 0.05)))
end
local function executeCommandNow(task, command)
    if command.kind == "sensor" then
        local info, err = probes.sensor(task.machine)
        if not info then return { ok = false, err = err or "传感器读取失败" } end
        if command.field == nil then return { ok = true, info = info, lines = info.lines } end
        local value, fieldErr = gt_infodata.extract(info.lines, command.field)
        if value == nil then
            return { ok = false, err = fieldErr or ("传感器字段不可读：" .. tostring(command.field)) }
        end
        return { ok = true, value = value }
    end
    if command.kind == "readItems" then
        local items, err = transposer.items(task.entry.transposer, command.side)
        if not items then return { ok = false, err = err or "物品读取失败" } end
        return { ok = true, items = items }
    end
    if command.kind == "transferFluid" then
        local ok, moved = transposer.transferFluid(task.entry.transposer, command.from,
            command.to, command.amount, command.tank)
        if ok and tonumber(moved) and tonumber(moved) > 0 then
            return { ok = true, moved = tonumber(moved) }
        end
        local raw = tostring(moved or "流体转运失败")
        return { ok = false, err = raw, code = transferCode(raw, "FLUID_NOT_MOVED") }
    end
    if command.kind == "transferItem" then
        local ok, moved = transposer.transferItem(task.entry.transposer, command.from,
            command.to, command.count, command.slot)
        if ok and tonumber(moved) and tonumber(moved) > 0 then
            return { ok = true, moved = tonumber(moved) }
        end
        local raw = tostring(moved or "物品转运失败")
        return { ok = false, err = raw, code = transferCode(raw, "ITEM_NOT_MOVED") }
    end
    return { ok = false, err = "未知制作命令：" .. tostring(command.kind), code = "COMMAND_INVALID" }
end
local function executeCommand(task, command)
    local startedAt = clock.uptime()
    local result = executeCommandNow(task, command)
    local finishedAt = clock.uptime()
    result.startedAt = startedAt
    result.finishedAt = finishedAt
    result.elapsed = math.max(0, finishedAt - startedAt)
    task.lastCommand = command.kind
    task.lastResultAt = finishedAt
    task.lastResult = {
        ok = result.ok == true,
        err = result.err,
        moved = result.moved,
        value = result.value,
        items = result.items and #result.items or nil,
        startedAt = startedAt,
        finishedAt = finishedAt,
        elapsed = result.elapsed,
    }
    return result
end
local function canRun(task)
    if task.cycleSeq ~= data().facts.host.cycle.seq then return false, "周期已变化" end
    if not entryActive(task.entry) then return false, "绑定已失效" end
    if not machineActive(task.machine) then return false, "机器未运行" end
    return produce_service.canRunBinding(task.entry)
end
local function remove(id)
    store().tasks[id] = nil
end
local function usageText(task)
    local list = {}
    for _, item in pairs(task.usage or {}) do list[#list + 1] = item end
    table.sort(list, function(a, b) return (a.order or 0) < (b.order or 0) end)
    local parts = {}
    for _, item in ipairs(list) do
        local amount = util.formatShortNumber(item.amount or 0)
        if item.unit == "fluid" then
            parts[#parts + 1] = item.label .. " " .. util.formatVolume(item.amount)
        else
            parts[#parts + 1] = string.format("%s×%s", item.label, amount)
        end
    end
    return table.concat(parts, "、")
end
local function remember(task, status, at, reason)
    store().last = {
        id = task.id,
        level = task.level,
        machine = task.machine,
        state = task.state,
        status = status,
        expectedAt = task.expectedAt,
        completedAt = at,
        reason = reason,
        lastResult = task.lastResult,
    }
end
local function complete(task, at)
    at = at or clock.uptime()
    task.completedAt = at
    remember(task, "done", at)
    remove(task.id)
    local used = usageText(task)
    log.system(string.format("%s 制作完成%s", constants.levelCode(task.level),
        used ~= "" and ("：" .. used) or ""))
end
local function fail(task, reason, failure, at)
    at = at or clock.uptime()
    task.failedAt = at
    remember(task, "failed", at, tostring(reason))
    remove(task.id)
    log.warn(string.format("%s 制作失败：%s（机器 %s）",
        constants.levelCode(task.level), tostring(reason), machineText(task.level, task.machine)))
    if failure then produce_service.onTransferFailure(task.machine, failure) end
end
local function cancelAll()
    store().tasks = {}
end
local function pickDue(now)
    local picked
    for _, task in pairs(store().tasks) do
        if task.runAt <= now then
            if not picked or task.priority < picked.priority
                or (task.priority == picked.priority and task.runAt < picked.runAt) then
                picked = task
            end
        end
    end
    return picked
end
local function addTask(entry, method, seq, now)
    local id = string.format("produce:%d:%s", entry.level, entry.machine)
    if store().tasks[id] then return end
    local task = machine.create(method, entry, now)
    task.id = id
    task.machine = entry.machine
    task.entry = entry
    task.level = entry.level
    task.priority = tonumber(method.priority) or 100
    task.cycleSeq = seq
    task.runAt = now
    task.expectedAt = now
    task.createdAt = now
    store().tasks[id] = task
end
local function spawnCycle(seq, now)
    if seq <= 0 or not control.isRunning(data()) then return end
    local progress = tonumber(data().facts.host.progress.value)
    local maxProgress = tonumber(data().facts.host.progressMax.value)
    if progress and maxProgress and maxProgress > 0
        and progress / maxProgress > (CONFIG.PRODUCE.CYCLE_CUTOFF or 0.9) then
        return
    end
    for _, entry in ipairs(data().produce.bindings or {}) do
        local method = produce.method(entry.level)
        local product = data().produce.levels[entry.level] or {}
        if method and product.enabled == true and machineActive(entry.machine) then
            local ok = produce_service.canRunBinding(entry)
            if ok then addTask(entry, method, seq, now) end
        end
    end
end
function runtime.load()
    store().tasks = {}
    store().activeCycle = data().facts.host.cycle.seq or 0
end
function runtime.nextDue(now)
    local slot = store()
    if not control.isRunning(data()) then
        if next(slot.tasks or {}) ~= nil then return now end
        return math.huge
    end
    if (data().facts.host.cycle.seq or 0) ~= slot.activeCycle then return now end
    local best = math.huge
    for _, task in pairs(slot.tasks or {}) do
        if task.runAt < best then best = task.runAt end
    end
    return best
end
function runtime.step(now)
    local seq = data().facts.host.cycle.seq or 0
    local slot = store()
    if seq ~= slot.activeCycle then
        cancelAll()
        slot.activeCycle = seq
        spawnCycle(seq, now)
        return true
    end
    if not control.isRunning(data()) then
        cancelAll()
        return false
    end
    local task = pickDue(now)
    if not task then return false end
    local ok = canRun(task)
    if not ok then
        remove(task.id)
        return true
    end
    local method = produce.method(task.level)
    if not method then
        fail(task, "制作方法未注册", nil, now)
        return true
    end
    local env = { chunkLimit = function() return chunkLimit(task) end }
    local response = machine.step(task, method, now, env,
        function(command) return executeCommand(task, command) end)
    local finishedAt = clock.uptime()
    task.lastStartedAt = now
    task.lastFinishedAt = finishedAt
    if response.status == "done" then
        task.completedAt = finishedAt
        complete(task, finishedAt)
    elseif response.status == "wait" then
        task.runAt = finishedAt + math.max(0.05, tonumber(response.seconds) or 0.05)
        task.expectedAt = task.runAt
    elseif response.status == "continue" then
        task.runAt = finishedAt + 0.05
        task.expectedAt = task.runAt
    else
        task.failedAt = finishedAt
        fail(task, response.reason, response.failure, finishedAt)
    end
    return true
end
return runtime

services/produce_service.lua
30035
local config = require("shared.config")
local constants = require("shared.constants")
local state = require("services.state")
local log = require("services.log")
local device = require("hardware.device")
local machines = require("hardware.machines")
local transposer = require("hardware.transposer")
local produce_store = require("services.produce_store")
local layout = require("business.produce.layout")
local produce_registry = require("business.produce")
local util = require("shared.util")
local control = require("services.control")
local service = {}
local INTERVAL = {
    scan = (config.PRODUCE and config.PRODUCE.SCAN) or 10,
}
local MISSING_SCANS = constants.PRODUCE_MISSING_SCANS or 3
local due = { scan = 0 }
local current = nil
local queue = {}
local queued = {}
local refreshRequested = false
local configBatches = {}
local function produce()
    return state.get().produce
end
local function machineLabel(level, address)
    for _, machine in ipairs(machines.of(level)) do
        if machine.address == address then
            if type(machine.x) == "number" and type(machine.y) == "number"
                and type(machine.z) == "number" then
                return string.format("(%d,%d,%d)", machine.x, machine.y, machine.z)
            end
            break
        end
    end
    return util.shortAddress(address)
end
local function findPosition(list, field, value)
    for index, entry in ipairs(list or {}) do
        if entry[field] == value then return index, entry end
    end
end
local function findActive(machine)
    local _, entry = findPosition(produce().bindings, "machine", machine)
    return entry
end
local function findCandidate(machine)
    local _, entry = findPosition(produce().candidates, "machine", machine)
    return entry
end
local function findAnyByMachine(machine)
    return findActive(machine) or findCandidate(machine)
end
local function findAnyByTransposer(address)
    local active = produce().bindings
    for _, entry in ipairs(active) do
        if entry.transposer == address then return entry end
    end
    local candidates = produce().candidates
    for _, entry in ipairs(candidates) do
        if entry.transposer == address then return entry end
    end
end
local function bindingLess(a, b)
    if a.level ~= b.level then return a.level < b.level end
    return tostring(a.machine) < tostring(b.machine)
end
local function persist()
    local ok, err = produce_store.save(produce().bindings, produce().candidates)
    if not ok then log.error("制作配置保存失败：" .. tostring(err)) end
    return ok == true
end
local function keyBusy(key)
    if key == nil then return false end
    if current and current.key == key then return true end
    for _, task in ipairs(queue) do
        if task.key == key then return true end
    end
    return queued[key] == true
end
local function enqueue(task)
    if task.key and keyBusy(task.key) then return false end
    if task.key then queued[task.key] = true end
    queue[#queue + 1] = task
    return true
end
local function batchFor(level)
    local batch = configBatches[level]
    if not batch then
        batch = { side = 0, slot = 0 }
        configBatches[level] = batch
    end
    return batch
end
local function recordConfig(level, field)
    local batch = batchFor(level)
    batch[field] = (batch[field] or 0) + 1
end
local function hasConfigure(level)
    if current and current.kind == "configure" and current.entry and current.entry.level == level then
        return true
    end
    for _, task in ipairs(queue) do
        if task.kind == "configure" and task.entry and task.entry.level == level then return true end
    end
    return false
end
local function flushConfigBatch(level)
    if hasConfigure(level) then return end
    local batch = configBatches[level]
    configBatches[level] = nil
    if not batch or (batch.side == 0 and batch.slot == 0) then return end
    local parts = {}
    if batch.side > 0 then parts[#parts + 1] = string.format("侧位 %d 台", batch.side) end
    if batch.slot > 0 then parts[#parts + 1] = string.format("槽位 %d 台", batch.slot) end
    log.system(string.format("%s 配置完成：%s", constants.levelCode(level), table.concat(parts, "，")))
end
local function finishCurrent()
    local finished = current
    if finished and finished.key then queued[finished.key] = nil end
    current = nil
    if finished and finished.kind == "configure" and finished.entry then
        flushConfigBatch(finished.entry.level)
    end
end
local function queueConfigure(entry, mode)
    if not entry then return false end
    local key = "configure:" .. tostring(entry.machine)
    if current and current.key == key then
        if mode == "force" then current.mode = "force" end
        return false
    end
    for _, task in ipairs(queue) do
        if task.key == key then
            if mode == "force" then task.mode = "force" end
            return false
        end
    end
    return enqueue({ kind = "configure", key = key, entry = entry, mode = mode or "auto" })
end
local function machineExists(level, address)
    for _, machine in ipairs(machines.of(level)) do
        if machine.address == address then return machine end
    end
end
local function sortedTransposers(devices)
    local out = {}
    for address, kind in pairs(devices or {}) do
        if kind == "transposer" then out[#out + 1] = address end
    end
    table.sort(out)
    return out
end
local function bindingAddressBound(address)
    return findAnyByTransposer(address) ~= nil
end
local function queueRate(entry, mode)
    if not entry then return false end
    mode = mode or "restore"
    local key = "refresh-rate:" .. tostring(entry.transposer)
    if current and current.key == key then
        if mode == "refresh" then current.mode = "refresh" end
        return false
    end
    for _, task in ipairs(queue) do
        if task.key == key then
            if mode == "refresh" then task.mode = "refresh" end
            return false
        end
    end
    return enqueue({ kind = "rate", key = key, mode = mode, entry = entry })
end
local function reconcilePresence(devices)
    local data = produce()
    local oldOnline = data.online or {}
    local nextActive, nextCandidates = {}, {}
    local changed, onlineChanged = false, false
    for _, entry in ipairs(data.bindings or {}) do
        local online = devices[entry.transposer] == "transposer"
        if online then
            nextActive[#nextActive + 1] = entry
            if entry.miss ~= nil then
                entry.miss = nil
                changed = true
            end
            if not tonumber(entry.rate) then queueRate(entry, "restore") end
            if entry.sides == nil then
                queueConfigure(entry, "auto")
            elseif entry.slots == nil then
                queueConfigure(entry, "slots")
            elseif entry.forceOff == true then
                queueConfigure(entry, "diagnose")
            end
        else
            entry.miss = 1
            nextCandidates[#nextCandidates + 1] = entry
            changed = true
            log.warn(string.format("%s 转运器 %s 离线（1/%d，机器 %s）",
                constants.levelCode(entry.level), util.shortAddress(entry.transposer),
                MISSING_SCANS, machineLabel(entry.level, entry.machine)))
        end
    end
    for _, entry in ipairs(data.candidates or {}) do
        local online = devices[entry.transposer] == "transposer"
        if online then
            entry.miss = nil
            nextActive[#nextActive + 1] = entry
            changed = true
            log.system(string.format("%s 转运器 %s 恢复在线（机器 %s）",
                constants.levelCode(entry.level), util.shortAddress(entry.transposer),
                machineLabel(entry.level, entry.machine)))
            if not tonumber(entry.rate) then queueRate(entry, "restore") end
            if entry.sides == nil then
                queueConfigure(entry, "auto")
            elseif entry.slots == nil then
                queueConfigure(entry, "slots")
            elseif entry.forceOff == true then
                queueConfigure(entry, "diagnose")
            end
        else
            local miss = math.max(1, tonumber(entry.miss) or 1) + 1
            entry.miss = miss
            if miss >= MISSING_SCANS then
                changed = true
                log.warn(string.format("%s 转运器 %s 连续 %d 次缺失，已解除绑定（机器 %s）",
                    constants.levelCode(entry.level), util.shortAddress(entry.transposer),
                MISSING_SCANS, machineLabel(entry.level, entry.machine)))
            else
                nextCandidates[#nextCandidates + 1] = entry
                changed = true
            end
        end
    end
    table.sort(nextActive, bindingLess)
    table.sort(nextCandidates, bindingLess)
    data.bindings = nextActive
    data.candidates = nextCandidates
    local onlineMap = {}
    for _, entry in ipairs(nextActive) do onlineMap[entry.transposer] = true end
    for _, entry in ipairs(nextCandidates) do onlineMap[entry.transposer] = false end
    for address, value in pairs(onlineMap) do
        if oldOnline[address] ~= value then onlineChanged = true; break end
    end
    for address in pairs(oldOnline) do
        if onlineMap[address] == nil then onlineChanged = true; break end
    end
    data.online = onlineMap
    if changed then persist() end
    if changed or onlineChanged then state.bump() end
end
local function queueRefreshProperties()
    for _, entry in ipairs(produce().bindings) do
        if produce().online[entry.transposer] == true then
            queueRate(entry, "refresh")
        end
    end
end
local function componentScan(now, force)
    local devices = device.list()
    reconcilePresence(devices)
    due.scan = now + INTERVAL.scan
    if force then queueRefreshProperties() end
end
local function startBindingRate(level, machine, address)
    return enqueue({
        kind = "rate",
        key = "bind-rate:" .. tostring(address),
        mode = "binding",
        level = level,
        machine = machine,
        transposer = address,
    })
end
local function stepCandidates(task)
    local item = produce().binding
    if not item or item.level ~= task.level or item.machine ~= task.machine then
        finishCurrent()
        return
    end
    local devices = device.list()
    local candidates = {}
    for _, address in ipairs(sortedTransposers(devices)) do
        if not bindingAddressBound(address) then candidates[#candidates + 1] = address end
    end
    item.candidates = candidates
    item.loading = false
    state.bump()
    finishCurrent()
end
local function commitBinding(level, machine, address, rate)
    local other = findAnyByTransposer(address)
    if other and other.machine ~= machine then
        produce().binding = nil
        log.warn(string.format("%s 转运器 %s 已被机器 %s 占用，绑定失败",
            constants.levelCode(level), util.shortAddress(address), machineLabel(level, other.machine)))
        return false
    end
    local old = produce()
    local active, candidates = {}, {}
    for _, entry in ipairs(old.bindings or {}) do
        if entry.machine ~= machine and entry.transposer ~= address then active[#active + 1] = entry end
    end
    for _, entry in ipairs(old.candidates or {}) do
        if entry.machine ~= machine and entry.transposer ~= address then candidates[#candidates + 1] = entry end
    end
    local entry = {
        level = level,
        machine = machine,
        transposer = address,
        rate = rate,
    }
    active[#active + 1] = entry
    table.sort(active, bindingLess)
    table.sort(candidates, bindingLess)
    local ok = produce_store.save(active, candidates)
    if not ok then
        produce().binding = nil
        log.error(string.format("%s 绑定保存失败（机器 %s）",
            constants.levelCode(level), machineLabel(level, machine)))
        return false
    end
    old.bindings = active
    old.candidates = candidates
    old.online[address] = true
    old.binding = nil
    state.bump()
    log.system(string.format("%s 已绑定转运器 %s → 机器 %s（速率 %s/s）",
        constants.levelCode(level), util.shortAddress(address), machineLabel(level, machine),
        util.formatVolume(rate)))
    queueConfigure(entry, "auto")
    return true
end
local function cacheItemSlots(level)
    return level ~= constants.T6_LEVEL
end
local function refreshSlots(entry, faces)
    local fluids, items = layout.requirements(entry.level)
    if not fluids then
        entry.slots = { ready = false, fluid = {}, item = {} }
        entry.forceOff = true
        entry.forceReason = "该等级没有制作自动化侧位定义"
        return false, entry.forceReason
    end
    local cacheItems = cacheItemSlots(entry.level)
    local slots = layout.buildSlots(faces, entry.sides, items, cacheItems)
    local availabilitySides = entry.sides
    if not cacheItems then
        local itemSources, seen = {}, {}
        local target = entry.sides.itemTarget
        if target ~= nil then
            itemSources[#itemSources + 1] = target
            seen[target] = true
        end
        for _, side in ipairs(entry.sides.itemSources or {}) do
            if not seen[side] then
                itemSources[#itemSources + 1] = side
                seen[side] = true
            end
        end
        availabilitySides = {
            sources = entry.sides.sources,
            itemSources = itemSources,
        }
    end
    local available, missing = layout.sourcesAvailable(
        faces, availabilitySides, fluids, items)
    if not cacheItems and #(entry.sides.itemSources or {}) == 0 then
        available = false
        missing = "没有物品来源侧"
    end
    slots.ready = available == true
    entry.slots = slots
    if available then
        entry.forceOff = false
        entry.forceReason = nil
    else
        entry.forceOff = true
        entry.forceReason = "原料不足：" .. tostring(missing or "未知原料")
    end
    return available, missing
end
local function applyConfig(task)
    local entry = task.entry
    if findActive(entry.machine) ~= entry then return end
    local fluids, items = layout.requirements(entry.level)
    if not fluids then
        entry.sideFail = "该等级没有制作自动化侧位定义"
        state.bump()
        return
    end
    local topology = layout.topology(task.faces)
    if task.mode == "slots" then
        if not entry.sides then
            entry.sideFail = "侧位尚未配置"
            entry.slots = { ready = false, fluid = {}, item = {} }
            state.bump()
            return
        end
        local ok, missing = refreshSlots(entry, task.faces)
        entry.topology = topology
        entry.sideFail = nil
        state.bump()
        if ok then
            recordConfig(entry.level, "slot")
        else
            log.warn(string.format("%s 槽位配置失败：%s（机器 %s）",
                constants.levelCode(entry.level), tostring(entry.forceReason or missing), machineLabel(entry.level, entry.machine)))
        end
        return
    end
    if task.mode == "diagnose" then
        if entry.topology ~= nil and entry.topology == topology then
            local ok, missing = refreshSlots(entry, task.faces)
            entry.sideFail = nil
            state.bump()
            if not ok then
                log.warn(string.format("%s 槽位检查失败：%s（机器 %s）",
                    constants.levelCode(entry.level), tostring(entry.forceReason or missing), machineLabel(entry.level, entry.machine)))
            end
            return
        end
        entry.configChanged = true
    elseif task.mode ~= "force" then
        if entry.sides ~= nil and entry.configChanged ~= true then return end
    end
    local sides, reason = layout.classify(task.faces, fluids, items)
    if not sides then
        entry.sideFail = reason
        entry.configured = false
        entry.slots = { ready = false, fluid = {}, item = {} }
        entry.forceOff = true
        entry.forceReason = tostring(reason)
        state.bump()
        log.warn(string.format("%s 侧位配置失败：%s（机器 %s）",
            constants.levelCode(entry.level), tostring(reason), machineLabel(entry.level, entry.machine)))
        return
    end
    local oldSides, oldTopology = entry.sides, entry.topology
    local oldFail = entry.sideFail
    local oldConfigured = entry.configured
    local oldChanged = entry.configChanged
    entry.sides = sides
    entry.topology = topology
    entry.sideFail = nil
    entry.configured = true
    entry.configChanged = false
    if not persist() then
        entry.sides, entry.topology = oldSides, oldTopology
        entry.sideFail = oldFail
        entry.configured = oldConfigured
        entry.configChanged = oldChanged
        return
    end
    recordConfig(entry.level, "side")
    local slotsOk, slotsMissing = refreshSlots(entry, task.faces)
    if slotsOk then
        recordConfig(entry.level, "slot")
    else
        log.warn(string.format("%s 槽位配置失败：%s（机器 %s）",
            constants.levelCode(entry.level), tostring(entry.forceReason or slotsMissing), machineLabel(entry.level, entry.machine)))
    end
    state.bump()
end
local function advanceConfig(task)
    local entry = task.entry
    if not entry or findActive(entry.machine) ~= entry then
        finishCurrent()
        return
    end
    local flu, items = layout.requirements(entry.level)
    if not flu then
        applyConfig(task)
        finishCurrent()
        return
    end
    task.faces = task.faces or {}
    task.side = task.side or 0
    task.phase = task.phase or "fluid"
    local needItems = items ~= nil and #items > 0
    while true do
        if task.side > 5 then
            applyConfig(task)
            finishCurrent()
            return
        end
        local face = task.faces[task.side] or {}
        task.faces[task.side] = face
        if task.phase == "fluid" then
            face.fluids, face.fluidErr = transposer.containers(entry.transposer, task.side)
            task.phase = needItems and "item" or "next"
            return
        elseif task.phase == "item" then
            face.items, face.itemErr = transposer.items(entry.transposer, task.side)
            task.phase = "next"
            return
        else
            task.side = task.side + 1
            task.phase = "fluid"
        end
    end
end
local function stepRate(task)
    local rate, err
    if task.mode == "binding" then
        local item = produce().binding
        if task.cancelled or not item or item.machine ~= task.machine then
            finishCurrent()
            return
        end
        rate, err = transposer.rate(task.transposer)
        local minRate = produce_registry.minTransferRate(task.level)
        if type(rate) ~= "number" or rate <= 0 then
            item.loading = false
            state.bump()
            log.warn(string.format("%s 转运器 %s 速率未知，绑定失败：%s",
                constants.levelCode(task.level), util.shortAddress(task.transposer),
                tostring(err or "速率无效")))
            finishCurrent()
            return
        elseif minRate and rate < minRate then
            item.loading = false
            state.bump()
            log.warn(string.format("%s 转运器 %s 速率不足：%s/s < %s/s，绑定失败",
                constants.levelCode(task.level), util.shortAddress(task.transposer),
                util.formatVolume(rate), util.formatVolume(minRate)))
            finishCurrent()
            return
        end
        commitBinding(task.level, task.machine, task.transposer, rate)
        finishCurrent()
        return
    end
    local entry = task.entry
    if not entry or findActive(entry.machine) ~= entry then
        finishCurrent()
        return
    end
    rate, err = transposer.rate(entry.transposer)
    if type(rate) == "number" and rate > 0 then
        if entry.rate ~= rate then
            entry.rate = rate
            state.bump()
            persist()
        end
    else
        log.warn(string.format("%s 刷新转运速率失败 %s：%s",
            constants.levelCode(entry.level), util.shortAddress(entry.transposer),
            tostring(err or "速率无效")))
    end
    if task.mode ~= "restore" then queueConfigure(entry, "force") end
    finishCurrent()
end
local function runCurrent(task)
    if task.kind == "rate" then
        stepRate(task)
    elseif task.kind == "candidates" then
        stepCandidates(task)
    elseif task.kind == "configure" then
        advanceConfig(task)
    else
        finishCurrent()
    end
    return false
end
function service.load()
    local active, candidates, problems = produce_store.load()
    local data = produce()
    data.bindings = active
    data.candidates = candidates
    data.online = {}
    data.binding = nil
    for _, problem in ipairs(problems or {}) do log.warn("制作配置读取异常：" .. tostring(problem)) end
    due.scan = 0
    state.bump()
end
function service.requestRefresh()
    refreshRequested = true
    due.scan = 0
end
function service.nextDue(now)
    if current or #queue > 0 or refreshRequested then return now end
    return due.scan
end
function service.step(now)
    if current then return runCurrent(current) end
    if #queue > 0 then
        current = table.remove(queue, 1)
        return runCurrent(current)
    end
    if refreshRequested then
        refreshRequested = false
        componentScan(now, true)
        return false
    end
    if due.scan <= now then
        componentScan(now, false)
        return false
    end
    return false
end
function service.beginBind(level, machine)
    level = tonumber(level)
    if not level or level < 1 or level > constants.LEVEL_COUNT then return false, "等级无效" end
    if not layout.implemented(level) then
        return false, constants.levelCode(level) .. " 制作自动化尚未实现"
    end
    if type(machine) ~= "string" or machine == "" then return false, "机器无效" end
    if produce().binding then return false, "已有正在进行的绑定，请先取消" end
    if not machineExists(level, machine) then
        return false, "机器不在该级注册表（先刷新扫描再试）"
    end
    produce().binding = {
        level = level,
        machine = machine,
        loading = true,
        candidates = {},
    }
    state.bump()
    enqueue({
        kind = "candidates",
        key = "candidates:" .. level .. ":" .. machine,
        level = level,
        machine = machine,
    })
    log.system(string.format("%s 开始选择转运器（机器 %s）",
        constants.levelCode(level), machineLabel(level, machine)))
    return true, nil
end
function service.cancelBind()
    if not produce().binding then return true, nil end
    produce().binding = nil
    if current and (current.mode == "binding" or current.kind == "candidates") then
        current.cancelled = true
    end
    for index = #queue, 1, -1 do
        local task = queue[index]
        if task.mode == "binding" or task.kind == "candidates" then
            if task.key then queued[task.key] = nil end
            table.remove(queue, index)
        end
    end
    state.bump()
    log.system("已取消绑定选择")
    return true, nil
end
function service.selectBindCandidate(machine, address)
    local item = produce().binding
    if not item or item.machine ~= machine then return false, "绑定选择已失效，请重新打开" end
    address = tostring(address or "")
    if address == "" then
        if findAnyByMachine(machine) then
            local ok, err = service.unbind(machine)
            if not ok then return false, err end
        else
            produce().binding = nil
            state.bump()
        end
        return true, nil
    end
    if item.loading then return false, "正在扫描未绑定转运器" end
    local allowed = false
    for _, candidate in ipairs(item.candidates or {}) do
        if candidate == address then allowed = true; break end
    end
    if not allowed then return false, "该转运器已不在待选列表，请重新选择" end
    if bindingAddressBound(address) then return false, "该转运器已被其他机器绑定" end
    item.loading = true
    state.bump()
    if not startBindingRate(item.level, item.machine, address) then
        item.loading = false
        state.bump()
        return false, "绑定时序冲突，请重试"
    end
    return true, nil
end
function service.canEnable(level)
    level = tonumber(level)
    if not level or not layout.implemented(level) then
        return false, constants.levelCode(level or 0) .. " 制作自动化尚未实现"
    end
    local list = machines.of(level)
    if #list == 0 then return false, constants.levelCode(level) .. " 没有已部署机器" end
    local unbound, missing, offline, unconfigured, materialBlocked = 0, 0, 0, 0, 0
    for _, machine in ipairs(list) do
        local entry = findAnyByMachine(machine.address)
        if not entry then
            unbound = unbound + 1
        else
            if entry.miss then missing = missing + 1 end
            if produce().online[entry.transposer] ~= true then offline = offline + 1 end
            if entry.sides == nil or entry.sideFail or entry.slots == nil or entry.slots.ready ~= true then
                unconfigured = unconfigured + 1
            elseif entry.forceOff == true then
                materialBlocked = materialBlocked + 1
            end
        end
    end
    if unbound > 0 then return false, string.format("还有 %d 台机器未绑定转运器", unbound) end
    if missing > 0 then return false, string.format("有 %d 台转运器缺失", missing) end
    if offline > 0 then return false, string.format("有 %d 台转运器离线", offline) end
    if unconfigured > 0 then return false, string.format("有 %d 台机器侧位或槽位尚未就绪", unconfigured) end
    if materialBlocked > 0 then return false, string.format("有 %d 台机器原料不足", materialBlocked) end
    return true, nil
end
function service.canRunBinding(entry)
    if not control.isRunning(state.get()) then return false, "调度未运行" end
    if not entry or findActive(entry.machine) ~= entry then return false, "绑定已失效" end
    local product = state.get().produce.levels[entry.level] or {}
    if product.enabled ~= true then return false, "制作自动化未启用" end
    local levelReady, levelReason = service.canEnable(entry.level)
    if not levelReady then return false, levelReason end
    if produce().online[entry.transposer] ~= true then return false, "转运器离线" end
    if not entry.sides or not entry.slots or entry.slots.ready ~= true then return false, "侧位或槽位未就绪" end
    if entry.forceOff == true then return false, tostring(entry.forceReason or "原料不足") end
    local rate = tonumber(entry.rate)
    if not rate or rate <= 0 then return false, "转运速率未知" end
    return true, nil
end
function service.unbind(machine)
    if type(machine) ~= "string" then return false, "机器无效" end
    local active, candidates = {}, {}
    local removed, removedAddress, removedLevel
    for _, entry in ipairs(produce().bindings or {}) do
        if entry.machine == machine then
            removed, removedAddress, removedLevel = entry, entry.transposer, entry.level
        else
            active[#active + 1] = entry
        end
    end
    for _, entry in ipairs(produce().candidates or {}) do
        if entry.machine == machine then
            removed = removed or entry
            removedAddress = removedAddress or entry.transposer
            removedLevel = removedLevel or entry.level
        else
            candidates[#candidates + 1] = entry
        end
    end
    if not removed then return false, "该机器未绑定" end
    local product = state.get().produce.levels[removedLevel]
    if product and product.enabled == true then
        local ok, err = require("services.config_service").setProduceEnabled(removedLevel, false)
        if not ok then return false, err end
    end
    local ok = produce_store.save(active, candidates)
    if not ok then return false, "写绑定表失败（data/produce.txt）" end
    produce().bindings = active
    produce().candidates = candidates
    produce().online[removedAddress] = nil
    if produce().binding and produce().binding["machine"] == machine then produce().binding = nil end
    if current and current["entry"] and current["entry"]["machine"] == machine then current.cancelled = true end
    state.bump()
    log.system(string.format("%s 已解除绑定 %s（机器 %s）",
        constants.levelCode(removedLevel), util.shortAddress(removedAddress), machineLabel(removedLevel, machine)))
    return true, nil
end
function service.onTransferFailure(machine, failure)
    local entry = findActive(machine)
    if not entry then return false, "该机器未绑定转运器" end
    if failure and failure.code == "ENERGY" then
        log.warn(string.format("%s 转运能量不足，保留侧位（机器 %s）",
            constants.levelCode(entry.level), machineLabel(entry.level, entry.machine)))
        return false, "energy"
    end
    entry.lastFailure = failure
    queueConfigure(entry, "diagnose")
    return true, nil
end
function service.handle(name, action)
    action = action or {}
    if name == "produce_bind_begin" then
        return true, service.beginBind(action.level, action.machine)
    elseif name == "produce_bind_cancel" then
        return true, service.cancelBind()
    elseif name == "produce_bind_select" then
        return true, service.selectBindCandidate(action.machine, action.address)
    elseif name == "produce_unbind" then
        return true, service.unbind(action.machine)
    end
    return false
end
return service

services/produce_store.lua
8104
local constants = require("shared.constants")
local storage = require("services.storage")
local produce_store = {}
local PATH = "data/produce.txt"
local SIDE_MIN, SIDE_MAX = 0, 5
local function validLevel(level)
    return type(level) == "number" and level >= 1 and level <= constants.LEVEL_COUNT
end
local function parseFields(rest)
    local fields = {}
    for token in tostring(rest or ""):gmatch("%S+") do
        local key, value = token:match("^([%w_]+)=(.+)$")
        if key then fields[key] = value end
    end
    return fields
end
local function parseSide(text)
    if text == nil or text == "" or text == "-" then return nil, false end
    local number = tonumber(text)
    if number and number >= SIDE_MIN and number <= SIDE_MAX and number % 1 == 0 then
        return number, false
    end
    return nil, true
end
local function parseSideList(text)
    if text == nil or text == "" or text == "-" then return {}, false end
    local out = {}
    for part in tostring(text):gmatch("[^,]+") do
        local number, bad = parseSide(part)
        if bad then return nil, true end
        if number ~= nil then out[#out + 1] = number end
    end
    table.sort(out)
    return out, false
end
local function parseSides(fields)
    local has = fields.fluid_target or fields.fluid_sources
        or fields.item_target or fields.item_sources
    if not has then return nil, nil end
    local target, bad = parseSide(fields.fluid_target)
    if bad then return nil, "fluid_target 非法" end
    local sources, badSources = parseSideList(fields.fluid_sources)
    if badSources then return nil, "fluid_sources 非法" end
    local itemTarget, badItem = parseSide(fields.item_target)
    if badItem then return nil, "item_target 非法" end
    local itemSources, badItemSources = parseSideList(fields.item_sources)
    if badItemSources then return nil, "item_sources 非法" end
    sources, itemSources = sources or {}, itemSources or {}
    if target == nil and itemTarget == nil and #sources == 0 and #itemSources == 0 then
        return nil, nil
    end
    return {
        target = target,
        sources = sources,
        itemTarget = itemTarget,
        itemSources = itemSources,
    }, nil
end
local function less(a, b)
    if a.level ~= b.level then return a.level < b.level end
    return tostring(a.machine) < tostring(b.machine)
end
function produce_store.load()
    local active, candidates, problems = {}, {}, {}
    local seenMachine, seenTransposer = {}, {}
    for _, line in ipairs(storage.readLines(PATH)) do
        local raw = tostring(line)
        if raw:match("^%s*[^#%s]") then
            local level, machine, address, rest =
                raw:match("^%s*(%d+)%s+(%S+)%s+(%S+)%s*(.*)$")
            level = tonumber(level)
            if not validLevel(level) then
                problems[#problems + 1] = "行格式不对（已跳过）：" .. raw
            elseif seenMachine[machine] then
                problems[#problems + 1] = "机器重复绑定（已跳过）：" .. machine
            elseif seenTransposer[address] then
                problems[#problems + 1] = "转运器重复绑定（已跳过）：" .. address
            else
                local fields = parseFields(rest)
                local status = fields.state or "active"
                if status ~= "active" and status ~= "missing" then
                    problems[#problems + 1] = "绑定状态非法（已跳过）：" .. raw
                else
                    local sides, sideErr = parseSides(fields)
                    if sideErr then
                        problems[#problems + 1] = string.format("%s（已忽略侧位）：%s", sideErr, raw)
                    else
                        seenMachine[machine], seenTransposer[address] = true, true
                        local rate = tonumber(fields.rate)
                        local entry = {
                            level = level,
                            machine = machine,
                            transposer = address,
                            rate = (rate and rate > 0) and rate or nil,
                            sides = sides,
                        }
                        if status == "missing" then
                            local miss = tonumber(fields.miss)
                            entry.miss = (miss and miss >= 1 and miss % 1 == 0) and miss or 1
                            candidates[#candidates + 1] = entry
                        else
                            active[#active + 1] = entry
                        end
                    end
                end
            end
        end
    end
    table.sort(active, less)
    table.sort(candidates, less)
    return active, candidates, problems
end
local function sideText(value)
    local number = tonumber(value)
    if number and number >= SIDE_MIN and number <= SIDE_MAX and number % 1 == 0 then
        return tostring(number)
    end
    return "-"
end
local function listText(list)
    local out = {}
    for _, value in ipairs(list or {}) do
        local number = tonumber(value)
        if number and number >= SIDE_MIN and number <= SIDE_MAX and number % 1 == 0 then
            out[#out + 1] = tostring(number)
        end
    end
    if #out == 0 then return "-" end
    table.sort(out, function(a, b) return tonumber(a) < tonumber(b) end)
    return table.concat(out, ",")
end
local function appendRate(parts, entry)
    local rate = tonumber(entry.rate)
    if rate and rate > 0 then parts[#parts + 1] = "rate=" .. tostring(rate) end
end
local function appendSides(parts, entry)
    local sides = entry.sides
    if type(sides) ~= "table" then return end
    if sides.target == nil and sides.itemTarget == nil
        and #(sides.sources or {}) == 0 and #(sides.itemSources or {}) == 0 then
        return
    end
    parts[#parts + 1] = "fluid_target=" .. sideText(sides.target)
    parts[#parts + 1] = "fluid_sources=" .. listText(sides.sources)
    parts[#parts + 1] = "item_target=" .. sideText(sides.itemTarget)
    parts[#parts + 1] = "item_sources=" .. listText(sides.itemSources)
end
local function buildLines(active, candidates)
    local lines = {
        "# 制作自动化绑定表（程序写入；一行一台机器：级 机器地址 转运器地址）",
        "# missing：字段 state=missing miss=N；连续 3 次组件扫描找不到后删除",
        "# 转运器速率：rate=L/s；可选侧位：fluid_target=... fluid_sources=... item_target=... item_sources=...",
    }
    for _, entry in ipairs(active or {}) do
        local parts = { string.format("%d %s %s", entry.level, entry.machine, entry.transposer) }
        appendRate(parts, entry)
        appendSides(parts, entry)
        lines[#lines + 1] = table.concat(parts, " ")
    end
    if candidates and #candidates > 0 then
        lines[#lines + 1] = ""
        lines[#lines + 1] = "# --- missing（重新扫到会自动恢复） ---"
        for _, entry in ipairs(candidates) do
            local miss = math.max(1, math.floor(tonumber(entry.miss) or 1))
            local parts = {
                string.format("%d %s %s state=missing miss=%d",
                    entry.level, entry.machine, entry.transposer, miss),
            }
            appendRate(parts, entry)
            appendSides(parts, entry)
            lines[#lines + 1] = table.concat(parts, " ")
        end
    end
    return lines
end
function produce_store.save(active, candidates)
    local lines = buildLines(active, candidates)
    local current = storage.readLines(PATH)
    local nonempty = {}
    for _, line in ipairs(current) do
        if line ~= "" then nonempty[#nonempty + 1] = line end
    end
    local expected = {}
    for _, line in ipairs(lines) do
        if line ~= "" then expected[#expected + 1] = line end
    end
    if table.concat(nonempty, "\n") == table.concat(expected, "\n") then
        return true, false
    end
    local ok, err = storage.replace(PATH, lines)
    if not ok then return false, err end
    return true, true
end
function produce_store.path()
    return PATH
end
return produce_store

services/read_model.lua
10316
local constants = require("shared.constants")
local log = require("services.log")
local state = require("services.state")
local facts = require("services.facts")
local machines = require("hardware.machines")
local layout = require("business.produce.layout")
local util = require("shared.util")
local plan_model = require("business.plan")
local learning_service = require("services.learning_service")
local history_service = require("services.history_service")
local read_model = {}
local function factValue(slot)
    return slot and slot.value or nil
end
local function bindingFor(data, machine)
    for _, entry in ipairs(data.produce.bindings or {}) do
        if entry.machine == machine then return entry end
    end
    for _, entry in ipairs(data.produce.candidates or {}) do
        if entry.machine == machine then return entry end
    end
end
local function sideStateOf(entry)
    if not entry then return "未绑定" end
    if entry.miss then return string.format("转运器缺失 %d/%d", entry.miss, constants.PRODUCE_MISSING_SCANS or 3) end
    if entry.sideFail then return "失败·" .. tostring(entry.sideFail) end
    if entry.forceOff == true then return tostring(entry.forceReason or "原料不足") end
    if entry.sides and entry.slots and entry.slots.ready == true then return "配置就绪" end
    if entry.sides then return "槽位未就绪" end
    return "自动配置中"
end
local function machineView(data, address, name, present, x, y, z)
    local entry = bindingFor(data, address)
    local online
    if entry then online = data.produce.online[entry.transposer] end
    local sideState = sideStateOf(entry)
    local text
    if type(x) == "number" and type(y) == "number" and type(z) == "number" then
        text = string.format("(%d,%d,%d)", x, y, z)
    else
        text = "无坐标(" .. util.shortAddress(address) .. ")"
    end
    return {
        address = address,
        name = name,
        x = x,
        y = y,
        z = z,
        text = text,
        bound = entry ~= nil,
        transposer = entry and entry.transposer or nil,
        transposerOnline = online,
        configured = entry and entry.sides ~= nil and entry.sideFail == nil
            and entry.slots ~= nil and entry.slots.ready == true or false,
        sideState = sideState,
        online = present == true,
    }
end
local function buildProduceLevels(data)
    local out = {}
    for level = 1, constants.LEVEL_COUNT do
        local stored = data.produce.levels[level] or {}
        local product = {}
        for key, value in pairs(stored) do product[key] = value end
        product.enabled = stored.enabled == true
        product.implemented = layout.implemented(level)
        local list, seen = {}, {}
        for _, machine in ipairs(machines.of(level)) do
            seen[machine.address] = true
            list[#list + 1] = machineView(data, machine.address, machine.name, machine.present, machine.x, machine.y, machine.z)
        end
        for _, entry in ipairs(data.produce.bindings or {}) do
            if entry.level == level and not seen[entry.machine] then
                seen[entry.machine] = true
                list[#list + 1] = machineView(data, entry.machine, entry.machine, false)
            end
        end
        for _, entry in ipairs(data.produce.candidates or {}) do
            if entry.level == level and not seen[entry.machine] then
                seen[entry.machine] = true
                list[#list + 1] = machineView(data, entry.machine, entry.machine, false)
            end
        end
        local bound, configured, online = 0, 0, 0
        for _, machine in ipairs(list) do
            if machine.bound then bound = bound + 1 end
            if machine.configured then configured = configured + 1 end
            if machine.transposerOnline == true then online = online + 1 end
        end
        local unbound = #list - bound
        local unavailable = bound - online
        local unconfigured = #list - configured
        local reason
        if #list == 0 then
            reason = "无机器"
        elseif unbound > 0 then
            reason = string.format("还有 %d 台未绑定", unbound)
        elseif unavailable > 0 then
            reason = string.format("有 %d 台转运器未就绪", unavailable)
        elseif unconfigured > 0 then
            reason = string.format("有 %d 台侧位未就绪", unconfigured)
        end
        product.machines = list
        product.count = #list
        product.bound = bound
        product.unbound = unbound
        product.configured = #list > 0 and configured == #list
        product.online = #list > 0 and online == #list
        product.ready = product.implemented and #list > 0
            and unbound == 0 and unavailable == 0 and unconfigured == 0
        product.reason = reason
        if not product.enabled then
            product.state = "未启用"
        elseif product.ready then
            product.state = "已就绪"
        else
            product.state = "未就绪"
        end
        out[level] = product
    end
    return out
end
function read_model.revision()
    return tostring(state.revision()) .. ":" .. tostring(log.revision())
end
function read_model.snapshot()
    local data = state.get()
    local hardware = factValue(data.facts.hardware)
    local water = factValue(data.facts.water)
    local produceLevels = buildProduceLevels(data)
    local levels = {}
    for level = 1, constants.LEVEL_COUNT do
        local machine = data.facts.levels[level] or {}
        local userThreshold = tonumber(data.settings.thresholds[level]) or 0
        local enabled = data.settings.enabledLevels[level]
        local lines = plan_model.lines(data, level)
        local learned = data.plan.learned[level]
        local machineFacts = {}
        for _, registered in ipairs(machines.of(level)) do
            local fact = data.facts.machines[registered.address] or {}
            machineFacts[#machineFacts + 1] = {
                address = registered.address,
                active = fact.active == true,
                current = fact.parallel,
                success = fact.success,
                confirmed = learning_service.confirmed(registered.address),
            }
        end
        levels[level] = {
            level = level,
            deployed = machine.deployed or 0,
            active = machine.active,
            water = water and water[level] or nil,
            switch = machine.switch,
            sample = machine.parallel,
            learned = learned and learned.parallel or nil,
            suggest = math.floor(tonumber(data.plan.suggest[level]) or 0),
            success = machine.success,
            machines = machineFacts,
            rule = {
                threshold = userThreshold,
                effectiveThreshold = lines.actual,
                userThreshold = lines.user,
                next = lines.next,
                overridden = lines.overridden,
                enabled = enabled ~= false,
            },
        }
    end
    local entries = log.entries()
    return {
        version = constants.CODE_VERSION,
        revision = read_model.revision(),
        system = {
            running = data.control.session == "running",
            awaiting = data.control.awaiting == true,
            awaitingReason = data.control.awaitingReason,
            priority = data.settings.priority,
            mode = data.settings.mode,
            enforceThreshold = data.settings.enforceThreshold,
            theme = data.settings.theme,
            t7Boost = data.settings.t7Boost,
            reflux = data.settings.reflux,
            t6DualLithium = data.settings.t6DualLithium,
            energyFactor = data.settings.energyFactor,
            autostart = data.settings.autostart,
            autostartStale = data.settings.autostartStale,
            autostartPath = data.settings.autostartPath,
            effectiveConfig = {
                enabled = true,
                threshold = true,
                weight = true,
                boost = true,
            },
        },
        hardware = {
            observed = hardware ~= nil,
            count = (data.facts.hardware.summary and ((data.facts.hardware.summary.host or 0) + (data.facts.hardware.summary.unitTotal or 0))) or (hardware and #hardware or 0),
            age = facts.age(data.facts.hardware),
            me = data.facts.hardware.me == true,
            missing = data.facts.hardware.missing or {},
        },
        water = {
            observed = water ~= nil,
            levels = water,
            age = facts.age(data.facts.water),
        },
        host = {
            switch = data.facts.host.switch.value,
            active = data.facts.host.active.value,
            progress = data.facts.host.progress.value,
            progressMax = data.facts.host.progressMax.value,
            cycleSeq = data.facts.host.cycle.seq,
        },
        power = {
            all = data.power.available,
            max = data.power.max,
            used = data.power.used,
            budget = data.plan.budget,
        },
        levels = levels,
        settings = {
            weights = data.settings.weights,
            thresholds = data.settings.thresholds,
            enabledLevels = data.settings.enabledLevels,
            reflux = data.settings.reflux,
            t6DualLithium = data.settings.t6DualLithium,
            t7Boost = data.settings.t7Boost,
            energyFactor = data.settings.energyFactor,
            autostart = data.settings.autostart,
            autostartStale = data.settings.autostartStale,
            autostartPath = data.settings.autostartPath,
        },
        history = history_service.view(),
        net = {
            enabled = data.net.enabled == true,
            available = data.net.available == true,
            strength = data.net.strength or 0,
        },
        produce = {
            levels = produceLevels,
            binding = data.produce.binding,
            bindings = data.produce.bindings or {},
            candidates = data.produce.candidates or {},
            online = data.produce.online or {},
        },
        logs = {
            revision = log.revision(),
            entries = entries,
        },
    }
end
return read_model

services/schedule_service.lua
12425
local constants = require("shared.constants")
local state = require("services.state")
local log = require("services.log")
local device = require("hardware.device")
local machines = require("hardware.machines")
local control = require("services.control")
local learning = require("services.learning_service")
local suggest = require("business.suggest")
local plan = require("business.plan")
local apply = require("business.apply")
local produce_service = require("services.produce_service")
local service = {}
local seenRevision = -1
local suggestionKey = nil
local suggestionPublished = false
local planKey = nil
local forcePlan = false
local retryAt = 0
local lastApplyAt = 0
local activeTopology = nil
local pendingCommands = nil
local pendingLevels = nil
local pendingShutdown = false
local pendingReason = nil
local function data()
    return state.get()
end
local function machinesByLevel()
    local out = {}
    for level = 1, constants.LEVEL_COUNT do out[level] = machines.of(level) end
    return out
end
local function topologyKey()
    local parts = {}
    for level = 1, constants.LEVEL_COUNT do
        local addresses = {}
        for _, machine in ipairs(machines.of(level)) do addresses[#addresses + 1] = machine.address end
        table.sort(addresses)
        parts[#parts + 1] = tostring(level) .. ":" .. table.concat(addresses, ",")
    end
    return table.concat(parts, "|")
end
local function produceReadiness()
    local ready = {}
    local levels = data().produce.levels or {}
    for level = 1, constants.LEVEL_COUNT do
        local product = levels[level] or {}
        if product.enabled == true then
            ready[level] = produce_service.canEnable(level)
        else
            ready[level] = false
        end
    end
    return ready
end
local function publishSuggestionIfChanged(force)
    local snapshot = data()
    local key = suggest.inputKey(snapshot)
    if not force and suggestionKey == key then return false end
    suggestionKey = key
    local result = suggest.compute(snapshot)
    local firstPublish = not suggestionPublished
    suggestionPublished = true
    if suggest.equals(snapshot.plan.suggest, result.values) then return false end
    local changes = {}
    for level = 1, constants.LEVEL_COUNT do
        local before = tonumber((snapshot.plan.suggest or {})[level]) or 0
        local after = tonumber(result.values[level]) or 0
        if before ~= after then
            changes[#changes + 1] = string.format("%s %d→%d",
                constants.levelCode(level), before, after)
        end
    end
    snapshot.plan.suggest = suggest.copy(result.values)
    state.bump()
    if not firstPublish and #changes > 0 then
        log.warn("建议并行变动：" .. table.concat(changes, "，"))
    end
    return true
end
local function clearPlan()
    local snapshot = data()
    snapshot.plan.levels = {}
    snapshot.plan.budget = 0
    snapshot.plan.used = 0
    snapshot.power.used = 0
    planKey = nil
    forcePlan = false
end
local function queueShutdown(reason, awaiting)
    local snapshot = data()
    if awaiting then control.awaitUser(snapshot, reason) else control.stop(snapshot, reason) end
    learning.resetAll()
    clearPlan()
    pendingShutdown = true
    retryAt = 0
    pendingReason = tostring(reason or "停机")
    pendingCommands = apply.shutdown(machinesByLevel())
    pendingLevels = {}
    for level = 1, constants.LEVEL_COUNT do pendingLevels[#pendingLevels + 1] = level end
    activeTopology = nil
    state.bump()
    if awaiting then
        log.warn("调度已暂停：等待用户处理（" .. tostring(pendingReason) .. "）")
    else
        log.system(string.format("系统停机：%s", tostring(pendingReason)))
    end
end
local function awaitWithoutShutdown(reason)
    local snapshot = data()
    control.awaitUser(snapshot, reason)
    learning.resetAll()
    clearPlan()
    pendingCommands = nil
    pendingLevels = nil
    pendingShutdown = false
    retryAt = 0
    activeTopology = nil
    state.bump()
    log.warn("调度已暂停：等待用户处理（" .. tostring(reason) .. "）")
end
local function hardStop(reason)
    queueShutdown(reason, false)
end
local function checkHardConditions()
    local snapshot = data()
    if not control.isRunning(snapshot) then return false end
    local hardware = snapshot.facts.hardware or {}
    if hardware.value == nil then
        hardStop("硬件事实失效")
        return true
    end
    if #(hardware.missing or {}) > 0 then
        hardStop("硬件缺失：" .. table.concat(hardware.missing or {}, "、"))
        return true
    end
    if (snapshot.facts.water or {}).value == nil then
        hardStop("水位事实失效")
        return true
    end
    if snapshot.facts.host.switch.value == false then
        hardStop("主机已关机")
        return true
    end
    if activeTopology ~= nil and activeTopology ~= topologyKey() then
        queueShutdown("硬件台账变化", true)
        return true
    end
    return false
end
local function finishPending()
    pendingCommands = nil
    pendingLevels = nil
    pendingShutdown = false
    pendingReason = nil
    retryAt = 0
end
local function executePending(now)
    if pendingCommands == nil then return false end
    local failed, failedLevels = {}, {}
    for _, command in ipairs(pendingCommands) do
        local _, err = device.invoke(command.address, "setWorkAllowed", command.want == true)
        if err then
            failed[#failed + 1] = command
            failedLevels[command.level] = tostring(err)
        end
    end
    if #failed > 0 then
        pendingCommands = failed
        local names = {}
        for level, err in pairs(failedLevels) do names[#names + 1] = constants.levelCode(level) .. ":" .. err end
        table.sort(names)
        log.warn("开关下发失败，稍后重试：" .. table.concat(names, " / "))
        retryAt = now + 1
        return true
    end
    local appliedCount = 0
    for _, level in ipairs(pendingLevels or {}) do
        for _ in ipairs(machines.of(level)) do appliedCount = appliedCount + 1 end
    end
    if #(pendingCommands or {}) == 0 then appliedCount = 0 end
    lastApplyAt = now
    if pendingShutdown then
        log.system(string.format("系统停机：%s（全关完成）", tostring(pendingReason or "-")))
    elseif #(pendingLevels or {}) > 0 then
        log.system(string.format("开关下发完成：%d 台｜%s", appliedCount,
            plan.describe(data().plan.levels)))
    end
    finishPending()
    return true
end
local function checkSwitchDrift()
    if not control.isRunning(data()) then return false end
    if lastApplyAt <= 0 or pendingCommands ~= nil then return false end
    for level = 1, constants.LEVEL_COUNT do
        local levelFact = data().facts.levels[level] or {}
        local observedAt = tonumber(levelFact.switchObservedAt)
        local got = levelFact.switch
        if observedAt and observedAt > lastApplyAt and type(got) == "boolean" then
            local want = data().plan.levels[level] == true
            if got ~= want then
                awaitWithoutShutdown(string.format("%s 开关被人工改动（实测%s，计划%s）",
                    constants.levelCode(level), got and "开" or "关", want and "开" or "关"))
                return true
            end
        end
    end
    return false
end
function service.load()
    seenRevision = -1
    suggestionKey = nil
    suggestionPublished = false
    planKey = nil
    forcePlan = false
    retryAt = 0
    lastApplyAt = 0
    activeTopology = nil
    pendingCommands = nil
    pendingLevels = nil
    pendingShutdown = false
    pendingReason = nil
    learning.resetAll()
end
function service.nextDue(now)
    if pendingCommands ~= nil then
        if retryAt > now then return retryAt end
        return now
    end
    if forcePlan or state.revision() ~= seenRevision then return now end
    return math.huge
end
function service.step(now)
    seenRevision = state.revision()
    if pendingCommands ~= nil and pendingShutdown then return executePending(now) end
    if checkHardConditions() then return true end
    if pendingCommands ~= nil then return executePending(now) end
    local snapshot = data()
    local suggestionChanged = publishSuggestionIfChanged(false)
    if suggestionChanged and control.isRunning(snapshot) then
        local baseline = snapshot.control.suggestBaseline
        if baseline and not suggest.equals(baseline, snapshot.plan.suggest) then
            queueShutdown("建议并行已变化", true)
            return true
        end
        planKey = nil
        forcePlan = true
    end
    if not control.isRunning(snapshot) then return suggestionChanged end
    local ready = produceReadiness()
    local key = plan.inputKey(snapshot, ready)
    if forcePlan or planKey ~= key then
        local forced = forcePlan
        local before = plan.copyLevels(snapshot.plan.levels)
        local result = plan.compute(snapshot, ready)
        local changed = forced or not plan.sameLevels(before, result.levels)
        local numbersChanged = snapshot.plan.budget ~= result.remaining
            or snapshot.plan.used ~= result.used
            or snapshot.power.used ~= result.used
        if changed or numbersChanged then
            snapshot.plan.levels = plan.copyLevels(result.levels)
            snapshot.plan.budget = result.remaining
            snapshot.plan.used = result.used
            snapshot.power.used = result.used
            state.bump()
        end
        planKey = key
        forcePlan = false
        if changed then
            local commands, levels = apply.commands(before, snapshot.plan.levels,
                machinesByLevel(), forced)
            pendingCommands = commands
            pendingLevels = levels
            pendingShutdown = false
            log.system(string.format("调度计划更新：%s｜功率 %s / %s",
                plan.describe(snapshot.plan.levels), tostring(result.used), tostring(result.budget)))
        end
        return true
    end
    return checkSwitchDrift()
end
function service.start(reason)
    local snapshot = data()
    if pendingShutdown then
        pendingCommands = nil
        pendingLevels = nil
        pendingShutdown = false
        pendingReason = nil
        retryAt = 0
        log.warn("用户启动：已取消未完成的停机下发")
    end
    if control.isRunning(snapshot) then return true, nil end
    local ok, err = control.canStart(snapshot)
    if not ok then return false, err end
    publishSuggestionIfChanged(false)
    control.start(snapshot, reason or "手动")
    learning.resetAll()
    activeTopology = topologyKey()
    clearPlan()
    lastApplyAt = 0
    forcePlan = true
    pendingCommands = nil
    pendingLevels = nil
    pendingShutdown = false
    retryAt = 0
    state.bump()
    log.system("系统启动：" .. tostring(reason or "手动"))
    return true, nil
end
function service.shutdownNow(reason)
    local snapshot = data()
    control.stop(snapshot, reason or "程序退出")
    learning.resetAll()
    clearPlan()
    pendingCommands = nil
    pendingLevels = nil
    pendingShutdown = false
    pendingReason = nil
    retryAt = 0
    lastApplyAt = 0
    activeTopology = nil
    local commands = apply.shutdown(machinesByLevel())
    local failed = {}
    for _, command in ipairs(commands) do
        local _, err = device.invoke(command.address, "setWorkAllowed", false)
        if err then
            failed[#failed + 1] = constants.levelCode(command.level) .. ":"
                .. tostring(err)
        end
    end
    state.bump()
    if #failed > 0 then
        log.warn(string.format("退出全关下发失败 %d/%d：%s", #failed, #commands,
            table.concat(failed, " / ")))
        return false, table.concat(failed, " / ")
    end
    log.system(string.format("全关下发完成：%d 台", #commands))
    return true, nil
end
function service.stop(reason)
    if not control.isRunning(data()) then return true, nil end
    queueShutdown(reason or "手动", false)
    return true, nil
end
function service.handle(name, action)
    if name ~= "system_toggle" then return false end
    local reason = tostring((action and action.reason) or "手动")
    if control.isRunning(data()) then
        return true, service.stop(reason)
    end
    return true, service.start(reason)
end
return service

services/settings_store.lua
1165
local storage = require("services.storage")
local settings = {}
local PATH = "data/settings.txt"
local function path()
    return PATH
end
function settings.exists()
    return storage.exists(PATH)
end
function settings.load()
    if not storage.exists(PATH) then return nil end
    local out = {}
    for _, line in ipairs(storage.readLines(PATH)) do
        local key, value = tostring(line):match("^%s*([%w_%.]+)%s*=%s*(.-)%s*$")
        if key and value ~= "" then out[key] = value end
    end
    return out
end
function settings.setMany(values)
    local all = settings.load() or {}
    for key, value in pairs(values or {}) do
        all[tostring(key)] = tostring(value)
    end
    local keys = {}
    for key in pairs(all) do keys[#keys + 1] = key end
    table.sort(keys)
    local lines = { "# 程序配置（可手改；重启后生效）" }
    for _, key in ipairs(keys) do
        lines[#lines + 1] = string.format("%s=%s", key, all[key])
    end
    return storage.replace(PATH, lines)
end
function settings.set(key, value)
    return settings.setMany({ [tostring(key)] = value })
end
function settings.path()
    return path()
end
return settings

