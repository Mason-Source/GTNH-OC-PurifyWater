local constants = require("shared.constants")
local utils     = require("shared.utils")
local device    = require("backend.hardware.device")
local fluid     = {}
local function amountOf(item)
    if type(item) ~= "table" then return 0 end
    return math.max(0, tonumber(item.size or item.amount or 0) or 0)
end
function fluid.readAll()
    local address = device.me()
    if not address then return {}, false, "未连接 ME 网络接口" end
    local list, listErr = device.invoke(address, "getFluidsInNetwork")
    if type(list) ~= "table" then
        return {}, false, "ME 接口读取失败：" .. tostring(listErr or "返回值不是列表")
    end
    local byName = {}
    for _, item in ipairs(list) do
        if type(item) == "table" and item.name then
            byName[utils.normalizeFluidName(item.name)] = amountOf(item)
        end
    end
    local out = {}
    for level = 1, constants.LEVEL_COUNT do
        out[level] = byName[utils.normalizeFluidName(constants.FLUID_NAMES[level])] or 0
    end
    return out, true, nil
end
return fluid

backend/hardware/gt_infodata.lua
8109
local gtInfodata = {}
local LENS_REQUEST_LABELS = {
    "lens_requested", "lens requested", "current required lens", "required lens",
    "current lens", "当前透镜", "所需透镜", "请求透镜", "需要的透镜"
}
local FIELDS = {
    {
        name    = "parallel",
        keys    = { "parallel.current", "parallel" },
        labels  = { "当前并行", "并行数", "当前并联", "current parallel", "并行", "parallel" },
        exclude = { "机器", "数量", "machine", "count" }
    },
    {
        name   = "success",
        keys   = { "success_chance", "success" },
        labels = { "成功几率", "成功率", "成功概率", "success chance", "success rate",
            "成功", "success", "chance" }
    }
}
function gtInfodata.stripColors(line)
    return (tostring(line):gsub("§.", ""))
end
function gtInfodata.stripIndex(line)
    return (tostring(line):gsub("^%s*%d+%s*[=:：%)%.]%s*", "", 1))
end
function gtInfodata.splitLine(line)
    local clean = gtInfodata.stripIndex(gtInfodata.stripColors(line))
    local key, rest = clean:match("^([%w%._]+)\\+(.*)$")
    if key then
        rest = rest:gsub("\\+", " / ")
        return key, (rest:gsub("^%s+", ""):gsub("%s+$", ""))
    end
    if clean:match("^[%w%._]+$") then
        return clean, ""
    end
    return nil, clean
end
function gtInfodata.firstNumber(text)
    if type(text) ~= "string" then return nil end
    local cleaned = text:gsub("(%d),(%d)", "%1%2")
    local numStr = cleaned:match("([%-%+]?%d+%.?%d*[eE]?[%-%+]?%d*)")
    if not numStr then return nil end
    local num = tonumber(numStr)
    if num == nil then return nil end
    return num
end
function gtInfodata.coloredNumber(text, fromPos)
    if type(text) ~= "string" then return nil end
    local i = fromPos or 1
    while true do
        local pos = text:find("§", i, true)
        if not pos then return nil end
        local seg = text:sub(pos + 3)
        local stop = seg:find("§", 1, true)
        if stop then seg = seg:sub(1, stop - 1) end
        local num = gtInfodata.firstNumber(seg)
        if num ~= nil then return num end
        i = pos + 3
    end
end
local function matchLabel(lowerLine, labels)
    for _, label in ipairs(labels or {}) do
        local needle = label:lower()
        local pos = lowerLine:find(needle, 1, true)
        if pos then return pos, #needle end
    end
    return nil, nil
end
local function excluded(lowerLine, field)
    for _, token in ipairs(field.exclude or {}) do
        if lowerLine:find(token:lower(), 1, true) then return true end
    end
    return false
end
local function findField(raw, plain, key)
    if key then
        local lowerKey = key:lower()
        for _, field in ipairs(FIELDS) do
            for _, k in ipairs(field.keys) do
                if lowerKey:find(k:lower(), 1, true) then
                    local kpos = raw:find(key, 1, true)
                    return field, (kpos and (kpos + #key) or 1)
                end
            end
        end
        return nil, nil
    end
    local lowerRaw = raw:lower()
    local lowerPlain = plain:lower()
    for _, field in ipairs(FIELDS) do
        local pos, len = matchLabel(lowerRaw, field.labels)
        if pos and not excluded(lowerPlain, field) then
            return field, (pos + len)
        end
    end
    return nil, nil
end
local function valueAt(raw, from)
    local num = gtInfodata.coloredNumber(raw, from)
    if num ~= nil then return num end
    if raw:find("§", 1, true) then return nil end
    return gtInfodata.firstNumber(raw:sub(from))
end
local function toLines(lines)
    if lines == nil then return {} end
    if type(lines) == "string" then
        local out = {}
        for line in tostring(lines):gmatch("[^\n]+") do out[#out + 1] = line end
        return out
    end
    if type(lines) ~= "table" then return {} end
    return lines
end
local function labelEnd(raw, labels)
    local lower = tostring(raw):lower()
    for _, label in ipairs(labels or {}) do
        local pos = lower:find(label:lower(), 1, true)
        if pos then return pos + #label end
    end
    return nil
end
local PH_LABELS = {
    "current ph value", "current ph", "ph value", "ph 值", "当前 ph", "当前ph", "酸碱度"
}
local TEMP_LABELS = {
    "current temperature", "temperature", "当前温度", "温度"
}
local SIGNAL_LABELS = {
    "current control signal", "control signal", "control_signal", "控制信号"
}
function gtInfodata.ph(lines)
    for _, raw in ipairs(toLines(lines)) do
        local plain = gtInfodata.stripColors(raw)
        local from = labelEnd(raw, PH_LABELS)
        if from then
            local value = valueAt(raw, from)
            if value ~= nil then return value end
        end
        local key = gtInfodata.splitLine(plain)
        if key and key:lower():find("ph", 1, true) then
            local kpos = raw:find(key, 1, true) or 1
            local value = valueAt(raw, kpos + #key)
            if value ~= nil then return value end
        end
        local value = gtInfodata.firstNumber(plain:match("([%-%d%.]+)%s*[pP][hH]"))
        if value ~= nil then return value end
    end
    return nil
end
function gtInfodata.temperature(lines)
    for _, raw in ipairs(toLines(lines)) do
        local plain = gtInfodata.stripColors(raw)
        local from = labelEnd(raw, TEMP_LABELS)
        if from then
            local value = valueAt(raw, from)
            if value ~= nil then return value end
        end
        local key = gtInfodata.splitLine(plain)
        if key and key:lower():find("temperature", 1, true) then
            local kpos = raw:find(key, 1, true) or 1
            local value = valueAt(raw, kpos + #key)
            if value ~= nil then return value end
        end
        local value = gtInfodata.firstNumber(plain:match("([%-%d%.]+)%s*[kK]"))
        if value ~= nil then return value end
    end
    return nil
end
function gtInfodata.lensRequest(lines)
    for _, raw in ipairs(toLines(lines)) do
        local plain = gtInfodata.stripIndex(gtInfodata.stripColors(raw))
        local lower = plain:lower()
        for _, label in ipairs(LENS_REQUEST_LABELS) do
            if lower:find(label, 1, true) then
                plain = plain:gsub("%s+", " ")
                return (plain:gsub("^%s+", ""):gsub("%s+$", ""))
            end
        end
    end
    return nil
end
function gtInfodata.controlSignal(lines)
    for _, raw in ipairs(toLines(lines)) do
        local plain = gtInfodata.stripColors(raw)
        local bits = plain:match("0[bB]([01]+)")
        if not bits and labelEnd(raw, SIGNAL_LABELS) then
            bits = plain:match("([01]+)%s*$")
        end
        if bits then return tonumber(bits, 2) end
    end
    return nil
end
local function put(info, name, value)
    info[name] = value
end
function gtInfodata.parse(lines)
    local info = {
        parallel = nil,
        success = nil
    }
    if lines == nil then return info end
    local list = toLines(lines)
    for _, raw in ipairs(list) do
        local plain = gtInfodata.stripColors(raw)
        local key = gtInfodata.splitLine(plain)
        local field, from = findField(raw, plain, key)
        if field then
            local num = valueAt(raw, from)
            if num ~= nil then put(info, field.name, num) end
        end
    end
    return info
end
gtInfodata.common = gtInfodata.parse
function gtInfodata.parallel(lines)
    return gtInfodata.common(lines).parallel
end
function gtInfodata.success(lines)
    return gtInfodata.common(lines).success
end
local FIELD_PARSERS = {
    parallel      = gtInfodata.parallel,
    success       = gtInfodata.success,
    ph            = gtInfodata.ph,
    temperature   = gtInfodata.temperature,
    controlSignal = gtInfodata.controlSignal,
    lensRequest   = gtInfodata.lensRequest
}
function gtInfodata.extract(lines, field)
    if field == nil or field == "common" then return gtInfodata.common(lines) end
    local parser = FIELD_PARSERS[field]
    if not parser then return nil, "unknown sensor field: " .. tostring(field) end
    return parser(lines)
end
return gtInfodata

backend/hardware/machines.lua
2734
local constants       = require("shared.constants")
local device          = require("backend.hardware.device")
local machines        = {}
local reg             = {}
local energyItem      = nil
local otherReg        = {}
local metaCache       = {}
local ENERGY_PATTERNS = {
    "hatch.energytunnel", "hatch.energywirelesstunnel",
    "hatch.energymulti", "hatch.energywirelessmulti",
    "wirelessenergyhatch"
}
local function isEnergy(name)
    for _, pattern in ipairs(ENERGY_PATTERNS) do
        if name:find(pattern, 1, true) then return true end
    end
    return false
end
for level = 0, constants.LEVEL_COUNT do reg[level] = {} end
function machines.classify()
    for level = 0, constants.LEVEL_COUNT do reg[level] = {} end
    energyItem, otherReg = nil, {}
    for _, address in ipairs(device.machines()) do
        local meta = metaCache[address]
        if not meta then
            local name = device.name(address)
            if name then
                local x, y, z = device.coordinates(address)
                meta = { name = name, x = x, y = y, z = z }
                metaCache[address] = meta
            end
        end
        if meta then
            local item = { address = address, name = meta.name, x = meta.x, y = meta.y, z = meta.z }
            local level = constants.MACHINE_NAMES[meta.name]
            if level then
                reg[level][#reg[level] + 1] = item
            elseif isEnergy(meta.name) then
                if energyItem then
                    otherReg[#otherReg + 1] = item
                else
                    energyItem = item
                end
            else
                otherReg[#otherReg + 1] = item
            end
        end
    end
    return machines.summary()
end
function machines.summary()
    local units, unitTotal = {}, 0
    for level = 1, constants.LEVEL_COUNT do
        units[level] = #reg[level]
        unitTotal = unitTotal + units[level]
    end
    return {
        host = #reg[0],
        unitTotal = unitTotal,
        units = units,
        energy = energyItem ~= nil,
        other = #otherReg
    }
end
function machines.of(level)
    return reg[level] or {}
end
function machines.energy()
    return energyItem
end
function machines.topology()
    local out = {}
    for level = 0, constants.LEVEL_COUNT do
        for _, m in ipairs(reg[level]) do
            out[#out + 1] = { level = level, address = m.address, name = m.name }
        end
    end
    if energyItem then
        out[#out + 1] = { level = "E", address = energyItem.address, name = energyItem.name }
    end
    for _, m in ipairs(otherReg) do
        out[#out + 1] = { level = "?", address = m.address, name = m.name }
    end
    return out
end
return machines

backend/hardware/net.lua
4294
local CONFIG    = require("shared.config")
local logs      = require("shared.logs")
local models    = require("shared.models")
local state     = require("shared.state")
local scheduler = require("core.scheduler")
local device    = require("backend.hardware.device")
local net       = {}
local source    = nil
local TASK      = "broadcast"
function net.setSource(fn)
    source = fn
end
function net.available()
    return device.net() ~= nil
end
function net.status()
    local st = state.read.net()
    return {
        available = net.available(),
        enabled = st.enabled == true,
        strength = state.read.netStrength()
    }
end
function net.setEnabled(on)
    local before      = state.read.net().enabled == true
    state.write.netSetEnabled(on == true)
    scheduler.setEnabled(TASK, state.read.net().enabled)
    local text = state.read.net().enabled
        and (net.available() and "无线广播：已开启" or "无线广播：已开启（网卡不在位，不发送）")
        or "无线广播：已关闭"
    if state.read.net().enabled ~= before then logs.system(text) end
    return text
end
function net.sendText(text)
    local address = device.net()
    if not address then return false, "无网卡/隧道组件" end
    local port      = CONFIG.NET.PORT
    local chunkSize = math.max(256, CONFIG.NET.CHUNK or 4000)
    local total     = math.max(1, math.ceil(#text / chunkSize))
    local frame     = (state.read.net().frame or 0) + 1
    state.write.netSetFrame(frame)
    for i = 1, total do
        local part      = text:sub((i - 1) * chunkSize + 1, i * chunkSize)
        local message   = table.concat({ "v3", frame, i, total, part }, "|")
        local sent, err, reason = device.invoke(address, "broadcast", port, message)
        if err then return false, "发送失败：" .. tostring(err) end
        if sent == false or (sent == nil and reason) then
            return false, "发送被拒：" .. tostring(reason or "端口/距离")
        end
    end
    return true, string.format("已广播 %d 片 / %d 字节", total, #text)
end
local strengthFor, strengthSent = nil, nil
local function pushStrength(address, value)
    if not address then return nil, "无卡" end
    if device.invoke(address, "isWireless") ~= true then return nil, "有线卡" end
    local applied, err = device.invoke(address, "setStrength", value)
    if err then return nil, tostring(err) end
    strengthFor, strengthSent = address, value
    return tonumber(applied) or value
end
local function syncStrength()
    local address = device.net()
    if not address then strengthFor, strengthSent = nil, nil return end
    local value = state.read.netStrength()
    if strengthFor == address and strengthSent == value then return end
    local applied, why = pushStrength(address, value)
    if not applied then
        strengthFor, strengthSent = address, value
        if why ~= "有线卡" then logs.warn("设置无线范围失败：" .. tostring(why)) end
        return
    end
    if applied ~= value then
        logs.system(string.format("无线范围 %d 超出卡上限，已按 %d 生效", value, applied))
    end
end
local tickCount = 0
function net.setStrength(value)
    return pushStrength(device.net(), value)
end
function net.tick()
    if state.read.net().enabled ~= true then return end
    if not source then return end
    if not net.available() then return end
    syncStrength()
    tickCount = tickCount + 1
    local payload, buildErr = source({ chart = (tickCount % 5 == 1) })
    if not payload then
        if not state.read.net().warned then
            state.write.netSetWarned(true)
            logs.warn("广播快照组装失败：" .. tostring(buildErr))
        end
        return
    end
    local ok, text = net.sendText(models.snapshot(payload))
    if not ok then
        if not state.read.net().warned then
            state.write.netSetWarned(true)
            logs.warn("广播失败：" .. tostring(text))
        end
        return
    end
    if state.read.net().warned then
        state.write.netSetWarned(nil)
        logs.system("广播已恢复")
    end
end
function net.register()
    return scheduler.every(TASK, CONFIG.INTERVAL.BROADCAST, net.tick,
        { enabled = state.read.net().enabled == true })
end
return net

backend/hardware/probes.lua
