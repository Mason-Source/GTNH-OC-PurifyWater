local CONFIG   = require("shared.config")
local logs     = require("shared.logs")
local models   = require("shared.models")
local state    = require("shared.state")
local settings = require("backend.store.settings")
local net      = require("backend.hardware.net")
local app      = {}
function app.loadSettings(bootSettings)
    bootSettings = bootSettings or {}
    local on = models.bool(bootSettings[CONFIG.NET.ENABLED_KEY], CONFIG.NET.ENABLED == true)
    net.setEnabled(on)
    if bootSettings[CONFIG.NET.ENABLED_KEY] == nil then
        settings.set(CONFIG.NET.ENABLED_KEY, on)
    end
    local strength = tonumber(bootSettings[CONFIG.NET.STRENGTH_KEY])
    if not strength or strength ~= math.floor(strength) or strength < 0 then
        strength = CONFIG.NET.STRENGTH
    end
    if strength > CONFIG.NET.STRENGTH_MAX then strength = CONFIG.NET.STRENGTH_MAX end
    state.write.netSetStrength(strength)
    if bootSettings[CONFIG.NET.STRENGTH_KEY] == nil then
        settings.set(CONFIG.NET.STRENGTH_KEY, strength)
    end
end
function app.toggle()
    local on   = not (state.read.net().enabled == true)
    local text = net.setEnabled(on)
    local ok   = settings.set(CONFIG.NET.ENABLED_KEY, on)
    if not ok then logs.warn("广播开关保存失败（重启回到上次保存的值）") end
    return text
end
function app.setStrength(value)
    value = tonumber(value)
    if not value or value ~= math.floor(value) or value < 0 then
        return false, "无线范围需为 0 以上的整数（方块）"
    end
    local applied, why = net.setStrength(value)
    if not applied then
        if why == "有线卡" then
            applied = 0
        else
            applied = value
        end
    end
    local note = ""
    if applied ~= value then
        note = string.format("（输入 %d 被卡钳制）", value)
    elseif why == "无卡" then
        note = "（网卡不在位，插卡后生效）"
    end
    state.write.netSetStrength(applied)
    local ok = settings.set(CONFIG.NET.STRENGTH_KEY, applied)
    logs.system(string.format("无线范围：%d 方块%s%s", applied, note,
        ok and "" or "（保存失败，重启回到上次保存的值）"))
    return true, ""
end
return app

backend/app/plan.lua
2307
local constants = require("shared.constants")
local logs      = require("shared.logs")
local state     = require("shared.state")
local utils     = require("shared.utils")
local power     = require("backend.domain.power")
local allocator = require("backend.domain.allocator")
local actuator  = require("backend.domain.actuator")
local settings  = require("backend.store.settings")
local plan      = {}
local warned    = {}
local function once(key, text)
    if warned[key] then return end
    warned[key] = true
    logs.append(text)
end
local function clearOnce(key)
    warned[key] = nil
end
function plan.run(reason)
    if not state.read.running() then
        return false
    end
    power.refresh()
    local result = allocator.plan()
    if result.warn then
        once("noPower", result.warn)
    else
        clearOnce("noPower")
    end
    local known = next(state.read.lastPlan()) ~= nil
    if known and allocator.isSame(state.read.lastPlan(), result.plan) then
        return false
    end
    local _, failed = actuator.apply(result.plan)
    state.write.setLastPlan(result.plan)
    local badNames = {}
    for level, err in pairs(failed or {}) do
        badNames[#badNames + 1] = constants.levelLabel(level)
        state.write.deleteLastPlanLevel(level)
    end
    if #badNames > 0 then
        table.sort(badNames)
        logs.warn(string.format("%s 下发失败，下一轮重试",
            table.concat(badNames, "、")))
    end
    logs.schedule(string.format("%s：%s ｜ 功率 %s / %s ｜ %s",
        tostring(reason or "-"),
        allocator.describe(result.plan),
        utils.formatShortNumber(result.used), utils.formatShortNumber(result.budget),
        actuator.describeReceipt()))
    return true
end
function plan.togglePriority()
    state.write.setPriority((state.read.priority() == "high") and "low" or "high")
    state.write.clearPlan()
    local ok              = settings.set("priority", state.read.priority())
    logs.system(string.format("运行模式：%s%s",
        state.read.priority() == "high" and "高级水优先" or "低级水优先",
        ok and "（已保存，下次启动沿用）" or "（保存失败，重启会回到默认）"))
    return state.read.priority()
end
function plan.forget()
    state.write.clearPlan()
end
return plan

backend/app/produce.lua
8428
local constants      = require("shared.constants")
local logs           = require("shared.logs")
local state          = require("shared.state")
local utils          = require("shared.utils")
local scheduler      = require("core.scheduler")
local produce        = require("backend.domain.produce")
local device         = require("backend.hardware.device")
local produce_table  = require("backend.store.produce")
local produce_config = require("backend.store.produce_config")
local binding        = require("backend.app.produce.binding")
local readiness      = require("backend.app.produce.readiness")
local view           = require("backend.app.produce.view")
local patrol         = nil
local produceJobs    = nil
local produceApp     = {}
local function patrolApp()
    patrol = patrol or require("backend.app.produce.patrol")
    return patrol
end
local function jobsApp()
    produceJobs = produceJobs or require("backend.app.produce.jobs")
    return produceJobs
end
local bindFailText = nil
local function notify(reason)
    scheduler.emit("produce_changed", { reason = reason })
end
local function commitBind(level, machine, transposer, message)
    local ok, err = binding.commit(level, machine, transposer)
    if not ok then return false, err end
    logs.system(message)
    readiness.refreshAll()
    notify("绑定：" .. tostring(machine))
    return true, nil
end
function produceApp.reload(snapshot)
    local changedSwitch, whySwitch = produce_config.load(snapshot)
    local cleared = {}
    for level = 1, constants.LEVEL_COUNT do
        if not produce.has(level) and state.read.produceLevel(level).enabled == true then
            produce_config.set(level, false)
            cleared[#cleared + 1] = constants.levelLabel(level)
        end
    end
    if #cleared > 0 then
        changedSwitch = true
        whySwitch = "已清除未实现等级的遗留开关：" .. table.concat(cleared, "/")
        logs.warn("制作自动化：" .. whySwitch)
    end
    local entries, problems = produce_table.load()
    if #problems > 0 then
        logs.warn(string.format("制作自动化绑定表：%s%s", tostring(problems[1]),
            (#problems > 1) and ("（共 " .. #problems .. " 条问题）") or ""))
    end
    local changedBinds = false
    local old = state.read.produce().binds
    if #old ~= #entries then
        changedBinds = true
    else
        for index = 1, #entries do
            local a, b = old[index], entries[index]
            if a.level ~= b.level or a.machine ~= b.machine or a.transposer ~= b.transposer then
                changedBinds = true
                break
            end
        end
    end
    binding.replaceAll(entries)
    local changedState = readiness.refreshAll()
    local changed = changedSwitch or changedBinds or changedState
    return changed, changed and "制作自动化配置已更新" or tostring(whySwitch or "制作自动化配置未变化")
end
function produceApp.refresh()
    binding.refreshOnline()
    return readiness.refreshAll()
end
function produceApp.patrol()
    return patrolApp().run()
end
function produceApp.beginBind(level, machine)
    level = tonumber(level)
    if not level or level < 1 or level > constants.LEVEL_COUNT then return false, "等级无效" end
    if not produce.has(level) then
        return false, constants.levelLabel(level) .. " 制作自动化尚未实现"
    end
    if type(machine) ~= "string" or machine == "" then return false, "机器无效" end
    if state.read.produce().binding then return false, "已有正在进行的绑定，请先取消" end
    binding.refreshOnline()
    local existing = binding.bindOf(machine)
    if existing and binding.onlineSet()[existing.transposer] then
        return false, "该机器已绑定且转运器在线（先解绑再重绑）"
    end
    if not binding.machineSet(level)[machine] then
        return false, "机器不在该级注册表（先刷新扫描再试）"
    end
    local label = constants.levelLabel(level)
    local text  = binding.machineTextOf(level, machine)
    local snapshot, unboundCount = {}, 0
    for _, address in ipairs(device.scanTransposers()) do
        snapshot[address] = true
        if not binding.transposerBound(address) then unboundCount = unboundCount + 1 end
    end
    state.write.produceSetBinding({ level = level, machine = machine, snapshot = snapshot })
    logs.system(string.format("%s 制作自动化：开始绑定（机器 %s）——请放下转运器并接入网络", label, text))
    if unboundCount > 0 then
        logs.warn(string.format("%s 制作自动化：网络有 %d 个未绑定转运器", label, unboundCount))
    end
    notify("开始绑定：" .. label)
    return true, ""
end
function produceApp.cancelBind()
    local item = state.read.produce().binding
    if not item then return false, "当前没有正在进行的绑定" end
    state.write.produceSetBinding(nil)
    logs.system(string.format("%s 制作自动化：已取消绑定", constants.levelLabel(item.level)))
    notify("取消绑定")
    return true, ""
end
function produceApp.unbind(machine)
    if type(machine) ~= "string" then return false, "机器无效" end
    local ok, removed, err = binding.remove(machine)
    if not ok then return false, tostring(err) end
    if not removed then return false, "该机器未绑定" end
    readiness.refreshAll()
    logs.system(string.format("%s 制作自动化：已解绑 %s…（机器 %s）",
        constants.levelLabel(removed.level), utils.shortAddress(removed.transposer),
        binding.machineTextOf(removed.level, machine)))
    notify("解绑：" .. tostring(machine))
    return true, ""
end
function produceApp.setEnabled(level, enabled)
    level = tonumber(level)
    if not level or level < 1 or level > constants.LEVEL_COUNT then return false, "等级无效" end
    if type(enabled) ~= "boolean" then return false, "开关值无效" end
    if not produce.has(level) then
        return false, constants.levelLabel(level) .. " 制作自动化尚未实现"
    end
    local label = constants.levelLabel(level)
    if enabled == true then
        binding.refreshOnline()
        patrolApp().run(level)
        local ok, reason, units = readiness.validateForEnable(level)
        if not ok then return false, reason end
        local saved, err = produce_config.set(level, true)
        if not saved then return false, "写配置失败（settings.txt）：" .. tostring(err) end
        logs.system(string.format("%s 制作自动化：已开启（%d 台机器）", label, #units))
        notify("开关：" .. label .. " 开")
        return true, ""
    end
    local saved, err = produce_config.set(level, false)
    if not saved then return false, "写配置失败（settings.txt）：" .. tostring(err) end
    logs.system(string.format("%s 制作自动化：已关闭", label))
    notify("开关：" .. label .. " 关")
    return true, ""
end
function produceApp.read() return view.read() end
function produceApp.syncJobs() return jobsApp().sync() end
function produceApp.onCycleStarted(payload) return jobsApp().onCycleStarted(payload) end
function produceApp.tick()
    local item = state.read.produce().binding
    if not item then return end
    local list = device.scanTransposers()
    local news = {}
    for _, address in ipairs(list) do
        if not item.snapshot[address] and not binding.transposerBound(address) then
            news[#news + 1] = address
        end
    end
    if #news == 0 then return end
    local ok, err = commitBind(item.level, item.machine, news[1], string.format(
        "%s 制作自动化：已绑定 %s… → 机器 %s", constants.levelLabel(item.level),
        utils.shortAddress(news[1]), binding.machineTextOf(item.level, item.machine)))
    if ok then
        bindFailText = nil
    elseif tostring(err) ~= bindFailText then
        bindFailText = tostring(err)
        logs.warn(string.format("%s 制作自动化：绑定失败——%s（会继续重试）",
            constants.levelLabel(item.level), tostring(err)))
    end
    if #news > 1 then
        local unbound = 0
        for _, address in ipairs(list) do
            if not binding.transposerBound(address) then unbound = unbound + 1 end
        end
        logs.warn(string.format("%s 制作自动化：网络有 %d 个未绑定转运器",
            constants.levelLabel(item.level), unbound))
    end
end
return produceApp

backend/app/produce/binding.lua
8055
local constants     = require("shared.constants")
local logs          = require("shared.logs")
local state         = require("shared.state")
local utils         = require("shared.utils")
local device        = require("backend.hardware.device")
local machines      = require("backend.hardware.machines")
local transposer    = require("backend.hardware.transposer")
local produce_table = require("backend.store.produce")
local binding = {}
local byMachine, byTransposer = {}, {}
local function rebuildIndex()
    byMachine, byTransposer = {}, {}
    for _, b in ipairs(state.read.produce().binds) do
        byMachine[b.machine] = b
        byTransposer[b.transposer] = b
    end
end
binding.rebuildIndex = rebuildIndex
local function bindLess(a, b)
    if a.level ~= b.level then return a.level < b.level end
    return tostring(a.machine) < tostring(b.machine)
end
function binding.machineTextOf(level, address)
    for _, m in ipairs(machines.of(level)) do
        if m.address == address then
            if type(m.x) == "number" and type(m.y) == "number" and type(m.z) == "number" then
                return string.format("(%d,%d,%d)", m.x, m.y, m.z)
            end
            break
        end
    end
    return "无坐标(" .. utils.shortAddress(address) .. ")"
end
function binding.bindOf(machine)
    if #state.read.produce().binds > 0 and next(byMachine) == nil then rebuildIndex() end
    return byMachine[machine]
end
function binding.transposerBound(address)
    if #state.read.produce().binds > 0 and next(byTransposer) == nil then rebuildIndex() end
    return byTransposer[address] ~= nil
end
function binding.onlineSet() return state.read.produce().online end
function binding.refreshOnline(forceRate)
    local map = {}
    local old = state.read.produce().online
    for _, b in ipairs(state.read.produce().binds) do
        local now = device.isTransposerOnline(b.transposer)
        local sub = state.read.produce().subs[b.machine]
        local rate = sub and sub.rate or nil
        if now and (forceRate == true or old[b.transposer] == nil
            or old[b.transposer] == false or type(rate) ~= "number") then
            rate = transposer.rate(b.transposer)
        end
        state.write.produceSetSub(b.machine, { rate = now and rate or nil })
        local was = old[b.transposer]
        if was ~= nil and was ~= now then
            if now then
                logs.system(string.format("%s 制作自动化：转运器 %s… 已恢复在线",
                    constants.levelLabel(b.level), utils.shortAddress(b.transposer)))
            else
                logs.warn(string.format("%s 制作自动化：转运器 %s… 掉线（机器 %s）",
                    constants.levelLabel(b.level), utils.shortAddress(b.transposer),
                    binding.machineTextOf(b.level, b.machine)))
            end
        end
        map[b.transposer] = now
    end
    state.write.produceSetOnlineAll(map)
end
function binding.machineSet(level)
    local out = {}
    for _, m in ipairs(machines.of(level)) do out[m.address] = true end
    return out
end
function binding.observedMachine(level, machine)
    for _, fact in ipairs(state.read.plant(level).machines or {}) do
        if fact.address == machine then return fact end
    end
    return nil
end
function binding.units(level)
    local online = binding.onlineSet()
    local out, seen = {}, {}
    for _, m in ipairs(machines.of(level)) do
        seen[m.address] = true
        local b = binding.bindOf(m.address)
        local sub = b and state.read.produce().subs[b.machine] or nil
        out[#out + 1] = {
            machine    = m.address,
            transposer = b and b.transposer or nil,
            online     = (b and online[b.transposer]) or nil,
            rate       = (b and online[b.transposer] and sub) and sub.rate or nil
        }
    end
    for _, b in ipairs(state.read.produce().binds) do
        if b.level == level and not seen[b.machine] then
            local sub = state.read.produce().subs[b.machine]
            out[#out + 1] = {
                machine    = b.machine,
                transposer = b.transposer,
                online     = online[b.transposer] or nil,
                rate       = (online[b.transposer] and sub) and sub.rate or nil
            }
        end
    end
    return out
end
function binding.rebuildSubs()
    local old  = state.read.produce().subs
    local subs = {}
    for _, b in ipairs(state.read.produce().binds) do
        local keep = old[b.machine]
        local same = keep and keep.transposer == b.transposer
        local sub  = same and keep or { transposer = b.transposer, cycleSeq = 0 }
        local sides, layout
        if not keep then
            sides, layout = b.sides, b.layout
        elseif same then
            sides  = keep.sides or b.sides
            layout = keep.layout or b.layout
        end
        sub.level       = b.level
        sub.sides       = sides
        sub.layout      = layout
        sub.sideTarget  = sides and sides.target or nil
        sub.itemTarget  = sides and sides.itemTarget or nil
        subs[b.machine] = sub
    end
    state.write.produceSetSubs(subs)
    rebuildIndex()
end
function binding.updateSide(machine, sides, layout)
    local b = binding.bindOf(machine)
    if not b then return false, "该机器未绑定" end
    local oldSides, oldLayout = b.sides, b.layout
    b.sides, b.layout = sides, layout
    local ok, err = produce_table.save(state.read.produce().binds)
    if not ok then
        b.sides, b.layout = oldSides, oldLayout
        return false, tostring(err)
    end
    return true, nil
end
function binding.commit(level, machine, transposerAddress)
    local binds = state.read.produce().binds
    local old
    for _, b in ipairs(binds) do
        if b.machine == machine then
            old = { level = b.level, transposer = b.transposer, sides = b.sides, layout = b.layout }
            b.level, b.transposer, b.sides, b.layout = level, transposerAddress, nil, nil
            break
        end
    end
    local added
    if not old then
        added = { level = level, machine = machine, transposer = transposerAddress }
        binds[#binds + 1] = added
    end
    table.sort(binds, bindLess)
    local ok, err = produce_table.save(binds)
    if not ok then
        if old then
            for _, b in ipairs(binds) do
                if b.machine == machine then
                    b.level, b.transposer, b.sides, b.layout =
                        old.level, old.transposer, old.sides, old.layout
                    break
                end
            end
        elseif added then
            for i, b in ipairs(binds) do
                if b == added then table.remove(binds, i); break end
            end
        end
        return false, "写绑定表失败（data/produce.txt）：" .. tostring(err)
    end
    local currentBinding = state.read.produce().binding
    if currentBinding and currentBinding.machine == machine then
        state.write.produceSetBinding(nil)
    end
    binding.rebuildSubs()
    binding.refreshOnline()
    return true, nil
end
function binding.remove(machine)
    local binds = state.read.produce().binds
    local index, removed
    for i, b in ipairs(binds) do
        if b.machine == machine then index, removed = i, b; break end
    end
    if not index then return false, nil, "该机器未绑定" end
    table.remove(binds, index)
    local ok, err = produce_table.save(binds)
    if not ok then
        table.insert(binds, index, removed)
        return false, nil, "写绑定表失败（data/produce.txt）：" .. tostring(err)
    end
    local currentBinding = state.read.produce().binding
    if currentBinding and currentBinding.machine == machine then
        state.write.produceSetBinding(nil)
    end
    binding.rebuildSubs()
    binding.refreshOnline()
    return true, removed, nil
end
function binding.replaceAll(entries)
    state.write.produceSetBinds(entries)
    binding.rebuildSubs()
    binding.refreshOnline()
end
return binding

backend/app/produce/executor.lua
8313
local probes       = require("backend.hardware.probes")
local gtInfodata   = require("backend.hardware.gt_infodata")
local transposer   = require("backend.hardware.transposer")
local executor = {}
local function scanFluids(sub)
    local out = {}
    for _, side in ipairs((sub.sides and sub.sides.sources) or {}) do
        for _, item in ipairs(transposer.containers(sub.transposer, side) or {}) do
            local amount = tonumber(item.amount) or 0
            local fluid = item.fluid
            if fluid and amount > 0 then
                local entry = out[fluid]
                if entry then
                    entry.available = entry.available + amount
                    if amount > entry.amount then
                        entry.side, entry.tank, entry.amount = side, item.tank, amount
                    end
                else
                    out[fluid] = {
                        fluid = fluid, side = side, tank = item.tank,
                        amount = amount, available = amount
                    }
                end
            end
        end
    end
    return out
end
local function findAnySource(sub, anyList, need)
    local found = scanFluids(sub)
    local best, enough
    for _, fluid in ipairs(anyList or {}) do
        local entry = found[fluid]
        if entry then
            if not best or entry.available > best.available then best = entry end
            if (not need or entry.available >= need)
                and (not enough or entry.available > enough.available) then
                enough = entry
            end
        end
    end
    return enough or best
end
local function findItemSource(sub, required)
    for _, side in ipairs((sub.sides and sub.sides.itemSources) or {}) do
        local slot, size = transposer.findItem(sub.transposer, side, required.name, required.damage)
        if slot and size > 0 then
            return { side = side, slot = slot, count = size, item = required }
        end
    end
end
local function itemSourceSide(sub, item)
    local source = findItemSource(sub, item)
    if source then return source.side end
    return ((sub.sides and sub.sides.itemSources) or {})[1]
end
local function validItemSourceSide(sub, side)
    for _, candidate in ipairs((sub.sides and sub.sides.itemSources) or {}) do
        if candidate == side then return side end
    end
end
local HANDLERS = {}
HANDLERS.sensor = function(action, job)
    local lines, err = probes.sensorLines(job.machine)
    if not lines then return { ok = false, reason = err or "传感器读取失败" } end
    local value
    if action.field ~= nil then
        value, err = gtInfodata.extract(lines, action.field)
        if err then return { ok = false, reason = err } end
    end
    return { ok = true, lines = lines, value = value }
end
HANDLERS.target = function(action, job)
    local sub = job.sub
    if not sub.sides then return { ok = false, reason = "侧位未配置" } end
    if sub.sides.target then
        for _, item in ipairs(transposer.containers(sub.transposer, sub.sides.target) or {}) do
            if item.fluid and (tonumber(item.amount) or 0) > 0 then
                return { ok = false, reason = "输出侧有流体残留，请先清空目标容器" }
            end
        end
    end
    if sub.sides.itemTarget then
        local items = transposer.items(sub.transposer, sub.sides.itemTarget)
        if items and #items > 0 then
            return { ok = false, reason = "输出侧物品残留" }
        end
    end
    return { ok = true }
end
HANDLERS.findFluid = function(action, job)
    local source = scanFluids(job.sub)[action.fluid]
    if not source then
        return { ok = false, reason = "找不到源流体：" .. tostring(action.label or action.fluid) }
    end
    return { ok = true, source = source }
end
HANDLERS.findAny = function(action, job)
    local source = findAnySource(job.sub, action.any, action.amount)
    if not source then
        return { ok = false, reason = "找不到候选流体：" .. tostring(action.label or "未知候选组") }
    end
    return { ok = true, source = source }
end
HANDLERS.findItem = function(action, job)
    local source = findItemSource(job.sub, action.item)
    if not source then
        return { ok = false, reason = "找不到物品源：" .. tostring(action.item.label or action.item.name) }
    end
    return { ok = true, source = source }
end
HANDLERS.transferFluid = function(action, job)
    local sub = job.sub
    if not sub.sides or not sub.sides.target then
        return { ok = false, reason = "没有流体目标侧" }
    end
    local ok, moved = transposer.transfer(sub.transposer, action.source.side,
        sub.sides.target, action.amount, action.source.tank)
    if not ok then
        return { ok = false, reason = tostring(action.label or action.source.fluid)
            .. " 转运失败：" .. tostring(moved or "未知原因") }
    end
    return { ok = true, moved = tonumber(moved) or 0 }
end
HANDLERS.transferItem = function(action, job)
    local sub = job.sub
    if not sub.sides or not sub.sides.itemTarget then
        return { ok = false, reason = "没有物品目标侧" }
    end
    local ok, moved = transposer.transferItems(sub.transposer, action.source.side,
        sub.sides.itemTarget, action.amount, action.source.slot)
    if not ok then
        return { ok = false, reason = tostring(action.label
            or action.source.item.label or action.source.item.name)
            .. " 转运失败：" .. tostring(moved or "未知原因") }
    end
    return { ok = true, moved = tonumber(moved) or 0 }
end
HANDLERS.returnItem = function(action, job)
    local sub = job.sub
    if not sub.sides or not sub.sides.itemTarget then
        return { ok = false, reason = "没有物品目标侧" }
    end
    local to = validItemSourceSide(sub, action.to)
        or itemSourceSide(sub, action.item)
    if to == nil then return { ok = false, reason = "没有可回收的物品来源侧" } end
    local slot, count, err = transposer.findItem(sub.transposer, sub.sides.itemTarget,
        action.item.name, action.item.damage)
    if not slot then
        return { ok = false, reason = err
            or ("目标侧找不到物品：" .. tostring(action.item.label or action.item.name)) }
    end
    local amount = math.min(tonumber(action.amount) or 1, count)
    local ok, moved = transposer.transferItems(sub.transposer, sub.sides.itemTarget,
        to, amount, slot)
    if not ok then return { ok = false, reason = tostring(moved or "物品回收失败") } end
    return { ok = true, moved = tonumber(moved) or 0 }
end
HANDLERS.recoverTarget = function(action, job)
    local sub = job.sub
    if not sub.sides or not sub.sides.itemTarget then
        return { ok = false, reason = "没有物品目标侧" }
    end
    if #((sub.sides and sub.sides.itemSources) or {}) == 0 then
        return { ok = false, reason = "没有可回收的物品来源侧" }
    end
    local items, err = transposer.items(sub.transposer, sub.sides.itemTarget)
    if not items then return { ok = false, reason = tostring(err or "目标侧物品读取失败") } end
    local movedOut = {}
    for _, stack in ipairs(items) do
        local item = { name = stack.name, damage = stack.damage }
        local to = itemSourceSide(sub, item)
        if to == nil then return { ok = false, reason = "没有可回收的物品来源侧" } end
        local ok, moved = transposer.transferItems(sub.transposer, sub.sides.itemTarget,
            to, stack.size, stack.slot)
        if not ok or tonumber(moved) ~= stack.size then
            return { ok = false, reason = string.format("残留物品回收不完整：%s %s/%d",
                tostring(stack.label or stack.name), tostring(moved or "-"), stack.size) }
        end
        movedOut[#movedOut + 1] = {
            name = stack.name,
            damage = stack.damage,
            label = stack.label,
            amount = moved
        }
    end
    return { ok = true, moved = movedOut }
end
function executor.run(action, job)
    local handler = HANDLERS[action and action.kind]
    if not handler then
        return { ok = false, reason = "未知 action：" .. tostring(action and action.kind) }
    end
    return handler(action, job)
end
return executor

backend/app/produce/jobs.lua
2388
local computer       = require("computer")
local CONFIG         = require("shared.config")
local constants      = require("shared.constants")
local state          = require("shared.state")
local hostCycle      = require("backend.domain.host_cycle")
local produce        = require("backend.domain.produce")
local interface      = require("backend.domain.produce.interface")
local binding        = require("backend.app.produce.binding")
local readiness      = require("backend.app.produce.readiness")
local produceRuntime = require("backend.app.produce_runtime")
local produceJob     = require("backend.app.produce_job")
local jobs = {}
local function sameCycleAllowed(job, seq)
    return hostCycle.seq() == seq
        and readiness.machineAllowed(job.machine, job.level, job.sub)
end
local function addOperation(machine, sub, method, seq)
    local id = string.format("job:%d:%s", sub.level, machine)
    if produceRuntime.has(id) or (sub.cycleSeq or 0) == seq then return false end
    local job = produceJob.new(machine, sub, interface.operation(method),
        interface.recoversTargetItems(method))
    job.id           = id
    job.levelLabel   = constants.levelLabel(sub.level)
    job.machineText  = binding.machineTextOf(sub.level, machine)
    job.priority     = interface.priority(method) or 20
    job.cycleSeq     = seq
    job.runAt        = computer.uptime()
    job.gate         = function() return sameCycleAllowed(job, seq) end
    produceRuntime.add(job)
    state.write.produceSetSub(machine, { cycleSeq = seq })
    return true
end
function jobs.sync()
    local seq = hostCycle.seq()
    return produceRuntime.cancelWhere(function(job)
        return not sameCycleAllowed(job, seq)
    end)
end
function jobs.onCycleStarted(payload)
    local seq = (payload and payload.seq) or hostCycle.seq()
    produceRuntime.cancelWhere(function(job)
        return job.cycleSeq ~= seq
    end)
    local ratio = payload and payload.ratio
    if ratio and ratio > (tonumber(CONFIG.PRODUCE.CYCLE_CUTOFF) or 0.9) then
        return
    end
    for machine, sub in pairs(state.read.produce().subs) do
        local method = produce.method(sub.level)
        if method and type(interface.operation(method)) == "function"
            and readiness.machineAllowed(machine, sub.level, sub) then
            addOperation(machine, sub, method, seq)
        end
    end
end
return jobs

backend/app/produce/patrol.lua
6329
local constants  = require("shared.constants")
local logs       = require("shared.logs")
local state      = require("shared.state")
local utils      = require("shared.utils")
local produce    = require("backend.domain.produce")
local interface  = require("backend.domain.produce.interface")
local binding    = require("backend.app.produce.binding")
local sides      = require("backend.app.produce.sides")
local probes     = require("backend.hardware.probes")
local transposer = require("backend.hardware.transposer")
local patrol = {}
local FORCE_REASON_WIDTH   = 48
local function resolveAnyFound(found, anyList)
    local picked, best = nil, 0
    for _, fluid in ipairs(anyList or {}) do
        local amount = found[fluid] or 0
        if amount > best then picked, best = fluid, amount end
    end
    return picked or (anyList and anyList[1]) or "?"
end
local function readFluidStock(sub)
    local found = {}
    for _, side in ipairs(sub.sides.sources or {}) do
        for _, item in ipairs(transposer.containers(sub.transposer, side) or {}) do
            if item.fluid and (not found[item.fluid] or (item.amount or 0) > found[item.fluid]) then
                found[item.fluid] = item.amount or 0
            end
        end
    end
    return found
end
local function readItemStock(sub, stock)
    local wanted, found = {}, {}
    for _, need in ipairs(stock) do
        if need.item then
            wanted[need.item.name .. ":" .. (tonumber(need.item.damage) or 0)] = true
        end
    end
    for _, side in ipairs(sub.sides.itemSources or {}) do
        for _, item in ipairs(transposer.items(sub.transposer, side) or {}) do
            local key = item.name .. ":" .. (tonumber(item.damage) or 0)
            if wanted[key] then
                found[key] = (found[key] or 0) + (tonumber(item.size) or 0)
            end
        end
    end
    return found
end
local function checkStock(sub, stock)
    local needFluid, needItem = false, false
    for _, need in ipairs(stock) do
        if need.item then needItem = true else needFluid = true end
    end
    local found = needFluid and readFluidStock(sub) or {}
    local foundItems = needItem and readItemStock(sub, stock) or {}
    local miss = {}
    for _, need in ipairs(stock) do
        if need.item then
            local key = need.item.name .. ":" .. (tonumber(need.item.damage) or 0)
            local have = foundItems[key] or 0
            if have < need.amount then
                miss[#miss + 1] = string.format("%s %d/%d个",
                    tostring(need.label or need.item.label or need.item.name), have, need.amount)
            end
        else
            local fluid = need.fluid or resolveAnyFound(found, need.any)
            local have = fluid and (found[fluid] or 0) or 0
            if have < need.amount then
                miss[#miss + 1] = string.format("%s %d/%dL",
                    tostring(need.label or fluid), have, need.amount)
            end
        end
    end
    return miss
end
local function configure(machine, sub, method, changed)
    local requiredFluids = interface.requiredFluids(method)
    local requiredItems  = interface.requiredItems(method)
    if (not requiredFluids or #requiredFluids == 0)
        and (not requiredItems or #requiredItems == 0) then
        return changed
    end
    local ok, reason, config = sides.configure(machine, sub, requiredFluids, requiredItems)
    if ok and config then
        return true
    end
    state.write.produceSetSub(machine, { sideFail = reason })
    return changed
end
local function reconfigureIfMoved(machine, sub, requiredItems)
    local signature = sides.layoutSignature(sub, requiredItems ~= nil and #requiredItems > 0)
    if sub.layout ~= nil and signature ~= sub.layout then
        sides.clear(machine)
        return true
    end
    return false
end
local function checkMachine(machine, sub, method, changed)
    local stock
    if interface.patrolByNeed(method) then
        local demand = method.need(probes.sensorLines(machine))
        stock = demand ~= nil and demand or nil
    else
        stock = interface.stockRequirements(method)
    end
    if stock == nil then return changed end
    local miss = checkStock(sub, stock)
    local enabled = state.read.produceLevel(sub.level).enabled == true
    local wasOff = sub.forceOff == true
    if #miss > 0 then
        if not wasOff then
            if enabled then
                logs.warn(string.format("%s 制作自动化：原料不足，已强制关断（机器 %s）",
                    constants.levelLabel(sub.level), binding.machineTextOf(sub.level, machine)))
            end
            local requiredItems = interface.requiredItems(method)
            if reconfigureIfMoved(machine, sub, requiredItems) then changed = true end
            local forceReason = "原料不足：" .. utils.joinLimited(miss, FORCE_REASON_WIDTH)
            state.write.produceSetSub(machine, { forceOff = true, forceReason = forceReason })
            changed = true
        end
    elseif wasOff then
        state.write.produceSetSub(machine, { forceOff = false, forceReason = nil })
        if enabled then
            logs.system(string.format("%s 制作自动化：原料已充足，解除强制关断（机器 %s）",
                constants.levelLabel(sub.level), binding.machineTextOf(sub.level, machine)))
        end
        changed = true
    end
    return changed
end
function patrol.run(forceLevel)
    local changed = false
    local online = binding.onlineSet()
    local hostActive = state.read.plant(constants.HOST_LEVEL).active == true
    for machine, sub in pairs(state.read.produce().subs) do
        local method = produce.method(sub.level)
        if method and online[sub.transposer] then
            local entry = state.read.produceLevel(sub.level)
            local shouldScan = (forceLevel == sub.level)
                or (forceLevel == nil and (sub.sides == nil
                    or (hostActive and entry.enabled == true)))
            if shouldScan then
                if not sub.sides then
                    changed = configure(machine, sub, method, changed)
                else
                    changed = checkMachine(machine, sub, method, changed)
                end
            end
        end
    end
    return changed
end
return patrol

backend/app/produce/readiness.lua
3723
local CONFIG    = require("shared.config")
local constants = require("shared.constants")
local state     = require("shared.state")
local produce   = require("backend.domain.produce")
local interface = require("backend.domain.produce.interface")
local binding   = require("backend.app.produce.binding")
local readiness = {}
local function methodRate(method)
    return interface.minTransferRate(method)
end
function readiness.evaluate(level)
    local method = produce.method(level)
    local units  = binding.units(level)
    if not method then
        return false, "该级制作自动化尚未实现", units, nil
    end
    local ok, reason = produce.check(level, units, {
        machines = binding.machineSet(level),
        minRate  = methodRate(method)
    })
    return ok, reason, units, method
end
function readiness.refreshLevel(level)
    local ok, reason, units = readiness.evaluate(level)
    state.write.produceSetLevel(level, { valid = ok, validReason = reason or "" })
    return ok, reason, units
end
function readiness.refreshAll()
    local changed = false
    for level = 1, constants.LEVEL_COUNT do
        local before = state.read.produceLevel(level).valid == true
        readiness.refreshLevel(level)
        local after = state.read.produceLevel(level).valid == true
        if before ~= after then changed = true end
    end
    return changed
end
function readiness.validateForEnable(level)
    local ok, reason, units = readiness.refreshLevel(level)
    if not ok then
        return false, string.format("%s 制作自动化未就绪：%s",
            constants.levelLabel(level), tostring(reason)), units
    end
    for _, b in ipairs(state.read.produce().binds) do
        if b.level == level then
            local sub = state.read.produce().subs[b.machine]
            if not (sub and sub.sides) then
                return false, string.format("%s 制作自动化未就绪：侧位尚未自动配置（机器 %s）",
                    constants.levelLabel(level), binding.machineTextOf(level, b.machine)), units
            end
            if sub.forceOff == true then
                return false, string.format("%s 制作自动化原料不足：%s（机器 %s）",
                    constants.levelLabel(level), tostring(sub.forceReason or "原料不足"),
                    binding.machineTextOf(level, b.machine)), units
            end
        end
    end
    return true, nil, units
end
function readiness.machineAllowed(machine, level, expectedSub)
    local entry = state.read.produceLevel(level)
    if entry.enabled ~= true or entry.valid ~= true then return false end
    local sub = state.read.produce().subs[machine]
    if not sub or sub.level ~= level or (expectedSub and sub ~= expectedSub) then return false end
    if not sub.sides or sub.forceOff == true then return false end
    local rate = tonumber(sub.rate)
    if not rate or rate <= 0 then return false end
    local method = produce.method(level)
    local minRate = methodRate(method)
    if minRate and rate < minRate then return false end
    if rate * (tonumber(CONFIG.PRODUCE.CHUNK_RATIO) or 0.05) < 1 then return false end
    local fact = binding.observedMachine(level, machine)
    return fact ~= nil and fact.active == true
end
function readiness.stateOf(level)
    local entry = state.read.produceLevel(level)
    if entry.valid ~= true then return "invalid", entry.validReason or "未就绪" end
    if entry.enabled ~= true then return "off", nil end
    for _, sub in pairs(state.read.produce().subs) do
        if sub.level == level and sub.forceOff == true then
            return "blocked", sub.forceReason or "原料不足"
        end
    end
    return "ok", nil
end
return readiness

backend/app/produce/sides.lua
7200
local state      = require("shared.state")
local utils      = require("shared.utils")
local transposer = require("backend.hardware.transposer")
local binding    = require("backend.app.produce.binding")
local sides = {}
local MAX_MISSING_WIDTH = 52
local function sameItem(a, b)
    return a ~= nil and b ~= nil
        and a.name == b.name
        and (tonumber(a.damage) or 0) == (tonumber(b.damage) or 0)
end
local function signatureOf(side, face)
    local itemNames = {}
    for _, item in ipairs(face.items or {}) do
        itemNames[#itemNames + 1] = string.format("%s:%d",
            tostring(item.name), tonumber(item.damage) or 0)
    end
    table.sort(itemNames)
    return string.format("%d:F[%s]I[%s]", side,
        table.concat(face.fluidNames or {}, ","), table.concat(itemNames, ","))
end
function sides.inspect(address, needItems)
    local faces, parts = {}, {}
    for side = 0, 5 do
        local fluids   = transposer.containers(address, side)
        local itemSize = needItems and transposer.inventorySize(address, side) or nil
        if fluids or itemSize then
            local items = itemSize and transposer.items(address, side, itemSize) or nil
            local fluidNames, hasFluid = {}, false
            for _, item in ipairs(fluids or {}) do
                if item.fluid then
                    fluidNames[#fluidNames + 1] = item.fluid
                    hasFluid = true
                end
            end
            table.sort(fluidNames)
            local face = {
                fluids     = fluids,
                fluidNames = fluidNames,
                items      = items or {},
                itemSize   = itemSize or 0,
                hasFluid   = hasFluid
            }
            faces[side] = face
            parts[#parts + 1] = signatureOf(side, face)
        end
    end
    table.sort(parts)
    return { faces = faces, layout = table.concat(parts, "|") }
end
local function missingFluids(required, found)
    local miss = {}
    for _, item in ipairs(required or {}) do
        if type(item) == "table" then
            if item.any then
                local hit = false
                for _, name in ipairs(item.any) do
                    if found[name] then hit = true; break end
                end
                if not hit then miss[#miss + 1] = tostring(item.label or "候选流体") end
            else
                local id = item.id or item.fluid
                if id and not found[id] then
                    miss[#miss + 1] = tostring(item.label or id)
                end
            end
        elseif not found[item] then
            miss[#miss + 1] = tostring(item)
        end
    end
    return miss
end
function sides.classify(info, requiredFluids, requiredItems, preferredFluid, preferredItem)
    local faces = info.faces
    local target, emptyCount, emptySide, sources, found = nil, 0, nil, {}, {}
    local itemTarget, itemSources, itemEmptyCount, itemEmptySide = nil, {}, 0, nil
    for side = 0, 5 do
        local face = faces[side]
        if face then
            if face.fluids then
                if preferredFluid ~= nil and side == preferredFluid then
                    target = side
                elseif face.hasFluid then
                    sources[#sources + 1] = side
                    for _, name in ipairs(face.fluidNames) do found[name] = true end
                else
                    emptyCount = emptyCount + 1
                    emptySide = emptySide or side
                end
            end
            if requiredItems and #requiredItems > 0 and face.itemSize > 0 then
                local contains = false
                for _, item in ipairs(face.items) do
                    for _, req in ipairs(requiredItems) do
                        if sameItem(item, req) then contains = true; break end
                    end
                    if contains then break end
                end
                if preferredItem ~= nil and side == preferredItem then
                    itemTarget = side
                elseif contains then
                    itemSources[#itemSources + 1] = side
                else
                    itemEmptyCount = itemEmptyCount + 1
                    itemEmptySide = itemEmptySide or side
                end
            end
        end
    end
    if requiredFluids and #requiredFluids > 0 then
        if target == nil then
            if emptyCount == 0 then return nil, "找不到空容器（流体输出侧）" end
            if emptyCount > 1 then return nil, "有多个空容器，无法确定流体输出侧" end
            target = emptySide
        end
        local miss = missingFluids(requiredFluids, found)
        if #miss > 0 then
            return nil, "输入侧缺流体：" .. utils.joinLimited(miss, MAX_MISSING_WIDTH)
        end
    end
    if requiredItems and #requiredItems > 0 then
        if itemTarget == nil then
            if itemEmptyCount == 0 then return nil, "找不到物品输出侧（需要物品存储空间）" end
            if itemEmptyCount > 1 then return nil, "有多个物品输出侧，无法确定" end
            itemTarget = itemEmptySide
        end
        local missItems = {}
        for _, req in ipairs(requiredItems) do
            local hit = false
            for _, side in ipairs(itemSources) do
                for _, item in ipairs(faces[side] and faces[side].items or {}) do
                    if sameItem(item, req) then hit = true; break end
                end
                if hit then break end
            end
            if not hit then missItems[#missItems + 1] = tostring(req.label or req.name) end
        end
        if #missItems > 0 then
            return nil, "输入侧缺物品：" .. utils.joinLimited(missItems, MAX_MISSING_WIDTH)
        end
    end
    return {
        target      = target,
        sources     = sources,
        itemTarget  = itemTarget,
        itemSources = itemSources
    }, nil
end
function sides.configure(machine, sub, requiredFluids, requiredItems)
    local info = sides.inspect(sub.transposer,
        requiredItems ~= nil and #requiredItems > 0)
    local config, reason = sides.classify(info, requiredFluids, requiredItems,
        sub.sideTarget, sub.itemTarget)
    if not config then return false, reason end
    local ok, err = binding.updateSide(machine, config, info.layout)
    if not ok then return false, "侧位落盘失败：" .. tostring(err) end
    state.write.produceSetSub(machine, {
        sides      = config,
        sideTarget = config.target,
        itemTarget = config.itemTarget,
        sideFail   = nil,
        layout     = info.layout
    })
    return true, nil, config
end
function sides.layoutSignature(sub, needItems)
    return sides.inspect(sub.transposer, needItems).layout
end
function sides.clear(machine)
    local sub = state.read.produce().subs[machine]
    if not sub then return false, "该机器没有子系统（可能未绑定）" end
    local ok, err = binding.updateSide(machine, nil, nil)
    if not ok then return false, "侧位清空落盘失败：" .. tostring(err) end
    state.write.produceClearSides(machine)
    return true, nil
end
return sides

backend/app/produce/view.lua
2574
local constants = require("shared.constants")
local state     = require("shared.state")
local machines  = require("backend.hardware.machines")
local produce   = require("backend.domain.produce")
local interface = require("backend.domain.produce.interface")
local binding   = require("backend.app.produce.binding")
local readiness = require("backend.app.produce.readiness")
local view = {}
function view.read()
    local online = binding.onlineSet()
    local levels = {}
    for level = 1, constants.LEVEL_COUNT do
        local entry      = state.read.produceLevel(level)
        local st, reason = readiness.stateOf(level)
        local method     = produce.method(level)
        local applicable = interface.applicable(method)
        local list, bound, onlineCount, configured = {}, 0, 0, 0
        for _, m in ipairs(machines.of(level)) do
            local b         = binding.bindOf(m.address)
            local sub       = b and state.read.produce().subs[b.machine] or nil
            local subOnline = (b and online[b.transposer]) or nil
            local sideState = "-"
            if b and applicable and subOnline then
                sideState = (sub and sub.sides) and "ok" or "auto"
                if sub and sub.sides then configured = configured + 1 end
            end
            list[#list + 1] = {
                address   = m.address,
                text      = binding.machineTextOf(level, m.address),
                bound     = b and b.transposer or nil,
                online    = subOnline,
                sideState = sideState,
                sideFail  = (subOnline and sub) and sub.sideFail or nil,
                rate      = subOnline and sub and sub.rate or nil
            }
            if b then bound = bound + 1 end
            if subOnline then onlineCount = onlineCount + 1 end
        end
        levels[level] = {
            implemented = method ~= nil,
            enabled     = entry.enabled == true,
            state       = st,
            reason      = reason,
            ready       = entry.valid == true,
            count       = #list,
            bound       = bound,
            online      = onlineCount,
            configured  = configured,
            machines    = list
        }
    end
    local b = state.read.produce().binding
    local bindingInfo = nil
    if b then
        bindingInfo = {
            level = b.level,
            machine = b.machine,
            text = binding.machineTextOf(b.level, b.machine)
        }
    end
    return { binding = bindingInfo, levels = levels }
end
return view

backend/app/produce_job.lua
6553
local CONFIG   = require("shared.config")
local state    = require("shared.state")
local executor = require("backend.app.produce.executor")
local job = {}
local function activeFact(machine, level)
    for _, fact in ipairs(state.read.plant(level).machines or {}) do
        if fact.address == machine then return fact.active == true end
    end
    return false
end
local function newContext(machine, sub)
    local ctx = {
        machine = machine,
        level = sub.level,
        sources = {},
        itemSource = nil,
        itemReturnSide = nil,
        limit = math.max(1, math.floor((tonumber(sub.rate) or 0)
            * (tonumber(CONFIG.PRODUCE.CHUNK_RATIO) or 0.05)))
    }
    ctx.sensor = function()
        local result = ctx.action({ kind = "sensor" })
        if not result or not result.ok then return nil, result and result.reason or "传感器失败" end
        return result.lines, nil
    end
    ctx.sensorInfo = function(field)
        local result = ctx.action({ kind = "sensor", field = field })
        if not result or not result.ok then return nil, result and result.reason or "传感器失败" end
        return result.value, nil
    end
    ctx.active = function() return activeFact(machine, sub.level) end
    local function sourceFor(fluid, label)
        local source = ctx.sources[fluid]
        if source then return source end
        local result = ctx.action({ kind = "findFluid", fluid = fluid, label = label })
        if not result or not result.ok then
            return nil, result and result.reason
                or ("找不到源流体：" .. tostring(label or fluid))
        end
        ctx.sources[fluid] = result.source
        return result.source, nil
    end
    local function transferFluid(fluid, amount, label)
        amount = tonumber(amount) or 0
        label  = tostring(label or fluid)
        local remaining = amount
        while remaining > 0 do
            local source, why = sourceFor(fluid, label)
            if not source then return false, why end
            if source.available < remaining then
                return false, string.format("%s 可用量不足：%d/%d mB",
                    label, source.available, remaining)
            end
            local request = math.min(remaining, ctx.limit, source.amount)
            local result = ctx.action({
                kind = "transferFluid", source = source, amount = request, label = label
            })
            local moved = (result and result.ok) and tonumber(result.moved) or 0
            if moved ~= request then
                ctx.sources[fluid] = nil
                return false, string.format("%s 转运不完整：%d/%d mB（%s）",
                    label, moved, request, result and result.reason or "失败")
            end
            remaining = remaining - moved
            source.amount = source.amount - moved
            source.available = source.available - moved
            if source.amount <= 0 then ctx.sources[fluid] = nil end
        end
        return true, nil
    end
    ctx.transferFluid = function(fluid, amount, label)
        return transferFluid(fluid, amount, label)
    end
    ctx.transferAny = function(anyList, amount, label)
        label = tostring(label or "候选流体")
        local result = ctx.action({
            kind = "findAny", any = anyList, amount = amount, label = label
        })
        if not result or not result.ok then
            return false, result and result.reason or ("找不到候选流体：" .. label)
        end
        ctx.sources[result.source.fluid] = result.source
        return transferFluid(result.source.fluid, amount, label)
    end
    ctx.transferItem = function(required, amount)
        amount = tonumber(amount) or 0
        local remaining = amount
        local source = ctx.itemSource
        while remaining > 0 do
            if source and source.item ~= required then source, ctx.itemSource = nil, nil end
            if not source then
                local result = ctx.action({ kind = "findItem", item = required })
                if not result or not result.ok then
                    return false, result and result.reason
                        or ("找不到物品源：" .. tostring(required.label or required.name))
                end
                source, ctx.itemSource = result.source, result.source
            end
            ctx.itemReturnSide = source.side
            local request = math.min(remaining, source.count)
            local result = ctx.action({
                kind = "transferItem", source = source, amount = request,
                label = required.label or required.name
            })
            local moved = (result and result.ok) and tonumber(result.moved) or 0
            if moved <= 0 then
                ctx.itemSource = nil
                return false, result and result.reason
                    or ((required.label or required.name) .. " 转运失败")
            end
            remaining = remaining - moved
            source.count = source.count - moved
            if source.count <= 0 then source, ctx.itemSource = nil, nil end
        end
        return true, nil
    end
    ctx.returnItem = function(required)
        local result = ctx.action({
            kind = "returnItem",
            item = required,
            to = ctx.itemReturnSide
        })
        if not result or not result.ok then
            return false, result and result.reason or "物品回收失败"
        end
        local moved = tonumber(result.moved) or 0
        if moved <= 0 then return false, "物品未移动" end
        return true, nil
    end
    ctx.recoverTarget = function()
        local result = ctx.action({ kind = "recoverTarget" })
        if not result or not result.ok then
            return false, result and result.reason or "目标侧残留回收失败"
        end
        return true, nil
    end
    return ctx
end
function job.new(machine, sub, operation, recoversTargetItems)
    local ctx = newContext(machine, sub)
    return {
        machine = machine,
        level = sub.level,
        sub = sub,
        operation = function()
            if not recoversTargetItems then
                local result = ctx.action({ kind = "target" })
                if not result or not result.ok then
                    return false, result and result.reason or "输出侧检查失败"
                end
            end
            return operation(ctx)
        end,
        ctx = ctx,
        executor = executor.run
    }
end
return job

backend/app/produce_runtime.lua
3704
local computer = require("computer")
local logs     = require("shared.logs")
local runtime = {}
local jobs    = {}
local function now() return computer.uptime() end
local function fail(job, reason)
    jobs[job.id] = nil
    local where = tostring(job.machineText or job.machine or job.id or "?")
    if job.levelLabel then where = tostring(job.levelLabel) .. " " .. where end
    logs.warn(string.format("制作自动化任务失败（%s）：%s", where, tostring(reason)))
end
local function complete(job)
    jobs[job.id] = nil
    local label = job.levelLabel or ("T" .. tostring(job.level))
    local who   = job.machineText or tostring(job.machine)
    logs.system(string.format("%s 制作自动化：本轮完成（机器 %s）", label, who))
end
function runtime.add(job)
    assert(type(job) == "table" and type(job.operation) == "function", "无效的制作任务")
    assert(type(job.executor) == "function", "无效的执行器")
    job.runAt    = tonumber(job.runAt) or now()
    job.priority = tonumber(job.priority) or 100
    job.ctx.action = function(action)
        return coroutine.yield({ kind = "action", action = action })
    end
    job.ctx.wait = function(seconds)
        seconds = tonumber(seconds)
        if not seconds or seconds < 0 then seconds = 0.05 end
        return coroutine.yield({ kind = "wait", seconds = seconds })
    end
    job.co = coroutine.create(function() return job.operation(job.ctx) end)
    jobs[job.id] = job
    return job
end
function runtime.has(id)
    return id ~= nil and jobs[id] ~= nil
end
function runtime.cancelWhere(predicate)
    local n = 0
    for id, job in pairs(jobs) do
        if type(job) == "table" and predicate(job) then
            jobs[id] = false
            n = n + 1
        end
    end
    if n > 0 then
        for id, job in pairs(jobs) do
            if job == false then jobs[id] = nil end
        end
    end
    return n
end
local function pickDue(t)
    local picked
    for _, job in pairs(jobs) do
        if job.runAt <= t then
            if not picked
                or job.priority < picked.priority
                or (job.priority == picked.priority and job.runAt < picked.runAt) then
                picked = job
            end
        end
    end
    return picked
end
local function gate(job)
    if not job.gate then return true end
    local ok, allowed = pcall(job.gate)
    if not ok then
        fail(job, allowed)
        return false
    end
    if allowed then return true end
    jobs[job.id] = nil
    return false
end
local function resume(job)
    local ok, a, b
    if job.pending then
        ok, a, b = coroutine.resume(job.co, job.pending)
        job.pending = nil
    else
        ok, a, b = coroutine.resume(job.co)
    end
    if not ok then fail(job, a) return end
    if coroutine.status(job.co) == "dead" then
        if a == false then fail(job, b or "制作任务失败") else complete(job) end
        return
    end
    if type(a) ~= "table" then fail(job, "制作任务返回无效请求") return end
    if a.kind == "wait" then
        job.runAt = now() + math.max(0.05, tonumber(a.seconds) or 0.05)
        return
    end
    if a.kind == "action" then
        local okExec, result = pcall(job.executor, a.action, job)
        if not okExec then fail(job, result) return end
        if type(result) ~= "table" then fail(job, "执行器返回无效结果") return end
        job.pending = result
        job.runAt = now() + 0.05
        return
    end
    fail(job, "未知的制作任务请求：" .. tostring(a.kind))
end
function runtime.tick()
    local job = pickDue(now())
    if not job then return end
    if gate(job) then resume(job) end
end
return runtime

backend/app/rates.lua
4786
local scheduler    = require("core.scheduler")
local CONFIG       = require("shared.config")
local constants    = require("shared.constants")
local logs         = require("shared.logs")
local state        = require("shared.state")
local settings     = require("backend.store.settings")
local rates_config = require("backend.store.rates_config")
local mode         = require("backend.domain.mode")
local plan         = require("backend.app.plan")
local system       = require("backend.app.system")
local IDLE_NOTE    = "（当前模式不生效，已保存待用）"
local app          = {}
local function afterSuggestChange(reason)
    system.publish()
    plan.forget()
    system.auditThresholds()
    system.requestPlan(reason)
end
function app.toggleMode()
    local nextId = (state.read.mode() == "rate") and "threshold" or "rate"
    state.write.setMode(nextId)
    local ok = settings.set("mode", nextId)
    logs.system(string.format("调度模式：%s%s", mode.labelOf(nextId),
        ok and "（已保存，下次启动沿用）" or "（保存失败，重启会回到默认）"))
    scheduler.emit("mode_changed", { mode = nextId })
    return nextId
end
function app.toggleEnforceThreshold()
    state.write.setEnforce(not state.read.enforceThreshold())
    local ok = settings.set("enforce_threshold", state.read.enforceThreshold())
    logs.system(string.format("速率模式：%s水位阈值约束%s",
        state.read.enforceThreshold() and "受" or "不受",
        ok and "（已保存，下次启动沿用）" or "（保存失败，重启会回到默认）"))
    scheduler.emit("enforce_changed", { on = state.read.enforceThreshold() })
    return state.read.enforceThreshold()
end
function app.setWeight(level, weight)
    level, weight = tonumber(level), tonumber(weight)
    if not level or level < 1 or level > constants.LEVEL_COUNT then
        return false, "等级无效"
    end
    if not weight or weight < 0 or weight > CONFIG.RATES.MAX_WEIGHT
        or weight ~= math.floor(weight) then
        return false, string.format("权重需为 0-%d 的整数", CONFIG.RATES.MAX_WEIGHT)
    end
    local ok, err = rates_config.setWeight(level, weight)
    if not ok then return false, "写配置失败（settings.txt）：" .. tostring(err) end
    logs.system(string.format("%s 权重 = %d%s", constants.levelLabel(level), weight,
        system.effectiveConfig().weight and "" or IDLE_NOTE))
    scheduler.emit("rates_changed", { why = "权重变更" })
    return true, ""
end
function app.setT7Boost(value)
    value = tonumber(value)
    local options, matched = constants.T7_BOOST_OPTIONS, false
    for _, option in ipairs(options) do
        if option == value then matched = true break end
    end
    if not matched then
        return false, string.format("增产倍率只能是 %s", table.concat(options, " / "))
    end
    local ok, err = rates_config.setBoost(value)
    if not ok then return false, "写配置失败（settings.txt）：" .. tostring(err) end
    logs.system(string.format("T7 增产倍率：×%s%s", tostring(value),
        system.effectiveConfig().boost and "" or IDLE_NOTE))
    scheduler.emit("rates_changed", { why = "T7 增产倍率变更" })
    return true, ""
end
function app.setReflux(level, enabled)
    level = tonumber(level)
    if level ~= 1 and level ~= 2 then return false, "回流数据收集只支持 T1/T2" end
    if type(enabled) ~= "boolean" then return false, "开关值无效" end
    local ok, err = rates_config.setReflux(level, enabled)
    if not ok then return false, "写配置失败（settings.txt）：" .. tostring(err) end
    logs.system(string.format("%s 回流数据收集：%s%s", constants.levelLabel(level),
        enabled and "开" or "关",
        system.effectiveConfig().boost and "" or IDLE_NOTE))
    scheduler.emit("rates_changed", { why = "回流数据收集变更" })
    return true, ""
end
function app.setT6DualLithium(enabled)
    if type(enabled) ~= "boolean" then return false, "开关值无效" end
    local ok, err = rates_config.setT6DualLithium(enabled)
    if not ok then return false, "写配置失败（settings.txt）：" .. tostring(err) end
    logs.system(string.format("T6紫外 双锂数据收集：%s%s", enabled and "开" or "关",
        system.effectiveConfig().boost and "" or IDLE_NOTE))
    scheduler.emit("rates_changed", { why = "T6 双锂数据收集变更" })
    return true, ""
end
function app.onModeChanged()
    afterSuggestChange("调度模式切换")
end
function app.onRatesChanged(payload)
    if not system.effectiveConfig().weight then return end
    afterSuggestChange(payload and payload.why or "权重变化")
end
function app.onEnforceChanged()
    plan.forget()
    system.requestPlan("阈值约束切换")
end
return app

backend/app/system.lua
7592
local constants       = require("shared.constants")
local logs            = require("shared.logs")
local state           = require("shared.state")
local utils           = require("shared.utils")
local computer        = require("computer")
local scheduler       = require("core.scheduler")
local learning        = require("backend.domain.learning")
local mode            = require("backend.domain.mode")
local power           = require("backend.domain.power")
local actuator        = nil
local tracker         = nil
local plan            = nil
local function actuatorApp()
    actuator = actuator or require("backend.domain.actuator")
    return actuator
end
local function trackerApp()
    tracker = tracker or require("backend.domain.tracker")
    return tracker
end
local function planApp()
    plan = plan or require("backend.app.plan")
    return plan
end
local HOST_OFF_REASON = "主机已关机"
local system          = {}
local lastWarnSig      = nil
local lastZeroWarn     = nil
local lastPublishDrain = -1
function system.publish()
    local seq = scheduler.drainSeq()
    if seq == lastPublishDrain then return end
    lastPublishDrain = seq
    local text = mode.publish()
    if text and text ~= "" then logs.warn(text) end
end
function system.effectiveConfig()
    local rate   = state.read.mode() == "rate"
    local gated  = (not rate) or (state.read.enforceThreshold() == true)
    return {
        enabled   = gated,
        threshold = gated,
        weight    = rate,
        boost     = rate
    }
end
function system.requestPlan(reason)
    if not state.read.running() then return false end
    if system.checkSuggestionChange() then return false end
    return planApp().run(reason)
end
function system.resetSuggestBaseline()
    state.write.setBaseline(power.suggestVector())
end
function system.checkSuggestionChange()
    local now = power.suggestVector()
    local was = state.read.baseline()
    if not was then
        state.write.setBaseline(now)
        return false
    end
    local changed = {}
    for level = 1, constants.LEVEL_COUNT do
        local a, b = tonumber(was[level]) or 0, tonumber(now[level]) or 0
        if a ~= b then changed[#changed + 1] = { level = level, from = a, to = b } end
    end
    if #changed == 0 then return false end
    state.write.setBaseline(now)
    system.enterAwaiting("建议并行已变化", true, "请按新建议调好机器并行，再点【启动系统】")
    return true
end
function system.auditThresholds()
    local texts, signature, warnText = mode.audit()
    texts     = texts or {}
    signature = signature or ""
    if warnText then
        if warnText ~= lastZeroWarn then
            logs.warn(warnText)
            lastZeroWarn = warnText
        end
    else
        lastZeroWarn = nil
    end
    if signature == lastWarnSig then return end
    lastWarnSig = signature
    for _, text in ipairs(texts) do logs.warn(text) end
end
function system.resetLearning(why)
    trackerApp().resetAll()
    learning.forgetAll()
    scheduler.emit("rules_audit", { reason = why })
end
local function beginSession(reason)
    system.resetLearning(reason)
    state.write.setRunning(true)
    planApp().forget()
    system.resetSuggestBaseline()
    logs.system("并行学习已重置（从建议值重新学习）")
end
local function endSession(reason)
    state.write.setRunning(false)
    system.resetLearning(reason)
    planApp().forget()
end
function system.start(reason)
    if state.read.running() then return true end
    if state.read.plant(constants.HOST_LEVEL).switch == false then
        logs.warn("无法启动：净水主机未开机")
        return false
    end
    logs.system(string.format("启动（%s）", tostring(reason or "-")))
    if state.read.awaiting() then
        local why = state.write.clearAwaiting()
        logs.system("已恢复（原等待原因：" .. tostring(why) .. "）")
    end
    beginSession(reason)
    system.auditThresholds()
    system.requestPlan("启动")
    return true
end
function system.stop(reason)
    local count = actuatorApp().shutdownAll()
    endSession(reason)
    logs.system(string.format("停机（%s）：已下发全关 %d 台", tostring(reason or "-"), count))
end
function system.enterAwaiting(why, allOff, line)
    if state.read.awaiting() then return false end
    if line then logs.warn(line) end
    if allOff then
        system.stop(why)
    else
        endSession(why)
        logs.system(string.format("停机：%s；保持现状，未下发指令", why))
    end
    state.write.setAwaiting(tostring(why or "等待处理"))
    logs.warn("等待用户处理：" .. state.read.awaitReason())
    return true
end
local function stopIfRunning(why)
    if not state.read.running() then return false end
    system.stop(why)
    return true
end
function system.onHardwareMissing(payload)
    local what = table.concat((payload and payload.missing) or { "未知" }, "、")
    stopIfRunning("硬件缺失：" .. what)
end
function system.ensureHostStopped()
    return stopIfRunning(HOST_OFF_REASON)
end
function system.onSwitchMismatch(payload)
    if not payload or not payload.level then return end
    if not state.read.running() then return end
    local levelName    = constants.levelLabel(payload.level)
    local receipt      = actuatorApp().lastReceipt()
    local sent, failed = 0, 0
    for _, item in ipairs(receipt.items or {}) do
        sent = sent + 1
        if not item.ok then failed = failed + 1 end
    end
    local since    = (receipt.at and receipt.at > 0)
        and string.format("%d 秒前", math.max(0, math.floor(computer.uptime() - receipt.at)))
        or "无记录"
    local sentText = (sent == 0) and "还没有过下发记录"
        or string.format("最近一次下发 %s %d 台（失败 %d）", since, sent, failed)
    system.enterAwaiting(levelName .. " 开关被人工改动", false, string.format(
        "%s 实测%s，方案要%s；点【启动系统】恢复 ｜ %s",
        levelName, payload.got and "开" or "关", payload.want and "开" or "关", sentText))
end
function system.onHardwareChanged()
    if state.read.running() then
        system.enterAwaiting("硬件变更", true)
    else
        system.resetLearning("硬件变更")
    end
end
function system.onPowerChanged(payload)
    system.publish()
    system.resetLearning(string.format("功率变化 %s -> %s",
        tostring(payload and payload.from), tostring(payload and payload.to)))
    system.requestPlan("功率变化")
end
function system.onDeployedChanged()
    system.publish()
end
function system.onParallelWrite(payload)
    if not payload or not learning.remember(payload.level, payload.parallel, payload.success) then
        return false
    end
    logs.system(string.format("%s 实际并行 = %s（来源：%s）",
        constants.levelLabel(payload.level), utils.formatShortNumber(payload.parallel),
        tostring(payload.by or "传感器确认")))
    system.auditThresholds()
    system.requestPlan("并行更新")
    return true
end
function system.onPriorityToggle()
    planApp().togglePriority()
    system.requestPlan("优先级切换")
end
function system.onScheduleRequest(payload)
    system.requestPlan(payload and payload.reason or "事件")
end
function system.onProduceChanged(payload)
    system.requestPlan(payload and payload.reason or "制作自动化变化")
end
function system.toggle(reason)
    if state.read.running() then
        system.stop(reason or "手动")
        return false
    end
    system.start(reason or "手动")
    return true
end
return system

backend/app/watch.lua
3131
local constants = require("shared.constants")
local logs      = require("shared.logs")
local state     = require("shared.state")
local utils     = require("shared.utils")
local scheduler = require("core.scheduler")
local tracker   = require("backend.domain.tracker")
local power     = require("backend.domain.power")
local machines  = require("backend.hardware.machines")
local system    = require("backend.app.system")
local watch     = {}
local lastMismatchWarn = {}
function watch.onLevelRulesChanged(payload)
    system.auditThresholds()
    system.requestPlan("阈值变化")
end
local function warnParallelMismatch(level, snap)
    if not state.read.running() then
        lastMismatchWarn[level] = nil
        return
    end
    local sample = snap.sample
    local text
    if sample and (snap.deployed or 0) > 0 then
        local suggest = power.suggest(level)
        if sample ~= suggest then
            text = string.format("%s 当前 %s / 建议 %s", constants.levelLabel(level),
                utils.formatShortNumber(sample), utils.formatShortNumber(suggest))
        end
    end
    if text ~= lastMismatchWarn[level] then
        lastMismatchWarn[level] = text
        if text then logs.warn("当前并行与建议并行不一致：" .. text) end
    end
end
function watch.onPlantObserved(payload)
    local level     = payload.level
    local snap      = state.read.plant(level)
    local prev      = snap.lastSwitch
    state.write.setLastSwitch(level, payload.switch)
    if level == constants.HOST_LEVEL then
        if payload.switch == false and (prev == nil or prev == true) then
            logs.append("[警告] 主机未开机；请开启净水主机")
        elseif payload.switch == true and prev == false then
            logs.append("[系统] 主机已开机；不会自动恢复调度，点【启动系统】恢复")
        end
        if payload.switch == false then
            system.ensureHostStopped()
        end
        return
    end
    warnParallelMismatch(level, snap)
    local edge = (prev ~= nil and payload.switch ~= nil and prev ~= payload.switch)
    if edge then
        logs.system(string.format("%s 机器%s", constants.levelLabel(level),
            payload.switch and "打开" or "关闭"))
        tracker.clear(machines.of(level))
    end
    if payload.switch == nil then return end
    local want = payload.want
    if want == nil or payload.switch == want then return end
    scheduler.emit("switch_mismatch", {
        level = level, want = want, got = payload.switch
    })
end
function watch.onHostCycleStarted(payload)
    if not state.read.running() then return end
    local seq = payload and payload.seq
    for _, sample in ipairs((payload and payload.samples) or {}) do
        if tracker.feed(sample.address, sample.parallel, seq) == "write" then
            scheduler.emit("parallel_write", {
                level   = sample.level,
                address = sample.address,
                parallel = sample.parallel,
                success = sample.success,
                by = "周期开始采样"
            })
        end
    end
end
return watch

backend/domain/actuator.lua
1468
local constants = require("shared.constants")
local computer  = require("computer")
local device    = require("backend.hardware.device")
local machines  = require("backend.hardware.machines")
local actuator  = {}
local receipt   = { at = 0, items = {} }
function actuator.apply(plan)
    local now    = computer.uptime()
    receipt      = { at = now, items = {} }
    local count  = 0
    local failed = {}
    for level = 1, constants.LEVEL_COUNT do
        local list = machines.of(level)
        if #list > 0 then
            local want = plan[level] == true
            for _, m in ipairs(list) do
                local item = { level = level, address = m.address, want = want, ok = true }
                local _, err = device.invoke(m.address, "setWorkAllowed", want)
                if err then
                    item.ok, item.err = false, err
                    failed[level]     = tostring(err)
                end
                receipt.items[#receipt.items + 1] = item
                count = count + 1
            end
        end
    end
    return count, failed
end
function actuator.shutdownAll()
    return actuator.apply({})
end
function actuator.lastReceipt()
    return receipt
end
function actuator.describeReceipt()
    local failed = 0
    for _, item in ipairs(receipt.items) do
        if not item.ok then failed = failed + 1 end
    end
    return string.format("下发 %d 台，失败 %d 台", #receipt.items, failed)
end
return actuator

backend/domain/allocator.lua
