local scheduler = require("core.scheduler")
local system    = require("backend.app.system")
local produceApp = require("backend.app.produce")
local handlers  = {}
local watch     = nil
local rates     = nil
local function watchApp()
    watch = watch or require("backend.app.watch")
    return watch
end
local function ratesApp()
    rates = rates or require("backend.app.rates")
    return rates
end
function handlers.subscribe()
    scheduler.on("hardware_missing", system.onHardwareMissing)
    scheduler.on("hardware_changed", system.onHardwareChanged)
    scheduler.on("power_changed", system.onPowerChanged)
    scheduler.on("deployed_changed", system.onDeployedChanged)
    scheduler.on("plant_observed", function(...) return watchApp().onPlantObserved(...) end)
    scheduler.on("level_rules_changed", function(...) return watchApp().onLevelRulesChanged(...) end)
    scheduler.on("rates_changed", function(...) return ratesApp().onRatesChanged(...) end)
    scheduler.on("mode_changed", function(...) return ratesApp().onModeChanged(...) end)
    scheduler.on("enforce_changed", function(...) return ratesApp().onEnforceChanged(...) end)
    scheduler.on("parallel_write", system.onParallelWrite)
    scheduler.on("switch_mismatch", system.onSwitchMismatch)
    scheduler.on("rules_audit", system.auditThresholds)
    scheduler.on("produce_changed", system.onProduceChanged)
    scheduler.on("produce_changed", produceApp.syncJobs)
    scheduler.on("plant_observed", produceApp.syncJobs)
    scheduler.on("host_cycle_started", produceApp.onCycleStarted)
    scheduler.on("host_cycle_started", function(...) return watchApp().onHostCycleStarted(...) end)
    scheduler.on("schedule_now", system.onScheduleRequest)
    return 18
end
return handlers

backend/hardware/device.lua
3192
local component      = require("component")
local device         = {}
local ME_CANDIDATES  = { "fluid_interface", "me_interface" }
local NET_CANDIDATES = { "modem", "tunnel" }
local TRANSPOSER     = "transposer"
local GT_MACHINE     = "gt_machine"
local cache          = { me = false, net = false }
local sweepList      = {}
local machineAddrs   = {}
local transposerSet  = nil
local function inCandidates(ctype, list)
    for _, candidate in ipairs(list) do
        if ctype == candidate then return true end
    end
    return false
end
function device.sweep()
    local out, transposers = {}, {}
    for address, ctype in component.list() do
        out[#out + 1] = { address = address, ctype = ctype }
        if ctype == TRANSPOSER then transposers[address] = true end
    end
    sweepList = out
    transposerSet = transposers
end
function device.scanMe()
    for _, item in ipairs(sweepList) do
        if inCandidates(item.ctype, ME_CANDIDATES) then
            cache["me"] = { address = item.address, compType = item.ctype }
            return
        end
    end
    cache["me"] = false
end
function device.scanNet()
    for _, item in ipairs(sweepList) do
        if inCandidates(item.ctype, NET_CANDIDATES) then
            cache["net"] = { address = item.address, compType = item.ctype }
            return
        end
    end
    cache["net"] = false
end
function device.scanMachines()
    local out = {}
    for _, item in ipairs(sweepList) do
        if item.ctype == GT_MACHINE then out[#out + 1] = item.address end
    end
    machineAddrs = out
    return out
end
function device.me()
    local hit = cache["me"]
    if hit then return hit.address, hit.compType end
    return nil, nil
end
function device.net()
    local hit = cache["net"]
    if hit then return hit.address, hit.compType end
    return nil, nil
end
function device.machines()
    return machineAddrs
end
function device.scanTransposers()
    local out, transposers = {}, {}
    for address in component.list(TRANSPOSER) do
        out[#out + 1] = address
        transposers[address] = true
    end
    transposerSet = transposers
    return out
end
function device.isTransposerOnline(address)
    if not address or address == "" then return false end
    if transposerSet then return transposerSet[address] == true end
    local ok, ctype = pcall(component.type, address)
    return ok and ctype == TRANSPOSER
end
function device.name(address)
    if not address then return nil end
    local name = device.invoke(address, "getName")
    if type(name) == "string" and name ~= "" then return name end
    return nil
end
function device.coordinates(address)
    if not address then return nil, nil, nil end
    local ok, x, y, z = pcall(component.invoke, address, "getCoordinates")
    if ok and type(x) == "number" and type(y) == "number" and type(z) == "number" then
        return x, y, z
    end
    return nil, nil, nil
end
function device.invoke(address, method, ...)
    if not address then return nil, "地址为空" end
    local ok, value, reason = pcall(component.invoke, address, method, ...)
    if not ok then return nil, tostring(value) end
    return value, nil, reason
end
return device

backend/hardware/energy.lua
1889
local energy = {}
local constants = require("shared.constants") 
local function tierVoltage(word)
    local key = word:lower()
    for _, tier in ipairs(constants.VOLTAGE_TIERS) do
        if tier.name:lower() == key then return tier.eu end
    end
    return nil
end
local function bufferK(head)
    if head:find("wirelesstunnel", 1, true) then return 4000 end 
    if head:find("tunnel", 1, true) then return 24 end
    if head:find("wirelessenergyhatch", 1, true) then return 4000 end
    return nil
end
local function whole(x)
    return math.floor(x + 0.5)
end
function energy.powerOf(item, euMax)
    local name = tostring(item and item.name or "")
    local gtnltier, gtnlamps = name:match("wirelessenergyhatch(%a+)(%d+)a$")
    local tier = tonumber(name:match("tier%.(%d+)"))
    local head = name:match("^hatch%.([^.]+)") or name
    local voltage, amps, tunnel
    if gtnltier then
        voltage = tierVoltage(gtnltier)
        if not voltage then return 0 end
        amps = tonumber(gtnlamps)
    elseif tier then
        local multi = tonumber(head:match("multi(%d+)"))
        tunnel = tonumber(head:match("tunnel(%d+)"))
        amps = 1
        if multi then
            amps = multi
        elseif tunnel then
            amps = 64 * (4 ^ tunnel)
        end
        voltage = 8 * (4 ^ tier)
    else
        return 0
    end
    local nominal = voltage * amps
    if tunnel or gtnltier then
        local k = bufferK(head)
        if k and type(euMax) == "number" and euMax > 0 then
            local exact = euMax / k
            if exact ~= nominal then
                return whole(exact), string.format(
                    "激光仓限流至 %.0f A（最高 %.0f A）",
                    exact / voltage,
                    amps
                )
            end
            return whole(exact)
        end
    end
    return whole(nominal)
end
return energy

backend/hardware/fluid.lua
