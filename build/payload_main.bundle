local constants = require("shared.constants")
local machines = {}
local byAddress = {}
local reg = { other = {} }
for level = 0, constants.LEVEL_COUNT do reg[level] = {} end
local energyItem = nil
local changed = false
local ENERGY_PATTERNS = {
    "hatch.energytunnel", "hatch.energywirelesstunnel",
    "hatch.energymulti", "hatch.energywirelessmulti",
    "wirelessenergyhatch",
}
local function isEnergy(name)
    name = tostring(name or "")
    for _, pattern in ipairs(ENERGY_PATTERNS) do
        if name:find(pattern, 1, true) then return true end
    end
    return false
end
local function wantsCoordinates(level)
    return type(level) == "number" and level >= 1 and level <= constants.LEVEL_COUNT
end
local function newEntry(level, address, name, x, y, z)
    if not wantsCoordinates(level) then x, y, z = nil, nil, nil end
    return {
        level = level,
        address = address,
        name = name,
        x = x,
        y = y,
        z = z,
        present = true,
        produce = {
            enabled = false,
            bound = false,
            transposer = nil,
            side = nil,
            slot = nil,
        },
    }
end
local function bucket(level)
    if level == "E" or level == "?" then return reg.other end
    local number = tonumber(level)
    if number and number >= 0 and number <= constants.LEVEL_COUNT then return reg[number] end
    return reg.other
end
local function removeFromBucket(entry)
    local list = bucket(entry.level)
    for index = #list, 1, -1 do
        if list[index] == entry then table.remove(list, index) end
    end
end
local function register(level, address, name, x, y, z)
    if byAddress[address] then return byAddress[address] end
    local entry = newEntry(level, address, name, x, y, z)
    byAddress[address] = entry
    table.insert(bucket(level), entry)
    if level == "E" and not energyItem then energyItem = entry end
    changed = true
    return entry
end
local function parseLine(line)
    local level, address, name, rest = tostring(line):match("^%s*(%S+)%s+(%S+)%s+(%S+)%s*(.-)%s*$")
    if not level or not address or not name then return nil end
    local x, y, z
    if rest and rest ~= "" then
        local px, py, pz = rest:match("^(%S+)%s+(%S+)%s+(%S+)")
        x = px ~= "-" and tonumber(px) or nil
        y = py ~= "-" and tonumber(py) or nil
        z = pz ~= "-" and tonumber(pz) or nil
    end
    return level, address, name, x, y, z
end
function machines.load(lines)
    byAddress, reg, energyItem, changed = {}, { other = {} }, nil, false
    for level = 0, constants.LEVEL_COUNT do reg[level] = {} end
    for _, line in ipairs(lines or {}) do
        local level, address, name, x, y, z = parseLine(line)
        if address and name then
            if level ~= "E" and level ~= "?" then
                level = tonumber(level)
                if not level or level < 0 or level > constants.LEVEL_COUNT then level = "?" end
            end
            register(level, address, name, x, y, z)
        end
    end
    changed = false
end
function machines.needsCoordinates()
    local out = {}
    for level = 1, constants.LEVEL_COUNT do
        for _, entry in ipairs(reg[level]) do
            if entry.x == nil or entry.y == nil or entry.z == nil then
                out[#out + 1] = entry.address
            end
        end
    end
    table.sort(out)
    return out
end
function machines.setCoordinates(address, x, y, z)
    local entry = byAddress[address]
    if not entry or not wantsCoordinates(entry.level) then return false end
    if entry.x ~= x or entry.y ~= y or entry.z ~= z then
        entry.x, entry.y, entry.z = x, y, z
        changed = true
        return true
    end
    return false
end
function machines.prepareScan(devices)
    local removed = {}
    for address, entry in pairs(byAddress) do
        if devices[address] ~= "gt_machine" then
            removed[#removed + 1] = entry
        else
            entry.present = true
        end
    end
    for _, entry in ipairs(removed) do
        byAddress[entry.address] = nil
        removeFromBucket(entry)
        if energyItem == entry then energyItem = nil end
        changed = true
    end
    local candidates = {}
    for address, kind in pairs(devices) do
        if kind == "gt_machine" and not byAddress[address] then
            candidates[#candidates + 1] = address
        end
    end
    table.sort(candidates)
    return candidates, removed
end
function machines.levelForName(name)
    local level = constants.MACHINE_NAMES[name]
    if level ~= nil then return level end
    if isEnergy(name) and not energyItem then return "E" end
    return "?"
end
function machines.update(address, name, x, y, z)
    local entry = byAddress[address]
    if not entry then return nil end
    local dirty = false
    if name and name ~= "" and name ~= entry.name then
        entry.name = name
        dirty = true
    end
    local level = entry.level
    if entry.name then
        if isEnergy(entry.name) and (entry.level == "E" or energyItem == entry) then
            level = "E"
        else
            level = machines.levelForName(entry.name)
        end
    end
    if level ~= entry.level then
        removeFromBucket(entry)
        entry.level = level
        local list = bucket(level)
        local found = false
        for _, existing in ipairs(list) do
            if existing == entry then found = true; break end
        end
        if not found then table.insert(list, entry) end
        if entry == energyItem and level ~= "E" then energyItem = nil end
        if level == "E" and energyItem == nil then energyItem = entry end
        dirty = true
    end
    if not wantsCoordinates(entry.level) then
        x, y, z = nil, nil, nil
    end
    if x ~= nil and y ~= nil and z ~= nil
        and (entry.x ~= x or entry.y ~= y or entry.z ~= z) then
        entry.x, entry.y, entry.z = x, y, z
        dirty = true
    end
    entry.present = true
    if dirty then changed = true end
    return entry
end
function machines.add(address, name, x, y, z)
    if byAddress[address] then return byAddress[address] end
    local level = machines.levelForName(name)
    return register(level, address, name, x, y, z)
end
function machines.isRegistered(address)
    return byAddress[address] ~= nil
end
function machines.of(level)
    return reg[level] or {}
end
function machines.energy()
    return energyItem
end
function machines.all()
    return byAddress
end
function machines.summary()
    local units, total = {}, 0
    for level = 1, constants.LEVEL_COUNT do
        local count = 0
        for _, entry in ipairs(reg[level]) do
            if entry.present then count = count + 1 end
        end
        units[level] = count
        total = total + count
    end
    local host = 0
    for _, entry in ipairs(reg[0]) do if entry.present then host = host + 1 end end
    return {
        host = host,
        unitTotal = total,
        units = units,
        energy = energyItem ~= nil,
        other = #reg.other,
    }
end
local function coordinatesText(entry)
    local x = entry.x ~= nil and tostring(entry.x) or "-"
    local y = entry.y ~= nil and tostring(entry.y) or "-"
    local z = entry.z ~= nil and tostring(entry.z) or "-"
    return x, y, z
end
function machines.topologyLines()
    local lines = {}
    for level = 0, constants.LEVEL_COUNT do
        for _, entry in ipairs(reg[level]) do
            local x, y, z = coordinatesText(entry)
            if not wantsCoordinates(level) then x, y, z = "-", "-", "-" end
            lines[#lines + 1] = string.format("%d %s %s %s %s %s",
                level, entry.address, entry.name, x, y, z)
        end
    end
    for _, entry in ipairs(reg.other) do
        lines[#lines + 1] = string.format("%s %s %s - - -",
            entry.level, entry.address, entry.name)
    end
    table.sort(lines)
    return lines
end
function machines.consumeChanged()
    local value = changed
    changed = false
    return value
end
function machines.markChanged()
    changed = true
end
return machines

hardware/probes.lua
1320
local device = require("hardware.device")
local gt_infodata = require("hardware.gt_infodata")
local probes = {}
function probes.switch(address)
    local value, reason = device.invoke(address, "isWorkAllowed")
    if type(value) ~= "boolean" then return nil, reason or "switch is not boolean" end
    return value
end
function probes.active(address)
    local value, reason = device.invoke(address, "isMachineActive")
    if type(value) ~= "boolean" then return nil, reason or "active is not boolean" end
    return value
end
function probes.progress(address)
    local value, reason = device.invoke(address, "getWorkProgress")
    if type(value) ~= "number" then return nil, reason or "progress is not numeric" end
    return value
end
function probes.progressMax(address)
    local value, reason = device.invoke(address, "getWorkMaxProgress")
    if type(value) ~= "number" then return nil, reason or "max progress is not numeric" end
    return value
end
function probes.sensor(address)
    local lines, reason = device.invoke(address, "getSensorInformation")
    if type(lines) ~= "table" then return nil, reason or "sensor has no lines" end
    local common = gt_infodata.parse(lines)
    return {
        parallel = common.parallel,
        success = common.success,
        lines = lines,
    }
end
return probes

hardware/transposer.lua
3362
local device = require("hardware.device")
local transposer = {}
local function tankEntry(tank, info)
    if type(info) == "string" then
        return { tank = tank, fluid = info, amount = 0 }
    end
    if type(info) ~= "table" then
        return { tank = tank, fluid = nil, amount = 0 }
    end
    local fluid = info.fluid
    local name = info.name or (type(fluid) == "table" and fluid.name) or fluid
    local amount = info.amount or (type(fluid) == "table" and fluid.amount) or 0
    return {
        tank = tank,
        fluid = (type(name) == "string" and name ~= "") and name or nil,
        amount = tonumber(amount) or 0,
    }
end
local function numericLen(value)
    local length = 0
    for key in pairs(value or {}) do
        if type(key) == "number" and key > length then length = key end
    end
    return length
end
local function allTankEntries(all)
    if type(all) ~= "table" or next(all) == nil then return nil end
    if all.name ~= nil or all.amount ~= nil or all.fluid ~= nil then
        return { tankEntry(1, all) }
    end
    local count = numericLen(all)
    if count <= 0 then return nil end
    local out = {}
    for tank = 1, count do out[#out + 1] = tankEntry(tank, all[tank]) end
    return out
end
function transposer.containers(address, side)
    local all, err = device.invoke(address, "getFluidInTank", side)
    local out = allTankEntries(all)
    if out then return out, nil end
    return nil, tostring(err or "无流体容器")
end
local function allStacksEntries(value)
    if value == nil then return nil end
    local ok, all = pcall(function() return value:getAll() end)
    if not ok or type(all) ~= "table" then return nil end
    local out = {}
    for index, stack in pairs(all) do
        local slot = tonumber(index)
        if slot and type(stack) == "table" and stack.name then
            out[#out + 1] = {
                slot = slot + 1,
                name = stack.name,
                damage = tonumber(stack.damage) or 0,
                label = stack.label,
                size = tonumber(stack.size) or 0,
                maxSize = tonumber(stack.maxSize) or 64,
            }
        end
    end
    table.sort(out, function(a, b) return a.slot < b.slot end)
    return out
end
function transposer.items(address, side)
    local value, err = device.invoke(address, "getAllStacks", side)
    local out = allStacksEntries(value)
    if out then return out, nil end
    return nil, tostring(err or "无物品库存")
end
function transposer.rate(address)
    local value, err = device.invoke(address, "getFluidTransferRate")
    if type(value) == "number" then return value, nil end
    return nil, tostring(err or "读不到转运速率")
end
function transposer.transferFluid(address, from, to, amount, sourceTank)
    local moved, _, second = device.invoke(address, "transferFluid", from, to, amount,
        math.max(0, (tonumber(sourceTank) or 1) - 1))
    if moved == true then return true, tonumber(second) or amount end
    return false, tostring(second or "转运失败")
end
function transposer.transferItem(address, from, to, count, sourceSlot)
    local moved, _, second = device.invoke(address, "transferItem", from, to, count, sourceSlot)
    if type(moved) == "number" then return true, moved end
    return false, tostring(second or "物品转运失败")
end
return transposer

main.lua
6717
local selfPath = (debug.getinfo(1, "S").source or ""):gsub("^@", "")
local selfDir = selfPath:match("^(.*)[/\\][^/\\]*$")
local locateChunk = assert(loadfile((selfDir or ".") .. "/core/locate.lua"), "cannot load core/locate.lua")
local locate = locateChunk()
local appDir = locate.appDir(arg and arg[1], selfPath)
if appDir == "" then
    print("无法定位应用目录（需要 core/bootstrap.lua）")
    return
end
locate.injectPath(appDir)
local bootstrap = require("core.bootstrap")
bootstrap.clearModuleCache()
bootstrap = require("core.bootstrap")
local storage = require("services.storage")
storage.setRoot(appDir)
local event = require("event")
local config = require("shared.config")
local kernel = require("core.kernel")
local state = require("services.state")
local work = require("services.work")
local ui = require("frontend.app")
local config_service = require("services.config_service")
local autostart_service = require("services.autostart_service")
local net_service = require("services.net_service")
local log_flush = require("services.log_flush")
local read_model = require("services.read_model")
local hardware_service = require("services.hardware_service")
local produce_service = require("services.produce_service")
local schedule_service = require("services.schedule_service")
local produce_runtime = require("services.produce_runtime")
local history_service = require("services.history_service")
local log = require("services.log")
local clock = require("services.clock")
local function wait(delay)
    local values = { event.pull(delay) }
    if values[1] == nil then return nil end
    return values
end
local exitReason = "程序退出"
local function run()
    local quitting = false
    local uiDirty = false
    state.start(clock.uptime())
    local configOk, configErr = config_service.load()
    if not configOk then log.error("配置载入失败：" .. tostring(configErr)) end
    autostart_service.refresh()
    net_service.setSource(read_model.snapshot)
    net_service.load(clock.uptime())
    log_flush.load(clock.uptime())
    hardware_service.load()
    produce_service.load()
    schedule_service.load()
    produce_runtime.load()
    history_service.load()
    log.system("PurifyWater " .. bootstrap.version() .. " 启动")
    ui.boot({ theme = state.get().settings.theme })
    ui.setActionHandler(function(name, action)
        if name == "quit" then
            produce_service.cancelBind()
            exitReason = "用户退出"
            quitting = true
            return true
        end
        if name == "refresh" then
            hardware_service.requestRefresh()
            produce_service.requestRefresh()
            return true
        end
        local recognized, ok, err = schedule_service.handle(name, action)
        if recognized then
            if ok == false and err and err ~= "" then log.warn("操作未完成：" .. tostring(err)) end
            return ok
        end
        recognized, ok, err = produce_service.handle(name, action)
        if recognized then
            if ok == false and err and err ~= "" then log.warn("操作未完成：" .. tostring(err)) end
            return ok
        end
        recognized, ok, err = net_service.handle(name)
        if recognized then
            if ok == false and err and err ~= "" then log.warn("操作未完成：" .. tostring(err)) end
            return ok
        end
        recognized, ok, err = autostart_service.handle(name)
        if recognized then
            if ok == false and err and err ~= "" then log.warn("操作未完成：" .. tostring(err)) end
            return ok
        end
        ok, err = config_service.handle(name, action)
        if ok == false and err and err ~= "" then log.warn("操作未完成：" .. tostring(err)) end
        return ok
    end)
    local uiReadyLogged = false
    ui.setObserver(function(kind, data)
        if kind == "frame" and not uiReadyLogged and (data.draws or 0) > 0 then
            uiReadyLogged = true
            log.diag(string.format("界面就绪：绘制 %d 项，页面 %s",
                data.draws, tostring(data.page or "-")))
        end
    end)
    kernel.run({
        clock = clock.uptime,
        wait = wait,
        input = function(signal)
            if signal[1] == "interrupted" then
                produce_service.cancelBind()
                exitReason = "程序中断"
                quitting = true
            elseif signal[1] == "key_down" and signal[3] == 113 then
                produce_service.cancelBind()
                exitReason = "用户退出"
                quitting = true
            else
                if ui.handle(signal) then uiDirty = true end
            end
        end,
        quit = function() return quitting end,
        nextDue = work.nextDue,
        step = function(now)
            if uiDirty then
                uiDirty = false
                ui.frameInput()
                return
            end
            local item = work.select(now)
            if not item then return end
            state.setNow(now)
            local ok, result = pcall(item.run, now)
            local finishedAt = clock.uptime()
            state.setNow(finishedAt)
            if not ok then
                log.error("后台任务失败：" .. tostring(result))
                log.diag("任务：" .. tostring(item.name))
            end
            if ok then
                work.after(item, finishedAt, result == true)
            else
                work.fail(item, finishedAt)
            end
            ui.frameData()
        end,
    })
end
local ok, fatalError = xpcall(run, debug.traceback)
if not ok then log.error("程序异常退出：" .. tostring(fatalError)) end
local shutdownOk, shutdownErr = schedule_service.shutdownNow(exitReason)
if not shutdownOk then log.warn("退出全关失败：" .. tostring(shutdownErr)) end
local historyOk, historyErr = history_service.save()
if not historyOk then log.warn("退出时历史保存失败：" .. tostring(historyErr)) end
local runtimeData = state.get()
local runSeconds = math.max(0, (tonumber(clock.uptime()) or 0) - (tonumber(runtimeData.startedAt) or 0))
log.system(string.format("PurifyWater 已退出：%s｜运行 %.0f 秒", tostring(exitReason), runSeconds))
local logOk, logPathOrErr = log.flush()
ui.restoreResolution()
bootstrap.releaseConsole(config.UI.EXIT_LOG_ROW or 1)
print(string.format("已退出：%s｜运行 %.0f 秒", tostring(exitReason), runSeconds))
if logOk then
    print("日志：" .. tostring(logPathOrErr))
else
    print("日志写入失败：" .. tostring(logPathOrErr))
end
print("开机自启动：" .. (runtimeData.settings.autostart == true and "已开启" or "未开启"))

services/autostart_service.lua
1959
local state = require("services.state")
local log = require("services.log")
local store = require("services.autostart_store")
local service = {}
local function apply(info)
    local settings = state.get().settings
    settings.autostart = info.enabled == true
    settings.autostartStale = info.stale == true
    settings.autostartPath = info.path
    state.bump()
end
function service.refresh()
    local info = store.read()
    apply(info)
    if info.enabled then
        log.system(string.format("开机自启：已开启（%s）", tostring(info.path)))
    elseif info.stale then
        log.warn(string.format("开机自启指向其它路径：%s（配置页重新勾选可更新）",
            tostring(info.target or "-")))
    end
    if info.manualLine then
        log.warn("检测到 .shrc 另有手动启动行，开机可能重复启动：" .. tostring(info.manualLine))
    end
    return info.enabled == true
end
function service.toggle()
    local info = store.read()
    if not info.enabled then
        local ok, result = store.enable()
        if not ok then
            local text = "开机自启设置失败：" .. tostring(result)
            log.warn(text)
            return false, text
        end
        apply({ enabled = true, stale = false, path = result })
        log.system(string.format("开机自启已开启：%s（下次开机生效）", tostring(result)))
        return true, ""
    end
    local ok, result = store.disable()
    if not ok then
        local text = "开机自启取消失败：" .. tostring(result)
        log.warn(text)
        return false, text
    end
    apply({ enabled = false, stale = false, path = result })
    log.system(string.format("开机自启已关闭：已从 %s 移除", tostring(result)))
    return true, ""
end
function service.handle(name)
    if name ~= "autostart_toggle" then return false end
    local ok, err = service.toggle()
    return true, ok, err
end
return service

services/autostart_store.lua
3368
local storage = require("services.storage")
local store = {}
local BEGIN_MARK = "# >>> PurifyWater autostart >>>"
local END_MARK = "# <<< PurifyWater autostart <<<"
local function shrcPath()
    local home = os.getenv("HOME")
    if type(home) ~= "string" or home == "" then home = "/home" end
    return home .. "/.shrc"
end
local function appPath()
    return tostring(storage.root() or "."):gsub("[/\\]+$", "")
end
local function mainPath()
    return appPath() .. "/main.lua"
end
local function trim(text)
    return (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end
local function splitLines(text)
    local out = {}
    for line in (tostring(text or "") .. "\n"):gmatch("(.-)\n") do
        out[#out + 1] = line:gsub("\r$", "")
    end
    if out[#out] == "" then out[#out] = nil end
    return out
end
local function joinLines(lines)
    if #lines == 0 then return "" end
    return table.concat(lines, "\n") .. "\n"
end
local function extractBlocks(lines)
    local kept, commands, removed = {}, {}, 0
    local index = 1
    while index <= #lines do
        if trim(lines[index]) == BEGIN_MARK then
            removed = removed + 1
            index = index + 1
            while index <= #lines and trim(lines[index]) ~= END_MARK do
                local body = trim(lines[index])
                if body ~= "" then commands[#commands + 1] = body end
                index = index + 1
            end
            if index <= #lines then index = index + 1 end
        else
            kept[#kept + 1] = lines[index]
            index = index + 1
        end
    end
    return kept, commands, removed
end
local function findManualLine(lines, target)
    for _, line in ipairs(lines) do
        local value = trim(line)
        if value ~= "" and value:sub(1, 1) ~= "#" and value:find(target, 1, true) then
            return value
        end
    end
    return nil
end
function store.read()
    local path = shrcPath()
    local text = storage.readText(path)
    local kept, commands = extractBlocks(splitLines(text))
    local target = commands[#commands] or nil
    local want = mainPath()
    local matches = target ~= nil and target:find(want, 1, true) ~= nil
    return {
        enabled = matches,
        stale = target ~= nil and not matches,
        path = path,
        target = target,
        exists = text ~= nil,
        manualLine = findManualLine(kept, want),
    }
end
function store.enable()
    local path = shrcPath()
    local kept = extractBlocks(splitLines(storage.readText(path)))
    kept[#kept + 1] = BEGIN_MARK
    kept[#kept + 1] = string.format('cd "%s"', appPath())
    kept[#kept + 1] = string.format('lua "%s"', mainPath())
    kept[#kept + 1] = END_MARK
    local ok, err = storage.writeText(path, joinLines(kept))
    if not ok then return false, tostring(err or "写文件失败") end
    return true, path
end
function store.disable()
    local path = shrcPath()
    if not storage.exists(path) then return true, path end
    local kept, _, removed = extractBlocks(splitLines(storage.readText(path)))
    if removed == 0 then return true, path end
    local ok, err = storage.writeText(path, joinLines(kept))
    if not ok then return false, tostring(err or "写文件失败") end
    return true, path
end
function store.path() return shrcPath() end
function store.target() return mainPath() end
return store

