local state = {}
local data = {
    revision = 0,
    startedAt = 0,
    time = { now = 0, updatedAt = 0 },
    facts = {
        hardware = { value = nil, observedAt = 0 },
        water = { value = nil, observedAt = 0 },
        host = {
            switch = { value = nil, observedAt = 0 },
            active = { value = nil, observedAt = 0 },
