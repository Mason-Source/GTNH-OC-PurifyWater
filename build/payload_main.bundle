business/produce/t4.lua
2506
local resources = require("shared.resources")
local machine = require("business.produce.machine")
local flow = require("business.produce.flow")
local ACID = resources.FLUIDS.HYDROCHLORIC_ACID
local ALKALINE = resources.ITEMS.SODIUM_HYDROXIDE_DUST
local PH_TARGET = 7
local PH_TOLERANCE = 0.05
local PH_PER_DUST = 0.01
local PH_PER_10_ACID = 0.01
local MAX_DUST = 250
local MAX_ACID = 2500
local t4 = {
    level = 4,
    priority = 30,
    initial = "sensor",
}
function t4.requiredFluids() return { ACID } end
function t4.requiredItems() return { ALKALINE } end
function t4.minTransferRate() return 50000 end
function t4.demand(ph)
    ph = tonumber(ph)
    if ph == nil then return nil, "读不到 pH", nil end
    if ph <= 0 then return nil, "pH 尚未初始化", ph end
    local errorValue = PH_TARGET - ph
    if math.abs(errorValue) <= PH_TOLERANCE then return {}, nil, ph end
    if errorValue > 0 then
        local count = math.min(MAX_DUST, math.floor(errorValue / PH_PER_DUST + 0.5))
        return { { item = ALKALINE, amount = count, label = ALKALINE.label } }, nil, ph
    end
    local doses = math.floor((-errorValue) / PH_PER_10_ACID + 0.5)
    local amount = math.min(MAX_ACID, doses * 10)
    return { { fluid = ACID.id, amount = amount, label = ACID.label } }, nil, ph
end
function t4.build()
    return { state = "sensor" }
end
t4.states = {
    sensor = function(task, event, _, _)
        if event == nil then
            return machine.command("sensor", { field = "ph" }, "sensor")
        end
        if not event.ok then return machine.fail("读不到 pH：" .. tostring(event.err)) end
        local demand, why = t4.demand(event.value)
        if not demand then return machine.fail(why) end
        if #demand == 0 then return machine.done() end
        task.need = demand[1]
        return machine.jump("transfer")
    end,
    transfer = function(task, event, _, env)
        local need = task.need
        if not need then return machine.fail("T4 缺少 pH 调节需求") end
        local sides = task.entry.sides or {}
        local action, done
        if need.item then
            action, done = flow.item("io", task, event, need.item, need.amount,
                sides.itemTarget, "transfer")
        else
            action, done = flow.fluid("io", task, event, { id = need.fluid, label = need.label },
                need.amount, sides.target, env, "transfer")
        end
        if done then return machine.done() end
        return action
    end,
}
return t4

business/produce/t5.lua
4350
local resources = require("shared.resources")
local machine = require("business.produce.machine")
local flow = require("business.produce.flow")
local PLASMA = resources.FLUIDS.HELIUM_PLASMA
local COOLANT = resources.FLUIDS.SUPERCOOLANT
local HEAT_TARGET = 10000
local MAX_TEMP = 12500
local MAX_CYCLES = 3
local PLASMA_NEED = 100
local COOLANT_NEED = 2000
local CYCLE_SETTLE = 1
local t5 = {
    level = 5,
    priority = 5,
    initial = "init",
}
function t5.requiredFluids() return { PLASMA, COOLANT } end
function t5.build()
    return { state = "init", cycles = 0, temperature = 0 }
end
local function readTemperature(task)
    return machine.command("sensor", { field = "temperature" }, task.state)
end
local function applyTemperature(task, event)
    if not event.ok then return machine.fail("温度不可读：" .. tostring(event.err)) end
    local temperature = tonumber(event.value)
    if temperature == nil then return machine.fail("温度不是数值") end
    if temperature > MAX_TEMP then return machine.fail("温度超过安全上限") end
    task.temperature = temperature
    return nil
end
t5.states = {
    init = function(task, event, _, _)
        if event == nil then return readTemperature(task) end
        local failed = applyTemperature(task, event)
        if failed then return failed end
        if task.temperature > 0 then
            return machine.wait(task.temperature / 500, "precool_sensor")
        end
        return machine.jump("heat_start")
    end,
    precool_sensor = function(task, event, _, _)
        if event == nil then return readTemperature(task) end
        local failed = applyTemperature(task, event)
        if failed then return failed end
        if task.temperature > 0 then
            return machine.wait(task.temperature / 500, "precool_sensor")
        end
        return machine.jump("heat_start")
    end,
    heat_start = function(task, _, _, env)
        if task.cycles >= MAX_CYCLES then return machine.done() end
        local target = task.entry.sides and task.entry.sides.target
        local action = flow.fluid("heat", task, nil, { id = PLASMA.id, label = PLASMA.label },
            PLASMA_NEED, target, env, "heat_transfer")
        return action
    end,
    heat_transfer = function(task, event, _, env)
        local target = task.entry.sides and task.entry.sides.target
        local action, done = flow.fluid("heat", task, event, { id = PLASMA.id, label = PLASMA.label },
            PLASMA_NEED, target, env, "heat_transfer")
        if done then
            return machine.wait((HEAT_TARGET - math.max(0, task.temperature)) / 1000, "heat_sensor")
        end
        return action
    end,
    heat_sensor = function(task, event, _, _)
        if event == nil then return readTemperature(task) end
        local failed = applyTemperature(task, event)
        if failed then return failed end
        if task.temperature < HEAT_TARGET then
            return machine.wait((HEAT_TARGET - math.max(0, task.temperature)) / 1000, "heat_sensor")
        end
        return machine.jump("cool_start")
    end,
    cool_start = function(task, _, _, env)
        local target = task.entry.sides and task.entry.sides.target
        local action = flow.fluid("cool", task, nil, { id = COOLANT.id, label = COOLANT.label },
            COOLANT_NEED, target, env, "cool_transfer")
        return action
    end,
    cool_transfer = function(task, event, _, env)
        local target = task.entry.sides and task.entry.sides.target
        local action, done = flow.fluid("cool", task, event, { id = COOLANT.id, label = COOLANT.label },
            COOLANT_NEED, target, env, "cool_transfer")
        if done then
            return machine.wait(math.max(0.05, task.temperature / 500), "cool_sensor")
        end
        return action
    end,
    cool_sensor = function(task, event, _, _)
        if event == nil then return readTemperature(task) end
        local failed = applyTemperature(task, event)
        if failed then return failed end
        if task.temperature > 0 then
            return machine.wait(math.max(0.05, task.temperature / 500), "cool_sensor")
        end
        return machine.wait(CYCLE_SETTLE, "settle")
    end,
    settle = function(task, _, _, _)
        task.cycles = task.cycles + 1
        return machine.jump("heat_start")
    end,
}
return t5

business/produce/t6.lua
9063
local resources = require("shared.resources")
local machine = require("business.produce.machine")
local WAIT = 3
local MAX_PROBES = 6
local LENSES = {
    resources.ITEMS.LENS_SYNTHETIC_JADE,
    resources.ITEMS.LENS_AMBER,
    resources.ITEMS.LENS_WIND_MAGIC_CRYSTAL,
    resources.ITEMS.LENS_EMERALD,
    resources.ITEMS.LENS_MAGIC_DIAMOND,
    resources.ITEMS.LENS_BLUE_TOPAZ,
    resources.ITEMS.LENS_AMETHYST,
    resources.ITEMS.LENS_FLUORINE_IRON_TOURMALINE,
    resources.ITEMS.LENS_DILITHIUM,
}
local REQUIRED = {}
for index = 1, #LENSES - 1 do REQUIRED[index] = LENSES[index] end
local t6 = {
    level = 6,
    LENSES = LENSES,
    priority = 6,
    initial = "recover_read",
}
function t6.requiredItems() return REQUIRED end
function t6.build()
    return {
        state = "recover_read",
        lensIndex = 1,
        requestAttempts = 0,
        sourceIndex = 1,
    }
end
local function sameItem(stack, item)
    return stack.name == item.name and (tonumber(stack.damage) or 0) == (tonumber(item.damage) or 0)
end
local function signatureOf(event)
    if not event or not event.ok then return nil, tostring(event and event.err or "透镜需求不可读") end
    local signature = tostring(event.value or "")
    if signature == "" then return nil, "透镜需求签名为空" end
    return signature, nil
end
local function targetAndSources(task)
    local sides = task.entry.sides or {}
    return sides.itemTarget, sides.itemSources or {}
end
local function readTarget(task)
    local target = targetAndSources(task)
    if target == nil then return machine.fail("没有物品目标侧") end
    return machine.command("readItems", { side = target }, task.state)
end
t6.states = {
    recover_read = function(task, event, _, _)
        if event == nil then return readTarget(task) end
        if not event.ok then
            return machine.fail("目标侧读取失败：" .. tostring(event.err),
                { kind = "item", code = "TARGET_INVALID", side = targetAndSources(task) })
        end
        local items = event.items or {}
        if #items == 0 then
            task.nextProbeAt = 0
            task.requestAttempts = 0
            return machine.jump("request_read")
        end
        task.recoverStack = items[1]
        return machine.jump("recover_move")
    end,
    recover_move = function(task, event, _, _)
        local target, sources = targetAndSources(task)
        if event == nil then
            if target == nil then return machine.fail("没有物品目标侧") end
            local to = sources[1]
            if to == nil then return machine.fail("没有可回收的物品来源侧") end
            local stack = task.recoverStack
            if not stack then return machine.fail("T6 缺少待回收残留") end
            return machine.command("transferItem", {
                from = target, to = to, count = stack.size, slot = stack.slot,
            }, "recover_move")
        end
        local stack = task.recoverStack
        if not event.ok or tonumber(event.moved) ~= tonumber(stack.size) then
            return machine.fail("目标侧残留回收失败：" .. tostring(event.err or event.moved),
                { kind = "item", code = "RETURN_NOT_MOVED", item = stack, amount = stack.size })
        end
        task.recoverStack = nil
        return machine.jump("recover_read")
    end,
    request_read = function(task, event, now, _)
        if event == nil then
            if now < (task.nextProbeAt or 0) then
                return machine.wait(task.nextProbeAt - now, "request_read")
            end
            return machine.command("sensor", { field = "lensRequest" }, "request_read")
        end
        local signature, err = signatureOf(event)
        if signature then
            task.signature = signature
            task.lensIndex = 1
            task.currentLens = nil
            task.sourceIndex = 1
            return machine.jump("lens_find")
        end
        task.requestAttempts = (task.requestAttempts or 0) + 1
        if task.requestAttempts >= MAX_PROBES then
            return machine.fail("读取初始透镜需求失败：" .. tostring(err))
        end
        task.nextProbeAt = now + WAIT
        return machine.wait(WAIT, "request_read")
    end,
    wait_request = function(task, event, now, _)
        if event == nil then
            if now < (task.nextProbeAt or 0) then
                return machine.wait(task.nextProbeAt - now, "wait_request")
            end
            return machine.command("sensor", { field = "lensRequest" }, "wait_request")
        end
        local signature, err = signatureOf(event)
        if signature and signature ~= task.signature then
            task.nextSignature = signature
            task.currentLens = LENSES[task.lensIndex]
            task.lensIndex = task.lensIndex + 1
            return machine.jump("return_find")
        end
        task.requestAttempts = (task.requestAttempts or 0) + 1
        if task.requestAttempts >= MAX_PROBES then
            return machine.fail(string.format("等待第 %d 枚透镜需求变化失败：%s；%s 保留在目标侧",
                task.lensIndex + 1, tostring(err or "需求未变化"), LENSES[task.lensIndex].label))
        end
        task.nextProbeAt = now + WAIT
        return machine.wait(WAIT, "wait_request")
    end,
    return_find = function(task, event, _, _)
        if event == nil then return readTarget(task) end
        if not event.ok then
            return machine.fail("目标侧读取失败：" .. tostring(event.err),
                { kind = "item", code = "TARGET_INVALID", side = targetAndSources(task) })
        end
        task.returnSlot, task.returnSize = nil, nil
        for _, stack in ipairs(event.items or {}) do
            if sameItem(stack, task.currentLens) then
                task.returnSlot, task.returnSize = stack.slot, stack.size
                break
            end
        end
        task.sourceIndex = 1
        if task.returnSlot then return machine.jump("return_move") end
        return machine.jump("lens_find")
    end,
    return_move = function(task, event, _, _)
        local target, sources = targetAndSources(task)
        if event == nil then
            if target == nil then return machine.fail("没有物品目标侧") end
            local to = sources[1]
            if to == nil then return machine.fail("没有可回收的物品来源侧") end
            return machine.command("transferItem", {
                from = target, to = to, count = task.returnSize, slot = task.returnSlot,
            }, "return_move")
        end
        task.sourceIndex = 1
        return machine.jump("lens_find")
    end,
    lens_find = function(task, event, _, _)
        local _, sources = targetAndSources(task)
        local side = sources[task.sourceIndex]
        if side == nil then
            if task.lensIndex == #LENSES then return machine.done() end
            return machine.fail("找不到物品源：" .. tostring(LENSES[task.lensIndex].label))
        end
        if event == nil then
            return machine.command("readItems", { side = side }, "lens_find")
        end
        if not event.ok then
            return machine.fail("物品来源读取失败：" .. tostring(event.err),
                { kind = "item", code = "SOURCE_INVALID", side = side })
        end
        task.foundSlot, task.foundSize = nil, nil
        local lens = LENSES[task.lensIndex]
        for _, stack in ipairs(event.items or {}) do
            if sameItem(stack, lens) then
                task.foundSlot, task.foundSize = stack.slot, stack.size
                break
            end
        end
        if task.foundSlot then return machine.jump("lens_move") end
        task.sourceIndex = task.sourceIndex + 1
        return machine.jump("lens_find")
    end,
    lens_move = function(task, event, now, _)
        local target, sources = targetAndSources(task)
        local side = sources[task.sourceIndex]
        local lens = LENSES[task.lensIndex]
        if event == nil then
            if side == nil or target == nil then return machine.fail("T6 缺少透镜来源侧或目标侧") end
            return machine.command("transferItem", {
                from = side, to = target, count = 1, slot = task.foundSlot,
            }, "lens_move")
        end
        if not event.ok or (tonumber(event.moved) or 0) < 1 then
            if task.lensIndex == #LENSES then return machine.done() end
            return machine.fail(string.format("%s 投放失败：%s", lens.label, tostring(event.err or event.moved)),
                { kind = "item", code = "ITEM_NOT_MOVED", item = lens, side = side,
                  target = target, amount = 1 })
        end
        if task.lensIndex == #LENSES then return machine.done() end
        if task.nextSignature then task.signature = task.nextSignature end
        task.nextSignature = nil
        task.requestAttempts = 0
        task.nextProbeAt = now + WAIT
        return machine.wait(WAIT, "wait_request")
    end,
}
return t6

business/produce/t7.lua
3750
local resources = require("shared.resources")
local machine = require("business.produce.machine")
local flow = require("business.produce.flow")
local SUPERCONDUCTORS = {
    resources.FLUIDS.MOLTEN_SUPERCONDUCTOR_UV.id,
    resources.FLUIDS.MOLTEN_SUPERCONDUCTOR_UHV.id,
    resources.FLUIDS.MOLTEN_SUPERCONDUCTOR_UEV.id,
    resources.FLUIDS.MOLTEN_SUPERCONDUCTOR_UIV.id,
    resources.FLUIDS.MOLTEN_SUPERCONDUCTOR_UMV.id,
}
local SUPERCOOLANT = { fluid = resources.FLUIDS.SUPERCOOLANT.id, amount = 10000, label = resources.FLUIDS.SUPERCOOLANT.label, short = resources.FLUIDS.SUPERCOOLANT.short }
local GAS_HE = { fluid = resources.FLUIDS.HELIUM.id, amount = 10000, label = resources.FLUIDS.HELIUM.label }
local GAS_NE = { fluid = resources.FLUIDS.NEON.id, amount = 7500, label = resources.FLUIDS.NEON.label }
local GAS_KR = { fluid = resources.FLUIDS.KRYPTON.id, amount = 5000, label = resources.FLUIDS.KRYPTON.label }
local GAS_XE = { fluid = resources.FLUIDS.XENON.id, amount = 2500, label = resources.FLUIDS.XENON.label }
local SUPERCONDUCTOR = { any = SUPERCONDUCTORS, amount = 1440, label = "熔融超导粗胚", short = "超导粗胚" }
local NEUTRONIUM = { fluid = resources.FLUIDS.MOLTEN_NEUTRONIUM.id, amount = 4608, label = resources.FLUIDS.MOLTEN_NEUTRONIUM.label }
local FLUIDS = {
    resources.FLUIDS.SUPERCOOLANT,
    resources.FLUIDS.HELIUM,
    { label = "熔融超导粗胚（UV-UMV 任意）", any = SUPERCONDUCTORS },
    resources.FLUIDS.NEON,
    resources.FLUIDS.MOLTEN_NEUTRONIUM,
    resources.FLUIDS.KRYPTON,
    resources.FLUIDS.XENON,
}
local t7 = {
    level = 7,
    priority = 40,
    initial = "sensor",
}
function t7.requiredFluids() return FLUIDS end
function t7.minTransferRate() return 200000 end
function t7.demand(signal)
    local n = tonumber(signal)
    if n == nil then return nil, "读不到控制信号", nil end
    if n >= 8 then return {}, nil, n end
    if n == 0 then return { SUPERCOOLANT }, nil, n end
    local out = {}
    if n % 2 == 1 then
        local gas = math.floor(n / 2) % 4
        if gas == 0 then out[#out + 1] = GAS_HE
        elseif gas == 1 then out[#out + 1] = GAS_NE
        elseif gas == 2 then out[#out + 1] = GAS_KR
        else out[#out + 1] = GAS_XE end
    end
    if math.floor(n / 2) % 2 == 1 then out[#out + 1] = SUPERCONDUCTOR end
    if math.floor(n / 4) % 2 == 1 then out[#out + 1] = NEUTRONIUM end
    return out, nil, n
end
function t7.build()
    return { state = "sensor", index = 1 }
end
t7.states = {
    sensor = function(task, event, _, _)
        if event == nil then
            return machine.command("sensor", { field = "controlSignal" }, "sensor")
        end
        if not event.ok then return machine.fail("读不到控制信号：" .. tostring(event.err)) end
        local demand, why = t7.demand(event.value)
        if not demand then return machine.fail(why) end
        if #demand == 0 then return machine.done() end
        task.needs = demand
        task.index = 1
        return machine.jump("transfer")
    end,
    transfer = function(task, event, _, env)
        local need = task.needs and task.needs[task.index]
        if not need then return machine.done() end
        local target = task.entry.sides and task.entry.sides.target
        local spec = need.fluid and { id = need.fluid, label = need.label, short = need.short }
            or { any = need.any, label = need.label, short = need.short }
        local action, done = flow.fluid("io", task, event, spec, need.amount, target, env, "transfer")
        if done then
            task.index = task.index + 1
            if task.index > #task.needs then return machine.done() end
            return machine.jump("transfer")
        end
        return action
    end,
}
return t7

business/produce/t8.lua
2025
local resources = require("shared.resources")
local machine = require("business.produce.machine")
local flow = require("business.produce.flow")
local CATALYSTS = {
    resources.ITEMS.QUARK_UP_CATALYST,
    resources.ITEMS.QUARK_DOWN_CATALYST,
    resources.ITEMS.QUARK_STRANGE_CATALYST,
    resources.ITEMS.QUARK_CHARM_CATALYST,
    resources.ITEMS.QUARK_BOTTOM_CATALYST,
    resources.ITEMS.QUARK_TOP_CATALYST,
}
local WALK = { 1, 2, 3, 4, 5, 6, 2, 4, 6, 1, 3, 5, 1, 4, 6, 3, 2, 5 }
local SETTLE_SECONDS = 2
local t8 = {
    level = 8,
    priority = 10,
    initial = "sensor",
}
function t8.requiredItems() return CATALYSTS end
local function toPercent(value)
    value = tonumber(value)
    if value == nil then return nil end
    if value <= 1 then value = value * 100 end
    return value
end
function t8.build()
    return { state = "sensor", index = 1, first = true }
end
t8.states = {
    sensor = function(task, event, _, _)
        if event == nil then
            return machine.command("sensor", { field = "success" }, "sensor")
        end
        if not event.ok then return machine.fail("成功率不可读：" .. tostring(event.err)) end
        local success = toPercent(event.value)
        if success == nil then return machine.fail("成功率不是数值") end
        if success >= 99.5 then return machine.done() end
        if task.first then
            task.first = false
            task.index = 1
        else
            task.index = task.index + 1
            if task.index > #WALK then return machine.fail("18 枚催化剂已投完，但成功率未达到 100%") end
        end
        return machine.jump("transfer")
    end,
    transfer = function(task, event, _, _)
        local item = CATALYSTS[WALK[task.index]]
        local target = task.entry.sides and task.entry.sides.itemTarget
        local action, done = flow.item("io", task, event, item, 1, target, "transfer")
        if done then return machine.wait(SETTLE_SECONDS, "sensor") end
        return action
    end,
}
return t8

business/suggest.lua
7210
local CONFIG = require("shared.config")
local constants = require("shared.constants")
local suggest = {}
local function serviceTop(snapshot)
    local top = 0
    for level = 1, constants.LEVEL_COUNT do
        local row = (snapshot.facts.levels or {})[level] or {}
        if (tonumber(row.deployed) or 0) > 0 then
            top = level
        else
            break
        end
    end
    return top
end
suggest.serviceTop = serviceTop
local function weightOf(snapshot, level)
    local value = tonumber((snapshot.settings.weights or {})[level])
        or CONFIG.RATES.DEFAULT_WEIGHT
    return math.max(0, math.min(CONFIG.RATES.MAX_WEIGHT, value))
end
suggest.weightOf = weightOf
local function refluxOf(snapshot, level)
    local configured = (snapshot.settings.reflux or {})[level]
    if type(configured) == "boolean" then return configured end
    return constants.RATE_REFLUX_LEVELS[level] == true
end
suggest.refluxOf = refluxOf
function suggest.successOf(snapshot, level)
    local success = constants.RATE_SUCCESS[level] or 0
    if level == constants.T6_LEVEL and snapshot.settings.t6DualLithium == true then
        success = constants.RATE_SUCCESS_DUAL_LITHIUM
    end
    if refluxOf(snapshot, level) then
        success = success + constants.RATE_REFLUX_BONUS
    end
    return math.min(1, success)
end
local function wanted(snapshot, level, top)
    for current = level, top do
        if weightOf(snapshot, current) > 0 then return true end
    end
    return false
end
suggest.wanted = wanted
local function thresholdValues(snapshot)
    local budget = tonumber(snapshot.power.available) or 0
    local top = serviceTop(snapshot)
    local values = {}
    for level = 1, constants.LEVEL_COUNT do
        local value = 0
        if level <= top then
            local count = math.max(1, tonumber(((snapshot.facts.levels or {})[level] or {}).deployed) or 0)
            local perPower = constants.POWER_LEVELS[level] or 0
            if perPower <= 0 or budget <= 0 then
                value = 1
            else
                value = math.max(1, math.min(constants.parallelCap(level),
                    math.floor(budget / (perPower * count))))
            end
        end
        values[level] = value
    end
    return values, { top = top, budget = budget }
end
local function rateValues(snapshot)
    local top = serviceTop(snapshot)
    local budget = tonumber(snapshot.power.available) or 0
    local boost = tonumber(snapshot.settings.t7Boost) or CONFIG.RATES.DEFAULT_T7_BOOST
    local net, weights, counts = {}, {}, {}
    for level = 1, constants.LEVEL_COUNT do
        local gross = constants.RATE_PRODUCE * suggest.successOf(snapshot, level)
        if level == constants.T7_LEVEL then gross = gross * boost end
        net[level] = gross - (refluxOf(snapshot, level) and constants.RATE_REFLUX or 0)
        weights[level] = weightOf(snapshot, level)
        counts[level] = math.max(0, tonumber(((snapshot.facts.levels or {})[level] or {}).deployed) or 0)
    end
    local unitQ, unitDemand = {}, {}
    local nextQ = 0
    local margin = 1 + (CONFIG.RATES.ZERO_MARGIN or 0)
    for level = top, 1, -1 do
        local carry = constants.RATE_CONSUME * nextQ
        if weights[level] <= 0 and carry > 0 then carry = carry * margin end
        local demand = weights[level] + carry
        local q = net[level] > 0 and (demand / net[level]) or 0
        unitQ[level], unitDemand[level] = q, demand
        nextQ = q
    end
    for level = 1, constants.LEVEL_COUNT do
        if level > top then unitQ[level], unitDemand[level] = 0, 0 end
    end
    local unitPower = 0
    for level = 1, top do
        unitPower = unitPower + unitQ[level] * (constants.POWER_LEVELS[level] or 0)
    end
    local lambdaPower = (unitPower > 0 and budget > 0) and (budget / unitPower) or 0
    local lambdaCap = math.huge
    for level = 1, top do
        if unitQ[level] > 0 and counts[level] > 0 then
            local ratio = constants.parallelCap(level) * counts[level] / unitQ[level]
            if ratio < lambdaCap then lambdaCap = ratio end
        end
    end
    if lambdaCap == math.huge then lambdaCap = 0 end
    local lambda = math.min(lambdaPower, lambdaCap)
    local values, total, notes = {}, {}, {}
    for level = 1, top do
        local count = counts[level]
        local raw = count > 0 and (lambda * unitQ[level] / count) or 0
        local per = math.floor(raw)
        values[level], total[level] = per, per * count
        if per < 1 and unitDemand[level] > 0 and lambda > 0 then
            notes[#notes + 1] = { level = level, kind = "too_small" }
        end
    end
    for level = top + 1, constants.LEVEL_COUNT do
        values[level], total[level] = 0, 0
    end
    for level = 1, top - 1 do
        local count = counts[level + 1]
        local supply = total[level] * net[level]
        local maxNext = math.floor(math.max(0, supply) / constants.RATE_CONSUME)
        local perMax = count > 0 and math.floor(maxNext / count) or 0
        if values[level + 1] > perMax then
            notes[#notes + 1] = {
                level = level + 1,
                kind = "trimmed",
                from = values[level + 1],
                to = perMax,
            }
            values[level + 1] = perMax
            total[level + 1] = perMax * count
        end
    end
    return values, {
        top = top,
        budget = budget,
        notes = notes,
        want = unitQ,
        limit = { lambdaPower = lambdaPower, lambdaCap = lambdaCap },
    }
end
function suggest.compute(snapshot)
    local mode = snapshot.settings.mode == "rate" and "rate" or "threshold"
    local values, meta
    if mode == "rate" then
        values, meta = rateValues(snapshot)
    else
        values, meta = thresholdValues(snapshot)
    end
    meta.mode = mode
    meta.values = values
    return meta
end
function suggest.inputKey(snapshot)
    local mode = snapshot.settings.mode == "rate" and "rate" or "threshold"
    local parts = {
        mode,
        tostring(math.floor(tonumber(snapshot.power.available) or 0)),
    }
    for level = 1, constants.LEVEL_COUNT do
        local row = (snapshot.facts.levels or {})[level] or {}
        parts[#parts + 1] = tostring(math.floor(tonumber(row.deployed) or 0))
    end
    if mode == "rate" then
        for level = 1, constants.LEVEL_COUNT do
            parts[#parts + 1] = tostring(weightOf(snapshot, level))
        end
        for _, level in ipairs({ 1, 2, constants.T6_LEVEL }) do
            parts[#parts + 1] = tostring(refluxOf(snapshot, level))
        end
        parts[#parts + 1] = tostring(snapshot.settings.t6DualLithium == true)
        parts[#parts + 1] = tostring(tonumber(snapshot.settings.t7Boost) or 1)
    end
    return table.concat(parts, "|")
end
function suggest.equals(a, b)
    for level = 1, constants.LEVEL_COUNT do
        if (tonumber((a or {})[level]) or 0) ~= (tonumber((b or {})[level]) or 0) then
            return false
        end
    end
    return true
end
function suggest.copy(values)
    local out = {}
    for level = 1, constants.LEVEL_COUNT do
        out[level] = math.floor(tonumber((values or {})[level]) or 0)
    end
    return out
end
return suggest

core/bootstrap.lua
