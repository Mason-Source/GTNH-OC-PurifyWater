local CONFIG                     = {}
CONFIG.FILES                     = {
    SETTINGS = "data/settings.txt", 
    HARDWARE = "data/hardware.txt", 
    HISTORY  = "data/history.dat",  
    LOG      = "data/log.txt",      
    TRACE    = "data/last_run.txt", 
    PRODUCE  = "data/produce.txt"   
}
CONFIG.INTERVAL                  = {
    HARDWARE  = 10,
    FLUID     = 5,
    OBSERVE   = 5,
