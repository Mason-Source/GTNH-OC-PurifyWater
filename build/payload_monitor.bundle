local Component = require("frontend.ui.base")
local TabBar = {}
function TabBar.new()
    local self = Component.new("tabbar", { page = "overview" })
    self.fingerprint = TabBar.fingerprint
    self.render = TabBar.render
    return self
end
function TabBar:fingerprint(context)
    return table.concat({
        self.key, self.rect.x, self.rect.y, self.rect.w, self.rect.h,
        context.themeId, tostring(self.props.page), tostring(context.readOnly),
    }, "\x1f")
end
function TabBar:render(context)
    local p = context.painter
    local r = self.rect
    local page = self.props.page or "overview"
    p:fill(r, "surfaceAlt")
    local x = r.x + 1
    local tabs = { { key = "overview", label = "总览" } }
    if not context.readOnly then tabs[#tabs + 1] = { key = "config", label = "配置" } end
    for _, tab in ipairs(tabs) do
        local text = " " .. tab.label .. " "
        local width = p:measure(text)
        local active = page == tab.key
        local chip = { x = x, y = r.y, w = width, h = 1 }
        p:button(chip, text, active)
        context:hit({ type = "page", page = tab.key }, chip)
        x = x + width + 1
    end
    local hint = context.readOnly and "镜像端 · 只读 · Q 退出" or "X 启停 · R 刷新 · T 切页 · Q 退出"
    local hintW = p:measure(hint)
    if x + 2 + hintW <= r.x + r.w then
        p:textRight(r.x, r.y, r.w - 1, hint, "muted", "surfaceAlt")
    end
end
return TabBar

frontend/ui/painter.lua
5250
local unicode = require("unicode")
local Painter = {}
Painter.__index = Painter
function Painter.new(gpu, theme)
    return setmetatable({
        gpu = gpu,
        theme = theme,
        fg = nil,
        bg = nil,
    }, Painter)
end
function Painter:setTheme(theme)
    self.theme = theme
end
function Painter:begin()
    self.fg = nil
    self.bg = nil
end
local function blend(base, overlay, alpha)
    alpha = math.max(0, math.min(1, alpha))
    local br = math.floor(base / 0x10000) % 0x100
    local bg = math.floor(base / 0x100) % 0x100
    local bb = base % 0x100
    local overlayR = math.floor(overlay / 0x10000) % 0x100
    local og = math.floor(overlay / 0x100) % 0x100
    local ob = overlay % 0x100
    local r = math.floor(br * (1 - alpha) + overlayR * alpha + 0.5)
    local g = math.floor(bg * (1 - alpha) + og * alpha + 0.5)
    local b = math.floor(bb * (1 - alpha) + ob * alpha + 0.5)
    return r * 0x10000 + g * 0x100 + b
end
local function resolve(painter, role, fallback, seen)
    role = role or fallback or "text"
    if type(role) == "number" then return role end
    local colors = painter.theme.color
    local spec = colors[role]
    if spec == nil then return colors[fallback] or colors.text end
    if type(spec) == "number" then return spec end
    seen = seen or {}
    if seen[role] then return colors[fallback] or colors.canvas end
    seen[role] = true
    if type(spec) == "string" then
        return resolve(painter, spec, fallback, seen)
    end
    if type(spec) == "table" then
        local base = resolve(painter, spec.base or spec.inherit or fallback, "canvas", seen)
        if spec.color == nil then return base end
        local alpha = tonumber(spec.alpha)
        if alpha == nil then alpha = 1 end
        if alpha <= 0 then return base end
        if alpha >= 1 then return spec.color end
        return blend(base, spec.color, alpha)
    end
    return colors[fallback] or colors.text
end
function Painter:color(role, fallback)
    return resolve(self, role, fallback or "text")
end
function Painter:setForeground(role)
    local color = self:color(role, "text")
    if self.fg ~= color then
        self.gpu.setForeground(color)
        self.fg = color
    end
end
function Painter:setBackground(role)
    local color = self:color(role, "canvas")
    if self.bg ~= color then
        self.gpu.setBackground(color)
        self.bg = color
    end
end
function Painter:fill(rect, role)
    self:setBackground(role or "canvas")
    self.gpu.fill(rect.x, rect.y, rect.w, rect.h, " ")
end
function Painter:clear(rect)
    self:fill(rect, "canvas")
end
function Painter:measure(text)
    return unicode.wlen(tostring(text or ""))
end
function Painter:truncate(text, width)
    text = tostring(text or "")
    if width <= 0 then return "" end
    if unicode.wlen(text) <= width then return text end
    local out = ""
    for index = 1, unicode.len(text) do
        local char = unicode.sub(text, index, index)
        if unicode.wlen(out .. char) > width - 1 then break end
        out = out .. char
    end
    return out .. "…"
end
function Painter:text(x, y, text, foreground, background, width)
    text = tostring(text or "")
    if width then text = self:truncate(text, width) end
    self:setForeground(foreground or "text")
    self:setBackground(background or "canvas")
    self.gpu.set(x, y, text)
end
function Painter:textRight(x, y, width, text, foreground, background)
    local value = tostring(text or "")
    return self:text(x + width - self:measure(value), y, value, foreground, background)
end
function Painter:panel(rect, title)
    if rect.w < 2 or rect.h < 2 then return end
    self:fill(rect, "surface")
    self:setForeground("border")
    self:setBackground("surface")
    self.gpu.set(rect.x, rect.y, "┌" .. string.rep("─", rect.w - 2) .. "┐")
    if rect.h > 2 then
        self.gpu.fill(rect.x, rect.y + 1, 1, rect.h - 2, "│")
        self.gpu.fill(rect.x + rect.w - 1, rect.y + 1, 1, rect.h - 2, "│")
    end
    self.gpu.set(rect.x, rect.y + rect.h - 1, "└" .. string.rep("─", rect.w - 2) .. "┘")
    if title and rect.w > 6 and rect.h > 2 then
        local value = " " .. title .. " "
        self:text(rect.x + 2, rect.y, value, "accent", "surface", rect.w - 4)
    end
end
function Painter:bar(rect, ratio, fillRole, trackRole, emptyRole)
    ratio = math.max(0, math.min(1, tonumber(ratio) or 0))
    local filled = math.floor(rect.w * ratio)
    local role = filled > 0
        and (trackRole or "barTrack")
        or (emptyRole or "barEmpty")
    self:fill(rect, role)
    if filled > 0 then
        self:fill({ x = rect.x, y = rect.y, w = filled, h = rect.h }, fillRole or "barFill")
    end
end
function Painter:button(rect, text, active, disabled, foreground, background)
    local bg = disabled and "chipDisabled"
        or (active and "chipActive" or background or "chip")
    local fg
    if disabled then
        fg = "disabled"
    elseif active then
        fg = foreground or "accent"
    else
        fg = foreground or "text"
    end
    self:fill(rect, bg)
    local padding = math.max(0, math.floor((rect.w - self:measure(text)) / 2))
    self:text(rect.x + padding, rect.y, text, fg, bg, rect.w - padding)
end
return Painter

frontend/ui/renderer.lua
2308
local Renderer = {}
Renderer.__index = Renderer
function Renderer.new(painter)
    return setmetatable({
        painter = painter,
        fingerprints = {},
        hitboxesByKey = {},
        hitboxes = {},
        forceAll = true,
    }, Renderer)
end
function Renderer:setTheme(theme)
    self.painter:setTheme(theme)
end
function Renderer:invalidateAll()
    self.forceAll = true
end
function Renderer:invalidate(key)
    if key then self.fingerprints[key] = nil else self.forceAll = true end
end
local function makeContext(renderer, app)
    local context = {
        painter = renderer.painter,
        theme = app.theme,
        themeId = app.theme.id,
        ui = app.ui,
        viewport = app.viewport,
        readOnly = app.readOnly == true,
        hitboxes = {},
    }
    function context:hit(action, rect)
        self.hitboxes[#self.hitboxes + 1] = {
            action = action,
            rect = rect,
        }
    end
    return context
end
function Renderer:render(components, app)
    local context = makeContext(self, app)
    if self.forceAll then
        self.painter:clear({
            x = 1,
            y = 1,
            w = app.viewport.width,
            h = app.viewport.height,
        })
        self.fingerprints = {}
        self.hitboxesByKey = {}
    end
    local drawn = 0
    for _, component in ipairs(components or {}) do
        local key = component.key
        local fingerprint = component:fingerprint(context)
        if self.forceAll or self.fingerprints[key] ~= fingerprint then
            context.hitboxes = {}
            component:render(context)
            self.hitboxesByKey[key] = context.hitboxes
            self.fingerprints[key] = fingerprint
            drawn = drawn + 1
        end
    end
    self.hitboxes = {}
    for _, component in ipairs(components or {}) do
        for _, box in ipairs(self.hitboxesByKey[component.key] or {}) do
            self.hitboxes[#self.hitboxes + 1] = box
        end
    end
    self.forceAll = false
    return drawn
end
function Renderer:hit(x, y)
    for _, box in ipairs(self.hitboxes) do
        local rect = box.rect
        if x >= rect.x and x < rect.x + rect.w
            and y >= rect.y and y < rect.y + rect.h then
            return box.action, box
        end
    end
end
return Renderer

monitor.lua
5269
local selfPath = (debug.getinfo(1, "S").source or ""):gsub("^@", "")
local selfDir = selfPath:match("^(.*)[/\\][^/\\]*$")
local locateChunk = assert(loadfile((selfDir or ".") .. "/core/locate.lua"), "cannot load core/locate.lua")
local locate = locateChunk()
local appDir = locate.appDir(arg and arg[1], selfPath)
if appDir == "" then
    print("无法定位应用目录（需要 core/bootstrap.lua）")
    return
end
locate.injectPath(appDir)
local bootstrap = require("core.bootstrap")
bootstrap.clearModuleCache()
bootstrap = require("core.bootstrap")
local CONFIG = require("shared.config")
local clock = require("services.clock")
local models = require("shared.models")
local event = require("event")
local component = require("component")
local app = require("frontend.app")
local PORT = tonumber(arg and arg[1]) or CONFIG.NET.PORT or 4096
local frames = {}
local snapshot = nil
local snapshotAt = 0
local dirty = true
local lastLine = 0
local lastError = nil
local quitting = false
app.setSnapshotReader(function() return snapshot end)
app.setActionHandler(function(name)
    if name == "quit" then
        quitting = true
        return true
    end
    return false
end)
assert(app.boot({ readOnly = true }), "frontend boot failed")
local function findModem()
    for address, kind in component.list() do
        if kind == "modem" or kind == "tunnel" then return address end
    end
end
local modemAddress = findModem()
if not modemAddress then
    print("这台机器没有网卡/隧道组件")
    return
end
local openOk, openErr = pcall(component.invoke, modemAddress, "open", PORT)
if not openOk then
    print("监听端口失败：" .. tostring(openErr))
    return
end
local function drawMirrorLine()
    local p = assert(app.painter, "painter missing")
    local width = app.viewport.width
    local age = snapshot and (clock.uptime() - snapshotAt) or nil
    local text, role
    if not snapshot then
        text, role = string.format("镜像端 · 只读 | 端口 %d | 等待数据", PORT), "warning"
    elseif age > (CONFIG.NET.STALE or 30) then
        text, role = string.format("镜像端 · 只读 | 端口 %d | %.0f秒前收到", PORT, age), "warning"
    else
        text, role = string.format("镜像端 · 只读 | 端口 %d | %.0f秒前收到 | %s",
            PORT, age, tostring(snapshot.version or "-")), "success"
    end
    local lineX = math.max(1, width - 45)
    local room = width - lineX + 1
    p:fill({ x = lineX, y = 1, w = room, h = 1 }, "surfaceAlt")
    p:textRight(lineX, 1, room, p:truncate(text, room), role, "surfaceAlt")
end
local function drawWaiting()
    local p = assert(app.painter, "painter missing")
    local width, height = app.viewport.width, app.viewport.height
    p:clear({ x = 1, y = 1, w = width, h = height })
    local message = lastError
        or "等待主控广播：确认无线广播已开启，且两台机器处于同一网络（Q 退出）"
    message = p:truncate(message, width - 2)
    p:text(math.max(2, math.floor((width - p:measure(message)) / 2)),
        math.floor(height / 2), message, lastError and "danger" or "warning", "canvas", width - 2)
    drawMirrorLine()
end
local function accept(message)
    local frame, index, total, part = models.parseChunk(message)
    if not frame or not index or not total then return false end
    if total < 1 or total > 64 or index < 1 or index > total then return false end
    local now = clock.uptime()
    for key, slot in pairs(frames) do
        if now - slot.at > 60 then frames[key] = nil end
    end
    local slot = frames[frame]
    if not slot then
        slot = { parts = {}, total = total, at = now }
        frames[frame] = slot
    end
    slot.parts[index] = part or ""
    for i = 1, total do if slot.parts[i] == nil then return false end end
    local parts = {}
    for i = 1, total do parts[#parts + 1] = slot.parts[i] end
    frames[frame] = nil
    local payload, err = models.decodeSnapshot(table.concat(parts))
    if not payload then
        lastError = tostring(err or "快照解析失败")
        dirty = true
        return false
    end
    snapshot, snapshotAt, lastError, dirty = payload, now, nil, true
    return true
end
while not quitting do
    local ev = { event.pull(0.5) }
    local name = ev[1]
    if name == "interrupted" then
        break
    elseif name == "key_down" then
        local char, code = ev[3], ev[4]
        if char == 113 or code == 16 then break end
        if app.handle(ev) then app.frameInput() end
    elseif name == "modem_message" then
        if ev[4] == PORT and type(ev[6]) == "string" then accept(ev[6]) end
    elseif name == "screen_resized" or name == "touch" then
        if name == "screen_resized" then dirty = true end
        if app.handle(ev) then app.frameInput() end
    end
    local now = clock.uptime()
    if snapshot then
        if dirty then
            dirty, lastLine = false, now
            app.frameData()
            drawMirrorLine()
        elseif now - lastLine >= (CONFIG.NET.REFRESH or 2) then
            lastLine = now
            drawMirrorLine()
        end
    elseif dirty then
        dirty, lastLine = false, now
        drawWaiting()
    end
end
app.restoreResolution()
bootstrap.releaseConsole()
print("镜像端已退出")

