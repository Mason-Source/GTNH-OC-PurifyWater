local locate = {}
local function isAppDir(dir)
    if type(dir) ~= "string" or dir == "" then return false end
    local ok, fs = pcall(require, "filesystem")
    if not ok or not fs then return false end
    return fs.exists(dir .. "/core/bootstrap.lua") == true
end
function locate.appDir(hint, selfSource)
    if isAppDir(hint) then return hint end
    local selfDir = type(selfSource) == "string" and selfSource:match("^(.*)[/\\][^/\\]*$") or nil
    local candidates = {}
    if selfDir then
        table.insert(candidates, selfDir)
    end
    pcall(function()
        local shell = require("shell")
        local cwd = shell.getWorkingDirectory()
        table.insert(candidates, cwd)
        table.insert(candidates, cwd .. "/PurifyWater")
        table.insert(candidates, cwd .. "/..")
        table.insert(candidates, cwd .. "/../PurifyWater")
    end)
    for _, dir in ipairs(candidates) do
        if isAppDir(dir) then return dir end
    end
    return ""
end
function locate.injectPath(appDir)
    package.path = appDir .. "/?.lua;" .. appDir .. "/?/init.lua;" .. package.path
    return package.path
end
return locate

frontend/app.lua
6298
local component = require("component")
local clock = require("services.clock")
local config = require("shared.config")
local overview_model = require("frontend.model.overview")
local theme_registry = require("frontend.theme.registry")
local Painter = require("frontend.ui.painter")
local Renderer = require("frontend.ui.renderer")
local OverviewPage = require("frontend.pages.overview")
local input = require("frontend.input")
local app = {
    booted = false,
    revision = nil,
    pageName = "overview",
    page = nil,
    pages = nil,
    views = {},
    view = nil,
    painter = nil,
    renderer = nil,
    theme = nil,
    viewport = { width = 0, height = 0 },
    baseResolution = nil,
    readOnly = false,
    snapshotReader = nil,
    ui = {
        detailLevel = nil,
        chartLevel = 0,
        editLevel = nil,
        editField = nil,
        editBuf = "",
        producePage = 1,
        produceCandidatePage = 1,
    },
    actionHandler = nil,
    observer = nil,
    lastInputAt = nil,
}
local function readViewport()
    local width, height = component.gpu.getResolution()
    app.viewport.width = width
    app.viewport.height = height
end
local function applyResolution()
    local gpu = component.gpu
    local width, height = gpu.getResolution()
    app.baseResolution = { width = width, height = height }
    local targetW = config.UI.RESOLUTION_WIDTH or 0
    local targetH = config.UI.RESOLUTION_HEIGHT or 0
    if targetW <= 0 and targetH <= 0 then return end
    local wantW = targetW > 0 and targetW or width
    local wantH = targetH > 0 and targetH or height
    if wantW ~= width or wantH ~= height then
        pcall(gpu.setResolution, wantW, wantH)
    end
end
function app.restoreResolution()
    local base = app.baseResolution
    if not base or not component.gpu then return end
    local width, height = component.gpu.getResolution()
    if width ~= base.width or height ~= base.height then
        pcall(component.gpu.setResolution, base.width, base.height)
    end
end
function app.layout(width, height)
    app.viewport.width = width
    app.viewport.height = height
    if app.page then app.page:layout(width, height) end
    if app.renderer then app.renderer:invalidateAll() end
end
function app.setSnapshotReader(reader)
    app.snapshotReader = reader
end
function app.boot(options)
    options = options or {}
    if options.readOnly then app.readOnly = true end
    if not component.gpu then return false end
    app.theme = theme_registry.set(options.theme or config.UI.DEFAULT_THEME or "dark")
    app.painter = Painter.new(component.gpu, app.theme)
    app.renderer = Renderer.new(app.painter)
    app.pages = { overview = OverviewPage.new() }
    if not app.readOnly then
        local ConfigPage = require("frontend.pages.config")
        app.pages.config = ConfigPage.new()
    end
    app.page = app.pages[app.pageName]
    applyResolution()
    readViewport()
    app.page:layout(app.viewport.width, app.viewport.height)
    app.renderer:invalidateAll()
    app.booted = true
    return true
end
function app.setPage(name)
    if app.readOnly and name ~= "overview" then return false end
    local target = app.pages and app.pages[name]
    if not target then return false end
    if app.pageName ~= name then
        if app.actionHandler then app.actionHandler("produce_bind_cancel") end
        app.ui.editLevel, app.ui.editField, app.ui.editBuf = nil, nil, ""
    end
    app.pageName = name
    app.page = target
    if app.views[name] then app.page:update(app.views[name]) end
    app.page:layout(app.viewport.width, app.viewport.height)
    app.renderer:invalidateAll()
    return true
end
function app.togglePage()
    if app.readOnly then return false end
    return app.setPage(app.pageName == "overview" and "config" or "overview")
end
function app.setTheme(id)
    if not theme_registry.has(id) then return false end
    app.theme = theme_registry.set(id)
    app.renderer:setTheme(app.theme)
    app.renderer:invalidateAll()
    return true
end
function app.setActionHandler(handler)
    app.actionHandler = handler
end
function app.setObserver(observer)
    app.observer = observer
end
function app.frameInput()
    return app.frame("input")
end
function app.frameData()
    return app.frame("data")
end
function app.frame(reason)
    if not app.booted then return 0 end
    local startedCpu = clock.cpuTime()
    local startedReal = clock.realTime()
    local snapshot
    if app.snapshotReader then
        snapshot = app.snapshotReader()
    else
        snapshot = require("services.read_model").snapshot()
    end
    if not snapshot then return 0 end
    local themeId = snapshot.system and snapshot.system.theme
    if themeId and theme_registry.has(themeId) and themeId ~= app.theme.id then
        app.theme = theme_registry.set(themeId)
        app.renderer:setTheme(app.theme)
        app.renderer:invalidateAll()
    end
    if snapshot.revision ~= app.revision then
        app.revision = snapshot.revision
        app.views.overview = overview_model.build(snapshot)
        if not app.readOnly then
            app.views.config = require("frontend.model.config").build(snapshot)
        end
        app.view = app.views[app.pageName]
        app.page:update(app.view)
    end
    app.renderer:setTheme(app.theme)
    local draws = app.renderer:render(app.page.components, app)
    local latency = app.lastInputAt and ((startedReal - app.lastInputAt) * 1000) or nil
    if reason == "input" then app.lastInputAt = nil end
    if app.observer then
        app.observer("frame", {
            reason = reason or "manual",
            draws = draws,
            elapsedMs = (clock.cpuTime() - startedCpu) * 1000,
            latencyMs = latency,
            revision = app.revision,
            page = app.pageName,
        })
    end
    return draws
end
function app.handle(signal)
    local startedCpu = clock.cpuTime()
    local startedReal = clock.realTime()
    app.lastInputAt = startedReal
    local handled = input.handle(app, signal)
    if app.observer then
        app.observer("input", {
            name = signal and signal[1] or "unknown",
            handled = handled == true,
            elapsedMs = (clock.cpuTime() - startedCpu) * 1000,
        })
    end
    return handled
end
return app

frontend/input.lua
7306
local CONFIG = require("shared.config")
local input = {}
local function configView(app)
    return app.views and app.views.config or {}
end
local function clearEdit(app)
    app.ui.editLevel = nil
    app.ui.editField = nil
    app.ui.editBuf = ""
end
local function currentBuffer(app, field, level)
    local view = configView(app)
    if field == "threshold" then
        return tostring(tonumber(view.rows and view.rows[level] and view.rows[level].thresholdK) or 0)
    elseif field == "weight" then
        return tostring(tonumber(view.rows and view.rows[level] and view.rows[level].weight) or 0)
    elseif field == "factor" then
        return tostring(tonumber(view.system and view.system.energyFactor) or CONFIG.ENERGY.FACTOR_DEFAULT)
    elseif field == "strength" then
        return tostring(tonumber(view.net and view.net.strength) or 0)
    end
    return ""
end
local function limitFor(field)
    if field == "threshold" then return 100000000000000 end
    if field == "factor" then return CONFIG.ENERGY.FACTOR_MAX end
    if field == "strength" then return CONFIG.NET.STRENGTH_MAX end
    return CONFIG.RATES.MAX_WEIGHT
end
local function leaveProduceSelection(app)
    if app.ui.editField == "produce" and app.actionHandler then
        app.actionHandler("produce_bind_cancel")
    end
end
local function selectCell(app, level, field)
    leaveProduceSelection(app)
    if app.ui.editLevel == level and app.ui.editField == field then
        clearEdit(app)
    else
        app.ui.editLevel = level
        app.ui.editField = field
        app.ui.editBuf = currentBuffer(app, field, level)
        if field == "produce" then
            app.ui.producePage = 1
            app.ui.produceCandidatePage = 1
        end
    end
    app.renderer:invalidate("config_table")
    return true
end
local function selectGlobal(app, field)
    leaveProduceSelection(app)
    if app.ui.editLevel == nil and app.ui.editField == field then
        clearEdit(app)
    else
        app.ui.editLevel = nil
        app.ui.editField = field
        app.ui.editBuf = currentBuffer(app, field, nil)
    end
    app.renderer:invalidate("config_table")
    return true
end
local function applyKeypad(app, action)
    local field, level = app.ui.editField, app.ui.editLevel
    if not field then return false end
    local kind = action.kind
    if kind == "cancel" then
        clearEdit(app)
        app.renderer:invalidate("config_table")
        return true
    end
    if kind == "commit" then
        local value = tonumber(app.ui.editBuf or "")
        if value == nil then return false end
        local ok = app.actionHandler and app.actionHandler("config_commit", {
            field = field,
            level = level,
            value = value,
        })
        if ok ~= false then
            clearEdit(app)
            app.renderer:invalidate("config_table")
        end
        return true
    end
    local buf = app.ui.editBuf or ""
    if kind == "digit" then
        if buf == "0" then buf = "" end
        buf = buf .. tostring(action.value or "")
    elseif kind == "mul" or kind == "div" then
        local number = tonumber(buf) or 0
        local scale = tonumber(action.value) or 1
        buf = tostring(kind == "mul" and number * scale or math.floor(number / scale))
    elseif kind == "set" then
        buf = tostring(action.value or "")
    elseif kind == "back" then
        buf = buf:sub(1, math.max(0, #buf - 1))
    elseif kind == "clear" then
        buf = ""
    elseif kind == "copy" then
        local previous = configView(app).rows and configView(app).rows[(level or 1) - 1]
        if previous then buf = tostring(previous.thresholdK or 0) end
    end
    local value = tonumber(buf)
    if value and value > limitFor(field) then return true end
    app.ui.editBuf = buf
    app.renderer:invalidate("config_table")
    return true
end
local function dispatch(app, action)
    if not action then return false end
    if action.type == "page" then
        return app.setPage(action.page)
    elseif action.type == "detail_level" then
        app.ui.detailLevel = action.level
        app.renderer:invalidate("status")
        return true
    elseif action.type == "detail_back" then
        app.ui.detailLevel = nil
        app.renderer:invalidate("status")
        return true
    elseif action.type == "chart_level" then
        app.ui.chartLevel = action.level
        app.renderer:invalidate("chart")
        return true
    elseif action.type == "select_cell" then
        return selectCell(app, action.level, action.field)
    elseif action.type == "select_global" then
        return selectGlobal(app, action.field)
    elseif action.type == "keypad" then
        return applyKeypad(app, action)
    elseif action.type == "produce_page" then
        app.ui.producePage = math.max(1, (app.ui.producePage or 1) + (tonumber(action.delta) or 0))
        app.renderer:invalidate("config_table")
        return true
    elseif action.type == "produce_candidate_page" then
        app.ui.produceCandidatePage = math.max(1,
            (app.ui.produceCandidatePage or 1) + (tonumber(action.delta) or 0))
        app.renderer:invalidate("config_table")
        return true
    elseif action.type == "theme" then
        if app.readOnly then return false end
        local changed = app.setTheme(action.value)
        if changed and app.actionHandler then
            app.actionHandler("theme_set", { value = action.value })
        end
        return changed
    elseif action.type == "option" and app.actionHandler then
        local ok = app.actionHandler(action.name, action)
        if ok ~= false then
            clearEdit(app)
        end
        app.renderer:invalidate("config_table")
        return true
    elseif action.type == "command" and app.actionHandler then
        if app.readOnly and action.name ~= "quit" then return false end
        local ok = app.actionHandler(action.name, action)
        if ok ~= false and action.name == "produce_bind_begin" then
            app.ui.produceCandidatePage = 1
        elseif ok ~= false and action.name == "produce_bind_select" then
            app.ui.produceCandidatePage = 1
        end
        app.renderer:invalidate("config_table")
        return true
    end
    return false
end
function input.handle(app, signal)
    if not signal then return false end
    local name = signal[1]
    if name == "screen_resized" then
        local width, height = require("component").gpu.getResolution()
        app.layout(width, height)
        return true
    end
    if name == "key_down" then
        local char = signal[3]
        if char == 116 or char == 84 then
            if app.readOnly then return false end
            return app.togglePage()
        elseif char == 120 or char == 88 then
            if app.readOnly then return false end
            if app.actionHandler then app.actionHandler("system_toggle") end
            return true
        elseif char == 114 or char == 82 then
            if app.readOnly then return false end
            if app.actionHandler then app.actionHandler("refresh") end
            return true
        end
        return false
    end
    if name == "touch" then
        return dispatch(app, app.renderer:hit(signal[3], signal[4]))
    end
    return false
end
return input

frontend/model/logs.lua
882
local logs_model = {}
local LEVELS = {
    error = true,
    warn = true,
    system = true,
    diag = true,
}
local PREFIX = {
    error = "[错误] ",
    warn = "[警告] ",
    system = "[系统] ",
}
function logs_model.build(source)
    local entries = {}
    local revision = 0
    for _, record in ipairs((source and source.entries) or {}) do
        local level = LEVELS[record.kind] and record.kind or "system"
        if level ~= "diag" then
            revision = tonumber(record.seq) or revision
            entries[#entries + 1] = {
                seq = tonumber(record.seq) or 0,
                at = tonumber(record.at) or 0,
                kind = level,
                text = (PREFIX[level] or "") .. tostring(record.text or ""),
            }
        end
    end
    return {
        revision = revision,
        entries = entries,
    }
end
return logs_model

frontend/model/overview.lua
8560
local constants = require("shared.constants")
local util = require("shared.util")
local logs_model = require("frontend.model.logs")
local overview = {}
local function numberText(value)
    value = tonumber(value)
    if value == nil then return "-" end
    return util.formatShortNumber(value)
end
local function ageText(age)
    if age == nil then return "-" end
    return string.format("%.0fs", age)
end
local function hostText(switch)
    if switch == nil then return "读取失败", "danger" end
    if switch then return "已开启", "success" end
    return "已关闭", "danger"
end
function overview.build(read)
    local system = read.system or {}
    local hardware = read.hardware or {}
    local water = read.water or {}
    local host = read.host or {}
    local power = read.power or {}
    local sourceLevels = read.levels or {}
    local levels = {}
    local observedLevels = 0
    local machineTotal = 0
    for level = 1, constants.LEVEL_COUNT do
        local source = sourceLevels[level] or {}
        local value = tonumber(source.water)
        if value ~= nil then observedLevels = observedLevels + 1 end
        local rule = source.rule or {}
        local deployed = tonumber(source.deployed) or 0
        local active = tonumber(source.active)
        local base = tonumber(rule.effectiveThreshold) or 0
        local runText = deployed == 0 and "-" or ((active == nil) and "-" or (active .. "/" .. deployed))
        local switchText
        local switchRole
        if deployed == 0 then
            switchText, switchRole = "未部署", "danger"
        elseif source.switch == nil then
            switchText, switchRole = "读取失败", "danger"
        elseif source.switch then
            switchText, switchRole = "开 " .. runText, "success"
        else
            switchText, switchRole = "关 " .. runText, "warning"
        end
        local waterText = numberText(value)
        local thresholdText = numberText(rule.effectiveThreshold or 0)
        local sample = tonumber(source.sample)
        local learned = tonumber(source.learned)
        local suggest = tonumber(source.suggest)
        local sampleStale = (active or 0) == 0 and sample ~= nil
        local sampleRole = "text"
        if sampleStale then
            sampleRole = "disabled"
        elseif sample ~= nil and learned == sample then
            sampleRole = "accent"
        end
        local suggestRole = "text"
        if sample ~= nil and suggest ~= nil then
            suggestRole = suggest == sample and "accent" or "danger"
        end
        levels[level] = {
            level = level,
            label = constants.levelLabel(level),
            value = value,
            valueText = numberText(value),
            thresholdText = thresholdText,
            waterText = waterText,
            waterOfText = waterText .. "/" .. thresholdText,
            ratio = (value and base > 0) and math.min(1, value / base) or 0,
            role = value == nil and "disabled" or (value > 0 and "success" or "warning"),
            deployed = deployed,
            deployText = "×" .. tostring(deployed),
            active = active,
            running = deployed > 0 and (active or 0) > 0,
            runText = runText,
            switch = source.switch,
            switchText = switchText,
            switchRole = switchRole,
            sample = sample,
            sampleText = sample and numberText(sample) or "-",
            sampleRole = sampleRole,
            sampleStale = sampleStale,
            learned = learned,
            suggestText = suggest and numberText(suggest) or "-",
            suggestRole = suggestRole,
            machines = source.machines or {},
            successText = source.success and (tostring(source.success) .. "%") or "-",
            rateText = "成功率 " .. (source.success and (tostring(source.success) .. "%") or "-"),
            mark = rule.enabled and "[√]" or "[ ]",
            rule = rule,
        }
        machineTotal = machineTotal + deployed
    end
    local statusText = "等待采集"
    local statusRole = "disabled"
    if hardware.observed and water.observed then
        if system.awaiting then
            statusText, statusRole = "等待用户处理", "warning"
        else
            statusText = system.running and "自动调度中" or "停机待启动"
            statusRole = system.running and "success" or "disabled"
        end
    elseif hardware.observed or water.observed then
        statusText = "部分数据"
        statusRole = "warning"
    end
    local hostValue, hostRole = hostText(host.switch)
    local progress, progressMax = tonumber(host.progress), tonumber(host.progressMax)
    local cycleRatio = (progress and progressMax and progressMax > 0)
        and math.max(0, math.min(1, progress / progressMax)) or 0
    local cycleText = (progress and progressMax and progressMax > 0)
        and string.format("%d%%", math.floor(cycleRatio * 100 + 0.5)) or "未运行"
    local rateMode = system.mode == "rate"
    local controlRows = {
        { label = "系统状态：", value = statusText, role = statusRole },
        { label = "净水主机：", value = hostValue, role = hostRole },
        { label = "运行模式：", value = rateMode and "速率调度" or "阈值调度", role = "accent" },
        { label = "功率概况：", value = numberText(power.used or 0) .. " / " .. numberText(power.all or 0) .. " EU/t", role = "accent" },
        { label = "ME接口：", value = hardware.me and "已连接" or "未连接", role = hardware.me and "success" or "danger", optional = true },
        { label = "部署机器：", value = machineTotal .. " 台（T1–T8）", role = "accent" },
    }
    local net = read.net or {}
    return {
        revision = read.revision,
        title = "PurifyWater V2",
        version = constants.CODE_VERSION,
        status = { text = statusText, role = statusRole },
        summary = {
            hardwareText = hardware.observed
                and string.format("%d 个组件 · %s", hardware.count or 0, ageText(hardware.age))
                or "等待硬件",
            waterText = water.observed
                and string.format("%d/%d 级 · %s", observedLevels, constants.LEVEL_COUNT, ageText(water.age))
                or "等待水位",
            logText = string.format("%d 条", #(read.logs and read.logs.entries or {})),
        },
        control = {
            rows = controlRows,
            buttons = {
                system = {
                    label = system.running and "停机" or "启动系统",
                    action = "system_toggle",
                    role = system.running and "success" or "text",
                    active = system.running,
                },
                mode = {
                    label = rateMode and "切到阈值调度" or "切到速率调度",
                    action = "mode_toggle",
                    role = "accent",
                },
                subparam = {
                    label = rateMode
                        and (system.enforceThreshold and "阈值约束：开" or "阈值约束：关")
                        or (system.priority == "high" and "切到低级水优先" or "切到高级水优先"),
                    action = rateMode and "threshold_enforce_toggle" or "priority_toggle",
                    role = (not rateMode and system.priority == "high") and "danger" or "text",
                    background = (not rateMode and system.priority == "high") and "chipDanger" or nil,
                },
                refresh = { label = "刷新扫描", action = "refresh", role = "accent" },
                net = {
                    label = net.enabled and "无线广播：开" or "无线广播：关",
                    action = "net_toggle",
                    role = net.enabled and "accent" or "warning",
                    active = net.enabled,
                    disabled = net.available ~= true,
                },
                quit = { label = "退出程序", action = "quit", role = "danger" },
            },
        },
        cycle = { ratio = cycleRatio, text = cycleText },
        levels = levels,
        chart = {
            history = read.history or { times = {}, values = {} },
        },
        settings = {
            autostart = system.autostart == true,
            autostartStale = system.autostartStale == true,
            autostartPath = system.autostartPath,
        },
        logs = logs_model.build(read.logs),
    }
end
return overview

