local Component = {}
function Component.setProps(self, props)
    self.props = props or {}
end
function Component.setRect(self, rect)
    self.rect = rect or self.rect
end
function Component.new(key, props)
    return {
        key = key,
        props = props or {},
        rect = { x = 1, y = 1, w = 0, h = 0 },
        setProps = Component.setProps,
        setRect = Component.setRect,
    }
end
return Component

frontend/ui/components/chart.lua
9851
local Component = require("frontend.ui.base")
local constants = require("shared.constants")
local util = require("shared.util")
local Chart = {}
local GUTTER = 7
local function gameHoursText(realMinutes)
    local hours = math.floor(util.realSecondsToGameHours((tonumber(realMinutes) or 0) * 60) + 0.5)
    return math.max(1, hours)
end
function Chart.new()
    local self = Component.new("chart", { history = { count = 0, values = {} } })
    self.fingerprint = Chart.fingerprint
    self.render = Chart.render
    return self
end
function Chart:fingerprint(context)
    local history = self.props.history or {}
    local values = history.values or {}
    local parts = {
        self.key, self.rect.x, self.rect.y, self.rect.w, self.rect.h,
        context.themeId, tostring(context.ui.chartLevel or 0),
        tostring(history.count or 0), tostring(history.windowMinutes or 40),
    }
    for level = 1, constants.LEVEL_COUNT do
        local series = values[level] or {}
        parts[#parts + 1] = tostring(#series) .. ":" .. tostring(series[1] or "")
            .. ":" .. tostring(series[#series] or "")
    end
    return table.concat(parts, "\x1f")
end
local function chips(_, context, r, windowMinutes)
    local p = context.painter
    local selected = context.ui.chartLevel or 0
    local x = r.x + 2
    local labels = { "全部", "T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8" }
    for level = 0, 8 do
        local text = " " .. labels[level + 1] .. " "
        local width = p:measure(text)
        local rect = { x = x, y = r.y + 1, w = width, h = 1 }
        local active = selected == level
        local bg = active and "chipActive" or "chip"
        local fg = active and "canvas" or (level == 0 and "accent" or context.theme.series[level])
        p:fill(rect, bg)
        p:text(rect.x + 1, rect.y, labels[level + 1], fg, bg, width - 1)
        context:hit({ type = "chart_level", level = level }, rect)
        x = x + width + 1
    end
    local windowText = string.format("近 %d 游戏时", gameHoursText(windowMinutes))
    p:textRight(r.x, r.y + 1, r.w - 2, windowText, "disabled", "surface")
end
local function metrics(r)
    local x0 = r.x + 2 + 1 + GUTTER
    local y0 = r.y + 3
    local w = r.w - 2 * 2 - 2 - GUTTER
    local h = r.h - 5
    return x0, y0, w, h
end
local function shortNumber(value, width)
    local text = util.formatVolume(tonumber(value) or 0)
    width = math.max(1, math.floor(width or 1))
    if #text <= width then return text end
    local short = text:gsub("%.%d+", "")
    return #short <= width and short or (short:sub(1, math.max(1, width - 1)) .. "…")
end
local function gutter(_, context, r, y, value, role)
    local p = context.painter
    p:textRight(r.x + 1, y, GUTTER, shortNumber(value, GUTTER), role or "warning", "surface")
end
local function grid(_, context, x0, y0, w, h)
    local p = context.painter
    p:setBackground("surface")
    p:setForeground("chartGrid")
    for row = 1, 3 do
        local y = y0 + math.floor(h * row / 4)
        p.gpu.fill(x0, y, w, 1, "·")
    end
    p:setForeground("chartAxis")
    p.gpu.fill(x0 - 1, y0, 1, h, "│")
    p.gpu.fill(x0, y0 + h - 1, w, 1, "─")
    p.gpu.set(x0 - 1, y0 + h - 1, "└")
end
local function labels(_, context, x0, y0, w, h, count, interval)
    local p = context.painter
    if count < 2 then return end
    local points = { 1, math.floor(count / 2) + 1, count }
    for _, index in ipairs(points) do
        local x = x0 + math.floor((index - 1) / (count - 1) * (w - 1))
        local text
        if index == count then
            text = "现在"
        else
            local hours = math.floor(util.realSecondsToGameHours((count - index) * interval) + 0.5)
            text = hours < 1 and "刚刚" or string.format("-%d 游戏时", hours)
        end
        local tx = x - math.floor(p:measure(text) / 2)
        tx = math.max(x0, math.min(tx, x0 + w - p:measure(text)))
        p:text(tx, y0 + h, text, "muted", "surface", w)
    end
end
local function drawSeries(self, context, r, history, level)
    local p = context.painter
    local x0, y0, w, h = metrics(r)
    if w < 8 or h < 4 then return end
    local values = (history.values or {})[level] or {}
    local count = #values
    local windowMinutes = tonumber(history.windowMinutes) or 40
    local label = constants.levelLabel(level)
    p:text(x0, y0 - 1, string.format("近 %d 游戏时 %s 水量曲线（L）", gameHoursText(windowMinutes), label),
        "accent", "surface", w)
    if count < 2 then
        p:text(x0, y0 + math.floor(h / 2), "数据采集中…", "warning", "surface", w)
        return
    end
    local minimum, maximum = values[1], values[1]
    for index = 2, count do
        local value = values[index]
        if value < minimum then minimum = value end
        if value > maximum then maximum = value end
    end
    if minimum == maximum then maximum = minimum + 1 end
    grid(self, context, x0, y0, w, h)
    local color = context.theme.series[level]
    p:setForeground(color)
    p:setBackground("surface")
    local previous
    for index = 1, count do
        local x = x0 + math.floor((index - 1) / (count - 1) * (w - 1))
        local y = y0 + h - 1 - math.floor((values[index] - minimum) / (maximum - minimum) * (h - 1))
        if previous then
            local steps = math.max(1, math.abs(x - previous.x))
            for step = 0, steps do
                local px = previous.x + math.floor((x - previous.x) * step / steps)
                local py = previous.y + math.floor((y - previous.y) * step / steps)
                p.gpu.set(px, py, "█")
            end
        else
            p.gpu.set(x, y, "█")
        end
        previous = { x = x, y = y }
    end
    gutter(self, context, r, y0, maximum, "warning")
    gutter(self, context, r, y0 + h - 1, minimum, "warning")
    labels(self, context, x0, y0, w, h, count, history.interval or 30)
end
local function niceCeil(value)
    if value <= 0 then return 1 end
    local power = 1
    while power * 10 <= value do power = power * 10 end
    local fraction = value / power
    local step = fraction <= 1 and 1 or fraction <= 2 and 2 or fraction <= 5 and 5 or 10
    return step * power
end
local function drawBars(self, context, r, history)
    local p = context.painter
    local x0, y0, w, h = metrics(r)
    if w < 8 or h < 4 then return end
    local values, data = {}, {}
    for level = 1, constants.LEVEL_COUNT do
        local series = (history.values or {})[level] or {}
        values[level] = #series >= 2 and (series[#series] - series[1]) or 0
        data[level] = #series
    end
    if history.count < 2 then
        p:text(x0, y0 + math.floor(h / 2), "数据采集中…", "warning", "surface", w)
        return
    end
    grid(self, context, x0, y0, w, h)
    local extreme = 0
    for index = 1, #values do
        if math.abs(values[index]) > extreme then extreme = math.abs(values[index]) end
    end
    local bound = niceCeil(extreme * 1.05)
    local minValue, maxValue = -bound, bound
    local span = maxValue - minValue
    local function yOf(value)
        return y0 + h - 2 - math.floor((value - minValue) / span * (h - 2))
    end
    local zeroY = yOf(0)
    p:setForeground("muted")
    p:setBackground("surface")
    p.gpu.fill(x0, zeroY, w, 1, "─")
    local cellW = math.max(3, math.floor(w / constants.LEVEL_COUNT))
    local barW = math.max(1, math.min(cellW - 2, w))
    for level = 1, constants.LEVEL_COUNT do
        local value = values[level]
        local barX = x0 + (level - 1) * cellW + math.floor((cellW - barW) / 2)
        barX = math.max(x0, math.min(barX, x0 + w - barW))
        local valueY = yOf(value)
        local top = math.max(y0, math.min(zeroY, valueY))
        local bottom = math.min(y0 + h - 1, math.max(zeroY, valueY))
        if value ~= 0 then
            local color = value >= 0 and context.theme.color.accent or context.theme.color.danger
            p:fill({ x = barX, y = top, w = barW, h = math.max(1, bottom - top + 1) }, color)
        end
        local text = "T" .. level
        local labelX = x0 + (level - 1) * cellW
            + math.floor((cellW - p:measure(text)) / 2)
        p:text(labelX, y0 + h, text, "muted", "surface", cellW)
        if cellW >= 7 and data[level] >= 2 then
            local valueText = shortNumber(value, cellW)
            local textX = x0 + (level - 1) * cellW
                + math.floor((cellW - p:measure(valueText)) / 2)
            textX = math.max(x0, math.min(textX, x0 + w - p:measure(valueText)))
            local textY = value >= 0 and (top - 1) or (bottom + 1)
            textY = math.max(y0, math.min(y0 + h - 2, textY))
            p:text(textX, textY, valueText, value >= 0 and "accent" or "danger", "surface", cellW)
        end
    end
    gutter(self, context, r, y0, bound, "warning")
    gutter(self, context, r, zeroY, 0, "muted")
    gutter(self, context, r, y0 + h - 2, -bound, "warning")
end
function Chart:render(context)
    local p = context.painter
    local r = self.rect
    p:panel(r)
    if r.h < 7 or r.w < 24 then return end
    local history = self.props.history or { count = 0, values = {} }
    local windowMinutes = tonumber(history.windowMinutes) or 40
    chips(self, context, r, windowMinutes)
    local body = { x = r.x + 1, y = r.y + 2, w = math.max(1, r.w - 2), h = math.max(1, r.h - 3) }
    p:fill(body, "surface")
    if (history.count or 0) == 0 then
        local tip = "数据采集中…"
        p:text(r.x + math.max(1, math.floor((r.w - p:measure(tip)) / 2)),
            r.y + math.floor(r.h / 2), tip, "warning", "surface", r.w - 6)
        return
    end
    local level = context.ui.chartLevel or 0
    if level == 0 then
        drawBars(self, context, r, history)
    else
        drawSeries(self, context, r, history, level)
    end
end
return Chart

frontend/ui/components/control.lua
3364
local Component = require("frontend.ui.base")
local Control = {}
function Control.new()
    local self = Component.new("control", { rows = {}, buttons = {} })
    self.fingerprint = Control.fingerprint
    self.render = Control.render
    return self
end
function Control:fingerprint(context)
    local parts = { self.key, self.rect.x, self.rect.y, self.rect.w, self.rect.h, context.themeId }
    for _, row in ipairs(self.props.rows or {}) do
        parts[#parts + 1] = table.concat({ row.label, row.value, row.role }, ":")
    end
    for _, key in ipairs({ "system", "mode", "subparam", "refresh", "net", "quit" }) do
        local button = (self.props.buttons or {})[key] or {}
        parts[#parts + 1] = table.concat({
            key, tostring(button.label), tostring(button.disabled), tostring(button.role),
            tostring(button.active), tostring(button.background),
        }, ":")
    end
    return table.concat(parts, "\x1f")
end
local function drawButton(component, context, key, rect)
    local button = (component.props.buttons or {})[key]
    if not button or rect.w < 2 then return end
    local p = context.painter
    local disabled = button.disabled == true or (context.readOnly and key ~= "quit")
    p:button(rect, button.label or key, button.active == true, disabled, button.role, button.background)
    if not disabled then
        context:hit({ type = "command", name = button.action }, rect)
    end
end
local function columns(area, weights)
    local out, total = {}, 0
    for _, weight in ipairs(weights) do total = total + weight end
    local x, left = area.x, area.w
    for index, weight in ipairs(weights) do
        local width = (index == #weights) and left or math.floor(area.w * weight / total)
        out[index] = { x = x, w = width }
        x = x + width
        left = left - width
    end
    return out
end
function Control:render(context)
    local p = context.painter
    local r = self.rect
    local rows = self.props.rows or {}
    p:panel(r)
    p:text(r.x + 2, r.y + 1, "控制面板", "accent", "surface", math.max(1, r.w - 4))
    local cols = columns({ x = r.x + 2, w = math.max(1, r.w - 4) }, { 0.34, 0.66 })
    local maxRows = math.max(0, r.h - 8)
    for index = 1, math.min(#rows, maxRows) do
        local row = rows[index]
        local y = r.y + 1 + index
        p:text(cols[1].x, y, row.label, "text", "surface", cols[1].w)
        p:text(cols[2].x, y, row.value, row.role or "text", "surface", math.max(1, cols[2].w - 1))
    end
    local step = 2
    local startY = r.y + r.h - 2 - 8
    if startY <= r.y + 1 + math.min(#rows, maxRows) then
        step = 1
        startY = r.y + r.h - 2 - 4
    end
    local x = r.x + 3
    local fullW = math.max(2, r.w - 6)
    local halfW = math.floor((fullW - 1) / 2)
    drawButton(self, context, "system", { x = x, y = startY, w = fullW, h = 1 })
    drawButton(self, context, "mode", { x = x, y = startY + step, w = halfW, h = 1 })
    drawButton(self, context, "subparam",
        { x = x + halfW + 1, y = startY + step, w = fullW - halfW - 1, h = 1 })
    drawButton(self, context, "refresh", { x = x, y = startY + step * 2, w = fullW, h = 1 })
    drawButton(self, context, "net", { x = x, y = startY + step * 3, w = fullW, h = 1 })
    drawButton(self, context, "quit", { x = x, y = startY + step * 4, w = fullW, h = 1 })
end
return Control

frontend/ui/components/log.lua
2594
local unicode = require("unicode")
local Component = require("frontend.ui.base")
local LogPanel = {}
function LogPanel.new()
    local self = Component.new("log", { entries = {} })
    self.prepare = LogPanel.prepare
    self.fingerprint = LogPanel.fingerprint
    self.render = LogPanel.render
    self._wrapKey = nil
    self._wrapped = {}
    return self
end
local function wrapLine(text, width)
    local lines, current = {}, ""
    for index = 1, unicode.len(text) do
        local char = unicode.sub(text, index, index)
        if unicode.wlen(current .. char) > width then
            lines[#lines + 1] = current
            current = char
        else
            current = current .. char
        end
    end
    lines[#lines + 1] = current
    return lines
end
function LogPanel:prepare()
    local width = math.max(1, self.rect.w - 4)
    local view = self.props.log or {}
    local revision = tonumber(view.revision) or 0
    local key = tostring(revision) .. ":" .. tostring(width)
    if self._wrapKey == key then return end
    local wrapped = {}
    for _, entry in ipairs(view.entries or {}) do
        local text = tostring(entry.text or "")
        for line in (text .. "\n"):gmatch("(.-)\n") do
            local pieces = wrapLine(line, width)
            for _, piece in ipairs(pieces) do
                wrapped[#wrapped + 1] = {
                    text = piece,
                    kind = entry.kind or "info",
                    seq = entry.seq,
                }
            end
        end
    end
    self._wrapKey = key
    self._wrapped = wrapped
end
function LogPanel:fingerprint(context)
    self:prepare()
    return table.concat({
        self.key,
        self.rect.x, self.rect.y, self.rect.w, self.rect.h,
        context.themeId,
        self._wrapKey,
    }, "\x1f")
end
function LogPanel:render(context)
    local p = context.painter
    local r = self.rect
    self:prepare()
    p:panel(r, "系统日志")
    local rows = math.max(0, r.h - 2)
    if rows == 0 then return end
    p:fill({ x = r.x + 1, y = r.y + 1, w = r.w - 2, h = rows }, "surface")
    local total = #self._wrapped
    if total == 0 then
        p:text(r.x + 2, r.y + 1, "暂无日志", "muted", "surface", r.w - 4)
        return
    end
    local start = math.max(1, total - rows + 1)
    local y = r.y + 1
    for index = start, math.min(total, start + rows - 1) do
        local line = self._wrapped[index]
        local role = context.theme.log[line.kind] or "text"
        p:text(r.x + 2, y, line.text, role, "surface", r.w - 4)
        y = y + 1
    end
end
return LogPanel

frontend/ui/components/status.lua
12324
local Component = require("frontend.ui.base")
local constants = require("shared.constants")
local util = require("shared.util")
local Status = {}
function Status.new()
    local self = Component.new("status", { levels = {}, cycle = {} })
    self.fingerprint = Status.fingerprint
    self.render = Status.render
    return self
end
function Status:fingerprint(context)
    local cycle = self.props.cycle or {}
    local parts = {
        self.key, self.rect.x, self.rect.y, self.rect.w, self.rect.h,
        context.themeId,
        tostring(context.ui.detailLevel or 0),
        tostring(cycle.text), tostring(math.floor((cycle.ratio or 0) * 100)),
    }
    for level = 1, 8 do
        local row = self.props.levels[level] or {}
        parts[#parts + 1] = table.concat({
            row.label, tostring(row.switchText), tostring(row.waterOfText),
            tostring(math.floor((row.ratio or 0) * 100)), tostring(row.rateText),
            tostring(row.sample), tostring(row.sampleText), tostring(row.learned),
            tostring(row.suggestText), tostring(row.sampleRole), tostring(row.suggestRole),
            tostring(row.deployText), tostring(row.mark), tostring(row.running),
            tostring(row.active), tostring(row.deployed),
            tostring(row.rule and row.rule.userThreshold),
            tostring(row.rule and row.rule.effectiveThreshold),
            tostring(row.rule and row.rule.overridden),
        }, ":")
        for _, machine in ipairs(row.machines or {}) do
            parts[#parts + 1] = table.concat({
                tostring(machine.address), tostring(machine.active),
                tostring(machine.current), tostring(machine.confirmed),
                tostring(machine.success),
            }, ":")
        end
    end
    return table.concat(parts, "\x1f")
end
local function columns(area, weights)
    local out, total = {}, 0
    for _, weight in ipairs(weights) do total = total + weight end
    if total <= 0 then total = 1 end
    local x, left = area.x, area.w
    for index, weight in ipairs(weights) do
        local width = (index == #weights) and left
            or math.floor(area.w * weight / total)
        out[index] = { x = x, w = width }
        x = x + width
        left = left - width
    end
    return out
end
local BULLET = "· "
local RULE = "─"
local function ruleLine(p, x, y, width, text)
    local head = text ~= "" and (" " .. text .. " ") or ""
    local line = RULE .. head .. string.rep(RULE, math.max(0, width - p:measure(head) - 1))
    p:text(x, y, line, "disabled", "surface")
end
local function machineRows(p, row)
    local list, currentW, learnedW, rateW = {}, 0, 0, 0
    local learnedFallback = tonumber(row.learned)
    for index, machine in ipairs(row.machines or {}) do
        local current = machine.active
            and (machine.current ~= nil and util.formatNumber(machine.current) or "-")
            or "停"
        local learnedValue = machine.confirmed or learnedFallback
        local learned = learnedValue ~= nil and util.formatNumber(learnedValue) or "-"
        local rate = machine.success ~= nil and (tostring(machine.success) .. "%") or "-"
        list[#list + 1] = { index, current, learned, rate, machine.active == true }
        currentW = math.max(currentW, p:measure(current))
        learnedW = math.max(learnedW, p:measure(learned))
        rateW = math.max(rateW, p:measure(rate))
    end
    local function cell(prefix, value, width)
        return prefix .. string.rep(" ", math.max(0, width - p:measure(value))) .. value
    end
    local out = {}
    for _, item in ipairs(list) do
        out[#out + 1] = {
            label = string.format("%s#%d", BULLET, item[1]),
            value = table.concat({
                cell("当前并行 ", item[2], currentW),
                cell("学习并行 ", item[3], learnedW),
                cell("成功率 ", item[4], rateW),
            }, "   "),
            role = item[5] and "success" or "disabled",
        }
    end
    return out
end
local function detailRows(p, row, level)
    local per = constants.POWER_LEVELS[level] or 0
    local deployed = tonumber(row.deployed) or 0
    local suggest = tonumber(row.suggest) or 0
    local running = (tonumber(row.active) or 0) > 0
    local stale = running and "" or "（上次运行）"
    local num = util.formatNumber
    local rows = {}
    local function powerOf(parallel, perParallel, machines)
        return (tonumber(parallel) or 0) * 1.0
            * (tonumber(perParallel) or 0) * (tonumber(machines) or 0)
    end
    local function separator(text)
        rows[#rows + 1] = { kind = "rule", text = text }
    end
    local function item(label, value, role)
        rows[#rows + 1] = { kind = "item", label = BULLET .. label, value = value, role = role or "text" }
    end
    separator("基础")
    item("单并行功耗", num(per) .. " EU/t")
    item("已部署机器", tostring(deployed) .. " 台")
    local rule = row.rule or {}
    local userThreshold = tonumber(rule.userThreshold)
    local actualThreshold = tonumber(rule.effectiveThreshold)
    local thresholdText
    if rule.overridden == true and userThreshold ~= nil and actualThreshold ~= nil then
        thresholdText = util.formatNumber(math.floor(userThreshold / 1000)) .. " kL → " .. util.formatNumber(math.floor(actualThreshold / 1000)) .. " kL"
    else
        thresholdText = util.formatNumber(math.floor((actualThreshold or 0) / 1000)) .. " kL"
    end
    item("实际阈值", thresholdText, rule.overridden == true and "warning" or "text")
    separator("建议")
    item("每台并行", num(suggest), "accent")
    item("每台功耗", num(powerOf(suggest, per, 1)) .. " EU/t", "accent")
    item("全开总功耗", num(powerOf(suggest, per, deployed)) .. " EU/t", "accent")
    separator("当前功耗")
    local perPower = tonumber(row.sample)
    local totalPower = perPower and powerOf(perPower, per, deployed) or nil
    item("当前等级总功耗", totalPower and (num(totalPower) .. " EU/t" .. stale) or "-",
        running and "warning" or "disabled")
    separator("每台机器")
    for _, machineRow in ipairs(machineRows(p, row)) do
        rows[#rows + 1] = { kind = "item", label = machineRow.label,
            value = machineRow.value, role = machineRow.role }
    end
    return rows
end
local function detail(self, context)
    local p = context.painter
    local r = self.rect
    local level = context.ui.detailLevel
    local row = self.props.levels[level]
    p:panel(r)
    if not row then
        p:text(r.x + 2, r.y + 1, "净水单元详情：没有选中等级（点某一行进来）",
            "warning", "surface", r.w - 4)
        context:hit({ type = "detail_back" }, { x = r.x + 1, y = r.y + 1, w = r.w - 2, h = r.h - 2 })
        return
    end
    local title = string.format("净水单元详情 · %s", row.label or ("T" .. level))
    p:text(r.x + 2, r.y + 1, title, "accent", "surface", r.w - 4)
    p:textRight(r.x + 2, r.y + 1, r.w - 4, "← 点任意处返回", "disabled", "surface")
    local cols = columns({ x = r.x + 2, w = math.max(1, r.w - 4) }, { 0.26, 0.74 })
    local rows = detailRows(p, row, level)
    local top = r.y + 2
    local last = r.y + r.h - 2
    local drawn = 0
    for _, item in ipairs(rows) do
        local y = top + drawn
        if y > last then break end
        if item.kind == "rule" then
            ruleLine(p, cols[1].x, y, cols[1].w + cols[2].w, item.text)
        else
            p:text(cols[1].x, y, item.label, "disabled", "surface", cols[1].w)
            p:text(cols[2].x, y, tostring(item.value), item.role, "surface", cols[2].w)
        end
        drawn = drawn + 1
    end
    if drawn < #rows and top + drawn <= last then
        p:text(cols[1].x, top + drawn,
            string.format("…（屏高不够，还有 %d 行）", #rows - drawn), "warning", "surface")
    end
    context:hit({ type = "detail_back" }, { x = r.x + 1, y = r.y + 1, w = r.w - 2, h = r.h - 2 })
end
function Status:render(context)
    local p = context.painter
    local r = self.rect
    local cycle = self.props.cycle or {}
    if context.ui.detailLevel then
        detail(self, context)
        return
    end
    p:panel(r)
    local titleY = r.y + 1
    local title = "各级净水状态"
    p:text(r.x + 2, titleY, title, "accent", "surface", p:measure(title) + 1)
    local label = "运行周期 "
    local labelX = r.x + 3 + p:measure(title)
    local barX = labelX + p:measure(label)
    local pctW = 7
    local hint = "点某一级看详情 →"
    local hintW = p:measure(hint)
    local pctX = r.x + r.w - 2 - pctW
    if pctX - barX > hintW + 2 then
        p:textRight(r.x, titleY, r.w - 3, hint, "muted", "surface")
        pctX = r.x + r.w - 3 - hintW - pctW - 1
    end
    local barW = pctX - barX - 1
    if barW >= 8 then
        p:text(labelX, titleY, label, "muted", "surface")
        p:bar({ x = barX, y = titleY, w = barW, h = 1 }, cycle.ratio or 0,
            "cycleFill", "cycleTrack", "cycleTrack")
    end
    p:textRight(pctX, titleY, pctW, tostring(cycle.text or "-"), "accent", "surface")
    local top = r.y + 2
    local bottom = r.y + r.h - 2
    local available = math.max(0, bottom - top + 1)
    local rowH = available >= 16 and 2 or 1
    local inner = { x = r.x + 2, w = math.max(1, r.w - 4) }
    local cols = columns(inner, { 0.30, 0.24, 0.46 })
    local parallelLabel = "并行 "
    local parallelLabelW = p:measure(parallelLabel)
    local parallelIdealW = parallelLabelW + 7 + 1 + 7
    local parallelW = math.min(parallelIdealW, cols[3].w)
    local parallelValueSpace = math.max(2, parallelW - parallelLabelW - 1)
    local parallelLeftW = math.max(1, math.floor(parallelValueSpace / 2))
    local parallelRightW = math.max(1, parallelValueSpace - parallelLeftW)
    local rightEdge = cols[3].x + cols[3].w
    local rightX = rightEdge - parallelW
    local barX = inner.x
    local barW = math.max(0, rightX - barX - 1)
    for level = 1, 8 do
        local row = self.props.levels[level]
        local y = top + (level - 1) * rowH
        if not row or y > bottom then break end
        context:hit({ type = "detail_level", level = level },
            { x = r.x + 1, y = y, w = r.w - 2, h = rowH })
        local name = row.label .. " " .. tostring(row.deployText or "-")
        p:text(cols[1].x, y, name, row.running and "text" or "disabled", "surface", cols[1].w)
        local markRole = row.rule and row.rule.enabled and "success" or "disabled"
        local mark = tostring(row.mark or "[ ]")
        local markW = p:measure(mark)
        p:text(cols[2].x, y, mark, markRole, "surface")
        p:text(cols[2].x + markW + 1, y, row.switchText, row.switchRole or "muted",
            "surface", math.max(1, cols[2].w - markW - 1))
        local waterRoom = math.max(1, rightX - cols[3].x - 1)
        local waterText = "水量 " .. tostring(row.waterOfText or "- / -")
        if p:measure(waterText) > waterRoom then
            waterText = tostring(row.waterOfText or "- / -")
        end
        p:text(cols[3].x, y, p:truncate(waterText, waterRoom), "text", "surface", waterRoom)
        local successLabel = "成功率"
        local successValue = tostring(row.successText or "-")
        local successRoom = math.max(1, parallelW - p:measure(successLabel) - 1)
        p:text(rightX, y, successLabel, "accent", "surface")
        p:textRight(rightX, y, parallelW, p:truncate(successValue, successRoom),
            "accent", "surface")
        if rowH == 2 then
            if barW > 0 then
                p:bar({ x = barX, y = y + 1, w = barW, h = 1 }, row.ratio or 0)
            end
            local leftX = rightX + parallelLabelW
            local slashX = leftX + parallelLeftW
            local suggestX = slashX + 1
            p:text(rightX, y + 1, parallelLabel, "accent", "surface")
            p:text(leftX, y + 1,
                p:truncate(tostring(row.sampleText or "-"), parallelLeftW),
                row.sampleRole or "text", "surface", parallelLeftW)
            p:text(slashX, y + 1, "/", "muted", "surface")
            p:textRight(suggestX, y + 1, parallelRightW,
                p:truncate(tostring(row.suggestText or "-"), parallelRightW),
                row.suggestRole or "text", "surface")
        end
    end
end
return Status

frontend/ui/components/tabbar.lua
